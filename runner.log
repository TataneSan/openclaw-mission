package main

import (
	"encoding/csv"
	"flag"
	"fmt"
	"io"
	"os"
	"strconv"
	"strings"
)

var (
	delimiter = flag.String("d", ",", "field delimiter")
	columns   = flag.Int("columns", 0, "expected number of columns (0 = auto from header)")
	version   = flag.Bool("version", false, "print version and exit")
)

const versionStr = "csv-validate v1.0.0"

type error struct {
	line   int
	column int
	msg    string
}

func main() {
	flag.Parse()
	if *version {
		fmt.Println(versionStr)
		os.Exit(0)
	}

	files := flag.Args()
	if len(files) == 0 {
		fmt.Fprintln(os.Stderr, "usage: csv-validate [flags] file.csv [file2.csv ...]")
		fmt.Fprintln(os.Stderr, "Validates CSV structure: column count, empty fields, data types.")
		fmt.Fprintln(os.Stderr, "\nFlags:")
		fmt.Fprintln(os.Stderr, "  -columns int  expected number of columns (0 = auto from header)")
		fmt.Fprintln(os.Stderr, "  -d string     field delimiter (default \",\")")
		os.Exit(1)
	}

	allValid := true
	for _, filename := range files {
		if !validateFile(filename, *delimiter, *columns) {
			allValid = false
		}
	}

	if !allValid {
		os.Exit(1)
	}
}

func validateFile(filename, delimiter string, expectedCols int) bool {
	f, err := os.Open(filename)
	if err != nil {
		fmt.Fprintf(os.Stderr, "%s: error opening: %v\n", filename, err)
		return false
	}
	defer f.Close()

	r := csv.NewReader(f)
	r.Comma = []rune(delimiter)[0]
	r.FieldsPerRecord = -1 // allow variable
	r.LazyQuotes = true

	var errors []error
	line := 0
	expected := expectedCols

	for {
		record, err := r.Read()
		if err == io.EOF {
			break
		}
		if err != nil {
			errors = append(errors, error{line: line, msg: fmt.Sprintf("parse error: %v", err)})
			line++
			continue
		}

		line++

		if line == 1 && expected == 0 {
			expected = len(record)
		}

		if expected > 0 && len(record) != expected {
			errors = append(errors, error{line: line, msg: fmt.Sprintf("expected %d columns, got %d", expected, len(record))})
		}

		for i, field := range record {
			if field == "" {
				if line > 1 {
					errors = append(errors, error{line: line, column: i + 1, msg: "empty field"})
				}
			}
		}
	}

	prefix := filename
	if len(errors) == 0 {
		fmt.Fprintf(os.Stderr, "%s: OK (%d rows, %d columns)\n", prefix, line, expected)
		return true
	}

	for _, e := range errors {
		loc := fmt.Sprintf("%s:line %d", prefix, e.line)
		if e.column > 0 {
			loc += fmt.Sprintf(",col %d", e.column)
		}
		fmt.Fprintf(os.Stderr, "%s: %s\n", loc, e.msg)
	}

	fmt.Fprintf(os.Stderr, "%s: %d errors in %d rows\n", prefix, len(errors), line)
	return false
}

var _ = strconv.Atoi
var _ = strings.TrimSpace
EOF
