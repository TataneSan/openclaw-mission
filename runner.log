+package main
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+)
+
+var (
+	uncheckedRe = regexp.MustCompile(`^(\s*[-*])\s+\[ \](.*)$`)
+	checkedRe   = regexp.MustCompile(`^(\s*[-*])\s+\[x\](.*)$`)
+	anyCheckRe  = regexp.MustCompile(`^(\s*[-*])\s+\[([ x])\](.*)$`)
+)
+
+func main() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	cmd := os.Args[1]
+	switch cmd {
+	case "list", "ls":
+		doList(os.Args[2:])
+	case "toggle":
+		doToggle(os.Args[2:])
+	case "check":
+		doCheck(os.Args[2:])
+	case "uncheck":
+		doUncheck(os.Args[2:])
+	case "add":
+		doAdd(os.Args[2:])
+	case "progress":
+		doProgress(os.Args[2:])
+	case "clear":
+		doClear(os.Args[2:])
+	case "-h", "--help", "help":
+		printUsage()
+	default:
+		fmt.Fprintf(os.Stderr, "Unknown command: %s\n", cmd)
+		printUsage()
+		os.Exit(1)
+	}
+}
+
