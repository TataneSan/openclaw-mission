+func main() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	s, err := store.NewStore()
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "Error: %v\n", err)
+		os.Exit(1)
+	}
+	defer s.Close()
+
+	cmd := os.Args[1]
+	args := os.Args[2:]
+
+	switch cmd {
+	case "start":
+		handleStart(s, args)
+	case "stop":
+		handleStop(s)
+	case "status":
+		handleStatus(s)
+	case "history", "list", "log":
+		handleHistory(s, args)
+	case "projects":
+		handleProjects(s)
+	case "delete", "rm":
+		handleDelete(s, args)
+	case "report":
+		handleReport(s, args)
+	case "help", "-h", "--help":
+		printUsage()
+	case "version", "-v", "--version":
+		fmt.Println("time-tracker v1.0.0")
+	default:
+		fmt.Fprintf(os.Stderr, "Error: unknown command '%s'\n\n", cmd)
+		printUsage()
+		os.Exit(1)
+	}
+}
+
+func handleStart(s *store.Store, args []string) {
+	project := ""
+	task := ""
+
+	// Parse --project flag
+	for i, arg := range args {
+		if arg == "--project" && i+1 < len(args) {
+			project = args[i+1]
+		} else if arg == "--task" && i+1 < len(args) {
+			task = args[i+1]
+		} else if !strings.HasPrefix(arg, "--") {
+			if task == "" {
+				task = arg
+			} else if project == "" {
+				project = arg
+			}
+		}
+	}
+
+	if task == "" {
+		// Use remaining args as task
+		task = strings.Join(filterFlags(args), " ")
+	}
