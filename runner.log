+package main
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestCleanLineContinuations(t *testing.T) {
+	input := `curl -X POST \
+  https://api.example.com \
+  -H "Content-Type: application/json"`
+	result := cleanLineContinuations(input)
+	if strings.Contains(result, "\\\\") {
+		t.Error("expected no line continuations")
+	}
+	if !strings.Contains(result, "curl -X POST") {
+		t.Error("expected curl command preserved")
+	}
+}
+
+func TestParseCurlBasic(t *testing.T) {
+	cc := parseCurl(`curl -X POST https://api.example.com/users -H "Content-Type: application/json" -d '{"name":"Alice"}'`)
+
+	if cc.method != "POST" {
+		t.Errorf("expected POST, got %s", cc.method)
+	}
+	if cc.url != "https://api.example.com/users" {
+		t.Errorf("expected URL, got %s", cc.url)
+	}
+	if len(cc.headers) != 1 {
+		t.Errorf("expected 1 header, got %d", len(cc.headers))
+	}
+	if cc.data != `{"name":"Alice"}` {
+		t.Errorf("expected data, got %s", cc.data)
+	}
+}
+
+func TestParseCurlGetMethod(t *testing.T) {
+	cc := parseCurl(`curl https://api.example.com`)
+	if cc.method != "GET" {
+		t.Errorf("expected GET, got %s", cc.method)
+	}
+}
+
+func TestParseCurlInferPost(t *testing.T) {
+	cc := parseCurl(`curl https://api.example.com -d 'test'`)
+	if cc.method != "POST" {
+		t.Errorf("expected POST (inferred from -d), got %s", cc.method)
+	}
+}
+
+func TestParseCurlFlags(t *testing.T) {
+	cc := parseCurl(`curl -L -k --compressed https://api.example.com`)
+	if !cc.followRedirect {
+		t.Error("expected followRedirect=true")
+	}
+	if !cc.insecure {
+		t.Error("expected insecure=true")
+	}
+	if !cc.compress {
+		t.Error("expected compress=true")
+	}
+}
+
+func TestParseCurlAuth(t *testing.T) {
+	cc := parseCurl(`curl -u admin:password https://api.example.com`)
+	if cc.auth != "admin:password" {
+		t.Errorf("expected auth, got %s", cc.auth)
+	}
+}
+
+func TestTokenizer(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected int
+	}{
+		{`curl https://example.com`, 2},
+		{`curl -H "Content-Type: json" https://example.com`, 4},
