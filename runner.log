+package main
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+// Schema represents the YAML validation schema for env files.
+type Schema struct {
+	Variables map[string]VariableSchema `yaml:"variables"`
+}
+
+// VariableSchema defines the validation rules for a single env variable.
+type VariableSchema struct {
+	Type        string `yaml:"type"`
+	Required    bool   `yaml:"required"`
+	Default     *string `yaml:"default,omitempty"`
+	Description string `yaml:"description,omitempty"`
+	Enum        []string `yaml:"enum,omitempty"`
+	Min         *int   `yaml:"min,omitempty"`
+	Max         *int   `yaml:"max,omitempty"`
+	MinLength   *int   `yaml:"min_length,omitempty"`
+	MaxLength   *int   `yaml:"max_length,omitempty"`
+	Pattern     string `yaml:"pattern,omitempty"`
+}
+
+// EnvVar represents a parsed environment variable.
+type EnvVar struct {
+	Key   string
+	Value string
+}
+
+// ValidationResult holds the outcome of validating one variable.
+type ValidationResult struct {
+	Key       string
+	Valid     bool
+	Errors    []string
+	UsedValue string
+}
+
+func main() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	command := os.Args[1]
+
+	switch command {
+	case "validate":
+		exitValidate(os.Args[2:])
+	case "check":
+		exitValidate(os.Args[2:])
+	case "list":
+		exitList(os.Args[2:])
+	case "example":
+		exitExample(os.Args[2:])
+	case "help", "--help", "-h":
+		printUsage()
+	case "--version", "-v":
+		fmt.Println("env-schema v1.0.0")
+	default:
+		fmt.Fprintf(os.Stderr, "Unknown command: %s\n", command)
+		printUsage()
+		os.Exit(1)
+	}
+}
+
+func printUsage() {
+	usage := `
+env-schema - Validate .env files against a YAML schema
+
