+}
+
+func clearLine() {
+	fmt.Print("\r\033[K")
+}
+
+func printCentered(text string) {
+	width := 80
+	if termWidth, err := getTermWidth(); err == nil && termWidth > 0 {
+		width = termWidth
+	}
+	padded := strings.Repeat(" ", (width-len(text))/2) + text
+	fmt.Printf("\r%s\n", padded)
+}
+
+func getTermWidth() (int, error) {
+	var buf [8]byte
+	if _, err := syscall.Syscall(syscall.SYS_IOCTL, syscall.Stdin, 0x5413, uintptr(unsafe.Pointer(&buf[0]))); err != 0 {
+		return 0, err
+	}
+	return int(*(*uint16)(unsafe.Pointer(&buf))), nil
+}
+
+func formatTime(seconds int) string {
+	m := seconds / 60
+	s := seconds % 60
+	return fmt.Sprintf("%02d:%02d", m, s)
+}
