+
+type BingoCard struct {
+	Name   string
+	Grid   [5][5]string
+	Numbers [5][5]int
+}
+
+var columns = []struct {
+	letter string
+	min    int
+	max    int
+}{
+	{"B", 1, 15},
+	{"I", 16, 30},
+	{"N", 31, 45},
+	{"G", 46, 60},
+	{"O", 61, 75},
+}
+
+func generateCard(name string) *BingoCard {
+	card := &BingoCard{Name: name}
+	used := make(map[int]bool)
+
+	for col := 0; col < 5; col++ {
+		min := columns[col].min
+		max := columns[col].max
+		nums := make([]int, 0, 15)
+
+		for n := min; n <= max; n++ {
+			nums = append(nums, n)
+		}
+
+		rand.Shuffle(len(nums), func(i, j int) {
+			nums[i], nums[j] = nums[j], nums[i]
+		})
+
+		for row := 0; row < 5; row++ {
+			val := nums[row]
+			card.Numbers[row][col] = val
+			if row == 2 && col == 2 {
+				card.Grid[row][col] = " FREE "
+			} else {
+				s := strconv.Itoa(val)
+				if len(s) == 1 {
+					s = "  " + s + "  "
+				} else {
+					s = " " + s + " "
+				}
+				card.Grid[row][col] = s
+			}
+			used[val] = true
+		}
+	}
+
+	return card
+}
