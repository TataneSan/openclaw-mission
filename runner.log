+package domain
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/TataneSan/nginx-gen/internal/model"
+)
+
+// Generator produces Nginx configuration from a Config model.
+type Generator struct{}
+
+// Generate renders the full Nginx config string.
+func (g *Generator) Generate(cfg *model.Config) string {
+	var sb strings.Builder
+
+	for _, ups := range cfg.Upstreams {
+		sb.WriteString(g.renderUpstream(ups))
+		sb.WriteString("\n")
+	}
+
+	for i, s := range cfg.ServerBlocks {
+		if i > 0 {
+			sb.WriteString("\n")
+		}
+		sb.WriteString(g.renderServerBlock(s))
+	}
+
+	return sb.String()
+}
+
+func (g *Generator) renderUpstream(ups model.Upstream) string {
+	var sb strings.Builder
+	sb.WriteString(fmt.Sprintf("upstream %s {\n", ups.Name))
+	for _, srv := range ups.Servers {
+		line := fmt.Sprintf("    server %s", srv.Address)
+		if srv.Weight > 0 {
+			line += fmt.Sprintf(" weight=%d", srv.Weight)
+		}
+		sb.WriteString(line + ";\n")
+	}
+	sb.WriteString("}\n")
+	return sb.String()
+}
+
+func (g *Generator) renderServerBlock(s model.ServerBlock) string {
+	var sb strings.Builder
+
+	// Determine if this is an HTTPS block
+	isHTTPS := s.SSLCert != "" || s.SSLKey != ""
+
+	sb.WriteString("server {\n")
+	if isHTTPS {
+		sb.WriteString(fmt.Sprintf("    listen %d ssl;\n", s.Listen))
+	} else {
+		sb.WriteString(fmt.Sprintf("    listen %d;\n", s.Listen))
+	}
+	sb.WriteString(fmt.Sprintf("    server_name %s;\n", s.ServerName))
+
+	if s.Root != "" {
+		sb.WriteString(fmt.Sprintf("    root %s;\n", s.Root))
+	}
+
+	if len(s.Index) > 0 {
+		sb.WriteString(fmt.Sprintf("    index %s;\n", strings.Join(s.Index, " ")))
+	}
+
+	if isHTTPS {
+		sb.WriteString(fmt.Sprintf("    ssl_certificate %s;\n", s.SSLCert))
+		sb.WriteString(fmt.Sprintf("    ssl_certificate_key %s;\n", s.SSLKey))
+		sb.WriteString("    ssl_protocols TLSv1.2 TLSv1.3;\n")
+		sb.WriteString("    ssl_ciphers HIGH:!aNULL:!MD5;\n")
+	}
+
+	if s.RedirectHTTP != nil && s.RedirectHTTP.Enabled && !isHTTPS {
+		sb.WriteString("    return 301 https://$host$request_uri;\n")
+	}
+
