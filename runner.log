+package scanner
+
+import (
+	"encoding/json"
+	"fmt"
+	"net"
+	"sort"
+	"sync"
+	"time"
+
+	"github.com/TataneSan/port-scanner/services"
+)
+
+// Result holds the scan result for a single port.
+type Result struct {
+	Host    string `json:"host"`
+	Port    int    `json:"port"`
+	State   string `json:"state"`
+	Service string `json:"service,omitempty"`
+	Latency string `json:"latency,omitempty"`
+}
+
+// Config holds scan configuration.
+type Config struct {
+	Host     string
+	Ports    []int
+	Workers  int
+	Timeout  time.Duration
+	JSON     bool
+	Verbose  bool
+}
+
+// ScanResult holds the full results of a scan.
+type ScanResult struct {
+	Host      string   `json:"host"`
+	OpenPorts []Result `json:"open_ports"`
+	Scanned   int      `json:"ports_scanned"`
+	Open      int      `json:"open_count"`
+	Closed    int      `json:"closed_count"`
+	Duration  string   `json:"duration"`
+}
+
+// Scan performs a TCP port scan with the given configuration.
+func Scan(cfg Config) (*ScanResult, error) {
+	if len(cfg.Ports) == 0 {
+		return nil, fmt.Errorf("no ports specified")
+	}
+	if cfg.Workers <= 0 {
+		cfg.Workers = 100
+	}
+	if cfg.Timeout <= 0 {
+		cfg.Timeout = 1 * time.Second
+	}
+
+	start := time.Now()
+
+	// Resolve host
+	addrs, err := net.LookupHost(cfg.Host)
+	if err != nil {
+		return nil, fmt.Errorf("cannot resolve host %q: %w", cfg.Host, err)
+	}
+	ip := addrs[0]
+
+	portCh := make(chan int, cfg.Workers)
+	resultCh := make(chan Result, len(cfg.Ports))
+
+	var wg sync.WaitGroup
+
+	// Spawn workers
+	for i := 0; i < cfg.Workers; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for port := range portCh {
+				addr := fmt.Sprintf("%s:%d", ip, port)
+				connStart := time.Now()
+				conn, err := net.DialTimeout("tcp", addr, cfg.Timeout)
+				latency := time.Since(connStart)
