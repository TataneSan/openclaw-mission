+#!/usr/bin/env bash
+# env-export - Export variables from a .env file into the current shell
+# Usage: source env-export [.env [OPTIONS]]
+
+set -euo pipefail
+
+# Defaults
+ENV_FILE=".env"
+VERBOSE=0
+NO_EXPORT=0
+SHELL_TYPE=""
+
+# Colors
+RED='\033[0;31m'
+GREEN='\033[0;32m'
+CYAN='\033[0;36m'
+YELLOW='\033[1;33m'
+BOLD='\033[1m'
+RESET='\033[0m'
+
+usage() {
+    cat << 'EOF'
+env-export - Export variables from .env files into the current shell
+
+Usage:
+  source env-export [.env [OPTIONS]]
+  source env-export /path/to/.env
+
+Options:
+  -v, --verbose    Show each variable as it is exported
+  --no-export      Print export commands without executing them
+  -h, --help       Show this help message
+
+Examples:
+  source env-export                     # Load .env from current directory
+  source env-export .env.production     # Load a specific .env file
+  source env-export .env -v             # Load with verbose output
+  source env-export .env --no-export    # Preview what would be exported
+
+Notes:
+  - Must be sourced (not executed) to affect the current shell
+  - Supports standard .env format: KEY=VALUE
+  - Lines starting with # are ignored (comments)
+  - Empty lines are skipped
+  - Values can be quoted with single or double quotes
+  - Exports variables so child processes inherit them
+EOF
+}
+
+log_info() {
+    if [[ "$VERBOSE" -eq 1 ]]; then
+        printf "  ${CYAN}→${RESET} %s\n" "$1"
+    fi
+}
+
+log_success() {
+    if [[ "$VERBOSE" -eq 1 ]]; then
+        printf "  ${GREEN}✓${RESET} %s\n" "$1"
+    fi
+}
+
+log_warn() {
+    printf "  ${YELLOW}!${RESET} %s\n" "$1" >&2
+}
+
+log_error() {
+    printf "  ${RED}✗${RESET} %s\n" "$1" >&2
+}
+
+# Parse arguments
+parse_args() {
+    while [[ $# -gt 0 ]]; do
+        case "$1" in
+            -h|--help)
+                usage
+                return 1
+                ;;
+            -v|--verbose)
