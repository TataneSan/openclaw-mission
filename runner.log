+func (s *JSONSurveyStore) Save(survey domain.Survey) error {
+	if survey.ID == "" {
+		survey.ID = generateID(survey.Title)
+	}
+	if survey.CreatedAt.IsZero() {
+		survey.CreatedAt = time.Now()
+	}
+	data, err := json.MarshalIndent(survey, "", "  ")
+	if err != nil {
+		return fmt.Errorf("failed to marshal survey: %w", err)
+	}
+	return os.WriteFile(s.surveyPath(survey.ID), data, 0644)
+}
+
+func (s *JSONSurveyStore) Get(id string) (domain.Survey, error) {
+	data, err := os.ReadFile(s.surveyPath(id))
+	if err != nil {
+		return domain.Survey{}, fmt.Errorf("survey not found: %s", id)
+	}
+	var survey domain.Survey
+	if err := json.Unmarshal(data, &survey); err != nil {
+		return domain.Survey{}, fmt.Errorf("failed to unmarshal survey: %w", err)
+	}
+	return survey, nil
+}
+
+func (s *JSONSurveyStore) List() ([]domain.Survey, error) {
+	entries, err := os.ReadDir(s.dataDir)
+	if err != nil {
+		return nil, fmt.Errorf("failed to read data directory: %w", err)
+	}
+	var surveys []domain.Survey
+	for _, entry := range entries {
+		if !strings.HasSuffix(entry.Name(), ".json") {
+			continue
+		}
+		data, err := os.ReadFile(filepath.Join(s.dataDir, entry.Name()))
+		if err != nil {
+			continue
+		}
+		var survey domain.Survey
+		if err := json.Unmarshal(data, &survey); err != nil {
+			continue
+		}
+		surveys = append(surveys, survey)
+	}
+	return surveys, nil
+}
