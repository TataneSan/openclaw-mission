+function renderText(template, data) {
+  let result = template;
+  for (const [key, value] of Object.entries(data)) {
+    const regex = new RegExp('\\{\\{' + key + '\\}\\}', 'g');
+    result = result.replace(regex, String(value));
+  }
+  return result;
+}
+
+function renderJson(template, data) {
+  let obj;
+  if (typeof template === 'object') {
+    obj = JSON.parse(JSON.stringify(template));
+  } else {
+    obj = JSON.parse(template);
+  }
+  return applyData(obj, data);
+}
+
+function applyData(obj, data, prefix) {
+  if (typeof obj !== 'string' || !obj.startsWith('{{') || !obj.endsWith('}}')) {
+    if (Array.isArray(obj)) return obj.map(item => applyData(item, data, prefix));
+    if (obj && typeof obj === 'object') {
+      const result = {};
+      for (const [k, v] of Object.entries(obj)) {
+        result[k] = applyData(v, data, prefix ? prefix + '.' + k : k);
+      }
+      return result;
+    }
+    return obj;
+  }
+
+  const key = obj.slice(2, -2).trim();
+  const parts = key.split('.');
+  let value = data;
+  for (const p of parts) {
+    if (value && typeof value === 'object' && p in value) {
+      value = value[p];
+    } else {
+      return obj;
+    }
+  }
+  return value;
+}
+
+function renderYaml(template, data) {
+  const jsonResult = renderJson(parseYaml(template), data);
+  return toJsonYaml(jsonResult);
+}
