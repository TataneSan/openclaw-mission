+// GitRunner executes git commands.
+type GitRunner struct{}
+
+// NewGitRunner creates a new GitRunner.
+func NewGitRunner() *GitRunner {
+	return &GitRunner{}
+}
+
+// runGit runs a git command and returns stdout.
+func (g *GitRunner) runGit(args ...string) (string, error) {
+	cmd := exec.Command("git", args...)
+	output, err := cmd.Output()
+	if err != nil {
+		return "", fmt.Errorf("git %s: %w", strings.Join(args, " "), err)
+	}
+	return strings.TrimSpace(string(output)), nil
+}
+
+// IsGitRepo checks if the current directory is a git repository.
+func (g *GitRunner) IsGitRepo() error {
+	_, err := g.runGit("rev-parse", "--git-dir")
+	if err != nil {
+		return fmt.Errorf("not a git repository")
+	}
+	return nil
+}
+
+// GetTags returns all tags sorted by creation date (newest first).
+func (g *GitRunner) GetTags() ([]string, error) {
+	output, err := g.runGit("tag", "--sort=-creatordate")
+	if err != nil {
+		return nil, err
+	}
+	lines := strings.Split(strings.TrimSpace(output), "\n")
+	var tags []string
+	for _, line := range lines {
+		line = strings.TrimSpace(line)
+		if line != "" {
+			tags = append(tags, line)
+		}
+	}
+	return tags, nil
+}
