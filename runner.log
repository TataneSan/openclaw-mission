+package infrastructure
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"strings"
+	"time"
+
+	"github.com/TataneSan/deploy-hook/internal/deploy"
+)
+
+// CommandRepository handles executing shell commands as deployment hooks.
+type CommandRepository struct{}
+
+// NewCommandRepository creates a new CommandRepository.
+func NewCommandRepository() *CommandRepository {
+	return &CommandRepository{}
+}
+
+// ExecuteHook executes a deployment hook command.
+func (r *CommandRepository) ExecuteHook(ctx context.Context, hook deploy.Hook) (*deploy.HookResult, error) {
+	startTime := time.Now()
+
+	result := &deploy.HookResult{
+		HookName:  hook.Name,
+		StartTime: startTime,
+	}
+
+	// Parse timeout if specified
+	timeout := 5 * time.Minute
+	if hook.Timeout != "" {
+		if d, err := parseDuration(hook.Timeout); err == nil {
+			timeout = d
+		}
+	}
+
+	// Create context with timeout
+	execCtx, cancel := context.WithTimeout(ctx, timeout)
+	defer cancel()
+
+	// Build command
+	cmd := exec.CommandContext(execCtx, hook.Command)
+	if len(hook.Args) > 0 {
+		cmd.Args = append([]string{hook.Command}, hook.Args...)
+	}
+
+	// Set working directory
+	if hook.WorkingDir != "" {
+		cmd.Dir = hook.WorkingDir
+	}
+
+	// Capture output
+	var output strings.Builder
+	cmd.Stdout = &output
+	cmd.Stderr = &output
+
+	// Execute command
+	err := cmd.Run()
+	endTime := time.Now()
+	result.EndTime = endTime
+	result.Duration = endTime.Sub(startTime).String()
+	result.Output = output.String()
+
+	if err != nil {
+		result.Success = false
+		result.ExitCode = cmd.ProcessState.ExitCode()
+
+		// Determine error message
+		if execCtx.Err() != nil {
+			result.Error = fmt.Sprintf("timeout after %v", timeout)
+		} else if exitError, ok := err.(*exec.ExitError); ok {
+			result.Error = fmt.Sprintf("exit code %d", exitError.ExitCode())
+		} else {
+			result.Error = err.Error()
+		}
+
