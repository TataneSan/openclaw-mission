+#!/usr/bin/env python3
+"""
+cert-check — Check SSL certificate expiration for domains.
+
+Usage:
+    cert-check example.com
+    cert-check example.com api.example.com:8443
+    cert-check -f domains.txt
+    cert-check example.com --json
+    cert-check example.com --warn 30 --crit 7
+"""
+
+import argparse
+import json
+import socket
+import ssl
+import sys
+from datetime import datetime, timezone
+from typing import List, Dict, Optional, Tuple
+
+
+# ── Colors ─────────────────────────────────────────────────────────────
+
+class C:
+    """ANSI colors for terminal output."""
+    RED = "\033[91m"
+    YELLOW = "\033[93m"
+    GREEN = "\033[92m"
+    CYAN = "\033[96m"
+    GRAY = "\033[90m"
+    BOLD = "\033[1m"
+    RESET = "\033[0m"
+
+
+def colorize(text: str, color: str, enabled: bool = True) -> str:
+    if not enabled:
+        return text
+    return f"{color}{text}{C.RESET}"
+
+
+# ── Certificate checking ───────────────────────────────────────────────
+
+def parse_host_port(target: str, default_port: int = 443) -> Tuple[str, int]:
+    """Parse 'host:port' or just 'host'."""
+    if ":" in target:
+        host, port_str = target.rsplit(":", 1)
+        try:
+            port = int(port_str)
+        except ValueError:
+            raise ValueError(f"Invalid port in '{target}'")
+        return host, port
+    return target, default_port
+
+
+def check_cert(host: str, port: int = 443, timeout: float = 10.0) -> Dict:
+    """Check SSL certificate for a host. Returns dict with cert info."""
+    result = {
+        "host": host,
+        "port": port,
+        "status": "ok",
+        "error": None,
+        "subject": None,
+        "issuer": None,
+        "not_before": None,
+        "not_after": None,
+        "days_remaining": None,
+        "serial": None,
+        "sans": [],
+        "protocol": None,
+        "cipher": None,
+    }
+
+    try:
+        ctx = ssl.create_default_context()
+        with socket.create_connection((host, port), timeout=timeout) as sock:
+            with ctx.wrap_socket(sock, server_hostname=host) as ssock:
+                cert = ssock.getpeercert()
+                result["protocol"] = ssock.version()
