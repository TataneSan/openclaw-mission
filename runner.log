+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strings"
+)
+
+func main() {
+	if len(os.Args) < 2 {
+		fmt.Fprintf(os.Stderr, "Usage: json-group-by <key> [file.json]\n")
+		fmt.Fprintf(os.Stderr, "\nGroup JSON array objects by a key.\n")
+		fmt.Fprintf(os.Stderr, "Reads JSON from stdin if no file provided.\n")
+		fmt.Fprintf(os.Stderr, "\nExamples:\n")
+		fmt.Fprintf(os.Stderr, "  json-group-by color items.json\n")
+		fmt.Fprintf(os.Stderr, "  cat items.json | json-group-by category\n")
+		fmt.Fprintf(os.Stderr, "  json-group-by status http://api.example.com/items\n")
+		os.Exit(1)
+	}
+
+	key := os.Args[1]
+	var data []byte
+	var err error
+
+	if len(os.Args) >= 3 {
+		src := os.Args[2]
+		if strings.HasPrefix(src, "http://") || strings.HasPrefix(src, "https://") {
