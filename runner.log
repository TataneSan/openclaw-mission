+package handlers
+
+import (
+	"encoding/json"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"strings"
+	"time"
+)
+
+// Config holds the server configuration.
+type Config struct {
+	CORS   bool
+	Delay  time.Duration
+	Silent bool
+}
+
+// NewMux creates the HTTP multiplexer with all routes.
+func NewMux(cfg *Config) *http.ServeMux {
+	mux := http.NewServeMux()
+	h := &handler{cfg: cfg}
+
+	mux.HandleFunc("/", h.echo)
+	mux.HandleFunc("/get", h.echo)
+	mux.HandleFunc("/post", h.echo)
+	mux.HandleFunc("/put", h.echo)
+	mux.HandleFunc("/delete", h.echo)
+	mux.HandleFunc("/patch", h.echo)
+	mux.HandleFunc("/headers", h.headers)
+	mux.HandleFunc("/method", h.method)
+	mux.HandleFunc("/user-agent", h.userAgent)
+	mux.HandleFunc("/ip", h.ip)
+
+	return mux
+}
+
+type handler struct {
+	cfg *Config
+}
+
+func (h *handler) logf(format string, args ...interface{}) {
+	if !h.cfg.Silent {
+		log.Printf(format, args...)
+	}
+}
+
+func (h *handler) cors(w http.ResponseWriter) {
+	if h.cfg.CORS {
+		w.Header().Set("Access-Control-Allow-Origin", "*")
+		w.Header().Set("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, PATCH, OPTIONS")
+		w.Header().Set("Access-Control-Allow-Headers", "*")
+	}
+}
+
+func (h *handler) delay() {
+	if h.cfg.Delay > 0 {
+		time.Sleep(h.cfg.Delay)
+	}
+}
+
+func (h *handler) remoteIP(r *http.Request) string {
+	addr := r.Header.Get("X-Forwarded-For")
+	if addr == "" {
+		addr = r.Header.Get("X-Real-IP")
+	}
+	if addr == "" {
+		host, _, _ := net.SplitHostPort(r.RemoteAddr)
+		addr = host
+	}
+	return addr
+}
+
+func (h *handler) jsonResponse(w http.ResponseWriter, data interface{}) {
+	w.Header().Set("Content-Type", "application/json")
+	json.NewEncoder(w).Encode(data)
+}
