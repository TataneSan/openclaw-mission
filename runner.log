+#!/usr/bin/env node
+const net = require('net');
+const http = require('http');
+const fs = require('fs');
+const path = require('path');
+
+const CONFIG_FILE = path.join(process.cwd(), 'portforward.json');
+
+// ANSI colors
+const COLORS = {
+  reset: '\x1b[0m',
+  bold: '\x1b[1m',
+  red: '\x1b[31m',
+  green: '\x1b[32m',
+  yellow: '\x1b[33m',
+  blue: '\x1b[34m',
+  cyan: '\x1b[36m',
+  gray: '\x1b[90m'
+};
+
+function log(message, color = '') {
+  const timestamp = new Date().toISOString();
+  process.stdout.write(`${COLORS.gray}[${timestamp}]${COLORS.reset} ${color}${message}${COLORS.reset}\n`);
+}
+
+function loadConfig() {
+  if (!fs.existsSync(CONFIG_FILE)) {
+    return { forwards: [] };
+  }
+  const raw = fs.readFileSync(CONFIG_FILE, 'utf-8');
+  return JSON.parse(raw);
+}
+
+function saveConfig(config) {
+  fs.writeFileSync(CONFIG_FILE, JSON.stringify(config, null, 2) + '\n');
+}
+
+function createForward(localPort, remoteHost, remotePort, bindAddress = '127.0.0.1') {
+  return new Promise((resolve, reject) => {
+    const server = net.createServer((clientSocket) => {
+      const clientInfo = `${clientSocket.remoteAddress}:${clientSocket.remotePort}`;
+      log(`Connection from ${clientInfo} -> ${remoteHost}:${remotePort}`, COLORS.cyan);
+
+      const remoteSocket = net.connect({
+        host: remoteHost,
+        port: remotePort
+      }, () => {
+        log(`Connected to ${remoteHost}:${remotePort}`, COLORS.green);
+        clientSocket.pipe(remoteSocket);
+        remoteSocket.pipe(clientSocket);
+      });
+
+      remoteSocket.on('error', (err) => {
+        log(`Remote error: ${err.message}`, COLORS.red);
+        clientSocket.end();
+      });
+
+      clientSocket.on('error', (err) => {
+        log(`Client error: ${err.message}`, COLORS.red);
+        remoteSocket.end();
+      });
+
+      clientSocket.on('close', () => {
+        remoteSocket.end();
+        log(`Connection closed from ${clientInfo}`, COLORS.gray);
+      });
+
+      remoteSocket.on('close', () => {
+        clientSocket.end();
+      });
+    });
+
+    server.on('error', (err) => {
+      if (err.code === 'EADDRINUSE') {
+        reject(new Error(`Port ${localPort} is already in use`));
+      } else if (err.code === 'EACCES' || err.code === 'EPERM') {
+        reject(new Error(`Permission denied to bind to port ${localPort}. Try a port > 1024 or run as root.`));
+      } else {
