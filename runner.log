+type CreateTemplateRequest struct {
+	Name    string `json:"name"`
+	Content string `json:"content"`
+	Format  string `json:"format"`
+}
+
+type RenderRequest struct {
+	Content string            `json:"content"`
+	Data    map[string]any    `json:"data"`
+	Format  string            `json:"format"`
+}
+
+func CreateTemplateHandler(store *infrastructure.TemplateStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var req CreateTemplateRequest
+		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+			writeError(w, http.StatusBadRequest, "invalid JSON body")
+			return
+		}
+		defer r.Body.Close()
+
+		if req.Name == "" || req.Content == "" {
+			writeError(w, http.StatusBadRequest, "name and content are required")
+			return
+		}
+
+		format := strings.ToLower(req.Format)
+		if format == "" {
+			format = "text"
+		}
+
+		t := &domain.Template{
+			Name:    req.Name,
+			Content: req.Content,
+			Format:  format,
+		}
+
+		result := store.Create(t)
+		writeJSON(w, http.StatusCreated, result)
+	}
+}
+
+func ListTemplatesHandler(store *infrastructure.TemplateStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		templates := store.List()
+		writeJSON(w, http.StatusOK, templates)
+	}
+}
+
+func GetTemplateHandler(store *infrastructure.TemplateStore) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		vars := mux.Vars(r)
+		id := vars["id"]
+
+		t, err := store.Get(id)
+		if err != nil {
+			writeError(w, http.StatusNotFound, err.Error())
+			return
+		}
+		writeJSON(w, http.StatusOK, t)
+	}
+}
+
