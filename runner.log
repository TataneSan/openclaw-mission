+// Deploy runs the deployment pipeline: pre-deploy, deploy, post-deploy.
+func (d *Deployer) Deploy(version, commit string) error {
+	start := time.Now()
+	record := config.DeploymentRecord{
+		ID:        generateID(),
+		Timestamp: start,
+		Version:   version,
+		Commit:    commit,
+		Author:    currentAuthor(),
+		Status:    "failed",
+		Message:   "",
+	}
+
+	fmt.Printf("Starting deployment of %s v%s...\n", d.Config.App, version)
+
+	// Pre-deploy hooks
+	if len(d.Config.PreDeploy) > 0 {
+		fmt.Println("Running pre-deploy hooks...")
+		if err := runCommands(d.Config.PreDeploy); err != nil {
+			record.Message = fmt.Sprintf("pre-deploy failed: %v", err)
+			d.saveRecord(record)
+			return fmt.Errorf("pre-deploy failed: %w", err)
+		}
+	}
+
+	// Deploy hooks
+	if len(d.Config.Deploy) > 0 {
+		fmt.Println("Running deploy commands...")
+		if err := runCommands(d.Config.Deploy); err != nil {
+			record.Message = fmt.Sprintf("deploy failed: %v", err)
+			d.saveRecord(record)
+			return fmt.Errorf("deploy failed: %w", err)
+		}
+	} else {
+		// Default: copy to target path
+		if err := d.defaultDeploy(); err != nil {
+			record.Message = fmt.Sprintf("default deploy failed: %v", err)
+			d.saveRecord(record)
+			return fmt.Errorf("default deploy failed: %w", err)
+		}
+	}
+
+	// Post-deploy hooks
+	if len(d.Config.PostDeploy) > 0 {
+		fmt.Println("Running post-deploy hooks...")
+		if err := runCommands(d.Config.PostDeploy); err != nil {
+			record.Message = fmt.Sprintf("post-deploy failed: %v", err)
+			d.saveRecord(record)
+			return fmt.Errorf("post-deploy failed: %w", err)
