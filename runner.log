+// Package query evaluates dot-notation expressions against parsed JSON.
+// Supports: field access, array indexing, slicing, iteration, select(), keys(), length, type.
+package query
+
+import (
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// Eval evaluates an expression against a JSON document and returns all matching results.
+func Eval(doc any, expr string) ([]any, nil) {
+	expr = strings.TrimSpace(expr)
+	if expr == "" || expr == "." {
+		return []any{doc}, nil
+	}
+
+	parts := tokenize(expr)
+	results := []any{doc}
+
+	for _, part := range parts {
+		next := []any{}
+		for _, val := range results {
+			matched, err := applyOne(val, part)
+			if err != nil {
+				return nil, err
+			}
+			next = append(next, matched...)
+		}
+		results = next
+		if len(results) == 0 {
+			return results, nil
+		}
+	}
+
+	return results, nil
+}
+
+// tokenize splits an expression like ".users[].name" into [".users", "[*]", ".name"].
+func tokenize(expr string) []string {
+	parts := []string{}
+	current := ""
+	inBrackets := 0
+	inParens := 0
+
+	for _, ch := range expr {
+		switch ch {
+		case '[':
+			inBrackets++
+			current += string(ch)
+		case ']':
+			inBrackets--
+			current += string(ch)
+		case '(':
+			inParens++
+			current += string(ch)
+		case ')':
+			inParens--
+			current += string(ch)
+		case '.':
+			if inBrackets == 0 && inParens == 0 {
+				if current != "" {
+					parts = append(parts, current)
+				}
+				current = ""
+			} else {
+				current += string(ch)
+			}
+		case ' ':
+			if inBrackets == 0 && inParens == 0 {
+				continue
+			}
+			current += string(ch)
+		default:
+			current += string(ch)
+		}
