+var rootCmd = &cobra.Command{
+	Use:   "snippet-cli",
+	Short: "Shell snippet manager — save, search, and run command snippets",
+	Long: `snippet-cli is a command-line tool to manage shell command snippets.
+
+Save your frequently used commands, organize them by category and tags,
+search through them, and execute them with a single command.
+
+Examples:
+  snippet-cli add "git rebase -i HEAD~3" --name "rebase" --category "git"
+  snippet-cli search rebase
+  snippet-cli run "rebase"
+  snippet-cli list --category git`,
+	Version: version,
+}
+
+func Execute() error {
+	return rootCmd.Execute()
+}
+
