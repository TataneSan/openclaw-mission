+package main
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"sort"
+	"strings"
+)
+
+var version = "1.0.0"
+
+type entry struct {
+	path  string
+	size  int64
+}
+
+func runGit(args ...string) (string, error) {
+	cmd := exec.Command("git", args...)
+	cmd.Dir = "."
+	out, err := cmd.Output()
+	return strings.TrimSpace(string(out)), err
+}
+
+func getRepoSize() (int64, error) {
+	out, err := exec.Command("du", "-sb", ".git").Output()
+	if err != nil {
+		return 0, err
+	}
+	var size int64
+	fmt.Sscanf(string(out), "%d", &size)
+	return size, nil
+}
+
+func getWorkingTreeSize() (int64, error) {
+	cmd := exec.Command("git", "ls-files")
+	cmd.Dir = "."
+	out, err := cmd.Output()
+	if err != nil {
+		return 0, err
+	}
+
+	total := int64(0)
+	files := strings.Split(strings.TrimSpace(string(out)), "\n")
+	for _, f := range files {
+		if f == "" {
+			continue
+		}
+		info, err := os.Stat(f)
+		if err != nil {
+			continue
+		}
+		total += info.Size()
+	}
+	return total, nil
+}
+
+func getTopBlobs(limit int) ([]entry, error) {
+	args := []string{"rev-list", "--objects", "--all"}
+	out, err := runGit(args...)
+	if err != nil {
+		return nil, err
+	}
+
+	lines := strings.Split(strings.TrimSpace(string(out)), "\n")
+	type blobLine struct {
+		hash string
+		path string
+	}
+	var blobs []blobLine
+	for _, line := range lines {
+		parts := strings.Fields(line)
+		if len(parts) >= 2 {
+			blobs = append(blobs, blobLine{parts[0], parts[1]})
+		}
+	}
+
