+#!/usr/bin/env python3
+"""
+base64-cli — Encode/decode base64, base32, hex with auto-detection.
+
+Usage:
+    base64-cli encode [-t TYPE] [INPUT]
+    base64-cli decode [-t TYPE] [INPUT]
+    base64-cli detect [INPUT]
+    base64-cli -h
+"""
+
+import argparse
+import base64
+import binascii
+import sys
+import urllib.parse
+
+# ── Encoding/decoding functions ──────────────────────────────────────────────
+
+ENCODERS = {
+    "base64": lambda data: base64.b64encode(data).decode("ascii"),
+    "base64url": lambda data: base64.urlsafe_b64encode(data).decode("ascii"),
+    "base32": lambda data: base64.b32encode(data).decode("ascii"),
+    "hex": lambda data: binascii.hexlify(data).decode("ascii"),
+    "url": lambda data: urllib.parse.quote(data.decode("utf-8", errors="replace"), safe=""),
+}
+
+DECODERS = {
+    "base64": lambda s: base64.b64decode(s),
+    "base64url": lambda s: base64.urlsafe_b64decode(s),
+    "base32": lambda s: base64.b32decode(s, casefold=True),
+    "hex": lambda s: binascii.unhexlify(s.strip()),
+    "url": lambda s: urllib.parse.unquote(s).encode("utf-8"),
+}
+
+# ── Auto-detection ───────────────────────────────────────────────────────────
+
+def detect_encoding(s: str) -> str:
+    """Try to guess the encoding of a string."""
+    s = s.strip()
+
+    # URL-encoded: contains %XX patterns
+    if "%" in s and any(f"%{i:02X}" in s.upper() or f"%{i:02x}" in s for i in range(256)):
+        # Check if it looks like real URL encoding
+        import re
+        if re.search(r'%[0-9A-Fa-f]{2}', s):
+            return "url"
+
+    # Hex: only hex chars, even length
+    if len(s) >= 2 and len(s) % 2 == 0:
+        try:
+            bytes.fromhex(s)
+            return "hex"
+        except ValueError:
+            pass
+
+    # Base32: A-Z, 2-7, with optional = padding, length multiple of 8
+    import re
+    if re.match(r'^[A-Z2-7]+=*$', s) and len(s) % 8 == 0 and len(s) >= 8:
+        return "base32"
+
+    # Base64: A-Za-z0-9+/= with optional = padding, length multiple of 4
+    if re.match(r'^[A-Za-z0-9+/]+=*$', s) and len(s) % 4 == 0 and len(s) >= 4:
+        return "base64"
+
+    # Base64url: A-Za-z0-9-_ (no padding or = padding)
+    if re.match(r'^[A-Za-z0-9_-]+=*$', s) and len(s) >= 4:
+        return "base64url"
+
+    return "unknown"
+
+
+# ── Wrapping ─────────────────────────────────────────────────────────────────
+
+def wrap_lines(text: str, width: int = 76) -> str:
+    """Wrap text to the given width."""
+    lines = []
+    for i in range(0, len(text), width):
