+
+func parseEnvFile(filename string) ([]EnvVar, error) {
+	var file *os.File
+	var err error
+
+	if filename == "-" {
+		return nil, fmt.Errorf("stdin not supported for parsing, provide a file path")
+	}
+
+	file, err = os.Open(filename)
+	if err != nil {
+		return nil, err
+	}
+	defer file.Close()
+
+	var vars []EnvVar
+	var current EnvVar
+	scanner := bufio.NewScanner(file)
+	lineNum := 0
+
+	for scanner.Scan() {
+		lineNum++
+		line := scanner.Text()
+		trimmed := strings.TrimSpace(line)
+
+		if trimmed == "" {
+			continue
+		}
+
+		if cm := commentRe.FindStringSubmatch(trimmed); cm != nil {
+			comment := cm[1]
+			if len(vars) > 0 {
+				current = vars[len(vars)-1]
+				current.Comment = comment
+				vars[len(vars)-1] = current
+			} else {
+				// Comment before any var — look ahead
+				current.Comment = comment
+			}
+			// Parse inline metadata from comments
+			if strings.Contains(comment, "required") {
+				current.Required = true
+			}
+			if strings.Contains(strings.ToLower(comment), "example:") {
+				parts := strings.SplitN(comment, "example:", 2)
+				if len(parts) == 2 {
+					current.Example = strings.TrimSpace(parts[1])
+				}
+			}
+			if strings.Contains(strings.ToLower(comment), "type:") {
+				parts := strings.SplitN(comment, "type:", 2)
