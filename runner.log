+package main
+
+import (
+	"fmt"
+	"math/rand"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+)
+
+var faces = map[int]string{
+	1: "     \n  *  \n     \n  *  \n     ",
+	2: "  *  \n     \n     \n     \n  *  ",
+	3: "  *  \n     \n  *  \n     \n  *  ",
+	4: "  *  \n     \n  *  \n     \n  *  ",
+	5: "  *  \n     \n  *  \n     \n  *  ",
+	6: "  *  \n  *  \n  *  \n  *  \n  *  ",
+}
+
+func roll(sides int) int {
+	return rand.Intn(sides) + 1
+}
+
+func parseDiceNotation(notation string) (int, int, int) {
+	notation = strings.TrimSpace(notation)
+	parts := strings.Split(notation, "d")
+	if len(parts) != 2 {
+		return 0, 0, 0
+	}
+
+	count := 1
+	if parts[0] != "" {
+		c, err := strconv.Atoi(parts[0])
+		if err != nil || c < 1 {
+			return 0, 0, 0
+		}
+		count = c
+	}
+
+	sides, err := strconv.Atoi(parts[1])
+	if err != nil || sides < 2 {
+		return 0, 0, 0
+	}
+
+	return count, sides, 0
+}
+
+func main() {
+	rand.Seed(time.Now().UnixNano())
+
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	switch os.Args[1] {
+	case "roll":
+		cmdRoll(os.Args[2:])
+	case "d4":
+		cmdRollDice(1, 4, os.Args[2:])
+	case "d6":
+		cmdRollDice(1, 6, os.Args[2:])
+	case "d8":
+		cmdRollDice(1, 8, os.Args[2:])
+	case "d10":
+		cmdRollDice(1, 10, os.Args[2:])
+	case "d12":
+		cmdRollDice(1, 12, os.Args[2:])
+	case "d20":
+		cmdRollDice(1, 20, os.Args[2:])
+	default:
+		if notation := os.Args[1]; strings.Contains(notation, "d") || strings.Contains(notation, "D") {
+			cmdRollDiceNotation(notation)
+			return
+		}
+		fmt.Fprintf(os.Stderr, "Unknown command: %s\n\n", notation)
+		printUsage()
