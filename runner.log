+func TestHeadingParsing(t *testing.T) {
+	tests := []struct {
+		line       string
+		hasHeading bool
+	}{
+		{"# Hello", true},
+		{"## World", true},
+		{"### Test", true},
+		{"#### Deep", true},
+		{"##### Deeper", true},
+		{"###### Deepest", true},
+		{"Not a heading", false},
