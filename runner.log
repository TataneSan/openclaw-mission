+)
+
+type Parser struct{}
+
+func NewParser() *Parser {
+	return &Parser{}
+}
+
+func (p *Parser) GetAllProcesses() ([]*domain.Process, error) {
+	var processes []*domain.Process
+
+	entries, err := os.ReadDir("/proc")
+	if err != nil {
+		return nil, fmt.Errorf("read /proc: %w", err)
+	}
+
+	for _, entry := range entries {
+		if !entry.IsDir() {
+			continue
+		}
+
+		pidStr := entry.Name()
+		pid, err := strconv.Atoi(pidStr)
+		if err != nil {
+			continue
+		}
+
+		proc, err := parseProc(pid)
+		if err != nil {
+			continue
+		}
+		processes = append(processes, proc)
+	}
+
+	return processes, nil
+}
+
+func (p *Parser) GetProcessTree(filterPID int) (*domain.Process, error) {
+	processes, err := p.GetAllProcesses()
+	if err != nil {
+		return nil, err
+	}
+
+	processMap := make(map[int]*domain.Process)
+	for _, proc := range processes {
+		processMap[proc.PID] = proc
+	}
+
+	// Build tree
+	var roots []*domain.Process
+	for _, proc := range processes {
+		if proc.PPID == 0 || proc.PID == 1 {
+			roots = append(roots, proc)
+		} else if parent, ok := processMap[proc.PPID]; ok {
+			parent.Children = append(parent.Children, proc)
+		} else if proc.PPID != 0 {
+			roots = append(roots, proc)
+		}
+	}
+
+	// If filterPID specified, find that subtree
+	if filterPID > 0 {
+		if proc, ok := processMap[filterPID]; ok {
+			return proc, nil
+		}
