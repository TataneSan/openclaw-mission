+"""Git repository statistics analysis."""
+
+import subprocess
+import re
+from collections import defaultdict
+from dataclasses import dataclass, field
+from datetime import datetime, timedelta
+from typing import Optional
+
+
+@dataclass
+class Contributor:
+    """Stats for a single contributor."""
+    name: str
+    email: str
+    commits: int = 0
+    insertions: int = 0
+    deletions: int = 0
+
+    @property
+    def lines_changed(self) -> int:
+        return self.insertions + self.deletions
+
+
+@dataclass
+class DayActivity:
+    """Activity for a single day."""
+    date: str
+    commits: int = 0
+    insertions: int = 0
+    deletions: int = 0
+
+
+@dataclass
+class HourActivity:
+    """Activity by hour of day."""
+    hour: int
+    commits: int = 0
+
+
+@dataclass
+class WeekdayActivity:
+    """Activity by day of week."""
+    weekday: int  # 0=Mon, 6=Sun
+    commits: int = 0
+
+
+@dataclass
+class FileStats:
+    """Stats for file types."""
+    extension: str
+    files: int = 0
+    insertions: int = 0
+    deletions: int = 0
+
+
+@dataclass
+class RepoStats:
+    """Complete repository statistics."""
+    repo_path: str
+    total_commits: int = 0
+    total_insertions: int = 0
+    total_deletions: int = 0
+    contributors: list[Contributor] = field(default_factory=list)
+    daily_activity: list[DayActivity] = field(default_factory=list)
+    hourly_activity: list[HourActivity] = field(default_factory=list)
+    weekday_activity: list[WeekdayActivity] = field(default_factory=list)
+    file_stats: list[FileStats] = field(default_factory=list)
+    first_commit: Optional[str] = None
+    last_commit: Optional[str] = None
+    active_days: int = 0
+
+
+def run_git(args: list[str], cwd: str = ".") -> str:
+    """Run a git command and return output."""
+    result = subprocess.run(
+        ["git"] + args,
+        cwd=cwd,
