+package main
+
+import (
+	"fmt"
+	"math/rand"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+)
+
+type Joke struct {
+	Category string
+	Setup    string
+	Punch    string
+}
+
+var jokes = []Joke{
+	// Programmation
+	{Category: "dev", Setup: "Pourquoi les programmeurs confondent-ils Halloween et Noël ?", Punch: "Parce que OCT 31 = DEC 25."},
+	{Category: "dev", Setup: "Combien de développeurs faut-il pour changer une ampoule ?", Punch: "Aucun, c'est un problème hardware."},
+	{Category: "dev", Setup: "Un développeur a deux problèmes.", Punch: "Il pense qu'il en a deux."},
+	{Category: "dev", Setup: "Pourquoi a-t-on besoin de 3 développeurs pour faire ce qu'un développeur peut faire en 4 heures ?", Punch: "On ne peut pas le faire en moins de 4 heures."},
+	{Category: "dev", Setup: "Qu'est-ce qu'un cache de 256 bits ?", Punch: "Un souvenir que vous ne pouvez pas avoir."},
+	{Category: "dev", Setup: "Mon code ne marche pas.", Punch: "Je ne sais pas pourquoi. Mon code marche. Je ne sais pas pourquoi non plus."},
+	{Category: "dev", Setup: "Il y a 10 types de personnes dans le monde.", Punch: "Ceux qui comprennent le binaire et ceux qui ne le comprennent pas."},
