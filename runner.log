+// toml-lint checks TOML syntax and style.
+package main
+
+import (
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/BurntSushi/toml"
+)
+
+type issue struct {
+	line   int
+	kind   string
+	message string
+}
+
+func main() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	path := os.Args[1]
+	data, err := os.ReadFile(path)
+	if err != nil {
+		fatal(err)
+	}
+
+	var decoded map[string]interface{}
+	_, err = toml.Decode(string(data), &decoded)
+	if err != nil {
+		fatal(fmt.Errorf("syntax error: %w", err))
+	}
+
+	issues := checkStyle(string(data))
+	for _, i := range issues {
+		fmt.Printf("%s:%d: %s: %s\n", path, i.line, i.kind, i.message)
+	}
+
+	if len(issues) > 0 {
+		fmt.Fprintf(os.Stderr, "\n%d issue(s) found\n", len(issues))
+		os.Exit(1)
+	}
+	fmt.Println("OK")
+}
+
