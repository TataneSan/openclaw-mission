+// chmod-cli visualizes and converts Unix file permissions.
+//
+// It displays permissions in symbolic (rwxr-xr-x), octal (755), and
+// human-readable formats, and can convert between representations.
+//
+// Usage:
+//
+//	chmod-cli file.txt                  # show permissions of a file
+//	chmod-cli -o 755                   # convert octal to symbolic
+//	chmod-cli -s rwxr-xr--             # convert symbolic to octal
+//	chmod-cli -t 644                   # show permission table for octal
+//	chmod-cli -c 755 dir/              # apply chmod 755 to dir/
+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+)
+
+func main() {
+	flagOctal := flag.String("o", "", "Convert octal to symbolic (e.g. -o 755)")
+	flagSymbolic := flag.String("s", "", "Convert symbolic to octal (e.g. -s rwxr-xr-x)")
+	flagTable := flag.String("t", "", "Show permission breakdown table for octal")
+	flagApply := flag.String("c", "", "Apply chmod with given octal to file(s)")
+	flagHelp := flag.Bool("h", false, "Show help")
+	flag.Parse()
+
+	if *flagHelp {
+		printUsage()
+		return
+	}
+
+	// -o: convert octal to symbolic
+	if *flagOctal != "" {
+		showOctalConversion(*flagOctal)
+		return
+	}
+
+	// -s: convert symbolic to octal
+	if *flagSymbolic != "" {
+		showSymbolicConversion(*flagSymbolic)
+		return
+	}
+
+	// -t: show permission table
+	if *flagTable != "" {
+		showPermissionTable(*flagTable)
+		return
+	}
+
+	// -c: apply chmod
+	if *flagApply != "" {
+		if flag.NArg() == 0 {
+			fmt.Fprintf(os.Stderr, "Error: -c requires at least one file argument\n")
+			os.Exit(1)
+		}
+		applyChmod(*flagApply, flag.Args())
+		return
+	}
+
+	// Default: show permissions of files
+	if flag.NArg() == 0 {
+		fmt.Fprintf(os.Stderr, "Error: provide one or more file paths, or use -h for help\n")
+		os.Exit(1)
+	}
+
+	for _, path := range flag.Args() {
+		showFilePermissions(path)
+		if flag.NArg() > 1 {
+			fmt.Println()
+		}
+	}
+}
+
+// showFilePermissions displays detailed permissions for a file.
