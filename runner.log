+"""Extracteur de meta tags depuis une page HTML."""
+
+import asyncio
+from html.parser import HTMLParser
+from typing import Any
+
+import aiohttp
+
+
+class MetaTagExtractor(HTMLParser):
+    """Parse HTML et extrait les meta tags, title, et liens canoniques."""
+
+    def __init__(self):
+        super().__init__()
+        self.meta_tags: list[dict[str, str]] = []
+        self.title: str | None = None
+        self.canonical: str | None = None
+        self.description: str | None = None
+        self._in_title = False
+        self._title_buf: list[str] = []
+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]):
+        attr_dict = dict(attrs)
+
+        if tag == "meta":
+            meta: dict[str, str] = {}
+            for key in ("name", "property", "http-equiv", "content", "charset"):
+                if key in attr_dict and attr_dict[key]:
+                    meta[key] = attr_dict[key]
+            if meta:
+                self.meta_tags.append(meta)
+                # Extraire la description
+                if meta.get("name", "").lower() == "description" and meta.get("content"):
+                    self.description = meta["content"]
+
+        elif tag == "title":
+            self._in_title = True
+            self._title_buf = []
+
+        elif tag == "link":
+            rel = attr_dict.get("rel", "")
+            href = attr_dict.get("href", "")
+            if rel == "canonical" and href:
+                self.canonical = href
+
+    def handle_data(self, data: str):
+        if self._in_title:
+            self._title_buf.append(data)
+
+    def handle_endtag(self, tag: str):
+        if tag == "title" and self._in_title:
+            self._in_title = False
+            self.title = "".join(self._title_buf).strip()
+
+
