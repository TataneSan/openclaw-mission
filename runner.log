+#!/usr/bin/env node
+'use strict';
+
+const { program } = require('commander');
+const { createWatcher } = require('../src/watcher');
+const pkg = require('../package.json');
+
+program
+  .name('file-watcher')
+  .description('Watch files and run commands on change')
+  .version(pkg.version)
+  .argument('<command>', 'Command to run on file change')
+  .option('-w, --watch <paths...>', 'Paths to watch (default: current directory)', ['.'])
+  .option('-e, --ext <extensions>', 'File extensions to watch (comma-separated)', 'js,ts,json,yaml,yml,toml,py,go,rs,html,css,scss')
+  .option('-i, --ignore <patterns...>', 'Patterns to ignore', ['node_modules', '.git', 'dist', 'build', '__pycache__'])
+  .option('-d, --delay <ms>', 'Debounce delay in milliseconds', '300')
+  .option('-c, --clear', 'Clear terminal before re-running', false)
+  .option('-r, --restart-on-exit', 'Restart command even if it exits', false)
+  .option('-s, --signal <signal>', 'Signal to send when killing process', 'SIGTERM')
+  .option('--no-colors', 'Disable colored output')
+  .action((command, options) => {
+    const watcher = createWatcher({
+      command,
+      watchPaths: options.watch,
+      extensions: options.ext.split(',').map(e => e.trim().toLowerCase()),
+      ignorePatterns: options.ignore,
+      delay: parseInt(options.delay, 10),
+      clear: options.clear,
+      restartOnExit: options.restartOnExit,
+      signal: options.signal,
+      colors: options.colors !== false,
+    });
+
+    watcher.start();
+
+    const cleanup = () => {
+      watcher.stop();
+      process.exit(0);
+    };
+
+    process.on('SIGINT', cleanup);
+    process.on('SIGTERM', cleanup);
+  });
+
+program.parse();
