+// deploy-hook executes post-deploy commands with automatic rollback on failure.
+//
+// It reads a deploy configuration file (YAML or JSON) that defines
+// deployment steps and corresponding rollback steps. If any step fails,
+// all previously executed steps are rolled back in reverse order.
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"gopkg.in/yaml.v3"
+)
+
+// Step represents a single deployment step with its rollback command.
+type Step struct {
+	Name     string `json:"name" yaml:"name"`
+	Command  string `json:"command" yaml:"command"`
+	Rollback string `json:"rollback,omitempty" yaml:"rollback,omitempty"`
+	Timeout  int    `json:"timeout,omitempty" yaml:"timeout,omitempty"` // seconds, 0 = 30s default
+}
+
+// DeployConfig defines the full deployment configuration.
+type DeployConfig struct {
+	Name      string `json:"name" yaml:"name"`
+	Version   string `json:"version,omitempty" yaml:"version,omitempty"`
+	WorkingDir string `json:"working_dir,omitempty" yaml:"working_dir,omitempty"`
+	Steps     []Step `json:"steps" yaml:"steps"`
+}
+
+const defaultTimeout = 30 * time.Second
+
+func main() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	command := os.Args[1]
+	args := os.Args[2:]
+
+	switch command {
+	case "run":
+		if err := runDeploy(args); err != nil {
+			fmt.Fprintf(os.Stderr, "deploy-hook: %v\n", err)
+			os.Exit(1)
+		}
+	case "init":
+		if err := initConfig(args); err != nil {
+			fmt.Fprintf(os.Stderr, "deploy-hook: %v\n", err)
+			os.Exit(1)
+		}
+	case "validate":
+		if err := validateConfig(args); err != nil {
+			fmt.Fprintf(os.Stderr, "deploy-hook: %v\n", err)
+			os.Exit(1)
+		}
+	case "rollback":
+		if err := runRollback(args); err != nil {
+			fmt.Fprintf(os.Stderr, "deploy-hook: %v\n", err)
+			os.Exit(1)
+		}
+	case "help", "--help", "-h":
+		printUsage()
+	case "version", "--version", "-v":
+		fmt.Println("deploy-hook v0.1.0")
+	default:
+		fmt.Fprintf(os.Stderr, "deploy-hook: unknown command %q\n", command)
+		printUsage()
+		os.Exit(1)
+	}
+}
+
