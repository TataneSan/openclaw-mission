+package cmd
+
+import (
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/TataneSan/deploy-cli/internal/config"
+	"github.com/TataneSan/deploy-cli/internal/deployer"
+	"gopkg.in/yaml.v3"
+)
+
+// Execute runs the root command.
+func Execute() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	command := os.Args[1]
+
+	switch command {
+	case "deploy":
+		runDeploy(os.Args[2:])
+	case "rollback":
+		runRollback(os.Args[2:])
+	case "status":
+		runStatus()
+	case "history":
+		runHistory(os.Args[2:])
+	case "init":
+		runInit()
+	case "validate":
+		runValidate()
+	case "version":
+		fmt.Println("deploy-cli v1.0.0")
+	case "help", "--help", "-h":
+		printUsage()
+	default:
+		fmt.Fprintf(os.Stderr, "Unknown command: %s\n", command)
+		printUsage()
+		os.Exit(1)
+	}
+}
+
+func runDeploy(args []string) {
+	cfg := mustLoadConfig()
+	dep := deployer.New(cfg)
+
