+"""Moteur de mesure de performance web."""
+
+import asyncio
+import time
+from dataclasses import dataclass, field
+from html.parser import HTMLParser
+from urllib.parse import urlparse
+
+import aiohttp
+
+
+@dataclass
+class ResourceMetrics:
+    """Métriques d'une ressource chargée."""
+    url: str
+    content_type: str
+    status: int | None
+    size_bytes: int
+    download_time_ms: float
+    error: str | None = None
+
+
+@dataclass
+class PageMetrics:
+    """Métriques complètes d'une page."""
+    url: str
+    status: int | None = None
+    error: str | None = None
+
+    # Timing
+    dns_ms: float = 0.0
+    connect_ms: float = 0.0
+    tls_ms: float = 0.0
+    ttfb_ms: float = 0.0  # Time To First Byte
+    download_ms: float = 0.0
+    total_ms: float = 0.0
+
+    # Taille
+    html_size_bytes: int = 0
+    total_size_bytes: int = 0
+    total_resources: int = 0
+
+    # Ressources
+    resources: list[ResourceMetrics] = field(default_factory=list)
+
+    # Compteurs par type
+    resource_counts: dict[str, int] = field(default_factory=dict)
+
+    # Headers
+    headers: dict[str, str] = field(default_factory=dict)
+
+    # Compression
+    content_encoding: str | None = None
+
+    # Redirects
+    redirect_count: int = 0
+    final_url: str | None = None
+
+
+class ResourceExtractor(HTMLParser):
+    """Extrait les URLs des ressources d'une page HTML."""
+
+    def __init__(self):
+        super().__init__()
+        self.resources: list[str] = []
+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]):
+        attr_dict = dict(attrs)
+        url = None
+
+        if tag == "script" and attr_dict.get("src"):
+            url = attr_dict["src"]
+        elif tag == "link" and attr_dict.get("rel") == "stylesheet" and attr_dict.get("href"):
+            url = attr_dict["href"]
+        elif tag == "img" and attr_dict.get("src"):
+            url = attr_dict["src"]
+        elif tag == "source" and attr_dict.get("src"):
+            url = attr_dict["src"]
