+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+	"regexp"
+	"strings"
+	"unicode"
+)
+
+var (
+	// Transliterate common accented characters to ASCII
+	transliterate = map[rune]string{
+		'à': "a", 'á': "a", 'â': "a", 'ã': "a", 'ä': "a", 'å': "a",
+		'è': "e", 'é': "e", 'ê': "e", 'ë': "e",
+		'ì': "i", 'í': "i", 'î': "i", 'ï': "i",
+		'ò': "o", 'ó': "o", 'ô': "o", 'õ': "o", 'ö': "o",
+		'ù': "u", 'ú': "u", 'û': "u", 'ü': "u",
+		'ç': "c", 'ñ': "n", 'ß': "ss",
+		'À': "A", 'Á': "A", 'Â': "A", 'Ã': "A", 'Ä': "A", 'Å': "A",
+		'È': "E", 'É': "E", 'Ê': "E", 'Ë': "E",
+		'Ì': "I", 'Í': "I", 'Î': "I", 'Ï': "I",
+		'Ò': "O", 'Ó': "O", 'Ô': "O", 'Õ': "O", 'Ö': "O",
+		'Ù': "U", 'Ú': "U", 'Û': "U", 'Ü': "U",
+		'Ç': "C", 'Ñ': "N",
+	}
+
+	// Collapse multiple dashes
+	collapseDash = regexp.MustCompile(`-+`)
+)
+
+func toSlug(input string) string {
+	// Lowercase
+	result := strings.Builder{}
+	for _, r := range input {
+		if repl, ok := transliterate[r]; ok {
+			result.WriteString(repl)
+		} else {
+			result.WriteRune(unicode.ToLower(r))
+		}
+	}
+
+	s := result.String()
+
+	// Replace spaces and non-alphanumeric with dash
+	out := strings.Builder{}
+	for _, r := range s {
+		if unicode.IsLetter(r) || unicode.IsDigit(r) {
+			out.WriteRune(r)
+		} else {
+			out.WriteByte('-')
+		}
+	}
+
+	slug := out.String()
+
+	// Collapse multiple dashes
+	slug = collapseDash.ReplaceAllString(slug, "-")
+
+	// Trim leading/trailing dashes
+	slug = strings.Trim(slug, "-")
+
+	return slug
+}
+
+func main() {
+	flag.Parse()
+
+	if flag.NArg() == 0 {
+		// Read from stdin
+		var input strings.Builder
+		buf := make([]byte, 4096)
+		for {
+			n, err := os.Stdin.Read(buf)
+			if n > 0 {
+				input.Write(buf[:n])
+			}
