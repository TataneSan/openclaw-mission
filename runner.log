+#!/usr/bin/env python3
+"""docker-clean — Nettoie les ressources Docker inutilisées."""
+
+import argparse
+import subprocess
+import sys
+import json
+import re
+from datetime import datetime
+from typing import List, Dict, Any, Optional, Tuple
+
+
+class Colors:
+    RED = "\033[91m"
+    GREEN = "\033[92m"
+    YELLOW = "\033[93m"
+    BLUE = "\033[94m"
+    CYAN = "\033[96m"
+    BOLD = "\033[1m"
+    DIM = "\033[2m"
+    RESET = "\033[0m"
+
+
+def run_docker(args: List[str], check: bool = True) -> subprocess.CompletedProcess:
+    """Execute a docker command."""
+    cmd = ["docker"] + args
+    return subprocess.run(cmd, capture_output=True, text=True, check=check)
+
+
+def get_json_output(args: List[str]) -> Any:
+    """Run docker command and parse JSON output."""
+    result = run_docker(args)
+    if result.stdout.strip():
+        return json.loads(result.stdout)
+    return []
+
+
+def format_size(size_bytes: int) -> str:
+    """Format bytes into human-readable size."""
+    if size_bytes == 0:
+        return "0B"
+    units = ["B", "KB", "MB", "GB", "TB"]
+    i = 0
+    size = float(size_bytes)
+    while size >= 1024 and i < len(units) - 1:
+        size /= 1024
+        i += 1
+    return f"{size:.1f}{units[i]}"
+
+
+def parse_size(size_str: str) -> int:
+    """Parse Docker size string to bytes."""
+    if not size_str or size_str == "0":
+        return 0
+    size_str = size_str.strip()
+    multipliers = {
+        "B": 1, "KB": 1024, "MB": 1024**2, "GB": 1024**3, "TB": 1024**4,
+        "kB": 1000, "MB": 1000**2, "GB": 1000**3,
+    }
+    for suffix, mult in sorted(multipliers.items(), key=lambda x: -len(x[0])):
+        if size_str.upper().endswith(suffix.upper()):
+            num = size_str[: -len(suffix)].strip()
+            try:
+                return int(float(num) * mult)
+            except ValueError:
+                return 0
+    try:
+        return int(size_str)
+    except ValueError:
+        return 0
+
+
+def get_dangling_images() -> List[Dict[str, Any]]:
+    """Get list of dangling images."""
+    try:
+        return get_json_output(
+            ["images", "--filter", "dangling=true", "--format", "{{json .}}"]
+        )
