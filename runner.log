+package infrastructure
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/TataneSan/log-stream/internal/domain"
+)
+
+type LogReader struct {
+	mu      sync.RWMutex
+	sources map[string]*domain.LogSource
+	entries chan domain.LogEntry
+	buffer  []domain.LogEntry
+	maxBuf  int
+}
+
+func NewLogReader(maxBuf int) *LogReader {
+	if maxBuf == 0 {
+		maxBuf = 10000
+	}
+	return &LogReader{
+		sources: make(map[string]*domain.LogSource),
+		entries: make(chan domain.LogEntry, 1000),
+		buffer:  make([]domain.LogEntry, 0, maxBuf),
+		maxBuf:  maxBuf,
+	}
+}
+
+func (lr *LogReader) AddSource(req domain.AddSourceRequest) (*domain.LogSource, error) {
+	lr.mu.Lock()
+	defer lr.mu.Unlock()
+
+	absPath, err := filepath.Abs(req.Path)
+	if err != nil {
+		return nil, fmt.Errorf("invalid path: %w", err)
+	}
+
+	var re *regexp.Regexp
+	if req.Pattern != "" {
+		re, err = regexp.Compile(req.Pattern)
+		if err != nil {
+			return nil, fmt.Errorf("invalid pattern: %w", err)
+		}
+	}
+
+	id := fmt.Sprintf("%d", time.Now().UnixNano())
+	source := &domain.LogSource{
+		ID:      id,
+		Name:    req.Name,
+		Path:    absPath,
+		Enabled: true,
+		Pattern: req.Pattern,
+		AddedAt: time.Now(),
+	}
+
+	lr.sources[id] = source
+	go lr.tailFile(source, re)
+
+	return source, nil
+}
+
+func (lr *LogReader) RemoveSource(id string) error {
+	lr.mu.Lock()
+	defer lr.mu.Unlock()
+
+	delete(lr.sources, id)
+	return nil
+}
+
+func (lr *LogReader) ListSources() []*domain.LogSource {
