+package service
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/TataneSan/git-ignore/internal/infrastructure/templates"
+)
+
+// AddTemplates appends template content to a .gitignore file.
+// If the file doesn't exist, it creates it.
+func AddTemplates(templateNames []string, outputFile string) error {
+	var existingLines []string
+	if info, err := os.Stat(outputFile); err == nil && !info.IsDir() {
+		data, err := os.ReadFile(outputFile)
+		if err == nil {
+			existingLines = strings.Split(string(data), "\n")
+		}
+	}
+
+	existingEntries := make(map[string]bool)
+	for _, line := range existingLines {
+		trimmed := strings.TrimSpace(line)
+		if trimmed != "" && !strings.HasPrefix(trimmed, "#") {
+			existingEntries[trimmed] = true
+		}
+	}
+
+	var newEntries []string
+	for _, name := range templateNames {
+		content, err := templates.Get(name)
+		if err != nil {
+			return fmt.Errorf("template '%s': %w", name, err)
+		}
+		for _, line := range strings.Split(content, "\n") {
+			trimmed := strings.TrimSpace(line)
+			if trimmed == "" || strings.HasPrefix(trimmed, "#") {
+				continue
+			}
+			if !existingEntries[trimmed] {
+				existingEntries[trimmed] = true
+				newEntries = append(newEntries, line)
+			}
+		}
+	}
+
+	if len(newEntries) == 0 {
+		fmt.Println("All patterns already present in", outputFile)
+		return nil
+	}
+
+	var sb strings.Builder
+	if len(existingLines) > 0 {
+		last := existingLines[len(existingLines)-1]
+		if strings.TrimSpace(last) != "" && last != "" {
+			sb.WriteString("\n")
+		}
+		sb.WriteString(strings.Join(existingLines, "\n"))
+	}
+	if sb.Len() > 0 && !strings.HasSuffix(sb.String(), "\n") {
+		sb.WriteString("\n")
+	}
+	sb.WriteString("\n")
+	sb.WriteString(strings.Join(newEntries, "\n"))
+	sb.WriteString("\n")
+
+	if err := os.WriteFile(outputFile, []byte(sb.String()), 0644); err != nil {
+		return fmt.Errorf("write %s: %w", outputFile, err)
+	}
+
+	fmt.Printf("Added %d new patterns to %s\n", len(newEntries), outputFile)
+	return nil
+}
+
+// MergeTemplates merges templates into an existing .gitignore,
+// preserving order and removing duplicates.
