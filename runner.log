+  %(prog)s document.pdf
+  %(prog)s document.pdf -p 1 2 3
+  %(prog)s document.pdf -o output.txt
+  %(prog)s document.pdf --pages 1-5
+  %(prog)s document.pdf --password secret
+  %(prog)s document.pdf --stats
+  %(prog)s document.pdf -p 1 --plain
+        """,
+    )
