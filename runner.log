+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"io"
+)
+
+// jsonDecode decodes JSON data into a Go value.
+func jsonDecode(data []byte, v any) error {
+	decoder := json.NewDecoder(bytes.NewReader(data))
+	decoder.UseNumber()
+	return decoder.Decode(v)
+}
+
+// jsonEncodeCompact encodes a Go value to compact JSON.
+func jsonEncodeCompact(v any) ([]byte, error) {
+	var buf bytes.Buffer
+	encoder := json.NewEncoder(&buf)
+	encoder.SetEscapeHTML(false)
+	if err := encoder.Encode(v); err != nil {
+		return nil, err
+	}
+	// Encode adds a trailing newline; remove it for compact output
+	out := bytes.TrimSuffix(buf.Bytes(), []byte("\n"))
+	return out, nil
+}
+
+// jsonEncodeIndent encodes a Go value to pretty-printed JSON.
+func jsonEncodeIndent(v any) ([]byte, error) {
+	out, err := json.MarshalIndent(v, "", "  ")
+	if err != nil {
+		return nil, err
+	}
+	out = append(out, '\n')
+	return out, nil
+}
+
+// Ensure bytes is io.Writer
+var _ io.Writer = &bytes.Buffer{}
