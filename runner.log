+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/santhosh-tekuri/jsonschema/v5"
+)
+
+func main() {
+	if len(os.Args) < 4 {
+		fmt.Fprintf(os.Stderr, "Usage: json-schema-validate <schema-file> <json-file> [--pretty]\n")
+		os.Exit(1)
+	}
+
+	schemaFile := os.Args[1]
+	jsonFile := os.Args[2]
+	pretty := false
+	for _, arg := range os.Args[3:] {
+		if arg == "--pretty" {
+			pretty = true
+		}
+	}
+
+	schemaData, err := os.ReadFile(schemaFile)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "Error reading schema file: %v\n", err)
+		os.Exit(1)
+	}
+
+	jsonData, err := os.ReadFile(jsonFile)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "Error reading JSON file: %v\n", err)
+		os.Exit(1)
+	}
+
+	compiler := jsonschema.NewCompiler()
+	if err := compiler.AddResource("schema.json", schemaData); err != nil {
+		fmt.Fprintf(os.Stderr, "Error loading schema: %v\n", err)
+		os.Exit(1)
+	}
+
+	schema, err := compiler.Compile("schema.json")
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "Error compiling schema: %v\n", err)
+		os.Exit(1)
+	}
+
+	var data interface{}
+	if err := json.Unmarshal(jsonData, &data); err != nil {
+		fmt.Fprintf(os.Stderr, "Error parsing JSON: %v\n", err)
+		os.Exit(1)
+	}
+
+	if err := schema.Validate(data); err != nil {
+		handleValidationError(err, pretty)
+		os.Exit(1)
+	}
+
+	fmt.Println("Valid")
+}
+
+func handleValidationError(err error, pretty bool) {
+	if pretty {
+		fmt.Println("Validation failed:")
+		printPrettyError(err, "")
+	} else {
+		fmt.Fprintf(os.Stderr, "Validation failed: %v\n", err)
+	}
+}
+
+func printPrettyError(err error, indent string) {
+	if verr, ok := err.(*jsonschema.ValidationError); ok {
+		fmt.Printf("%s%s: %s\n", indent, verr.InstanceLocation, verr.Message)
+		for _, cause := range verr.Causes {
+			printPrettyError(cause, indent+"  ")
