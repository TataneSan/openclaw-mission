+package main
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"os/exec"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+type AuthorStats struct {
+	Name        string
+	Email       string
+	Commits     int
+	Files       int
+	Insertions  int
+	Deletions   int
+}
+
+func main() {
+	repo := "."
+	if len(os.Args) >= 2 {
+		repo = os.Args[1]
+	}
+
+	authors := make(map[string]*AuthorStats)
+
+	// Get commit count per author
+	if err := countCommits(repo, authors); err != nil {
+		fmt.Fprintf(os.Stderr, "Error counting commits: %v\n", err)
+		os.Exit(1)
+	}
+
+	// Get files touched per author
+	if err := countFiles(repo, authors); err != nil {
+		fmt.Fprintf(os.Stderr, "Warning: could not count files: %v\n", err)
+	}
+
+	// Get insertions/deletions per author
+	if err := countLOC(repo, authors); err != nil {
+		fmt.Fprintf(os.Stderr, "Warning: could not count LOC: %v\n", err)
+	}
+
+	// Sort by commits
+	list := make([]*AuthorStats, 0, len(authors))
+	for _, a := range authors {
+		list = append(list, a)
+	}
+	sort.Slice(list, func(i, j int) bool {
+		return list[i].Commits > list[j].Commits
+	})
+
+	// Print header
+	fmt.Printf("%-30s %-8s %-8s %-8s %-8s %-8s\n", "Author", "Email", "Commits", "Files", "Insertions", "Deletions")
+	fmt.Println(strings.Repeat("-", 80))
+
+	var totalCommits, totalFiles, totalIns, totalDel int
+	for _, a := range list {
+		fmt.Printf("%-30s %-8s %-8d %-8d %-8d %-8d\n",
+			a.Name, a.Email, a.Commits, a.Files, a.Insertions, a.Deletions)
+		totalCommits += a.Commits
+		totalFiles += a.Files
+		totalIns += a.Insertions
+		totalDel += a.Deletions
+	}
+
+	fmt.Println(strings.Repeat("-", 80))
+	fmt.Printf("%-30s %-8s %-8d %-8d %-8d %-8d\n",
+		"TOTAL", "", totalCommits, totalFiles, totalIns, totalDel)
+}
+
+func countCommits(repo string, authors map[string]*AuthorStats) error {
+	cmd := exec.Command("git", "-C", repo, "log", "--format=%an|||%ae|||%H")
+	output, err := cmd.Output()
+	if err != nil {
+		return err
