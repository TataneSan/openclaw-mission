+'use strict';
+
+const chokidar = require('chokidar');
+const { spawn } = require('child_process');
+const path = require('path');
+const pc = require('picocolors');
+
+/**
+ * Create a file watcher that runs a command on change.
+ * @param {object} opts - Configuration options
+ * @returns {{ start: Function, stop: Function }}
+ */
+function createWatcher(opts) {
+  const {
+    command,
+    watchPaths,
+    extensions,
+    ignorePatterns,
+    delay,
+    clear,
+    restartOnExit,
+    signal,
+    colors,
+  } = opts;
+
+  let watcher = null;
+  let child = null;
+  let debounceTimer = null;
+  let restartCount = 0;
+
+  const log = (color, prefix, msg) => {
+    const ts = new Date().toLocaleTimeString();
+    const tag = colors ? color(`[${prefix}]`) : `[${prefix}]`;
+    console.log(`${tag} ${ts} ${msg}`);
+  };
+
+  const info = (msg) => log(pc.cyan, 'fw', msg);
+  const warn = (msg) => log(pc.yellow, 'fw', msg);
+  const err = (msg) => log(pc.red, 'fw', msg);
+  const ok = (msg) => log(pc.green, 'fw', msg);
+
+  /**
+   * Build chokidar glob patterns from extensions and paths.
+   */
+  function buildGlobs() {
+    const exts = extensions.map(e => e.replace(/^\./, ''));
+    const globs = [];
+    for (const p of watchPaths) {
+      for (const ext of exts) {
+        globs.push(path.join(p, '**', `*.${ext}`));
+      }
+    }
+    return globs;
+  }
+
+  /**
+   * Kill the running child process.
+   */
+  function killChild() {
+    if (child && !child.killed) {
+      try {
+        child.kill(signal);
+      } catch (_) {
+        // process already dead
+      }
+      child = null;
+    }
+  }
+
+  /**
+   * Run the command.
+   */
+  function runCommand() {
+    killChild();
+
+    if (clear) {
+      process.stdout.write('\x1Bc');
+    }
