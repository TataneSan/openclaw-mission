+package infrastructure
+
+import (
+	"context"
+	"database/sql"
+	"fmt"
+	"strings"
+	"time"
+
+	"github.com/TataneSan/snippet-cli/internal/domain"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+type Repository struct {
+	db *sql.DB
+}
+
+func NewRepository(dbPath string) (*Repository, error) {
+	db, err := sql.Open("sqlite3", dbPath)
+	if err != nil {
+		return nil, fmt.Errorf("open database: %w", err)
+	}
+
+	if err := createTable(db); err != nil {
+		return nil, err
+	}
+
+	return &Repository{db: db}, nil
+}
+
+func createTable(db *sql.DB) error {
+	query := `
+	CREATE TABLE IF NOT EXISTS snippets (
+		id INTEGER PRIMARY KEY AUTOINCREMENT,
+		name TEXT NOT NULL,
+		command TEXT NOT NULL,
+		category TEXT NOT NULL DEFAULT '',
+		tags TEXT NOT NULL DEFAULT '',
+		created_at TEXT NOT NULL,
+		used_count INTEGER NOT NULL DEFAULT 0
+	);`
+	_, err := db.Exec(query)
+	return err
+}
+
+func (r *Repository) Create(ctx context.Context, s *domain.Snippet) error {
+	query := `INSERT INTO snippets (name, command, category, tags, created_at, used_count)
+	          VALUES (?, ?, ?, ?, ?, 0)`
+	result, err := r.db.ExecContext(ctx, query, s.Name, s.Command, s.Category, joinTags(s.Tags), s.CreatedAt.Format(time.RFC3339))
+	if err != nil {
+		return fmt.Errorf("insert snippet: %w", err)
+	}
+
+	id, err := result.LastInsertId()
+	if err != nil {
+		return err
+	}
+	s.ID = id
+	return nil
+}
+
+func (r *Repository) GetAll(ctx context.Context) ([]domain.Snippet, error) {
+	rows, err := r.db.QueryContext(ctx, "SELECT id, name, command, category, tags, created_at, used_count FROM snippets ORDER BY used_count DESC, created_at DESC")
+	if err != nil {
+		return nil, fmt.Errorf("query all: %w", err)
+	}
+	defer rows.Close()
+
+	return scanRows(rows)
+}
+
+func (r *Repository) GetByID(ctx context.Context, id int64) (*domain.Snippet, error) {
+	row := r.db.QueryRowContext(ctx, "SELECT id, name, command, category, tags, created_at, used_count FROM snippets WHERE id = ?", id)
+	snippet, err := scanRow(row)
+	if err != nil {
+		return nil, err
+	}
