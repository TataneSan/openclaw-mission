+#!/usr/bin/env node
+
+const { execSync } = require('child_process');
+const os = require('os');
+
+const BLUE = '\x1b[34m';
+const GREEN = '\x1b[32m';
+const YELLOW = '\x1b[33m';
+const RED = '\x1b[31m';
+const CYAN = '\x1b[36m';
+const MAGENTA = '\x1b[35m';
+const BOLD = '\x1b[1m';
+const DIM = '\x1b[2m';
+const RESET = '\x1b[0m';
+
+const BRANCH = `${DIM}├──${RESET} `;
+const LAST_BRANCH = `${DIM}└──${RESET} `;
+const VERTICAL = `${DIM}│  ${RESET}`;
+const BLANK = '   ';
+
+function getProcessList() {
+  try {
+    const output = execSync('ps -eo pid,ppid,comm,user,%cpu,%mem --no-headers', { encoding: 'utf-8' });
+    const processes = [];
+    for (const line of output.trim().split('\n')) {
+      const parts = line.trim().split(/\s+/);
+      if (parts.length >= 6) {
+        processes.push({
+          pid: parseInt(parts[0], 10),
+          ppid: parseInt(parts[1], 10),
+          comm: parts[2],
+          user: parts[3],
+          cpu: parseFloat(parts[4]),
+          mem: parseFloat(parts[5]),
+        });
+      }
+    }
+    return processes;
+  } catch {
+    return [];
+  }
+}
+
+function buildTree(processes, rootPid) {
+  const children = processes.filter(p => p.ppid === rootPid);
+  const tree = [];
+  for (const child of children) {
+    const node = { ...child, children: buildTree(processes, child.pid) };
+    tree.push(node);
+  }
+  return tree;
+}
+
+function printTree(nodes, prefix, maxDepth, currentDepth) {
+  if (maxDepth >= 0 && currentDepth > maxDepth) return;
+
+  for (let i = 0; i < nodes.length; i++) {
+    const node = nodes[i];
+    const isLast = i === nodes.length - 1;
+    const connector = isLast ? LAST_BRANCH : BRANCH;
+    const continuation = isLast ? BLANK : VERTICAL;
+
+    const cpuColor = node.cpu > 50 ? RED : node.cpu > 10 ? YELLOW : GREEN;
+    const memColor = node.mem > 10 ? RED : node.mem > 5 ? YELLOW : GREEN;
+
+    const pidStr = String(node.pid).padStart(6);
+    const commStr = node.comm.length > 30 ? '...' + node.comm.slice(-27) : node.comm.padEnd(30);
+    const userStr = node.user.padEnd(10);
+    const cpuStr = node.cpu.toFixed(1).padStart(5) + '%';
+    const memStr = node.mem.toFixed(1).padStart(5) + '%';
+
+    console.log(
+      `${prefix}${connector}` +
+      `${CYAN}${pidStr}${RESET} ` +
+      `${BLUE}${commStr}${RESET} ` +
+      `${DIM}${userStr}${RESET} ` +
+      `${cpuColor}${cpuStr}${RESET} ` +
+      `${memColor}${memStr}${RESET}`
