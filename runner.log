+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+
+	"github.com/urfave/cli/v2"
+)
+
+func renameKeys(data interface{}, replacements map[string]string, regexReplacements map[*regexp.Regexp]string) interface{} {
+	switch v := data.(type) {
+	case map[string]interface{}:
+		newMap := make(map[string]interface{})
+		for k, val := range v {
+			newKey := k
+			if r, ok := replacements[k]; ok {
+				newKey = r
+			} else {
+				for re, replacement := range regexReplacements {
+					if re.MatchString(k) {
+						newKey = re.ReplaceAllString(k, replacement)
+						break
+					}
+				}
+			}
+			newMap[newKey] = renameKeys(val, replacements, regexReplacements)
+		}
+		return newMap
+	case []interface{}:
+		for i, item := range v {
+			v[i] = renameKeys(item, replacements, regexReplacements)
+		}
+		return v
+	default:
+		return v
+	}
+}
+
+func loadReplacements(mappings []string) (map[string]string, map[*regexp.Regexp]string, error) {
+	exact := make(map[string]string)
+	regex := make(map[*regexp.Regexp]string)
+
+	for _, m := range mappings {
+		parts := strings.SplitN(m, "=", 2)
+		if len(parts) != 2 {
+			return nil, nil, fmt.Errorf("invalid mapping %q: expected format old=new", m)
+		}
+		old := parts[0]
+		new := parts[1]
+
+		if strings.HasPrefix(old, "re:") {
+			pattern := strings.TrimPrefix(old, "re:")
+			re, err := regexp.Compile(pattern)
+			if err != nil {
+				return nil, nil, fmt.Errorf("invalid regex in %q: %w", old, err)
+			}
+			regex[re] = new
+		} else {
+			exact[old] = new
+		}
+	}
+
+	return exact, regex, nil
+}
+
