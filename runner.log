@@ -0,0 +1,39 @@
+package main
+
+import (
+	"flag"
+	"fmt"
+	"log"
+	"net/http"
+	"time"
+
+	"github.com/TataneSan/ip-api/internal/geolocation"
+	"github.com/TataneSan/ip-api/internal/handler"
+	"github.com/TataneSan/ip-api/internal/middleware"
+)
+
+func main() {
+	port := flag.Int("port", 8080, "Port to listen on")
+	host := flag.String("host", "0.0.0.0", "Host to bind to")
+	timeout := flag.Int("timeout", 10, "HTTP timeout in seconds")
+	flag.Parse()
+
+	geoClient := geolocation.NewClient(time.Duration(*timeout) * time.Second)
+	h := handler.New(geoClient)
+
+	mux := http.NewServeMux()
+	h.Register(mux)
+
+	srv := &http.Server{
+		Addr:         fmt.Sprintf("%s:%d", *host, *port),
+		Handler:      middleware.CORS(mux),
+		ReadTimeout:  15 * time.Second,
+		WriteTimeout: 15 * time.Second,
+		IdleTimeout:  60 * time.Second,
+	}
+
+	log.Printf("ip-api listening on http://%s:%d", *host, *port)
+	if err := srv.ListenAndServe(); err != nil {
+		log.Fatalf("server error: %v", err)
+	}
+}
