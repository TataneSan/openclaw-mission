+package domain
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/google/uuid"
+)
+
+type TargetRepository interface {
+	Save(ctx context.Context, target *PingTarget) error
+	FindAll(ctx context.Context) ([]PingTarget, error)
+	FindByID(ctx context.Context, id string) (*PingTarget, error)
+	Delete(ctx context.Context, id string) error
+}
+
+type ResultRepository interface {
+	Save(ctx context.Context, result *PingResult) error
+	FindByTargetID(ctx context.Context, targetID string, limit int) ([]PingResult, error)
+	FindLatest(ctx context.Context, limit int) ([]PingResult, error)
+}
+
+type Pinger struct {
+	targetRepo   TargetRepository
+	resultRepo   ResultRepository
+	httpClient   *http.Client
+	mu           sync.RWMutex
+	intervals    map[string]*time.Timer
+	intervalMux  sync.RWMutex
+	stopChannels map[string]chan struct{}
+	stopMux      sync.RWMutex
+}
+
+func NewPinger(targetRepo TargetRepository, resultRepo ResultRepository) *Pinger {
+	return &Pinger{
+		targetRepo:   targetRepo,
+		resultRepo:   resultRepo,
+		httpClient:   &http.Client{Timeout: 10 * time.Second},
+		intervals:    make(map[string]*time.Timer),
+		stopChannels: make(map[string]chan struct{}),
+	}
+}
+
+func (p *Pinger) AddTarget(ctx context.Context, req *AddTargetRequest) (*PingTarget, error) {
+	if req.URL == "" {
+		return nil, fmt.Errorf("url is required")
+	}
+	if req.Name == "" {
+		req.Name = req.URL
+	}
+	if req.Method == "" {
+		req.Method = "GET"
+	}
+
+	target := &PingTarget{
+		ID:        uuid.New().String(),
+		Name:      req.Name,
+		URL:       req.URL,
+		Method:    req.Method,
+		Interval:  req.Interval,
+		Enabled:   true,
+		CreatedAt: time.Now().UTC(),
+	}
+
+	if err := p.targetRepo.Save(ctx, target); err != nil {
+		return nil, fmt.Errorf("failed to save target: %w", err)
+	}
+
+	if target.Interval > 0 {
+		p.startInterval(target)
+	}
+
+	return target, nil
+}
