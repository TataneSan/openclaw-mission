+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+	"os/exec"
+	"sort"
+	"strings"
+)
+
+type treeNode struct {
+	name     string
+	children map[string]*treeNode
+	isFile   bool
+	status   string
+}
+
+func newTreeNode(name, status string, isFile bool) *treeNode {
+	return &treeNode{
+		name:     name,
+		children: make(map[string]*treeNode),
+		isFile:   isFile,
+		status:   status,
+	}
+}
+
+func (n *treeNode) insert(path string, status string) {
+	parts := strings.Split(path, "/")
+	current := n
+	for i, part := range parts {
+		child, exists := current.children[part]
+		if !exists {
+			isFile := i == len(parts)-1
+			child = newTreeNode(part, status, isFile)
+			current.children[part] = child
+		}
+		current = child
+	}
+}
+
+var statusColors = map[string]string{
+	"M": "\033[33m", // Modified: yellow
+	"A": "\033[32m", // Added: green
+	"D": "\033[31m", // Deleted: red
+	"R": "\033[36m", // Renamed: cyan
+	"C": "\033[35m", // Copied: magenta
+	"U": "\033[1;31m", // Updated: bold red
+	"T": "\033[34m", // Type changed: blue
+	"":  "\033[0m",  // Default: reset
+}
+
+var resetColor = "\033[0m"
+
+func (n *treeNode) print(indent string, showStatus bool, flat bool) {
+	if n.name == "" {
+		for _, child := range getSortedChildren(n) {
+			child.print("", showStatus, flat)
+		}
+		return
+	}
+
+	color := statusColors[n.status]
+	if color == "" {
+		color = "\033[0m"
+	}
+
+	var prefix string
+	if flat || n.name == "" {
+		prefix = ""
+	} else {
+		prefix = indent
+	}
+
+	statusStr := ""
+	if showStatus && n.status != "" {
+		statusStr = fmt.Sprintf(" [%s%s%s] ", color, n.status, resetColor)
+	}
