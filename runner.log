+func parseDiffTreeStat(s string) stats {
+	// diff-tree --shortstat output: " 1 file changed, 5 insertions(+)"
+	var result stats
+	parts := strings.Fields(s)
+	for i := 0; i < len(parts); i++ {
+		if strings.HasPrefix(parts[i], "insertion") {
+			if i > 0 {
+				result.added, _ = strconv.Atoi(parts[i-1])
+			}
+		}
+		if strings.HasPrefix(parts[i], "deletion") {
+			if i > 0 {
+				result.deleted, _ = strconv.Atoi(parts[i-1])
+			}
+		}
+	}
+	return result
+}
