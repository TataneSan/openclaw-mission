+// Run executes the CLI with the given arguments.
+func (cli *CLI) Run(args []string) int {
+	filter := domain.Filter{}
+
+	// Parse arguments
+	for i := 0; i < len(args); i++ {
+		arg := args[i]
+		switch arg {
+		case "-h", "--help":
+			infrastructure.PrintUsage()
+			return 0
+		case "-f", "--follow":
+			filter.Follow = true
+		case "-l", "--level":
+			if i+1 >= len(args) {
+				fmt.Fprintln(os.Stderr, "error: --level requires a value")
+				return 1
+			}
+			i++
+			filter.Level = strings.ToLower(args[i])
+		case "-s", "--since":
+			if i+1 >= len(args) {
+				fmt.Fprintln(os.Stderr, "error: --since requires a value")
+				return 1
+			}
+			i++
+			filter.Since = args[i]
+		case "-t", "--tail":
+			if i+1 >= len(args) {
+				fmt.Fprintln(os.Stderr, "error: --tail requires a value")
+				return 1
+			}
+			i++
+			filter.Tail = args[i]
+		case "-g", "--grep":
+			if i+1 >= len(args) {
+				fmt.Fprintln(os.Stderr, "error: --grep requires a value")
+				return 1
