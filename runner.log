+"""CLI interface for text-stats."""
+
+import argparse
+import json
+import sys
+
+from .analyzer import TextStats
+
+
+def create_parser() -> argparse.ArgumentParser:
+    """Create the argument parser."""
+    parser = argparse.ArgumentParser(
+        prog="textstats",
+        description="Analyze text and display statistics: words, characters, sentences, reading time.",
+        epilog="Examples:\n"
+        "  textstats document.txt\n"
+        "  cat file.md | textstats\n"
+        "  textstats --json report.txt\n"
+        "  textstats --fields words,lines file.txt\n",
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+    )
+
+    parser.add_argument(
+        "input",
+        nargs="?",
+        default="-",
+        help="Input file path. Use '-' or omit for stdin (default: stdin).",
+    )
+    parser.add_argument(
+        "--json",
+        action="store_true",
+        help="Output results in JSON format.",
+    )
+    parser.add_argument(
+        "--fields",
+        default=None,
+        help="Comma-separated list of fields to display. "
+        "Available: characters, characters_no_spaces, words, sentences, paragraphs, "
+        "lines, avg_word_length, unique_words, longest_word, reading_time, speaking_time.",
+    )
+
+    return parser
+
+
+def open_input(path: str) -> str:
+    """Read text from file or stdin."""
+    if path == "-":
+        return sys.stdin.read()
+    try:
+        with open(path, "r", encoding="utf-8") as f:
+            return f.read()
+    except FileNotFoundError:
+        print(f"Error: File not found: {path}", file=sys.stderr)
+        sys.exit(1)
+    except PermissionError:
+        print(f"Error: Permission denied: {path}", file=sys.stderr)
+        sys.exit(1)
+
+
+def format_text(stats: TextStats, fields: list[str] | None = None) -> str:
+    """Format statistics as human-readable text."""
+    default_fields = [
