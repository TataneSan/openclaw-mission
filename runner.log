+package service
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"time"
+)
+
+// ServiceStatus represents the current state of a system service.
+type ServiceStatus struct {
+	Name        string  `json:"name"`
+	Active      bool    `json:"active"`
+	Enabled     bool    `json:"enabled"`
+	PID         int     `json:"pid,omitempty"`
+	Uptime      string  `json:"uptime,omitempty"`
+	MemoryRSS   string  `json:"memory_rss,omitempty"`
+	CPUPercent  float64 `json:"cpu_percent,omitempty"`
+	LastExit    int     `json:"last_exit_code,omitempty"`
+	Description string  `json:"description,omitempty"`
+	Error       string  `json:"error,omitempty"`
+}
+
+// ServiceChecker defines the interface for checking service states.
+type ServiceChecker interface {
+	ListServices(ctx context.Context) ([]ServiceStatus, error)
+	GetService(ctx context.Context, name string) (*ServiceStatus, error)
+	SearchServices(ctx context.Context, pattern string) ([]ServiceStatus, error)
+}
+
+// SystemChecker is responsible for querying system service information.
+type SystemChecker struct {
+	repo ServiceRepository
+}
+
+// ServiceRepository defines the data access interface for system services.
+type ServiceRepository interface {
+	EnumerateServices(ctx context.Context) ([]ServiceStatus, error)
+	FetchService(ctx context.Context, name string) (*ServiceStatus, error)
+}
+
+// NewSystemChecker creates a new SystemChecker with the given repository.
+func NewSystemChecker(repo ServiceRepository) *SystemChecker {
+	return &SystemChecker{repo: repo}
+}
+
+// ListServices returns all active and inactive services on the system.
+func (sc *SystemChecker) ListServices(ctx context.Context) ([]ServiceStatus, error) {
+	services, err := sc.repo.EnumerateServices(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to list services: %w", err)
+	}
+	return services, nil
+}
+
+// GetService returns detailed status for a specific service by name.
+func (sc *SystemChecker) GetService(ctx context.Context, name string) (*ServiceStatus, error) {
+	if strings.TrimSpace(name) == "" {
+		return nil, fmt.Errorf("service name cannot be empty")
+	}
+
+	status, err := sc.repo.FetchService(ctx, name)
+	if err != nil {
+		return nil, fmt.Errorf("failed to get service %q: %w", name, err)
+	}
+	return status, nil
+}
+
+// SearchServices returns services whose names match the given pattern.
+func (sc *SystemChecker) SearchServices(ctx context.Context, pattern string) ([]ServiceStatus, error) {
+	if strings.TrimSpace(pattern) == "" {
+		return nil, fmt.Errorf("search pattern cannot be empty")
+	}
+
+	allServices, err := sc.repo.EnumerateServices(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to search services: %w", err)
+	}
