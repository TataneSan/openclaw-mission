+#!/usr/bin/env node
+'use strict';
+
+const { program } = require('commander');
+const fs = require('fs');
+const pc = require('picocolors');
+const { toASCII, toColored, toPNG, toSVG, getInfo } = require('../src/qr');
+const pkg = require('../package.json');
+
+program
+  .name('qr-gen')
+  .description('Generate QR codes in terminal (ASCII) or as images')
+  .version(pkg.version)
+  .argument('[data]', 'Data to encode (or use -f for file)')
+  .option('-o, --output <file>', 'Output file (png, svg, or text)')
+  .option('-f, --file <path>', 'Read data from file')
+  .option('-s, --stdin', 'Read data from stdin', false)
+  .option('-W, --width <px>', 'PNG width in pixels', '300')
+  .option('-m, --margin <modules>', 'Margin size in modules', '1')
+  .option('--dark <color>', 'Dark module color (hex)', '#000000')
+  .option('--light <color>', 'Light module color (hex)', '#ffffff')
+  .option('--invert', 'Invert colors for dark terminals', false)
+  .option('--no-color', 'Disable colored terminal output')
+  .option('--info', 'Show QR code metadata', false)
+  .action(async (data, options) => {
+    // Read data from various sources
+    if (options.file) {
+      try {
+        data = fs.readFileSync(options.file, 'utf-8').trim();
+      } catch (e) {
+        console.error(pc.red(`Error reading file: ${e.message}`));
+        process.exit(1);
+      }
+    } else if (options.stdin || (!data && !process.stdin.isTTY)) {
+      const chunks = [];
+      for await (const chunk of process.stdin) {
+        chunks.push(chunk);
+      }
+      data = Buffer.concat(chunks).toString('utf-8').trim();
+    }
+
+    if (!data) {
+      console.error(pc.red('Error: No data provided. Pass a string, use -f, or pipe to stdin.'));
+      process.exit(1);
+    }
+
+    // Show info
+    if (options.info) {
+      const info = getInfo(data);
+      console.log(pc.cyan('QR Code Info:'));
+      console.log(`  Version:    ${info.version}`);
+      console.log(`  Size:       ${info.size}x${info.size} modules`);
+      console.log(`  Data:       ${info.dataLength} chars`);
+      console.log(`  EC Level:   ${info.errorCorrection}`);
+      console.log(`  Mode:       ${info.mode}`);
+      process.exit(0);
+    }
+
+    const output = options.output || '';
+
+    try {
+      // Determine output format
+      if (output.endsWith('.png')) {
+        const buf = await toPNG(data, {
+          width: parseInt(options.width, 10),
+          margin: parseInt(options.margin, 10),
+          darkColor: options.dark,
+          lightColor: options.light,
+        });
+        fs.writeFileSync(output, buf);
+        console.log(pc.green(`✓ Saved to ${output} (${buf.length} bytes)`));
+      } else if (output.endsWith('.svg')) {
+        const svg = await toSVG(data, {
+          margin: parseInt(options.margin, 10),
+          darkColor: options.dark,
+          lightColor: options.light,
+        });
+        fs.writeFileSync(output, svg);
