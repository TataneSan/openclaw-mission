+package handler
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"strconv"
+	"time"
+
+	"github.com/TataneSan/random-api/internal/generator"
+)
+
+// Handler serves random data endpoints.
+type Handler struct {
+	startTime time.Time
+}
+
+// New creates a new Handler.
+func New() *Handler {
+	return &Handler{
+		startTime: time.Now(),
+	}
+}
+
+// Register registers all routes on the given mux.
+func (h *Handler) Register(mux *http.ServeMux) {
+	mux.HandleFunc("/int", h.handleInt)
+	mux.HandleFunc("/float", h.handleFloat)
+	mux.HandleFunc("/uuid", h.handleUUID)
+	mux.HandleFunc("/string", h.handleString)
+	mux.HandleFunc("/bool", h.handleBool)
+	mux.HandleFunc("/item", h.handleItem)
+	mux.HandleFunc("/array", h.handleArray)
+	mux.HandleFunc("/shuffle", h.handleShuffle)
+	mux.HandleFunc("/health", h.handleHealth)
+}
+
+func (h *Handler) handleInt(w http.ResponseWriter, r *http.Request) {
+	min, err := strconv.ParseInt(r.URL.Query().Get("min"), 10, 64)
+	if err != nil {
+		min = 0
+	}
+	max, err := strconv.ParseInt(r.URL.Query().Get("max"), 10, 64)
+	if err != nil {
+		max = 100
+	}
+
+	result, err := generator.Int(min, max)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+
+	data, _ := generator.WriteJSON(result)
+	w.Header().Set("Content-Type", "application/json")
+	w.Write(data)
+}
+
+func (h *Handler) handleFloat(w http.ResponseWriter, r *http.Request) {
+	minStr := r.URL.Query().Get("min")
+	maxStr := r.URL.Query().Get("max")
+	precisionStr := r.URL.Query().Get("precision")
+
+	min, _ := strconv.ParseFloat(minStr, 64)
+	max, _ := strconv.ParseFloat(maxStr, 64)
+	precision, _ := strconv.Atoi(precisionStr)
+	if precision <= 0 {
+		precision = 4
+	}
+
+	result, err := generator.Float(min, max, precision)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+
+	data, _ := generator.WriteJSON(result)
+	w.Header().Set("Content-Type", "application/json")
