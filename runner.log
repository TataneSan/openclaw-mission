+#!/usr/bin/env python3
+"""
+disk-usage — Visualize disk usage as a treemap in the terminal.
+
+Usage:
+    disk-usage /path/to/dir
+    disk-usage . --depth 2
+    disk-usage / --top 20
+    disk-usage . --sort size --no-color
+    disk-usage . --json
+"""
+
+import argparse
+import json
+import os
+import sys
+from collections import defaultdict
+from typing import Dict, List, Tuple, Optional
+
+
+# ── Constants ──────────────────────────────────────────────────────────
+
+BLOCK_CHARS = [" ", "▏", "▎", "▍", "▌", "▋", "▊", "▉", "█"]
+TREE_CHARS = {"pipe": "│", "tee": "├── ", "corner": "└── ", "space": "    "}
+BAR_WIDTH = 30
+
+
+# ── Colors ─────────────────────────────────────────────────────────────
+
+class C:
+    RED = "\033[91m"
+    YELLOW = "\033[93m"
+    GREEN = "\033[92m"
+    CYAN = "\033[96m"
+    MAGENTA = "\033[95m"
+    BLUE = "\033[94m"
+    GRAY = "\033[90m"
+    BOLD = "\033[1m"
+    DIM = "\033[2m"
+    RESET = "\033[0m"
+
+COLORS_BY_SIZE = [C.GREEN, C.CYAN, C.BLUE, C.YELLOW, C.RED]
+
+
+def size_color(ratio: float, color: bool = True) -> str:
+    """Get color based on size ratio (0-1)."""
+    if not color:
+        return ""
+    idx = min(int(ratio * len(COLORS_BY_SIZE)), len(COLORS_BY_SIZE) - 1)
+    return COLORS_BY_SIZE[idx]
+
+
+# ── Size formatting ────────────────────────────────────────────────────
+
+def format_size(size_bytes: int) -> str:
+    """Format bytes to human readable."""
+    if size_bytes == 0:
+        return "0 B"
+    units = ["B", "KB", "MB", "GB", "TB", "PB"]
+    i = 0
+    size = float(size_bytes)
+    while size >= 1024 and i < len(units) - 1:
+        size /= 1024
+        i += 1
+    if i == 0:
+        return f"{int(size)} B"
+    return f"{size:.1f} {units[i]}"
+
+
+# ── Scanning ───────────────────────────────────────────────────────────
+
+def scan_directory(
+    path: str,
+    max_depth: int = 999,
+    follow_symlinks: bool = False,
+    exclude: List[str] = None,
+) -> Dict:
+    """Scan directory recursively. Returns tree dict."""
