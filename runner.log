+package service
+
+import (
+	"fmt"
+
+	"merge-api/internal/model"
+)
+
+// Merger performs merge operations on JSON/YAML data.
+type Merger struct{}
+
+// NewMerger creates a new Merger.
+func NewMerger() *Merger {
+	return &Merger{}
+}
+
+// Execute merges base and override data using the specified strategy.
+func (m *Merger) Execute(req model.MergeRequest) model.MergeResponse {
+	resp := model.MergeResponse{}
+
+	strategy := req.Strategy
+	if strategy == "" {
+		strategy = "deep"
+	}
+
+	switch strategy {
+	case "deep":
+		resp.Merged = m.deepMerge(req.Base, req.Override)
+	case "shallow":
+		resp.Merged = m.shallowMerge(req.Base, req.Override)
+	case "array-append":
+		resp.Merged = m.arrayAppend(req.Base, req.Override)
+	case "array-replace":
+		resp.Merged = m.arrayReplace(req.Base, req.Override)
+	default:
+		resp.Error = fmt.Sprintf("unknown strategy: %s", strategy)
+		return resp
+	}
+
+	resp.Strategy = strategy
+	return resp
+}
+
+func (m *Merger) deepMerge(base, override interface{}) interface{} {
+	baseMap, baseOK := base.(map[string]interface{})
+	overrideMap, overrideOK := override.(map[string]interface{})
+
+	if !baseOK && !overrideOK {
+		return override
+	}
+	if !baseOK {
+		return override
+	}
+	if !overrideOK {
+		return base
+	}
+
+	result := make(map[string]interface{})
+	for k, v := range baseMap {
+		result[k] = v
+	}
+	for k, v := range overrideMap {
+		if baseVal, exists := baseMap[k]; exists {
+			baseNested, bnOK := baseVal.(map[string]interface{})
+			overrideNested, onOK := v.(map[string]interface{})
+			if bnOK && onOK {
+				result[k] = m.deepMerge(baseNested, overrideNested)
+				continue
+			}
+			baseArr, baOK := baseVal.([]interface{})
+			overrideArr, oaOK := v.([]interface{})
+			if baOK && oaOK {
+				result[k] = append(baseArr, overrideArr...)
+				continue
+			}
+		}
+		result[k] = v
+	}
