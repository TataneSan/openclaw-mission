+// csv-head displays the first N lines of a CSV file.
+package main
+
+import (
+	"encoding/csv"
+	"fmt"
+	"os"
+	"strconv"
+)
+
+func main() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	path := os.Args[1]
+	n := 10
+
+	if len(os.Args) >= 3 {
+		var err error
+		n, err = strconv.Atoi(os.Args[2])
+		if err != nil || n < 0 {
+			fatal(fmt.Errorf("invalid count: %s", os.Args[2]))
+		}
+	}
+
+	f, err := os.Open(path)
+	if err != nil {
+		fatal(err)
+	}
+	defer f.Close()
+
+	r := csv.NewReader(f)
+	count := 0
+	for {
+		record, err := r.Read()
+		if err == io.EOF {
+			break
+		}
+		if err != nil {
+			fatal(err)
+		}
+		fmt.Println(formatRecord(record))
+		count++
+		if count >= n {
+			break
+		}
+	}
+
+	if count < n {
+		fmt.Fprintf(os.Stderr, "(%d line%s shown)\n", count, plural(count))
+	}
+}
+
+func formatRecord(record []string) string {
+	out := ""
+	for i, field := range record {
+		if i > 0 {
+			out += ","
+		}
+		out += field
+	}
+	return out
+}
+
+func plural(n int) string {
+	if n == 1 {
+		return ""
+	}
+	return "s"
+}
+
+func printUsage() {
+	fmt.Println("csv-head - display the first N lines of a CSV file\n" +
+		"Usage:\n" +
+		"  csv-head <file> [n]\n" +
+		"\n" +
