+		fmt.Fprintf(os.Stderr, "Error: %v\n", err)
+		os.Exit(1)
+	}
+
+	stats = filterStats(stats)
+	stats = sortStats(stats, *sortBy)
+
+	if *csvOut != "" {
+		writeCSV(stats)
+	} else {
+		printTable(stats)
