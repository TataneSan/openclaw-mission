+package validators
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"gopkg.in/ini.v1"
+	"gopkg.in/yaml.v3"
+)
+
+type Result struct {
+	Valid  bool
+	Errors []string
+}
+
+func Validate(file, format string, schema map[string]interface{}) Result {
+	data, err := os.ReadFile(file)
+	if err != nil {
+		return Result{Valid: false, Errors: []string{fmt.Sprintf("cannot read file: %v", err)}}
+	}
+
+	detectedFormat := format
+	if detectedFormat == "" {
+		detectedFormat = detectFormat(file)
+	}
+
+	var parsed map[string]interface{}
+	switch detectedFormat {
+	case "json":
+		parsed, err = parseJSON(data)
+	case "yaml":
+		parsed, err = parseYAML(data)
+	case "toml":
+		parsed, err = parseTOML(data)
+	case "ini":
+		parsed, err = parseINI(data)
+	default:
+		return Result{Valid: false, Errors: []string{fmt.Sprintf("unsupported format: %s", detectedFormat)}}
+	}
+
+	if err != nil {
+		return Result{Valid: false, Errors: []string{err.Error()}}
+	}
+
+	if schema != nil {
+		schemaErrors := validateSchema(parsed, schema)
+		if len(schemaErrors) > 0 {
+			return Result{Valid: false, Errors: schemaErrors}
+		}
+	}
+
+	return Result{Valid: true, Errors: []string{}}
+}
+
+func detectFormat(file string) string {
+	ext := strings.ToLower(filepath.Ext(file))
+	switch ext {
+	case ".json":
+		return "json"
+	case ".yaml", ".yml":
+		return "yaml"
+	case ".toml":
+		return "toml"
+	case ".ini", ".cfg", ".conf":
+		return "ini"
+	default:
+		return ""
+	}
+}
+
+func parseJSON(data []byte) (map[string]interface{}, error) {
+	var result map[string]interface{}
+	if err := json.Unmarshal(data, &result); err != nil {
+		return nil, fmt.Errorf("invalid JSON: %v", err)
+	}
