+// Run executes the CLI with the given arguments.
+func (cli *CLI) Run(args []string) int {
+	opts := domain.GenerateOptions{
+		Format:  "markdown",
+		Grouped: true,
+	}
+
+	for i := 0; i < len(args); i++ {
+		arg := args[i]
+		switch arg {
+		case "-h", "--help":
+			printUsage()
+			return 0
+		case "-f", "--format":
+			if i+1 >= len(args) {
+				fmt.Fprintln(os.Stderr, "error: --format requires a value (markdown, plain, json)")
+				return 1
+			}
+			i++
+			opts.Format = strings.ToLower(args[i])
+		case "--ungrouped":
+			opts.Grouped = false
+		case "-v", "--verbose":
+			opts.Verbose = true
+		case "--unreleased":
+			opts.Unreleased = true
+		case "--from":
+			if i+1 >= len(args) {
+				fmt.Fprintln(os.Stderr, "error: --from requires a tag name")
+				return 1
+			}
+			i++
+			opts.FromTag = args[i]
+		case "--to":
+			if i+1 >= len(args) {
+				fmt.Fprintln(os.Stderr, "error: --to requires a tag name")
+				return 1
+			}
+			i++
+			opts.ToTag = args[i]
+		default:
+			fmt.Fprintf(os.Stderr, "error: unknown flag %s\n", arg)
+			printUsage()
+			return 1
+		}
+	}
+
+	// Validate format
+	switch opts.Format {
+	case "markdown", "md":
+		opts.Format = "markdown"
+	case "plain", "txt":
+		opts.Format = "plain"
+	case "json":
+		opts.Format = "json"
+	default:
+		fmt.Fprintf(os.Stderr, "error: invalid format %q (must be markdown, plain, or json)\n", opts.Format)
+		return 1
+	}
