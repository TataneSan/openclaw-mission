		os.Exit(0)
	}

	files := flag.Args()
	if len(files) == 0 {
		countStdin()
	} else {
		total := 0
		for _, f := range files {
			n := countFile(f)
			if len(files) > 1 {
				fmt.Fprintf(os.Stderr, "%s: %d rows\n", f, n)
			}
			total += n
		}
		if len(files) > 1 {
			fmt.Fprintf(os.Stderr, "total: %d rows\n", total)
		}
	}
}

func countStdin() {
	r := csv.NewReader(os.Stdin)
	r.Comma = []rune(*delimiter)[0]
	count := 0
	for {
		_, err := r.Read()
		if err == io.EOF {
			break
		}
		if err != nil {
			continue
		}
		count++
	}
	fmt.Println(count)
}

func countFile(path string) int {
	f, err := os.Open(path)
	if err != nil {
		fmt.Fprintf(os.Stderr, "error opening %s: %v\n", path, err)
		os.Exit(1)
	}
	defer f.Close()

	r := csv.NewReader(f)
	r.Comma = []rune(*delimiter)[0]
	count := 0
	for {
		_, err := r.Read()
		if err == io.EOF {
			break
		}
		if err != nil {
			continue
		}
		count++
	}
	if len(flag.Args()) == 1 {
		fmt.Println(count)
	}
	return count
}
