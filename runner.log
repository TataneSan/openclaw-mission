@@ -0,0 +1,34 @@
+// git-repo-info displays information about a git repository.
+//
+// Usage:
+//
+//	git-repo-info [path]
+//
+// Shows branch, commits, authors, branches list, remote URL, creation date,
+// last commit, and .git directory size.
+package main
+
+import (
+	"fmt"
+	"os"
+
+	"github.com/TataneSan/git-repo-info/internal/infrastructure"
+	"github.com/TataneSan/git-repo-info/internal/presentation"
+)
+
+func main() {
+	path := "."
+	if len(os.Args) > 1 {
+		path = os.Args[1]
+	}
+
+	collector := infrastructure.NewCollector(path)
+	info, err := collector.Collect()
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "Error: %v\n", err)
+		os.Exit(1)
+	}
+
+	printer := presentation.NewPrinter()
+	printer.Print(info)
+}
