+package main
+
+import (
+	"flag"
+	"log"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"github.com/TataneSan/log-stream/internal/infrastructure"
+	"github.com/TataneSan/log-stream/internal/presentation"
+)
+
+func main() {
+	port := flag.String("port", os.Getenv("PORT"), "HTTP port")
+	config := flag.String("config", os.Getenv("CONFIG_FILE"), "path to sources config file")
+	bufSize := flag.Int("buffer", 10000, "max log entries to buffer")
+	flag.Parse()
+
+	if *port == "" {
+		*port = "8080"
+	}
+
+	reader := infrastructure.NewLogReader(*bufSize)
+
+	if *config != "" {
+		if err := reader.LoadConfig(*config); err != nil {
+			log.Printf("warning: could not load config: %v", err)
+		}
+	}
+
+	handler := presentation.NewHandler(reader)
+
+	server := &http.Server{
+		Addr:         ":" + *port,
+		Handler:      handler,
+		ReadTimeout:  30 * time.Second,
+		WriteTimeout: 0,
+		IdleTimeout:  120 * time.Second,
+	}
+
+	c := make(chan os.Signal, 1)
+	signal.Notify(c, os.Interrupt, syscall.SIGTERM)
+
+	log.Printf("log-stream starting on :%s", *port)
+	go func() {
+		if err := server.ListenAndServe(); err != nil && err != http.ErrServerClosed {
+			log.Fatalf("server error: %v", err)
+		}
+	}()
+
+	<-c
+	log.Print("shutting down...")
+}
