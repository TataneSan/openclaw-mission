+// markdown-table — Convert CSV, TSV, or delimited data to Markdown tables.
+//
+// Reads data from a file or stdin and outputs a properly formatted
+// Markdown table to stdout.
+//
+// Usage:
+//   markdown-table [flags] [file]
+//
+// Flags:
+//   -d, --delimiter   Field delimiter: auto, comma, tab, pipe, semicolon (default: auto)
+//   -h, --has-header  First row is a header (default: true)
+//   -a, --align       Column alignment: left, right, center (default: left)
+//   -n, --no-border   Omit the separator line (GitHub Flavored Markdown requires it)
+package main
+
+import (
+	"bufio"
+	"encoding/csv"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+)
+
+const (
+	appName    = "markdown-table"
+	appVersion = "1.0.0"
+)
+
+func main() {
+	delimiter := flag.String("d", "auto", "Field delimiter: auto, comma, tab, pipe, semicolon")
+	delAlias := flag.String("delimiter", "auto", "Field delimiter: auto, comma, tab, pipe, semicolon")
+	hasHeader := flag.Bool("h", true, "First row is a header")
+	headerAlias := flag.Bool("has-header", true, "First row is a header")
+	align := flag.String("a", "left", "Column alignment: left, right, center")
+	alignAlias := flag.String("align", "left", "Column alignment: left, right, center")
+	noBorder := flag.Bool("n", false, "Omit the separator line")
+	noBorderAlias := flag.Bool("no-border", false, "Omit the separator line")
+	showVersion := flag.Bool("v", false, "Show version")
+	versionAlias := flag.Bool("version", false, "Show version")
+
+	flag.Parse()
+
+	if *showVersion || *versionAlias {
+		fmt.Printf("%s v%s\n", appName, appVersion)
+		os.Exit(0)
+	}
+
+	// Merge alias flags
+	if *delAlias != "auto" {
+		*delimiter = *delAlias
+	}
+	if !*headerAlias {
+		*hasHeader = *headerAlias
+	}
+	if *alignAlias != "left" {
+		*align = *alignAlias
+	}
+	if *noBorderAlias {
+		*noBorder = *noBorderAlias
+	}
+
+	// Validate alignment
+	switch *align {
+	case "left", "right", "center":
+	default:
+		fmt.Fprintf(os.Stderr, "Error: invalid alignment %q, must be left, right, or center\n", *align)
+		os.Exit(1)
+	}
+
+	// Validate delimiter
+	switch *delimiter {
+	case "auto", "comma", "tab", "pipe", "semicolon":
+	default:
+		fmt.Fprintf(os.Stderr, "Error: invalid delimiter %q, must be auto, comma, tab, pipe, or semicolon\n", *delimiter)
+		os.Exit(1)
+	}
