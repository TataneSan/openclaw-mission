+package main
+
+import (
+	"flag"
+	"fmt"
+	"log"
+	"net/http"
+	"os"
+	"os/signal"
+	"syscall"
+	"time"
+
+	"github.com/TataneSan/config-validator/internal/infrastructure"
+	"github.com/TataneSan/config-validator/internal/presentation"
+)
+
+func main() {
+	port := flag.String("port", os.Getenv("PORT"), "HTTP port")
+	flag.Parse()
+
+	if *port == "" {
+		*port = "8080"
+	}
+
+	validator := infrastructure.NewValidator()
+	handler := presentation.NewHandler(validator)
+
+	server := &http.Server{
+		Addr:         ":" + *port,
+		Handler:      handler,
+		ReadTimeout:  15 * time.Second,
+		WriteTimeout: 15 * time.Second,
+		IdleTimeout:  60 * time.Second,
+	}
+
+	c := make(chan os.Signal, 1)
+	signal.Notify(c, os.Interrupt, syscall.SIGTERM)
+
+	log.Printf("config-validator starting on :%s", *port)
+	go func() {
+		if err := server.ListenAndServe(); err != nil && err != http.ErrServerClosed {
+			log.Fatalf("server error: %v", err)
+		}
+	}()
+
+	<-c
+	log.Print("shutting down...")
+	fmt.Println("done")
+}
