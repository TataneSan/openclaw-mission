+package presentation
+
+import (
+	"fmt"
+	"math"
+	"os"
+	"sort"
+	"text/tabwriter"
+	"time"
+
+	"github.com/TataneSan/net-latency/internal/domain"
+)
+
+// Printer handles output formatting for probe results.
+type Printer struct {
+	w *tabwriter.Writer
+}
+
+// NewPrinter creates a new Printer writing to stdout.
+func NewPrinter() *Printer {
+	return &Printer{w: tabwriter.NewWriter(os.Stdout, 0, 0, 2, ' ', 0)}
+}
+
+// PrintResults prints individual probe results.
+func (p *Printer) PrintResults(results []domain.ProbeResult) {
+	for _, r := range results {
+		status := "OK"
+		if !r.Success {
+			status = "FAIL"
+		}
+		fmt.Printf("[%s] %s (%s) - %v\n", status, r.Host, r.Protocol, r.Latency.Round(time.Microsecond))
+		if !r.Success {
+			fmt.Printf("  error: %s\n", r.Error)
+		}
+	}
+}
+
+// PrintSummary prints aggregated latency summary.
+func (p *Printer) PrintSummary(summaries []*domain.Summary) {
+	fmt.Println()
+	p.w.Init(os.Stdout, 0, 0, 2, ' ', 0)
+	fmt.Fprintln(p.w, "HOST\tPORT\tPROTOCOL\tATTEMPTS\tOK\tMIN\tMAX\tAVG\tP95")
+	fmt.Fprintln(p.w, "----\t----\t--------\t--------\t--\t---\t---\t---\t---")
+
+	for _, s := range summaries {
+		fmt.Fprintf(p.w, "%s\t%d\t%s\t%d\t%d\t%s\t%s\t%s\t%s\n",
+			s.Host, s.Port, s.Protocol,
+			s.Attempts, s.Successes,
+			formatDur(s.MinLatency), formatDur(s.MaxLatency),
+			formatDur(s.AvgLatency), formatDur(s.P95Latency),
+		)
+	}
+	p.w.Flush()
+	fmt.Println()
+}
+
+func formatDur(d time.Duration) string {
+	if d < time.Millisecond {
+		return fmt.Sprintf("%dus", d.Microseconds())
+	}
+	if d < time.Second {
+		return fmt.Sprintf("%.1fms", float64(d.Microseconds())/1000)
+	}
+	return fmt.Sprintf("%.2fs", d.Seconds())
+}
+
