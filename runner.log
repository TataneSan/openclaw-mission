+const http = require('http');
+const url = require('url');
+
+const PORT = process.env.PORT || 3000;
+const MAX_DELAY = 30000; // 30 seconds max
+
+function sleep(ms) {
+  return new Promise(resolve => setTimeout(resolve, ms));
+}
+
+const server = http.createServer(async (req, res) => {
+  const parsedUrl = url.parse(req.url, true);
+  const pathname = parsedUrl.pathname;
+  const query = parsedUrl.query;
+
+  // /delay/:seconds
+  const delayMatch = pathname.match(/^\/delay\/(\d+(?:\.\d+)?)$/);
+  if (delayMatch) {
+    let delayMs = parseFloat(delayMatch[1]) * 1000;
+    if (delayMs > MAX_DELAY) delayMs = MAX_DELAY;
+
+    const startTime = Date.now();
+    await sleep(delayMs);
+    const actualDelay = Date.now() - startTime;
+
+    res.writeHead(200, { 'Content-Type': 'application/json' });
+    return res.end(JSON.stringify({
+      requested_delay_ms: parseFloat(delayMatch[1]) * 1000,
+      actual_delay_ms: actualDelay,
+      timestamp: new Date().toISOString()
+    }, null, 2));
+  }
+
+  // /delay?seconds=5
+  if (pathname === '/delay' && query.seconds) {
+    let delayMs = parseFloat(query.seconds) * 1000;
+    if (delayMs > MAX_DELAY) delayMs = MAX_DELAY;
+
+    const startTime = Date.now();
+    await sleep(delayMs);
+    const actualDelay = Date.now() - startTime;
+
+    res.writeHead(200, { 'Content-Type': 'application/json' });
+    return res.end(JSON.stringify({
+      requested_delay_ms: parseFloat(query.seconds) * 1000,
+      actual_delay_ms: actualDelay,
+      timestamp: new Date().toISOString()
+    }, null, 2));
+  }
+
+  // /status/:code
+  const statusMatch = pathname.match(/^\/status\/(\d{3})$/);
+  if (statusMatch) {
+    const statusCode = parseInt(statusMatch[1], 10);
+    let delayMs = 0;
+
+    if (query.seconds) {
+      delayMs = parseFloat(query.seconds) * 1000;
+      if (delayMs > MAX_DELAY) delayMs = MAX_DELAY;
+      await sleep(delayMs);
+    }
+
+    res.writeHead(statusCode, { 'Content-Type': 'application/json' });
+    return res.end(JSON.stringify({
+      status: statusCode,
+      timestamp: new Date().toISOString()
+    }, null, 2));
+  }
+
+  // /timeout - never responds (for testing connection timeouts)
+  if (pathname === '/timeout') {
+    const timeoutMs = query.seconds ? Math.min(parseFloat(query.seconds) * 1000, 60000) : 60000;
+    await sleep(timeoutMs);
+    res.writeHead(200, { 'Content-Type': 'application/json' });
+    return res.end(JSON.stringify({
+      message: 'timeout completed',
+      timestamp: new Date().toISOString()
+    }, null, 2));
