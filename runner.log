+package presentation
+
+import (
+	"fmt"
+	"os"
+	"text/tabwriter"
+
+	"github.com/TataneSan/git-repo-info/internal/domain"
+)
+
+// Printer formats and prints repository information.
+type Printer struct {
+	w *tabwriter.Writer
+}
+
+// NewPrinter creates a new Printer writing to stdout.
+func NewPrinter() *Printer {
+	return &Printer{w: tabwriter.NewWriter(os.Stdout, 0, 0, 2, ' ', 0)}
+}
+
+// Print outputs the full repo info.
+func (p *Printer) Print(info *domain.RepoInfo) {
+	fmt.Println("Repository Info")
+	fmt.Println("===============")
+	fmt.Println()
+
+	p.w.Init(os.Stdout, 0, 0, 2, ' ', 0)
+	fmt.Fprintf(p.w, "Path:\t%s\n", info.Path)
+	fmt.Fprintf(p.w, "Branch:\t%s\n", info.Branch)
+	fmt.Fprintf(p.w, "HEAD:\t%s\n", info.HEAD)
+	fmt.Fprintf(p.w, "Total commits:\t%d\n", info.TotalCommits)
+	fmt.Fprintf(p.w, "Remote:\t%s\n", info.RemoteURL)
+	fmt.Fprintf(p.w, "Created:\t%s\n", info.Created)
+	fmt.Fprintf(p.w, "Last commit:\t%s\n", info.LastCommit)
+	fmt.Fprintf(p.w, "Last author:\t%s\n", info.LastAuthor)
+	fmt.Fprintf(p.w, "Size (.git):\t%s\n", formatSize(info.SizeBytes))
+	p.w.Flush()
+
+	if len(info.Branches) > 0 {
+		fmt.Println()
+		fmt.Println("Branches:")
+		for _, b := range info.Branches {
+			fmt.Printf("  %s\n", b)
+		}
+	}
+
+	if len(info.Authors) > 0 {
+		fmt.Println()
+		fmt.Println("Top authors:")
+		for i, a := range info.Authors {
+			if i >= 10 {
+				break
+			}
+			fmt.Printf("  %s\n", a)
+		}
+	}
+	fmt.Println()
+}
+
+func formatSize(bytes int64) string {
+	if bytes < 1024 {
+		return fmt.Sprintf("%d B", bytes)
+	}
+	if bytes < 1024*1024 {
+		return fmt.Sprintf("%.1f KB", float64(bytes)/1024)
+	}
+	if bytes < 1024*1024*1024 {
+		return fmt.Sprintf("%.1f MB", float64(bytes)/(1024*1024))
+	}
+	return fmt.Sprintf("%.1f GB", float64(bytes)/(1024*1024*1024))
+}
