+package infrastructure
+
+import (
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/TataneSan/template-api/internal/domain"
+)
+
+type TemplateStore struct {
+	mu        sync.RWMutex
+	templates map[string]*domain.Template
+	counter   int
+}
+
+func NewTemplateStore() *TemplateStore {
+	return &TemplateStore{
+		templates: make(map[string]*domain.Template),
+	}
+}
+
+func (s *TemplateStore) nextID() string {
+	s.counter++
+	return fmt.Sprintf("tpl_%d", s.counter)
+}
+
+func (s *TemplateStore) Create(t *domain.Template) *domain.Template {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	now := time.Now().UTC()
+	t.ID = s.nextID()
+	t.CreatedAt = now
+	t.UpdatedAt = now
+	s.templates[t.ID] = t
+	return t
+}
+
+func (s *TemplateStore) Get(id string) (*domain.Template, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	t, ok := s.templates[id]
+	if !ok {
+		return nil, fmt.Errorf("template not found: %s", id)
+	}
+	return t, nil
+}
+
+func (s *TemplateStore) List() []*domain.Template {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	result := make([]*domain.Template, 0, len(s.templates))
+	for _, t := range s.templates {
+		result = append(result, t)
+	}
+	return result
+}
+
