+"""Image compression engine using Pillow."""
+
+from __future__ import annotations
+
+import io
+from pathlib import Path
+
+from PIL import Image
+
+
+SUPPORTED_FORMATS = {"JPEG", "PNG", "WEBP"}
+
+
+def detect_format(data: bytes) -> str | None:
+    """Detect image format from raw bytes using Pillow."""
+    try:
+        with Image.open(io.BytesIO(data)) as img:
+            fmt = img.format
+            return fmt if fmt in SUPPORTED_FORMATS else None
+    except Exception:
+        return None
+
+
+def compress_image(
+    data: bytes,
+    *,
+    quality: int = 80,
+    target_format: str | None = None,
+    max_width: int | None = None,
+    max_height: int | None = None,
+    strip_metadata: bool = True,
+) -> tuple[bytes, str, dict]:
+    """Compress an image and return (compressed_bytes, format, stats).
+
+    Parameters
+    ----------
+    data : bytes
+        Raw image bytes.
+    quality : int
+        Compression quality 1-100. Lower = smaller file.
+    target_format : str | None
+        Force output format (JPEG, PNG, WEBP). None = keep original.
+    max_width : int | None
+        Resize to fit this max width preserving aspect ratio.
+    max_height : int | None
+        Resize to fit this max height preserving aspect ratio.
+    strip_metadata : bool
+        Remove EXIF/metadata to reduce size.
+
+    Returns
+    -------
+    tuple[bytes, str, dict]
+        Compressed bytes, format string, and stats dict.
+    """
+    original_size = len(data)
+
+    with Image.open(io.BytesIO(data)) as img:
+        original_format = img.format or "JPEG"
+        original_dimensions = img.size
+
+        # Convert palette/transparency for JPEG
+        out_format = (target_format or original_format).upper()
+        if out_format not in SUPPORTED_FORMATS:
+            out_format = "JPEG"
+
+        # Ensure RGB for JPEG/WEBP
+        if out_format in ("JPEG", "WEBP") and img.mode in ("RGBA", "P", "LA"):
+            img = img.convert("RGB")
+        elif out_format == "PNG" and img.mode == "P":
