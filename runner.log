+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+var version = "1.0.0"
+
+func parseTime(t string) (time.Time, error) {
+	for _, layout := range []string{
+		"2006-01-02 15:04:05",
+		"2006-01-02T15:04:05",
+		"2006-01-02 15:04",
+		"2006-01-02",
+		"01/02/2006 15:04:05",
+		"02-01-2006 15:04:05",
+		time.RFC3339,
+		time.RFC1123,
+		time.RFC1123Z,
+	} {
+		if t, err := time.Parse(layout, t); err == nil {
+			return t, nil
+		}
+	}
+	return time.Time{}, fmt.Errorf("unable to parse time: %s", t)
+}
+
+func main() {
+	timeFlag := flag.String("t", "", "Time to set (format: 2006-01-02 15:04:05, ISO 8601, etc.)")
+	refFile := flag.String("r", "", "Reference file (copy its timestamps)")
+	access := flag.Bool("a", false, "Change only access time")
+	modify := flag.Bool("m", false, "Change only modify time")
+	force := flag.Bool("f", false, "Create files if they don't exist")
+	showVersion := flag.Bool("V", false, "Show version")
+	flag.Parse()
+
+	if *showVersion {
+		fmt.Printf("file-touch v%s\n", version)
+		return
+	}
+
+	files := flag.Args()
