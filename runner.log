+	api.HandleFunc("/render", interfaces.RenderHandler(store, renderer)).Methods("POST")
+	api.HandleFunc("/render/{id}", interfaces.RenderByIDHandler(store, renderer)).Methods("POST")
+
+	api.HandleFunc("/render/text", interfaces.RenderTextHandler(renderer)).Methods("POST")
+	api.HandleFunc("/render/json", interfaces.RenderJSONHandler(renderer)).Methods("POST")
+	api.HandleFunc("/render/yaml", interfaces.RenderYAMLHandler(renderer)).Methods("POST")
