+#!/usr/bin/env python3
+"""cron-parser — Parse et explique les expressions cron."""
+
+import argparse
+import sys
+from datetime import datetime, timedelta
+from typing import List, Optional, Tuple
+import re
+
+
+class Colors:
+    RED = "\033[91m"
+    GREEN = "\033[92m"
+    YELLOW = "\033[93m"
+    BLUE = "\033[94m"
+    CYAN = "\033[96m"
+    MAGENTA = "\033[95m"
+    BOLD = "\033[1m"
+    DIM = "\033[2m"
+    RESET = "\033[0m"
+
+
+# Common cron shortcuts
+SHORTCUTS = {
+    "@yearly": "0 0 1 1 *",
+    "@annually": "0 0 1 1 *",
+    "@monthly": "0 0 1 * *",
+    "@weekly": "0 0 * * 0",
+    "@daily": "0 0 * * *",
+    "@midnight": "0 0 * * *",
+    "@hourly": "0 * * * *",
+    "@every_minute": "* * * * *",
+    "@every_5m": "*/5 * * * *",
+    "@every_10m": "*/10 * * * *",
+    "@every_15m": "*/15 * * * *",
+    "@every_30m": "*/30 * * * *",
+    "@every_hour": "0 * * * *",
+    "@every_2h": "0 */2 * * *",
+    "@every_6h": "0 */6 * * *",
+    "@every_12h": "0 */12 * * *",
+}
+
+DAYS_FR = ["dimanche", "lundi", "mardi", "mercredi", "jeudi", "vendredi", "samedi"]
+DAYS_SHORT = ["dim", "lun", "mar", "mer", "jeu", "ven", "sam"]
+MONTHS_FR = [
+    "", "janvier", "février", "mars", "avril", "mai", "juin",
+    "juillet", "août", "septembre", "octobre", "novembre", "décembre"
+]
+
+
+class CronField:
+    """Represents a single cron field."""
+
+    def __init__(self, value: str, field_type: str, min_val: int, max_val: int):
+        self.raw = value
+        self.field_type = field_type
+        self.min_val = min_val
+        self.max_val = max_val
+        self.values = self._parse(value)
+
+    def _parse(self, value: str) -> List[int]:
+        """Parse cron field value."""
+        result = set()
+
+        # Handle day names
+        if self.field_type == "weekday":
+            value = value.upper()
+            for i, name in enumerate(["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]):
+                value = value.replace(name, str(i))
+            for i, name in enumerate(["DIM", "LUN", "MAR", "MER", "JEU", "VEN", "SAM"]):
+                value = value.replace(name, str(i))
+
+        # Handle month names
+        if self.field_type == "month":
+            value = value.upper()
+            for i, name in enumerate(["", "JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"], 1):
+                if i > 0:
+                    value = value.replace(name, str(i))
