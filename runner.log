+// reading-notes: notes de lecture par livre/chapitre
+// Usage: reading-notes [command] [flags]
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+)
+
+// Note represents a reading note for a specific chapter
+type Note struct {
+	Book     string   `json:"book"`
+	Chapter  string   `json:"chapter"`
+	Title    string   `json:"title"`
+	Content  string   `json:"content"`
+	Tags     []string `json:"tags,omitempty"`
+	Rating   int      `json:"rating,omitempty"` // 1-5
+	Created  string   `json:"created"`
+}
+
+// Book represents a book being read
+type Book struct {
+	Title     string   `json:"title"`
+	Author    string   `json:"author"`
+	Status    string   `json:"status"` // reading, completed, abandoned
+	Started   string   `json:"started"`
+	Finished  string   `json:"finished,omitempty"`
+	Rating    int      `json:"rating,omitempty"` // 1-5
+	Notes     []Note   `json:"notes"`
+	Created   string   `json:"created"`
+}
+
+const dataDir = ".reading-notes"
+
+func getDataPath() string {
+	home, err := os.UserHomeDir()
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "Error: cannot determine home directory\n")
+		os.Exit(1)
+	}
+	return filepath.Join(home, dataDir)
+}
+
+func getBookPath(title string) string {
+	// Create a safe filename from the title
+	safe := strings.ToLower(strings.ReplaceAll(title, " ", "-"))
+	return filepath.Join(getDataPath(), safe+".json")
+}
+
+func findBook(title string) (string, *Book, error) {
+	path := getBookPath(title)
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return "", nil, fmt.Errorf("book '%s' not found. Add it with: reading-notes add-book %s", title, title)
+	}
+	var book Book
+	if err := json.Unmarshal(data, &book); err != nil {
+		return "", nil, fmt.Errorf("failed to parse book data: %w", err)
+	}
+	return path, &book, nil
+}
+
+func saveBook(path string, book *Book) error {
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		return fmt.Errorf("failed to create directory: %w", err)
+	}
+	data, err := json.MarshalIndent(book, "", "  ")
+	if err != nil {
+		return fmt.Errorf("failed to marshal book data: %w", err)
+	}
+	return os.WriteFile(path, data, 0644)
+}
