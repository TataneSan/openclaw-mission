+      timeout: 30000,
+    }, (res) => {
+      let data = '';
+      res.on('data', chunk => data += chunk);
+      res.on('end', () => {
+        try {
+          const j = JSON.parse(data);
+          resolve(j.choices?.[0]?.message?.content || data);
+        } catch { resolve(data); }
+      });
+    });
+    req.on('error', (e) => resolve('LLM unavailable: ' + e.message));
+    req.on('timeout', () => { req.destroy(); resolve('LLM timeout'); });
+    req.write(body);
+    req.end();
+  });
+}
