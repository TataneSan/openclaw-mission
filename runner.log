+// httpbin-cli is a local HTTP test server that simulates various HTTP responses.
+// It supports configurable status codes, delays, headers, basic auth, and CORS.
+package main
+
+import (
+	"flag"
+	"fmt"
+	"log"
+	"net/http"
+	"os"
+	"os/signal"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/TataneSan/httpbin-cli/internal/handlers"
+)
+
+func main() {
+	host := flag.String("host", "127.0.0.1", "Bind address")
+	port := flag.Int("port", 8080, "Bind port")
