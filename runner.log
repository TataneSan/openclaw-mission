+log-filter app.log --from 2024-01-01T00:00:00 --to 2024-01-01T23:59:59
+
+# Combine filters
+log-filter app.log --level ERROR --pattern "database"
+
+# Invert filter (show non-matching lines)
+log-filter app.log --level ERROR --invert
+
+# Count matches
+log-filter app.log -l ERROR --count
 
 # Follow mode
-log-filter -i "ERROR" -f app.log
