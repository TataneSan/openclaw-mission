+"""Point d'entrée CLI pour link-checker."""
+
+import argparse
+import asyncio
+import sys
+import time
+from urllib.parse import urlparse
+
+from .checker import LinkChecker
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(
+        prog="link-checker",
+        description="Vérifie les liens morts d'un site web.",
+        epilog="Exemples:\n"
+        "  link-checker https://example.com\n"
+        "  link-checker https://example.com --depth 3 --timeout 15\n"
+        "  link-checker https://example.com --external --concurrency 20\n"
+        "  link-checker https://example.com --output report.json\n",
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+    )
+    parser.add_argument("url", help="URL de départ à vérifier")
+    parser.add_argument(
+        "-d",
+        "--depth",
+        type=int,
+        default=2,
+        help="Profondeur max de crawl (défaut: 2)",
+    )
+    parser.add_argument(
+        "-t",
+        "--timeout",
+        type=int,
+        default=10,
+        help="Timeout par requête en secondes (défaut: 10)",
+    )
+    parser.add_argument(
+        "-c",
+        "--concurrency",
+        type=int,
+        default=10,
+        help="Nombre de requêtes simultanées (défaut: 10)",
+    )
+    parser.add_argument(
