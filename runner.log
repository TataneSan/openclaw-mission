+}
+
+
+def tail_file(path: str, follow: bool, lines: int):
+    """Read the last N lines of a file, optionally following."""
+    try:
+        with open(path, "r") as f:
+            # Seek to end and read last N lines
+            f.seek(0, 2)
+            file_size = f.tell()
+
+            # Read backwards to find N newlines
+            block_size = min(file_size, 8192)
+            blocks = []
+            pos = file_size
+
+            newline_count = 0
+            while pos > 0 and newline_count < lines + 1:
+                read_size = min(block_size, pos)
+                pos -= read_size
+                f.seek(pos)
+                block = f.read(read_size)
+                blocks.append(block)
+                newline_count += block.count("\n")
+
+            content = "".join(reversed(blocks))
+            all_lines = content.split("\n")
+            # Get last N lines (skip trailing empty)
+            start = max(0, len(all_lines) - lines - 1)
+            for line in all_lines[start:]:
+                if line:
+                    yield line
+
+            if follow:
+                while True:
+                    line = f.readline()
+                    if line:
+                        yield line.rstrip("\n")
+                    else:
+                        time.sleep(0.1)
+    except FileNotFoundError:
+        print(f"\033[31mError:\033[0m File not found: {path}", file=sys.stderr)
+        sys.exit(1)
+    except PermissionError:
+        print(f"\033[31mError:\033[0m Permission denied: {path}", file=sys.stderr)
+        sys.exit(1)
+
+
+def read_stdin():
+    """Read lines from stdin."""
+    for line in sys.stdin:
+        yield line.rstrip("\n")
+
