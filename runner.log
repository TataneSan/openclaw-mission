+
+// TransformRequest represents a transformation operation on data.
+type TransformRequest struct {
+	Data     interface{} `json:"data"`
+	Operation string     `json:"operation"` // map, filter, sort, group, flatten, unique
+	Path     string      `json:"path,omitempty"`     // dot notation path to target nested data
+	Key      string      `json:"key,omitempty"`      // key for sort/group operations
+	Asc      *bool       `json:"asc,omitempty"`      // sort direction (default: true)
+	Expr     string      `json:"expr,omitempty"`     // expression for map/filter
+	Limit    int         `json:"limit,omitempty"`    // limit results
+	Offset   int         `json:"offset,omitempty"`   // skip N results
+}
+
+// TransformResponse contains the transformed data and metadata.
+type TransformResponse struct {
+	Data      interface{} `json:"data"`
+	Count     int         `json:"count"`
+	Operation string      `json:"operation"`
+	Error     string      `json:"error,omitempty"`
+}
