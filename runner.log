+// json-flatten-keys flattens nested JSON keys into a single level.
+//
+// Example:
+//   {"a": {"b": {"c": 1}}} → {"a.b.c": 1}
+//
+// Supports custom separators and handles arrays by index.
+package main
+
+import (
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+)
+
+// flatten recursively flattens a JSON value into key-value pairs.
+func flatten(v any, prefix string, sep string) map[string]any {
+	result := make(map[string]any)
+	switch val := v.(type) {
+	case map[string]any:
+		if len(val) == 0 {
+			result[prefix] = val
+			return result
+		}
+		for k, v := range val {
+			key := k
+			if prefix != "" {
+				key = prefix + sep + k
+			}
+			nested := flatten(v, key, sep)
+			for fk, fv := range nested {
+				result[fk] = fv
+			}
+		}
+	case []any:
+		if len(val) == 0 {
+			result[prefix] = val
+			return result
+		}
+		for i, v := range val {
+			key := fmt.Sprintf("%s%s%d", prefix, sep, i)
+			nested := flatten(v, key, sep)
+			for fk, fv := range nested {
+				result[fk] = fv
+			}
+		}
+	default:
+		result[prefix] = val
+	}
+	return result
+}
+
+func run() int {
+	var (
+		sep      = flag.String("s", ".", "separator for flattened keys")
+		input    = flag.String("f", "", "input file (default: stdin)")
+		output   = flag.String("o", "", "output file (default: stdout)")
+		compact  = flag.Bool("c", false, "compact output (no indentation)")
+		prefix   = flag.String("p", "", "prefix for all keys")
+		maxDepth = flag.Int("d", 0, "max nesting depth to flatten (0 = unlimited)")
+	)
+	flag.Parse()
+
+	// Read input
+	var reader io.Reader
+	if *input != "" {
+		f, err := os.Open(*input)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "error: %v\n", err)
+			return 1
+		}
+		defer f.Close()
+		reader = f
+	} else {
+		reader = os.Stdin
+	}
+
