+	equals := fs.String("eq", "", "filtrer: valeur égale")
+	contains := fs.String("contains", "", "filtrer: valeur contient la sous-chaîne")
+	gt := fs.String("gt", "", "filtrer: valeur numérique > n")
+	gte := fs.String("gte", "", "filtrer: valeur numérique >= n")
+	lt := fs.String("lt", "", "filtrer: valeur numérique < n")
+	lte := fs.String("lte", "", "filtrer: valeur numérique <= n")
+
+	// Transform flags
+	selectCols := fs.String("s", "", "sélectionner des colonnes (comma-separated, noms ou indices)")
+	sortCol := fs.String("sort", "", "trier par colonne (nom ou index)")
+	reverse := fs.Bool("reverse", false, "inverser l'ordre du tri")
+	noHeader := fs.Bool("no-header", false, "le fichier n'a pas de ligne d'en-tête")
+	delimiter := fs.String("d", ",", "délimiteur CSV (défaut: ,)")
+	output := fs.String("o", "", "fichier de sortie (vide = stdout)")
+
+	fs.Parse(os.Args[1:])
+
+	if fs.NArg() == 0 {
+		fmt.Fprintf(os.Stderr, "usage: csv-filter [options] <fichier.csv>\n\n")
