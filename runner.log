+#!/usr/bin/env python3
+"""Tests for cron-parser."""
+
+import sys
+import os
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from cron_parser import parse_cron, validate_expr, explain_cron, get_next_runs, build_summary
+from datetime import datetime
+
+
+def test_parse_wildcard():
+    m, h, dom, mo, dow = parse_cron("* * * * *")
+    assert m == set(range(0, 60))
+    assert h == set(range(0, 24))
+    assert dom == set(range(1, 32))
+    assert mo == set(range(1, 13))
+    assert dow == set(range(0, 7))
+
+
+def test_parse_step():
+    m, h, dom, mo, dow = parse_cron("*/5 * * * *")
+    assert m == {0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55}
+
+
+def test_parse_range():
+    m, h, dom, mo, dow = parse_cron("0 9-17 * * *")
+    assert h == set(range(9, 18))
+
+
+def test_parse_list():
+    m, h, dom, mo, dow = parse_cron("0 0 * * 1,3,5")
+    assert dow == {1, 3, 5}
+
+
+def test_parse_complex():
+    m, h, dom, mo, dow = parse_cron("*/15 9-17 1,15 * 1-5")
+    assert m == {0, 15, 30, 45}
+    assert h == set(range(9, 18))
+    assert dom == {1, 15}
+    assert dow == {1, 2, 3, 4, 5}
+
+
+def test_parse_invalid():
+    ok, err = validate_expr("invalid")
+    assert not ok
+
+
+def test_parse_too_few_fields():
+    ok, err = validate_expr("* * *")
+    assert not ok
+
+
+def test_validate_good():
+    ok, _ = validate_expr("*/5 * * * *")
+    assert ok
+
+
+def test_explain():
+    result = explain_cron("*/5 * * * *")
+    assert "every 5 minutes" in result.lower()
+
+
+def test_explain_weekdays():
+    result = explain_cron("0 9 * * 1-5")
+    assert "Monday" in result or "monday" in result
+
+
+def test_next_runs():
+    start = datetime(2026, 1, 1, 0, 0)
+    runs = get_next_runs("0 * * * *", count=3, start=start)
+    assert len(runs) == 3
+    assert runs[0] == datetime(2026, 1, 1, 0, 0)
+    assert runs[1] == datetime(2026, 1, 1, 1, 0)
+    assert runs[2] == datetime(2026, 1, 1, 2, 0)
+
+
+def test_next_runs_specific():
