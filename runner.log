+"""Log level detection and colorization."""
+
+import re
+from dataclasses import dataclass
+from enum import IntEnum
+from typing import Optional
+
+
+class Level(IntEnum):
+    TRACE = 0
+    DEBUG = 10
+    INFO = 20
+    WARN = 30
+    ERROR = 40
+    FATAL = 50
+    UNKNOWN = -1
+
+
+# ANSI color codes
+COLORS = {
+    Level.TRACE:  "\033[2;37m",    # dim white
+    Level.DEBUG:  "\033[36m",      # cyan
+    Level.INFO:   "\033[32m",      # green
+    Level.WARN:   "\033[33m",      # yellow
+    Level.ERROR:  "\033[31m",      # red
+    Level.FATAL:  "\033[1;31m",    # bold red
+    Level.UNKNOWN: "\033[0m",      # reset
+}
+
+LEVEL_TAG_COLORS = {
+    Level.TRACE:  "\033[2;37m",
+    Level.DEBUG:  "\033[1;36m",
+    Level.INFO:   "\033[1;32m",
+    Level.WARN:   "\033[1;33m",
+    Level.ERROR:  "\033[1;31m",
+    Level.FATAL:  "\033[1;5;31m",  # bold red blinking
+    Level.UNKNOWN: "\033[0m",
+}
+
+RESET = "\033[0m"
+BOLD = "\033[1m"
+DIM = "\033[2m"
+UNDERLINE = "\033[4m"
+
+# Patterns for detecting log levels (case-insensitive)
+LEVEL_PATTERNS = [
+    # Standard level keywords in brackets or standalone
+    (re.compile(r'\b(FATAL|CRITICAL|EMERG|EMERGENCY|PANIC)\b', re.IGNORECASE), Level.FATAL),
+    (re.compile(r'\b(ERROR|ERR|SEVERE)\b', re.IGNORECASE), Level.ERROR),
+    (re.compile(r'\b(WARN(?:ING)?)\b', re.IGNORECASE), Level.WARN),
+    (re.compile(r'\b(INFO|NOTICE)\b', re.IGNORECASE), Level.INFO),
+    (re.compile(r'\b(DEBUG|DBG)\b', re.IGNORECASE), Level.DEBUG),
+    (re.compile(r'\b(TRACE|TRC|FINEST?)\b', re.IGNORECASE), Level.TRACE),
+    # Syslog severity
+    (re.compile(r'<\d+>.*?\b(emerg|alert|crit)\b', re.IGNORECASE), Level.FATAL),
