+package client
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+)
+
+const baseURL = "https://api.dictionaryapi.dev/api/v2/entries"
+
+// Definition represents a single definition from the API.
+type Definition struct {
+	Text       string `json:"definition"`
+	Example    string `json:"example,omitempty"`
+	PartOfSpeech string
+}
+
+// LookupEntry contains all information about a word.
+type LookupEntry struct {
+	Definitions []Definition
+	Synonyms    []string
+	Antonyms    []string
+	Phonetic    string
+}
+
+// Dictionary provides access to the Free Dictionary API.
+type Dictionary struct {
+	httpClient *http.Client
+}
+
+// NewDictionary creates a new Dictionary client.
+func NewDictionary() *Dictionary {
+	return &Dictionary{
+		httpClient: &http.Client{
+			Timeout: 10 * time.Second,
+		},
+	}
+}
+
+// Define fetches definitions for a word.
+func (d *Dictionary) Define(word string) ([]Definition, error) {
+	entry, err := d.lookup(word)
+	if err != nil {
+		return nil, err
+	}
+	if entry == nil {
+		return nil, nil
+	}
+	return entry.Definitions, nil
+}
+
+// GetSynonyms fetches synonyms for a word.
+func (d *Dictionary) GetSynonyms(word string) ([]string, error) {
+	entry, err := d.lookup(word)
+	if err != nil {
+		return nil, err
+	}
+	if entry == nil {
+		return nil, nil
+	}
+	return entry.Synonyms, nil
+}
+
+// GetAntonyms fetches antonyms for a word.
+func (d *Dictionary) GetAntonyms(word string) ([]string, error) {
+	entry, err := d.lookup(word)
+	if err != nil {
+		return nil, err
+	}
+	if entry == nil {
+		return nil, nil
+	}
+	return entry.Antonyms, nil
+}
+
