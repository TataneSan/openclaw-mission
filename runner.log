+// byte-size displays file sizes in human-readable format (KB, MB, GB).
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// FormatBytes converts bytes to a human-readable string.
+func FormatBytes(bytes int64) string {
+	const unit = 1024
+	if bytes < unit {
+		return fmt.Sprintf("%d B", bytes)
+	}
+	div := float64(bytes)
+	exp := 0
+	units := []string{"B", "KB", "MB", "GB", "TB"}
+	for n := div / unit; n >= 1; n = div / unit {
+		exp++
+		div /= unit
+	}
+	if exp >= len(units) {
+		exp = len(units) - 1
+	}
+	return fmt.Sprintf("%.2f %s", div, units[exp])
+}
+
+// FileInfo holds file size information.
+type FileInfo struct {
+	Path  string
+	Size  int64
+	Human string
+}
+
+// GetFileSize returns the size of a file or directory.
+func GetFileSize(path string) (int64, error) {
+	info, err := os.Stat(path)
+	if err != nil {
+		return 0, err
+	}
+
+	if !info.IsDir() {
+		return info.Size(), nil
+	}
+
+	var size int64
+	err = filepath.Walk(path, func(_ string, info os.FileInfo, err error) error {
+		if err != nil {
+			return err
+		}
+		if !info.IsDir() {
+			size += info.Size()
+		}
+		return nil
+	})
+	return size, err
+}
+
+func printUsage() {
+	fmt.Println("byte-size - Display file sizes in human-readable format")
+	fmt.Println()
+	fmt.Println("Usage:")
+	fmt.Println("  byte-size <file>")
+	fmt.Println("  byte-size <directory>")
+	fmt.Println("  byte-size <file1> <file2> ...")
+	fmt.Println("  byte-size --sum <directory>")
+	fmt.Println()
+	fmt.Println("Options:")
+	fmt.Println("  --sum    Show total size of directory")
+	fmt.Println("  --bytes  Show raw bytes instead of human-readable")
+	fmt.Println("  -h, --help  Show this help message")
+}
+
+func main() {
+	args := os.Args[1:]
+
