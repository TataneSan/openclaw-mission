+// seed-api — Reproducible random generation API with seed support.
+//
+// Generates deterministic random data (numbers, strings, arrays) based on a seed.
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math/rand"
+	"net/http"
+	"strconv"
+	"strings"
+)
+
+const version = "1.0.0"
+
+func hashSeed(seed string) uint64 {
+	h := sha256.Sum256([]byte(seed))
+	return uint64(h[0])<<56 | uint64(h[1])<<48 | uint64(h[2])<<40 | uint64(h[3])<<32 |
+		uint64(h[4])<<24 | uint64(h[5])<<16 | uint64(h[6])<<8 | uint64(h[7])
+}
+
+func seededRand(seed string) *rand.Rand {
+	return rand.New(rand.NewSource(int64(hashSeed(seed))))
+}
+
+type Response struct {
+	Seed   string      `json:"seed"`
+	Type   string      `json:"type"`
+	Result interface{} `json:"result"`
+}
+
+type ErrorResponse struct {
+	Error string `json:"error"`
+}
+
+func writeJSON(w http.ResponseWriter, status int, data interface{}) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	json.NewEncoder(w).Encode(data)
+}
+
+func writeError(w http.ResponseWriter, status int, msg string) {
+	writeJSON(w, status, ErrorResponse{Error: msg})
+}
+
+// GET /random/int?seed=xxx&min=0&max=100
+func handleRandomInt(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodGet {
+		writeError(w, 405, "method not allowed")
+		return
+	}
+
+	seed := r.URL.Query().Get("seed")
+	if seed == "" {
+		writeError(w, 400, "seed parameter is required")
+		return
+	}
+
+	minStr := r.URL.Query().Get("min")
+	maxStr := r.URL.Query().Get("max")
+
+	minVal := 0
+	maxVal := 100
+
+	if minStr != "" {
+		if v, err := strconv.Atoi(minStr); err == nil {
+			minVal = v
+		}
+	}
+	if maxStr != "" {
+		if v, err := strconv.Atoi(maxStr); err == nil {
+			maxVal = v
+		}
+	}
+
