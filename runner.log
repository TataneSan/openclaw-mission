+COPY . .
+RUN go build -ldflags="-s -w" -o cors-proxy .
+
+FROM alpine:latest
+RUN apk --no-cache add ca-certificates
+COPY --from=builder /app/cors-proxy /usr/local/bin/cors-proxy
+
+EXPOSE 8080
+
+ENTRYPOINT ["cors-proxy"]
+CMD ["-host", "0.0.0.0", "-port", "8080"]
