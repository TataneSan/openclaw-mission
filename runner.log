+package main
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+func main() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	var sortOutput, ignoreCase, countOnly bool
+	var files []string
+
+	for _, arg := range os.Args[1:] {
+		switch arg {
+		case "-h", "--help":
+			printUsage()
+			return
+		case "-s", "--sort":
+			sortOutput = true
+		case "-i", "--ignore-case":
+			ignoreCase = true
+		case "-c", "--count":
+			countOnly = true
+		default:
+			files = append(files, arg)
+		}
+	}
+
+	if len(files) == 0 {
+		dedupReader(bufio.NewReader(os.Stdin), os.Stdout, sortOutput, ignoreCase, countOnly)
+		return
+	}
+
+	for _, f := range files {
