+package domain
+
+import (
+	"time"
+)
+
+type Protocol uint8
+
+const (
+	ICMP Protocol = 1
+	TCP  Protocol = 6
+	UDP  Protocol = 17
+)
+
+func (p Protocol) String() string {
+	switch p {
+	case TCP:
+		return "TCP"
+	case UDP:
+		return "UDP"
+	case ICMP:
+		return "ICMP"
+	default:
+		return "OTHER"
+	}
+}
+
+type Packet struct {
+	Timestamp time.Time
+	Protocol  Protocol
+	SrcIP     string
+	DstIP     string
+	SrcPort   uint16
+	DstPort   uint16
+	Length    int
+	TTL       uint8
+	Flags     string
+	Payload   []byte
+}
+
+type Flow struct {
+	Key       string
+	Packets   int
+	Bytes     int64
+	FirstSeen time.Time
+	LastSeen  time.Time
+}
+
+type Stats struct {
+	TotalPackets int
+	TotalBytes   int64
+	Protocols    map[string]int
+	TopFlows     []*Flow
+	Start        time.Time
+	End          time.Time
+}
