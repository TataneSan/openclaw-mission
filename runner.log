+#!/usr/bin/env python3
+"""Tests for base64-cli."""
+
+import sys
+import os
+
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), ".."))
+
+from base64_cli.main import detect_encoding, ENCODERS, DECODERS
+
+passed = 0
+failed = 0
+
+def assert_eq(actual, expected, msg):
+    global passed, failed
+    if actual == expected:
+        print(f"  PASS: {msg}")
+        passed += 1
+    else:
+        print(f"  FAIL: {msg} (got {actual!r}, expected {expected!r})")
+        failed += 1
+
+
+print("Testing encode/decode roundtrips...")
+for name, enc in ENCODERS.items():
+    if name == "url":
+        continue  # url encoding is lossy for binary
+    dec = DECODERS[name]
+    original = b"Hello, World! 123"
+    encoded = enc(original)
+    decoded = dec(encoded)
+    assert_eq(decoded, original, f"{name} roundtrip")
+
+
+print("\nTesting detect_encoding()...")
+# Base64
+import base64
+b64 = base64.b64encode(b"test data").decode()
+assert_eq(detect_encoding(b64), "base64", "detect base64")
+
+# Base32
+b32 = base64.b32encode(b"test data").decode()
+assert_eq(detect_encoding(b32), "base32", "detect base32")
+
+# Hex
+hx = b"test".hex()
+assert_eq(detect_encoding(hx), "hex", "detect hex")
+
+# URL
+assert_eq(detect_encoding("hello%20world"), "url", "detect url-encoded")
+
+print(f"\n{passed} passed, {failed} failed")
+sys.exit(1 if failed > 0 else 0)
