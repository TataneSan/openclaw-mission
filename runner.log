+const express = require('express');
+
+const app = express();
+app.use(express.json());
+
+// In-memory rate limit store
+// Key: identifier (IP, API key, etc.)
+// Value: { counts: [{timestamp, windowStart}], config }
+const store = new Map();
+
+// Rate limit configurations
+const configs = new Map();
+
+// Default config
+configs.set('default', {
+  windowMs: 60000,    // 1 minute
+  maxRequests: 100,
+  key: 'default'
+});
+
+// Check rate limit for an identifier
+function checkLimit(identifier, configKey) {
+  const config = configs.get(configKey) || configs.get('default');
+  if (!config) {
+    return { allowed: true, error: 'Config not found: ' + configKey };
+  }
+
+  const now = Date.now();
+  const windowStart = now - config.windowMs;
+
+  let record = store.get(identifier);
+  if (!record) {
+    record = { requests: [], configKey };
+    store.set(identifier, record);
+  }
+
+  // Clean old entries outside the window
+  record.requests = record.requests.filter(ts => ts > windowStart);
+
+  const remaining = config.maxRequests - record.requests.length;
+
+  if (remaining <= 0) {
+    const resetTime = record.requests[0] + config.windowMs;
+    return {
+      allowed: false,
+      limit: config.maxRequests,
+      remaining: 0,
+      reset: new Date(resetTime).toISOString(),
+      retryAfter: Math.ceil((resetTime - now) / 1000),
+      windowMs: config.windowMs
+    };
+  }
+
+  // Record this request
+  record.requests.push(now);
+
+  return {
+    allowed: true,
+    limit: config.maxRequests,
+    remaining: remaining - 1,
+    reset: new Date(windowStart + config.windowMs).toISOString(),
+    windowMs: config.windowMs
+  };
+}
+
+// Middleware for rate limiting
+function rateLimitMiddleware(configKey) {
+  return (req, res, next) => {
+    const identifier = req.ip || req.connection.remoteAddress || 'unknown';
+    const result = checkLimit(identifier, configKey);
+
+    // Set rate limit headers
+    res.setHeader('X-RateLimit-Limit', result.limit);
+    res.setHeader('X-RateLimit-Remaining', Math.max(0, result.remaining || 0));
+    res.setHeader('X-RateLimit-Reset', result.reset);
+
+    if (!result.allowed) {
+      res.setHeader('Retry-After', result.retryAfter);
