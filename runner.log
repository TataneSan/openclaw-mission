+"""CSV to JSON converter core logic."""
+
+import csv
+import json
+import sys
+from io import TextIOWrapper
+from typing import Any, Dict, List, Optional, TextIO
+
+
+def detect_delimiter(sample: str) -> str:
+    """Auto-detect CSV delimiter from a sample of the file."""
+    sniffer = csv.Sniffer()
+    try:
+        dialect = sniffer.sniff(sample, delimiters=",;\t|:")
+        return dialect.delimiter
+    except csv.Error:
+        return ","
+
+
+def convert_csv(
+    input_file: TextIO,
+    delimiter: Optional[str] = None,
+    header: bool = True,
+    auto_type: bool = True,
+    limit: Optional[int] = None,
+) -> List[Dict[str, Any]]:
+    """Convert CSV input to a list of dictionaries."""
+    # Read a sample for delimiter detection
+    if delimiter is None:
+        sample = ""
+        for _ in range(min(5, 100)):
+            line = input_file.readline()
+            if not line:
+                break
+            sample += line
+        if not sample.strip():
+            return []
+        delimiter = detect_delimiter(sample)
+        input_file.seek(0)
+
+    reader = csv.reader(input_file, delimiter=delimiter, quotechar='"', skipinitialspace=True)
+
+    rows: List[Dict[str, Any]] = []
+    headers: Optional[List[str]] = None
+    count = 0
+
+    for row in reader:
+        if not any(cell.strip() for cell in row):
+            continue  # skip empty rows
+
+        if headers is None:
+            if header:
+                headers = [h.strip() for h in row]
+                continue
+            else:
+                headers = [f"col_{i}" for i in range(len(row))]
+
+        # Handle rows with different number of columns
+        while len(row) < len(headers):
+            row.append("")
+        row = row[: len(headers)]
+
+        record: Dict[str, Any] = {}
+        for h, v in zip(headers, row):
+            val = v.strip()
+            if auto_type:
+                val = _auto_convert(val)
+            record[h] = val
+
+        rows.append(record)
+        count += 1
+
+        if limit is not None and count >= limit:
+            break
+
+    return rows
+
+
