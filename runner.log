+// log-compress compresses and archives log files with configurable retention.
+//
+// Supports gzip, zstd, and lz4 compression formats.
+// Filter files by glob pattern, minimum size, and age.
+//
+// Usage:
+//   log-compress /var/log -pattern "*.log" -format gzip -older-than 24h
+package main
+
+import (
+	"archive/tar"
+	"compress/gzip"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/klauspost/compress/zstd"
+	lz4 "github.com/pierrec/lz4/v4"
+)
+
+var (
+	dir             string
+	pattern         string
+	format          string
+	olderThan       string
+	minSize         string
+	removeOriginal  bool
+	dryRun          bool
+	verbose         bool
+)
+
+func init() {
+	flag.StringVar(&pattern, "pattern", "*.log", "Glob pattern for files to compress")
+	flag.StringVar(&format, "format", "gzip", "Compression format: gzip, zstd, lz4")
+	flag.StringVar(&olderThan, "older-than", "24h", "Only compress files older than duration (e.g., 24h, 2h)")
+	flag.StringVar(&minSize, "min-size", "0", "Only compress files larger than size (e.g., 100MB, 1GB)")
+	flag.BoolVar(&removeOriginal, "remove-original", false, "Remove original file after compression")
+	flag.BoolVar(&dryRun, "dry", false, "Dry run — show what would be done")
+	flag.BoolVar(&verbose, "v", false, "Verbose output")
+}
+
+func main() {
+	flag.Parse()
+
+	if flag.NArg() == 0 {
+		fmt.Fprintf(os.Stderr, "Usage: log-compress [flags] <directory>\n")
+		flag.PrintDefaults()
+		os.Exit(1)
+	}
+
+	dir = flag.Arg(0)
+
+	// Validate format
+	switch format {
+	case "gzip", "zstd", "lz4":
+	default:
+		fmt.Fprintf(os.Stderr, "error: unsupported format %q (supported: gzip, zstd, lz4)\n", format)
+		os.Exit(1)
+	}
+
+	// Parse duration
+	duration, err := time.ParseDuration(olderThan)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "error: invalid duration %q: %v\n", olderThan, err)
+		os.Exit(1)
+	}
+
+	// Parse min size
+	minBytes, err := parseSize(minSize)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "error: invalid size %q: %v\n", minSize, err)
+		os.Exit(1)
+	}
+
