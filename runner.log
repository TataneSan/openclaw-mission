+package infrastructure
+
+import (
+	"context"
+	"sync"
+
+	"github.com/TataneSan/ping-api/internal/domain"
+)
+
+type InMemoryResultRepository struct {
+	mu      sync.RWMutex
+	results []domain.PingResult
+}
+
+func NewInMemoryResultRepository() *InMemoryResultRepository {
+	return &InMemoryResultRepository{
+		results: make([]domain.PingResult, 0),
+	}
+}
+
+func (r *InMemoryResultRepository) Save(_ context.Context, result *domain.PingResult) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.results = append(r.results, *result)
+
+	if len(r.results) > 1000 {
+		r.results = r.results[len(r.results)-1000:]
+	}
+	return nil
+}
+
+func (r *InMemoryResultRepository) FindByTargetID(_ context.Context, targetID string, limit int) ([]domain.PingResult, error) {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+
+	var matched []domain.PingResult
+	for i := len(r.results) - 1; i >= 0; i-- {
+		if r.results[i].TargetID == targetID {
+			matched = append(matched, r.results[i])
+			if len(matched) >= limit {
+				break
+			}
+		}
+	}
+
+	return matched, nil
+}
+
+func (r *InMemoryResultRepository) FindLatest(_ context.Context, limit int) ([]domain.PingResult, error) {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+
+	if len(r.results) <= limit {
+		result := make([]domain.PingResult, len(r.results))
+		copy(result, r.results)
+		return result, nil
+	}
+
+	result := make([]domain.PingResult, limit)
+	copy(result, r.results[len(r.results)-limit:])
+	return result, nil
+}
