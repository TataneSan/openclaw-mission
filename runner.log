+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+func minify(r io.Reader) ([]byte, error) {
+	var v interface{}
+	if err := json.NewDecoder(r).Decode(&v); err != nil {
+		return nil, fmt.Errorf("invalid JSON: %w", err)
+	}
+	out, err := json.Marshal(v)
+	if err != nil {
+		return nil, fmt.Errorf("marshal error: %w", err)
+	}
+	return append(out, '\n'), nil
+}
+
+func minifyFile(path string) (int64, int64, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return 0, 0, err
+	}
+	defer f.Close()
+
+	stat, err := f.Stat()
+	if err != nil {
+		return 0, 0, err
+	}
+	originalSize := stat.Size()
+
+	data, err := minify(f)
+	if err != nil {
+		return 0, 0, err
+	}
+
+	if err := os.WriteFile(path, data, 0644); err != nil {
+		return 0, 0, err
+	}
+
+	return originalSize, int64(len(data)), nil
+}
+
+func minifyStdin() error {
+	data, err := minify(os.Stdin)
+	if err != nil {
+		return err
+	}
+	_, err = os.Stdout.Write(data)
+	return err
+}
+
+func minifyMultiple(paths []string) error {
+	totalOriginal := int64(0)
+	totalMinified := int64(0)
+	errors := []string{}
+
+	for _, path := range paths {
+		orig, minified, err := minifyFile(path)
+		if err != nil {
+			errors = append(errors, fmt.Sprintf("  %s: %v", path, err))
+			continue
+		}
+		totalOriginal += orig
+		totalMinified += minified
+
+		reduction := float64(orig-minified) / float64(orig) * 100
+		fmt.Printf("  %-40s %8d -> %8d bytes (%.1f%% reduction)\n",
+			filepath.Base(path), orig, minified, reduction)
+	}
+
