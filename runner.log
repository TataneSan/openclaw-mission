+"""Image Compress API — FastAPI application."""
+
+from __future__ import annotations
+
+import io
+from typing import Optional
+
+from fastapi import FastAPI, File, Form, HTTPException, Query, UploadFile
+from fastapi.responses import Response, StreamingResponse
+
+from .compressor import SUPPORTED_FORMATS, compress_image, detect_format
+
+app = FastAPI(
+    title="Image Compress API",
+    description="Compress JPEG, PNG, and WEBP images via a simple REST API.",
+    version="1.0.0",
+)
+
+MIME_MAP = {
+    "jpeg": "image/jpeg",
+    "png": "image/png",
+    "webp": "image/webp",
+}
+
+
+@app.get("/")
+async def root():
+    return {
+        "service": "image-compress-api",
+        "version": "1.0.0",
+        "endpoints": {
+            "POST /compress": "Upload and compress an image (returns compressed file)",
+            "POST /compress/info": "Upload and get compression stats without returning file",
+            "GET /health": "Health check",
+        },
+        "supported_formats": sorted(SUPPORTED_FORMATS),
+    }
+
+
+@app.get("/health")
+async def health():
+    return {"status": "ok"}
+
+
+@app.post("/compress")
+async def compress_endpoint(
+    file: UploadFile = File(..., description="Image file to compress"),
+    quality: int = Form(80, ge=1, le=100, description="Compression quality (1-100)"),
+    format: Optional[str] = Form(None, description="Target format: jpeg, png, webp"),
+    max_width: Optional[int] = Form(None, ge=1, description="Max width in pixels"),
+    max_height: Optional[int] = Form(None, ge=1, description="Max height in pixels"),
+    strip_metadata: bool = Form(True, description="Remove EXIF metadata"),
+):
+    """Compress an uploaded image and return the compressed file."""
+    data = await file.read()
+    if not data:
+        raise HTTPException(status_code=400, detail="Empty file")
+
+    detected = detect_format(data)
+    if detected is None:
+        raise HTTPException(status_code=400, detail="Unsupported or corrupt image file")
+
+    target = format.lower() if format else None
+    if target and target not in ("jpeg", "png", "webp"):
+        raise HTTPException(status_code=400, detail=f"Invalid format. Use: jpeg, png, webp")
+
+    try:
+        compressed, fmt, stats = compress_image(
+            data,
+            quality=quality,
+            target_format=target,
+            max_width=max_width,
+            max_height=max_height,
+            strip_metadata=strip_metadata,
+        )
+    except Exception as e:
+        raise HTTPException(status_code=500, detail=f"Compression failed: {e}")
+
