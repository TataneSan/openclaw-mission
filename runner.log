+package infrastructure
+
+import (
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/TataneSan/webhook-monitor/internal/domain"
+)
+
+type Store struct {
+	mu        sync.RWMutex
+	webhooks  map[string]*domain.Webhook
+	results   map[string][]*domain.CheckResult
+	alerts    map[string][]*domain.Alert
+	counter   int
+}
+
+func NewStore() *Store {
+	return &Store{
+		webhooks: make(map[string]*domain.Webhook),
+		results:  make(map[string][]*domain.CheckResult),
+		alerts:   make(map[string][]*domain.Alert),
+	}
+}
+
+func (s *Store) nextID() string {
+	s.counter++
+	return fmt.Sprintf("wh_%d", s.counter)
+}
+
+func (s *Store) CreateWebhook(w *domain.Webhook) *domain.Webhook {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	now := time.Now().UTC()
+	w.ID = s.nextID()
+	w.CreatedAt = now
+	w.UpdatedAt = now
+	if w.Method == "" {
+		w.Method = "GET"
+	}
+	if w.Headers == nil {
+		w.Headers = make(map[string]string)
+	}
+	if w.Interval <= 0 {
+		w.Interval = 60
+	}
+	if w.AlertAfter <= 0 {
+		w.AlertAfter = 3
+	}
+	s.webhooks[w.ID] = w
+	s.results[w.ID] = []*domain.CheckResult{}
+	s.alerts[w.ID] = []*domain.Alert{}
+	return w
+}
+
+func (s *Store) GetWebhook(id string) (*domain.Webhook, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	w, ok := s.webhooks[id]
+	if !ok {
+		return nil, fmt.Errorf("webhook not found: %s", id)
+	}
+	return w, nil
+}
+
+func (s *Store) ListWebhooks() []*domain.Webhook {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	result := make([]*domain.Webhook, 0, len(s.webhooks))
+	for _, w := range s.webhooks {
+		result = append(result, w)
+	}
+	return result
+}
