+// Execute runs the CLI.
+func Execute() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	command := os.Args[1]
+
+	switch command {
+	case "set":
+		runSet()
+	case "get":
+		runGet()
+	case "delete", "rm":
+		runDelete()
+	case "list", "ls":
+		runList()
+	case "search":
+		runSearch()
+	case "export":
+		runExport()
+	case "import":
+		runImport()
+	case "init":
+		runInit()
+	case "version":
+		fmt.Println("secret-manager v1.0.0")
+	case "help", "--help", "-h":
+		printUsage()
+	default:
+		fmt.Fprintf(os.Stderr, "Unknown command: %s\n", command)
+		printUsage()
+		os.Exit(1)
+	}
+}
+
+func getPassword() string {
+	env := os.Getenv("SECRET_MANAGER_PASSWORD")
+	if env != "" {
+		return env
+	}
+
+	fmt.Print("Password: ")
+	reader := bufio.NewReader(os.Stdin)
+	password, _ := reader.ReadString('\n')
+	return strings.TrimSpace(password)
+}
+
+func openVault() *vault.Vault {
+	password := getPassword()
+	v, err := vault.NewDefault(password)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "Error: %v\n", err)
+		os.Exit(1)
+	}
+	return v
+}
