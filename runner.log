+// csv-filter — filtre et transforme des fichiers CSV en ligne de commande.
+//
+// Usage:
+//
+//	csv-filter -c name -eq Alice input.csv
+//	csv-filter -c age -gt 30 input.csv
+//	csv-filter -c city -contains Paris input.csv
+//	csv-filter -s name,age,city input.csv
+//	csv-filter -sort age -reverse input.csv
+//	cat data.csv | csv-filter -c status -eq active
+package main
+
+import (
+	"encoding/csv"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+func main() {
+	fs := flag.NewFlagSet("csv-filter", flag.ExitOnError)
