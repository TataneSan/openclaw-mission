+package model
+
+// ServerBlock represents a single server block in Nginx config.
+type ServerBlock struct {
+	Listen       int               `yaml:"listen"`
+	ServerName   string            `yaml:"server_name"`
+	Root         string            `yaml:"root"`
+	Index        []string          `yaml:"index"`
+	Locations    []Location        `yaml:"locations"`
+	SSLCert      string            `yaml:"ssl_cert"`
+	SSLKey       string            `yaml:"ssl_key"`
+	RedirectHTTP *RedirectHTTP     `yaml:"redirect_http"`
+	CustomDirectives []string      `yaml:"custom_directives"`
+}
+
+// Location represents a location block.
+type Location struct {
+	Path           string   `yaml:"path"`
+	ProxyPass      string   `yaml:"proxy_pass"`
+	Root           string   `yaml:"root"`
+	TryFiles       []string `yaml:"try_files"`
+	Index          []string `yaml:"index"`
+	CustomDirectives []string `yaml:"custom_directives"`
+}
+
+// RedirectHTTP represents HTTP to HTTPS redirect config.
+type RedirectHTTP struct {
+	Enabled bool `yaml:"enabled"`
+}
+
+// Upstream represents an upstream block for load balancing.
+type Upstream struct {
+	Name    string     `yaml:"name"`
+	Servers []Server   `yaml:"servers"`
+}
+
+// Server represents a backend server in an upstream block.
+type Server struct {
+	Address string `yaml:"address"`
+	Weight  int    `yaml:"weight"`
+}
+
+// Config is the root configuration parsed from YAML.
+type Config struct {
+	ServerBlocks []ServerBlock `yaml:"servers"`
+	Upstreams    []Upstream    `yaml:"upstreams"`
+}
