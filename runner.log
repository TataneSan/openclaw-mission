+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"net"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/fatih/color"
+	"github.com/spf13/cobra"
+)
+
+var version = "1.0.0"
+
+func main() {
+	var rootCmd = &cobra.Command{
+		Use:     "port-scanner [host]",
+		Short:   "Fast TCP port scanner",
+		Long:    "port-scanner — A fast, concurrent TCP port scanner.\nScans single ports, ranges, or common ports with service detection.",
+		Version: version,
+		Args:    cobra.ExactArgs(1),
+		Run:     runScan,
+	}
+
+	rootCmd.Flags().StringP("ports", "p", "", "Ports to scan (e.g., 80,443 or 1-1024 or 80,443,8080)")
+	rootCmd.Flags().IntP("workers", "w", 100, "Number of concurrent workers")
+	rootCmd.Flags().DurationP("timeout", "t", 500*time.Millisecond, "Connection timeout")
+	rootCmd.Flags().BoolP("json", "j", false, "JSON output")
+	rootCmd.Flags().BoolP("no-color", "n", false, "Disable colors")
+	rootCmd.Flags().BoolP("common", "c", false, "Scan common ports only")
+
+	if err := rootCmd.Execute(); err != nil {
+		os.Exit(1)
+	}
+}
+
+func runScan(cmd *cobra.Command, args []string) {
+	noColor, _ := cmd.Flags().GetBool("no-color")
+	if noColor {
+		color.NoColor = true
+	}
+
+	host := args[0]
+	workers, _ := cmd.Flags().GetInt("workers")
+	timeout, _ := cmd.Flags().GetDuration("timeout")
+	jsonOutput, _ := cmd.Flags().GetBool("json")
+	commonOnly, _ := cmd.Flags().GetBool("common")
+
+	var ports []int
+	var err error
+
+	if commonOnly {
+		ports = getCommonPorts()
+	} else {
+		portStr, _ := cmd.Flags().GetString("ports")
+		if portStr == "" {
+			portStr = "1-1024"
+		}
+		ports, err = parsePorts(portStr)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
