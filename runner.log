+package main
+
+import (
+	"fmt"
+	"log"
+	"net/http"
+	"os"
+	"strconv"
+
+	"github.com/TataneSan/ping-api/internal/application"
+	"github.com/TataneSan/ping-api/internal/domain"
+	"github.com/TataneSan/ping-api/internal/infrastructure"
+)
+
+func main() {
+	port := os.Getenv("PORT")
+	if port == "" {
+		port = "8080"
+	}
+
+	targetRepo := infrastructure.NewInMemoryTargetRepository()
+	resultRepo := infrastructure.NewInMemoryResultRepository()
+
+	pinger := domain.NewPinger(targetRepo, resultRepo)
+	handler := application.NewHandler(pinger)
+
+	addr := ":" + port
+	log.Printf("ping-api starting on %s", addr)
+
+	if err := http.ListenAndServe(addr, handler); err != nil {
+		log.Fatalf("server failed: %v", err)
+	}
+}
+
+func init() {
+	_ = strconv.Atoi // ensure strconv is imported
+	_ = fmt.Sprintf  // ensure fmt is imported
+}
