+package main
+
+import (
+	"encoding/csv"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strings"
+)
+
+func flatten(val interface{}, prefix string, sep string, result map[string]string) {
+	switch v := val.(type) {
+	case map[string]interface{}:
+		for k, val := range v {
+			key := k
+			if prefix != "" {
+				key = prefix + sep + k
+			}
+			flatten(val, key, sep, result)
+		}
+	case []interface{}:
+		if len(v) == 0 {
+			result[prefix] = ""
+		} else {
+			for i, elem := range v {
+				key := fmt.Sprintf("%s[%d]", prefix, i)
+				flatten(elem, key, sep, result)
+			}
+		}
+	case nil:
+		result[prefix] = ""
+	case string:
+		result[prefix] = v
+	case float64:
+		if v == float64(int64(v)) {
+			result[prefix] = fmt.Sprintf("%d", int64(v))
+		} else {
+			result[prefix] = fmt.Sprintf("%v", v)
+		}
+	case bool:
+		if v {
+			result[prefix] = "true"
+		} else {
+			result[prefix] = "false"
+		}
+	default:
+		result[prefix] = fmt.Sprintf("%v", v)
+	}
+}
+
