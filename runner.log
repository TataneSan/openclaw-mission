+package storage
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"sync"
+
+	"reading-list/internal/models"
+)
+
+const defaultFileName = "reading.json"
+
+// Store manages reading list persistence.
+type Store struct {
+	mu      sync.Mutex
+	file    string
+	items   []models.Item
+	nextID  int
+}
+
+// New creates a new Store, loading from the given file path if it exists.
+func New(filePath string) (*Store, error) {
+	if filePath == "" {
+		home, err := os.UserHomeDir()
+		if err != nil {
+			return nil, fmt.Errorf("cannot determine home directory: %w", err)
+		}
+		filePath = filepath.Join(home, ".reading-list", defaultFileName)
+	}
+
+	s := &Store{file: filePath}
+	return s, s.load()
+}
+
+func (s *Store) load() error {
+	data, err := os.ReadFile(s.file)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil
+		}
+		return fmt.Errorf("read file: %w", err)
+	}
+
+	if len(data) == 0 {
+		return nil
+	}
+
+	if err := json.Unmarshal(data, &s.items); err != nil {
+		return fmt.Errorf("parse json: %w", err)
+	}
+
+	for _, item := range s.items {
+		if item.ID >= s.nextID {
+			s.nextID = item.ID + 1
+		}
+	}
+	return nil
+}
+
+func (s *Store) save() error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	dir := filepath.Dir(s.file)
+	if err := os.MkdirAll(dir, 0o755); err != nil {
+		return fmt.Errorf("create directory: %w", err)
+	}
+
+	data, err := json.MarshalIndent(s.items, "", "  ")
+	if err != nil {
+		return fmt.Errorf("marshal json: %w", err)
+	}
+
+	return os.WriteFile(s.file, data, 0o644)
+}
