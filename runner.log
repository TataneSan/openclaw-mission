-# Pipe from stdin
-tail -f app.log | log-filter -i "ERROR"
+# Pipe support
+cat app.log | log-filter -l ERROR
+tail -1000 app.log | log-filter -p "timeout"
 
-# Count matches
-log-filter -i "ERROR" -c app.log
+# Disable colors
+log-filter app.log --no-color
