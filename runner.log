+package infrastructure
+
+import (
+	"testing"
+	"time"
+)
+
+func TestSetAndGet(t *testing.T) {
+	c := NewInMemoryCache()
+
+	if err := c.Set("key1", "value1", 60); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	entry, err := c.Get("key1")
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if entry.Value != "value1" {
+		t.Fatalf("expected value1, got %v", entry.Value)
+	}
+}
+
+func TestSetValidation(t *testing.T) {
+	c := NewInMemoryCache()
+
+	if err := c.Set("", "value", 60); err == nil {
+		t.Fatal("expected error for empty key")
+	}
+	if err := c.Set("key", "value", 0); err == nil {
+		t.Fatal("expected error for zero TTL")
+	}
+	if err := c.Set("key", "value", -1); err == nil {
+		t.Fatal("expected error for negative TTL")
+	}
+}
+
+func TestGetNotFound(t *testing.T) {
+	c := NewInMemoryCache()
+
+	if _, err := c.Get("missing"); err == nil {
+		t.Fatal("expected error for missing key")
+	}
+}
+
+func TestDelete(t *testing.T) {
+	c := NewInMemoryCache()
+	c.Set("key1", "value1", 60)
+
+	if err := c.Delete("key1"); err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+
+	if _, err := c.Get("key1"); err == nil {
+		t.Fatal("expected error after delete")
+	}
+}
+
+func TestDeleteNotFound(t *testing.T) {
+	c := NewInMemoryCache()
+
+	if err := c.Delete("missing"); err == nil {
+		t.Fatal("expected error for missing key")
+	}
+}
+
+func TestListKeys(t *testing.T) {
+	c := NewInMemoryCache()
+	c.Set("key1", "value1", 60)
+	c.Set("key2", "value2", 60)
+
+	keys := c.ListKeys()
+	if len(keys) != 2 {
+		t.Fatalf("expected 2 keys, got %d", len(keys))
+	}
+}
