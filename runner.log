+	var pid int
+	var maxDepth int
+	var sortBy string
+
+	cmd := &cobra.Command{
+		Use:   "tree",
+		Short: "Show process tree",
+		Long:  "Display the process tree starting from init (PID 1) or a specific PID.",
+		RunE: func(cmd *cobra.Command, args []string) error {
+			parser := infrastructure.NewParser()
+			proc, err := parser.GetProcessTree(pid)
+			if err != nil {
+				return err
+			}
+
+			if sortBy == "cpu" {
+				sortProcessesByCPU(proc)
+			} else if sortBy == "mem" {
+				sortProcessesByMem(proc)
+			}
+
+			fmt.Println(renderTree(proc, "", true, 0, maxDepth))
+			return nil
+		},
+	}
+
+	cmd.Flags().IntVarP(&pid, "pid", "p", 0, "Show tree for specific PID (0 = init)")
+	cmd.Flags().IntVarP(&maxDepth, "depth", "d", 0, "Maximum tree depth (0 = unlimited)")
+	cmd.Flags().StringVarP(&sortBy, "sort", "s", "", "Sort children by: cpu, mem")
+	return cmd
+}
+
