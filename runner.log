+)
+
+type Handler struct {
+	validator *infrastructure.Validator
+}
+
+func NewHandler(v *infrastructure.Validator) *Handler {
+	return &Handler{validator: v}
+}
+
+func writeJSON(w http.ResponseWriter, status int, v interface{}) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	json.NewEncoder(w).Encode(v)
+}
+
+func writeError(w http.ResponseWriter, status int, msg string) {
+	writeJSON(w, status, map[string]string{"error": msg})
+}
+
+func (h *Handler) ValidateContent(w http.ResponseWriter, r *http.Request) {
+	body, err := io.ReadAll(r.Body)
+	if err != nil {
+		writeError(w, http.StatusBadRequest, "could not read body")
+		return
+	}
+	if len(body) == 0 {
+		writeError(w, http.StatusBadRequest, "empty content")
+		return
+	}
+
+	var req domain.ValidateRequest
+	if err := json.Unmarshal(body, &req); err != nil {
+		// Maybe raw content was sent directly
+		req.Content = string(body)
+	}
+
+	result := h.validator.Validate(req.Content, req.Format)
+	status := http.StatusOK
+	if !result.Valid {
+		status = http.StatusUnprocessableEntity
+	}
+	writeJSON(w, status, result)
+}
+
+func (h *Handler) ValidateFile(w http.ResponseWriter, r *http.Request) {
+	file, header, err := r.FormFile("file")
+	if err != nil {
+		writeError(w, http.StatusBadRequest, "file is required")
+		return
+	}
+	defer file.Close()
+
+	data, err := io.ReadAll(file)
+	if err != nil {
+		writeError(w, http.StatusBadRequest, "could not read file")
+		return
+	}
+
+	format := r.URL.Query().Get("format")
+	if format == "" {
+		ext := strings.ToLower(filepath.Ext(header.Filename))
+		switch ext {
