+#!/usr/bin/env python3
+"""password-gen — Secure password generator for the terminal."""
+
+import argparse
+import math
+import os
+import secrets
+import string
+import sys
+
+# ANSI
+RED = "\033[91m"
+GREEN = "\033[92m"
+YELLOW = "\033[93m"
+CYAN = "\033[96m"
+MAGENTA = "\033[95m"
+BOLD = "\033[1m"
+DIM = "\033[2m"
+RESET = "\033[0m"
+
+# Word list for passphrases (subset of EFF short words)
+WORDS = [
+    "apple", "brave", "cedar", "delta", "eagle", "fable", "giant", "hazel",
+    "ivory", "jewel", "karma", "lemon", "maple", "noble", "ocean", "pearl",
+    "quiet", "river", "solar", "tiger", "ultra", "vivid", "wheat", "xenon",
+    "youth", "zebra", "acorn", "blaze", "coral", "drift", "ember", "flame",
+    "grape", "honey", "index", "jolly", "knack", "lunar", "magic", "nexus",
+    "orbit", "prism", "quilt", "robin", "stone", "thorn", "umbra", "vault",
+    "whirl", "yacht", "amber", "bison", "creek", "dwarf", "frost", "glyph",
+    "helix", "igloo", "joker", "kayak", "lotus", "mocha", "nymph", "olive",
+    "pixel", "query", "raven", "sloth", "tempo", "uncle", "viper", "walrus",
+    "bluff", "charm", "dusk", "epoch", "fjord", "grove", "haven", "irony",
+    "joust", "knelt", "linen", "mirth", "nerve", "onset", "plume", "quirk",
+    "realm", "siege", "trout", "usher", "verge", "wager", "yeast", "zonal",
+    "arch", "bolt", "cove", "dart", "fern", "glen", "haze", "isle",
+    "jade", "knot", "lark", "mesh", "nova", "opal", "pier", "rust",
+    "sage", "tarn", "vale", "wren", "yoga", "zeal", "axle", "bark",
+]
+
+
+def calc_entropy(length, charset_size):
+    """Calculate password entropy in bits."""
+    if charset_size <= 0 or length <= 0:
+        return 0
+    return length * math.log2(charset_size)
+
+
+def strength_label(entropy):
+    """Return a human-readable strength label."""
+    if entropy < 28:
+        return f"{RED}Très faible{RESET}", 1
+    elif entropy < 36:
+        return f"{RED}Faible{RESET}", 2
+    elif entropy < 60:
+        return f"{YELLOW}Moyen{RESET}", 3
+    elif entropy < 80:
+        return f"{GREEN}Fort{RESET}", 4
+    else:
+        return f"{GREEN}Très fort{RESET}", 5
+
+
+def strength_bar(level):
+    """Visual strength bar."""
+    filled = "█" * level + "░" * (5 - level)
+    return f"[{filled}]"
+
+
+def gen_password(length, charset, exclude_ambiguous=False):
+    """Generate a random password from the given charset."""
+    if exclude_ambiguous:
+        ambiguous = "0O1lI|"
+        charset = "".join(c for c in charset if c not in ambiguous)
+
+    if not charset:
+        print(f"{RED}✗{RESET} Charset vide après exclusion.")
+        sys.exit(1)
+
+    return "".join(secrets.choice(charset) for _ in range(length))
