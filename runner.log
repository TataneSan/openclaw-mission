+const http = require('http');
+const url = require('url');
+const fs = require('fs');
+const path = require('path');
+
+const PORT = process.env.PORT || 3000;
+const DATA_FILE = path.join(__dirname, 'data.json');
+
+function loadCounters() {
+  if (fs.existsSync(DATA_FILE)) {
+    try {
+      return JSON.parse(fs.readFileSync(DATA_FILE, 'utf8'));
+    } catch {
+      return {};
+    }
+  }
+  return {};
+}
+
+function saveCounters(counters) {
+  fs.writeFileSync(DATA_FILE, JSON.stringify(counters, null, 2));
+}
+
+let counters = loadCounters();
+
+const server = http.createServer((req, res) => {
+  const parsedUrl = url.parse(req.url, true);
+  const pathname = parsedUrl.pathname;
+  const query = parsedUrl.query;
+
+  res.setHeader('Content-Type', 'application/json');
+
+  // GET /counter/:name
+  const getMatch = pathname.match(/^\/counter\/([^/]+)$/);
+  if (req.method === 'GET' && getMatch) {
+    const name = decodeURIComponent(getMatch[1]);
+    if (!(name in counters)) counters[name] = 0;
+    return res.end(JSON.stringify({ name, value: counters[name] }, null, 2));
+  }
+
+  // POST /counter/:name - increment
+  const postMatch = pathname.match(/^\/counter\/([^/]+)$/);
+  if (req.method === 'POST' && postMatch) {
+    const name = decodeURIComponent(postMatch[1]);
+    if (!(name in counters)) counters[name] = 0;
+    const by = query.by ? parseInt(query.by, 10) : 1;
+    counters[name] += by;
+    saveCounters(counters);
+    return res.end(JSON.stringify({ name, value: counters[name], increment: by }, null, 2));
+  }
+
+  // DELETE /counter/:name - reset to 0
+  const delMatch = pathname.match(/^\/counter\/([^/]+)$/);
+  if (req.method === 'DELETE' && delMatch) {
+    const name = decodeURIComponent(delMatch[1]);
+    counters[name] = 0;
+    saveCounters(counters);
+    return res.end(JSON.stringify({ name, value: 0, reset: true }, null, 2));
+  }
+
+  // GET /counter - list all
+  if (req.method === 'GET' && pathname === '/counter') {
+    return res.end(JSON.stringify({ counters }, null, 2));
+  }
+
+  // POST /counter - create with initial value
+  if (req.method === 'POST' && pathname === '/counter' && query.name) {
+    const name = decodeURIComponent(query.name);
+    counters[name] = query.value ? parseInt(query.value, 10) : 0;
+    saveCounters(counters);
+    return res.end(JSON.stringify({ name, value: counters[name], created: true }, null, 2));
+  }
+
+  // DELETE /counter - reset all
+  if (req.method === 'DELETE' && pathname === '/counter') {
+    counters = {};
+    saveCounters(counters);
+    return res.end(JSON.stringify({ reset: true, counters: {} }, null, 2));
