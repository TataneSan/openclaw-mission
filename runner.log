+package main
+
+import (
+	"database/sql"
+	"encoding/json"
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+type Skill struct {
+	ID        int
+	Name      string
+	Category  string
+	Level     int    // 1-10
+	Notes     string
+	CreatedAt string
+	UpdatedAt string
+}
+
+type PracticeLog struct {
+	ID      int
+	SkillID int
+	Hours   float64
+	Notes   string
+	Date    string
+}
+
+const dbFile = "~/.skill-tracker.db"
+
+func resolvePath(p string) string {
+	if strings.HasPrefix(p, "~/") {
+		home, _ := os.UserHomeDir()
+		return home + "/" + p[2:]
+	}
+	return p
+}
+
+func getDB() (*sql.DB, error) {
+	db, err := sql.Open("sqlite3", resolvePath(dbFile))
+	if err != nil {
+		return nil, err
+	}
+	_, err = db.Exec(`
+		CREATE TABLE IF NOT EXISTS skills (
+			id INTEGER PRIMARY KEY AUTOINCREMENT,
+			name TEXT NOT NULL UNIQUE,
+			category TEXT DEFAULT '',
+			level INTEGER DEFAULT 1,
+			notes TEXT DEFAULT '',
+			created_at TEXT DEFAULT (datetime('now')),
+			updated_at TEXT DEFAULT (datetime('now'))
+		);
+		CREATE TABLE IF NOT EXISTS practice_logs (
+			id INTEGER PRIMARY KEY AUTOINCREMENT,
+			skill_id INTEGER NOT NULL,
+			hours REAL NOT NULL,
+			notes TEXT DEFAULT '',
+			date TEXT DEFAULT (date('now')),
+			FOREIGN KEY (skill_id) REFERENCES skills(id)
+		);
+		CREATE INDEX IF NOT EXISTS idx_logs_skill ON practice_logs(skill_id);
+		CREATE INDEX IF NOT EXISTS idx_logs_date ON practice_logs(date);
+	`)
+	return db, err
+}
+
+func printSkills(skills []Skill) {
+	if len(skills) == 0 {
+		fmt.Println("  No skills tracked yet. Use 'add' to start.")
+		return
+	}
+	fmt.Printf("%-5s %-25s %-15s %-8s %s\n", "ID", "NAME", "CATEGORY", "LEVEL", "LAST UPDATED")
+	fmt.Println(strings.Repeat("-", 80))
