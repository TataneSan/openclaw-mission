+"""Moteur de crawling pour générer des sitemaps."""
+
+import asyncio
+from collections import deque
+from datetime import datetime, timezone
+from html.parser import HTMLParser
+from typing import AsyncIterator
+from urllib.parse import urljoin, urlparse, urldefrag
+
+import aiohttp
+
+
+class PageLinkExtractor(HTMLParser):
+    """Extrait les liens <a href> d'une page HTML."""
+
+    def __init__(self):
+        super().__init__()
+        self.links: list[str] = []
+        self._in_a = False
+        self._current_href: str | None = None
+
+    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]):
+        if tag == "a":
+            attr_dict = dict(attrs)
+            href = attr_dict.get("href")
+            if href:
+                self.links.append(href)
+
+    def handle_endtag(self, tag: str):
+        pass
+
+
+def normalize_url(url: str, base: str) -> str | None:
+    """Normalise une URL relative en absolue, retire le fragment."""
+    url = url.strip()
+    if not url or url.startswith("#") or url.startswith("mailto:") or url.startswith("tel:") or url.startswith("javascript:"):
+        return None
+
+    full = urljoin(base, url)
+    parsed = urlparse(full)
+
+    if parsed.scheme not in ("http", "https"):
+        return None
+
+    # Retirer le fragment
+    defragged, _ = urldefrag(full)
+    return defragged
+
+
+def is_same_domain(url: str, base_domain: str) -> bool:
+    """Vérifie si une URL est sur le même domaine."""
+    return urlparse(url).netloc == base_domain
+
+
+def is_valid_page(url: str) -> bool:
+    """Vérifie si l'URL semble être une page HTML (pas un asset)."""
+    parsed = urlparse(url)
+    path = parsed.path.lower()
+    skip_extensions = (
+        ".jpg", ".jpeg", ".png", ".gif", ".svg", ".webp", ".ico",
+        ".css", ".js", ".woff", ".woff2", ".ttf", ".eot",
+        ".pdf", ".zip", ".tar", ".gz", ".mp3", ".mp4", ".avi",
+        ".xml", ".json", ".txt", ".rss",
+    )
+    return not any(path.endswith(ext) for ext in skip_extensions)
+
+
+class SitemapCrawler:
+    """Crawler async qui collecte les URLs d'un site pour un sitemap."""
+
+    def __init__(
+        self,
+        start_url: str,
+        max_depth: int = 3,
+        timeout: int = 10,
+        max_concurrency: int = 15,
+        include_lastmod: bool = True,
+        changefreq: str = "weekly",
