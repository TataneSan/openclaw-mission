+
+// Handler holds HTTP handlers for the cache API.
+type Handler struct {
+	cache *infrastructure.InMemoryCache
+}
+
+// NewHandler creates a new Handler with the given cache.
+func NewHandler(cache *infrastructure.InMemoryCache) *Handler {
+	return &Handler{cache: cache}
+}
+
+func writeJSON(w http.ResponseWriter, status int, v interface{}) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	json.NewEncoder(w).Encode(v)
+}
+
+func writeError(w http.ResponseWriter, status int, message string) {
+	writeJSON(w, status, map[string]string{"error": message})
+}
+
+// HandleHealth returns API health status.
+func (h *Handler) HandleHealth(w http.ResponseWriter, r *http.Request) {
+	writeJSON(w, http.StatusOK, map[string]string{"status": "ok"})
+}
+
+// HandleSet adds or updates a cache entry.
+// PUT /cache/:key with JSON body or query params
+func (h *Handler) HandleSet(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPut && r.Method != http.MethodPost {
+		writeError(w, http.StatusMethodNotAllowed, "method not allowed")
+		return
+	}
+
+	key := extractKey(r)
+	if key == "" {
+		writeError(w, http.StatusBadRequest, "key is required")
+		return
+	}
+
+	var value interface{}
+	var ttlSeconds int
+
+	// Try JSON body first.
+	if r.Header.Get("Content-Type") == "application/json" && r.Body != nil {
+		var req struct {
+			Value interface{} `json:"value"`
+			TTL   int         `json:"ttl_seconds"`
+		}
+		if err := json.NewDecoder(r.Body).Decode(&req); err == nil {
+			value = req.Value
+			ttlSeconds = req.TTL
+		}
+	}
+
+	// Override with query params if present.
+	if v := r.URL.Query().Get("value"); v != "" {
+		value = parseValue(v)
+	}
+	if t := r.URL.Query().Get("ttl"); t != "" {
+		if parsed, err := strconv.Atoi(t); err == nil && parsed > 0 {
+			ttlSeconds = parsed
+		}
+	}
+
