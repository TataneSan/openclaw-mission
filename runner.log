+"""Duplicate file finder core logic."""
+
+import hashlib
+import os
+from collections import defaultdict
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Iterable, List, Optional, Set
+
+
+BUFFER_SIZE = 65536  # 64KB
+
+
+@dataclass
+class DuplicateGroup:
+    """A group of files that are duplicates of each other."""
+
+    hash: str
+    size: int
+    files: List[str]
+
+    @property
+    def wasted_space(self) -> int:
+        """Total wasted space (all but one copy)."""
+        return self.size * (len(self.files) - 1)
+
+
+def get_file_hash(filepath: str, algorithm: str = "sha256") -> Optional[str]:
+    """Compute hash of a file."""
+    h = hashlib.new(algorithm)
+    try:
+        with open(filepath, "rb") as f:
+            while True:
+                buf = f.read(BUFFER_SIZE)
+                if not buf:
+                    break
+                h.update(buf)
+        return h.hexdigest()
+    except (PermissionError, OSError):
+        return None
+
+
+def find_duplicates(
+    paths: Iterable[str],
+    algorithm: str = "sha256",
+    min_size: int = 1,
+    follow_symlinks: bool = False,
+    exclude_dirs: Optional[Set[str]] = None,
+) -> List[DuplicateGroup]:
+    """Find duplicate files in the given paths.
+
+    Uses a two-pass approach:
+    1. Group files by size (quick filter)
+    2. Hash only files that share a size with at least one other file
+    """
+    exclude = exclude_dirs or set()
+
+    # Pass 1: group by size
+    size_groups: defaultdict[int, List[str]] = defaultdict(list)
+
+    for path_str in paths:
+        root = Path(path_str)
+        if not root.exists():
+            continue
+
+        file_iter = root.rglob("*") if root.is_dir() else [root]
+
+        for entry in file_iter:
+            try:
+                if entry.is_dir():
+                    continue
+                if not follow_symlinks and entry.is_symlink():
+                    continue
+                # Check if any parent dir is excluded
+                parts = entry.relative_to(root).parts
+                if any(p in exclude for p in parts[:-1]):
+                    continue
+                stat = entry.stat(follow_symlinks=follow_symlinks)
