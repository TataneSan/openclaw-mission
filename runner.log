+// process-tree displays a tree view of running processes in the terminal.
+// It reads from /proc on Linux and shows parent-child relationships
+// with ASCII tree drawing characters.
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+type Process struct {
+	PID      int
+	PPID     int
+	Name     string
+	User     string
+	CPU      float64
+	Memory   float64
+	State    string
+	Children []*Process
+}
+
+func main() {
+	filterUser := ""
+	showAll := false
+
+	for _, arg := range os.Args[1:] {
+		switch arg {
+		case "-a", "--all":
+			showAll = true
+		case "-h", "--help":
+			printUsage()
+			os.Exit(0)
+		default:
+			if strings.HasPrefix(arg, "-u=") {
+				filterUser = strings.TrimPrefix(arg, "-u=")
+			}
+		}
+	}
+
+	processes := readProcesses()
+	if len(processes) == 0 {
+		fmt.Fprintln(os.Stderr, "error: could not read process information")
+		os.Exit(1)
+	}
+
+	// Build tree
+	root := buildTree(processes, filterUser)
+
+	// Print header
+	fmt.Printf("%-8s %-10s %-6s %-6s %s\n", "PID", "USER", "CPU%", "MEM%", "COMMAND")
+	fmt.Println(strings.Repeat("-", 72))
+
+	// Print tree
+	for _, proc := range root {
+		printTree(proc, "", showAll)
+	}
+}
+
+func printUsage() {
+	fmt.Println("process-tree - Display process tree in terminal")
+	fmt.Println()
+	fmt.Println("Usage:")
+	fmt.Println("  process-tree [OPTIONS]")
