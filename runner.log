+
+// Color codes
+const (
+	reset   = "\033[0m"
+	bold    = "\033[1m"
+	cyan    = "\033[36m"
+	yellow  = "\033[33m"
+	red     = "\033[31m"
+	green   = "\033[32m"
+	gray    = "\033[90m"
+	white   = "\033[37m"
+	bgGreen = "\033[42m"
+	bgBlack = "\033[40m"
+)
+
+type Calendar struct {
+	Year  int
+	Month time.Month
+}
+
+func (c Calendar) DaysInMonth() int {
+	// Days in month calculation
+	month := int(c.Month)
+	if month == 0 {
+		month = 12
+	}
+	if month == 2 {
+		if c.isLeap() {
+			return 29
+		}
+		return 28
+	}
+	if month == 4 || month == 6 || month == 9 || month == 11 {
+		return 30
+	}
+	return 31
+}
+
+func (c Calendar) isLeap() bool {
+	return c.Year%4 == 0 && (c.Year%100 != 0 || c.Year%400 == 0)
+}
+
+func (c Calendar) FirstDayOfWeek() int {
+	// Returns 0=Monday, 6=Sunday
+	t := time.Date(c.Year, c.Month, 1, 0, 0, 0, 0, time.UTC)
+	dow := t.Weekday()
+	// Convert Sunday=0 to Monday=0
+	if dow == 0 {
+		return 6
+	}
+	return int(dow) - 1
+}
+
+func (c Calendar) Title() string {
+	return fmt.Sprintf("%s %d", monthNames[c.Month-1], c.Year)
+}
+
