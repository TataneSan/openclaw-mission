+package main
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+func main() {
+	if len(os.Args) < 3 {
+		fmt.Fprintf(os.Stderr, "Usage: glob-match <pattern> <path> [path...]\n")
+		fmt.Fprintf(os.Stderr, "\nTest if file paths match a glob pattern.\n")
+		fmt.Fprintf(os.Stderr, "\nReads paths from stdin if none provided as arguments.\n")
+		fmt.Fprintf(os.Stderr, "\nExamples:\n")
+		fmt.Fprintf(os.Stderr, "  glob-match '*.go' main.go test.go\n")
+		fmt.Fprintf(os.Stderr, "  glob-match 'src/**/*_test.go' src/pkg/handler_test.go\n")
+		fmt.Fprintf(os.Stderr, "  echo -e 'a.go\\nb.txt' | glob-match '*.go'\n")
+		fmt.Fprintf(os.Stderr, "\nPatterns support:\n")
+		fmt.Fprintf(os.Stderr, "  *       matches any sequence of non-separator characters\n")
+		fmt.Fprintf(os.Stderr, "  **      matches any sequence of characters including separators\n")
+		fmt.Fprintf(os.Stderr, "  ?       matches any single non-separator character\n")
+		fmt.Fprintf(os.Stderr, "  [abc]   matches any character in the set\n")
+		fmt.Fprintf(os.Stderr, "  [!abc]  matches any character not in the set\n")
+		os.Exit(1)
+	}
+
+	pattern := os.Args[1]
+	paths := os.Args[2:]
+
+	// Read from stdin if no paths provided
+	if len(paths) == 0 {
+		scanner := bufio.NewScanner(os.Stdin)
+		for scanner.Scan() {
+			line := strings.TrimSpace(scanner.Text())
+			if line == "" {
+				continue
+			}
+			paths = append(paths, line)
+		}
+		if err := scanner.Err(); err != nil {
+			fmt.Fprintf(os.Stderr, "Error reading stdin: %v\n", err)
+			os.Exit(2)
+		}
+	}
+
+	anyMatch := false
+	anyNoMatch := false
+
+	for _, path := range paths {
+		matched, err := matchGlob(pattern, path)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "Error matching '%s': %v\n", path, err)
+			os.Exit(2)
+		}
+		if matched {
+			fmt.Printf("  MATCH   %s\n", path)
+			anyMatch = true
+		} else {
+			fmt.Printf("no match  %s\n", path)
+			anyNoMatch = true
+		}
+	}
+
+	if anyMatch && anyNoMatch {
+		os.Exit(1)
+	}
+	if !anyMatch {
+		os.Exit(1)
+	}
+}
+
