+package infrastructure
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/TataneSan/redirect-api/internal/domain"
+)
+
+type Store struct {
+	mu        sync.RWMutex
+	redirects map[string]*domain.Redirect
+	stats     map[string]*domain.RedirectStats
+	hits      map[string][]*domain.HitRecord
+}
+
+func NewStore() *Store {
+	return &Store{
+		redirects: make(map[string]*domain.Redirect),
+		stats:     make(map[string]*domain.RedirectStats),
+		hits:      make(map[string][]*domain.HitRecord),
+	}
+}
+
+func generateID() string {
+	b := make([]byte, 8)
+	rand.Read(b)
+	return hex.EncodeToString(b)
+}
+
+func (s *Store) CreateRedirect(r *domain.Redirect) *domain.Redirect {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	now := time.Now().UTC()
+	r.ID = generateID()
+	r.CreatedAt = now
+	r.UpdatedAt = now
+	if r.StatusCode == 0 {
+		r.StatusCode = 302
+	}
+	r.Enabled = true
+
+	s.redirects[r.ID] = r
+	s.stats[r.ID] = &domain.RedirectStats{
+		RedirectID: r.ID,
+		TotalHits:  0,
+	}
+	s.hits[r.ID] = []*domain.HitRecord{}
+
+	return r
+}
+
+func (s *Store) GetRedirect(id string) (*domain.Redirect, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	r, ok := s.redirects[id]
+	if !ok {
+		return nil, fmt.Errorf("redirect not found: %s", id)
+	}
+	return r, nil
+}
+
+func (s *Store) ListRedirects() []*domain.Redirect {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	result := make([]*domain.Redirect, 0, len(s.redirects))
+	for _, r := range s.redirects {
+		result = append(result, r)
+	}
+	return result
+}
+
