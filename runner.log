+package domain
+
+import "time"
+
+type ProcessState string
+
+const (
+	Running    ProcessState = "R"
+	Sleeping   ProcessState = "S"
+	DiskSleep  ProcessState = "D"
+	Stopped    ProcessState = "T"
+	Zombie     ProcessState = "Z"
+	Idle       ProcessState = "I"
+	Dead       ProcessState = "X"
+	TraceStop  ProcessState = "t"
+	DeadTask   ProcessState = "x"
+	WakeKilled ProcessState = "K"
+	Parking    ProcessState = "P"
+)
+
+func (s ProcessState) String() string {
+	names := map[ProcessState]string{
+		Running:    "running",
+		Sleeping:   "sleeping",
+		DiskSleep:  "disk sleep",
+		Stopped:    "stopped",
+		Zombie:     "zombie",
+		Idle:       "idle",
+		Dead:       "dead",
+		TraceStop:  "trace stop",
+		DeadTask:   "dead task",
+		WakeKilled: "wake killed",
+		Parking:    "parking",
+	}
+	if n, ok := names[s]; ok {
+		return n
+	}
+	return string(s)
+}
+
+type Process struct {
+	PID     int
+	PPID    int
+	Name    string
+	User    string
+	State   ProcessState
+	CPU     float64
+	Memory  float64 // MB
+	Threads int
+	StartTime time.Time
+	Args    string
+	Children []*Process
+}
+
+func (p *Process) Depth() int {
+	if p.PPID == 0 {
+		return 0
+	}
+	return 1
+}
