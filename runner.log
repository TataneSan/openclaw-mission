+// timestamp-api returns the current timestamp in various formats.
+//
+// Endpoints:
+//   GET /                          - JSON with all timestamp formats
+//   GET /unix                      - Unix epoch seconds (int)
+//   GET /unix-millis               - Unix epoch milliseconds (int)
+//   GET /unix-nano                 - Unix epoch nanoseconds (int)
+//   GET /iso                       - ISO 8601 formatted date-time
+//   GET /rfc3339                   - RFC 3339 formatted date-time
+//   GET /date                      - Human-readable date
+//   GET /time                      - Human-readable time
+//   GET /datetime                  - Human-readable date and time
+//   GET /convert?unix=1234567890   - Convert Unix timestamp to formatted output
+//   GET /now                       - Alias for /
+//   GET /health                    - Health check
+package main
+
+import (
+	"encoding/json"
+	"flag"
+	"fmt"
+	"log"
+	"net/http"
+	"os"
+	"os/signal"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+)
+
+type config struct {
+	port int
+	host string
+}
+
+func parseConfig() config {
+	cfg := config{}
+	flag.IntVar(&cfg.port, "port", 8080, "port to listen on")
+	flag.StringVar(&cfg.host, "host", "127.0.0.1", "host to bind to")
+	flag.Parse()
+	return cfg
+}
+
+type timestampResponse struct {
+	Unix       int64  `json:"unix"`
+	UnixMillis int64  `json:"unix_millis"`
+	UnixNano   int64  `json:"unix_nano"`
+	ISO8601    string `json:"iso8601"`
+	RFC3339    string `json:"rfc3339"`
+	Date       string `json:"date"`
+	Time       string `json:"time"`
+	Datetime   string `json:"datetime"`
+	Timezone   string `json:"timezone"`
+	DayOfWeek  string `json:"day_of_week"`
+	WeekYear   int    `json:"week_year"`
+	WeekNum    int    `json:"week_number"`
+}
+
+func getTimestamp() timestampResponse {
+	now := time.Now()
+	iso := now.UTC().Format(time.RFC3339)
+	rfc3339 := now.Format(time.RFC3339)
+	_, offset := now.Zone()
+	tz := fmt.Sprintf("UTC%s%d:%02d",
+		sign(offset), offset/3600, abs(offset%3600))
+	weekYear, weekNum := now.ISOWeek()
+
+	return timestampResponse{
+		Unix:       now.Unix(),
+		UnixMillis: now.UnixMilli(),
+		UnixNano:   now.UnixNano(),
+		ISO8601:    iso,
+		RFC3339:    rfc3339,
+		Date:       now.Format("2006-01-02"),
+		Time:       now.Format("15:04:05"),
+		Datetime:   now.Format("2006-01-02 15:04:05"),
+		Timezone:   tz,
