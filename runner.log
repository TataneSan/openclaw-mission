+package application
+
+import (
+	"encoding/json"
+	"net/http"
+	"strconv"
+
+	"github.com/TataneSan/log-api/internal/domain"
+)
+
+type Handler struct {
+	logger *domain.Logger
+}
+
+func NewHandler(logger *domain.Logger) *Handler {
+	return &Handler{logger: logger}
+}
+
+func (h *Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	switch {
+	case r.Method == http.MethodPost && r.URL.Path == "/api/logs":
+		h.addLog(w, r)
+	case r.Method == http.MethodGet && r.URL.Path == "/api/logs":
+		h.getLogs(w, r)
+	case r.Method == http.MethodGet && r.URL.Path == "/api/logs/stats":
+		h.getStats(w, r)
+	case r.Method == http.MethodDelete && r.URL.Path == "/api/logs":
+		h.purgeOld(w, r)
+	case r.Method == http.MethodGet && r.URL.Path == "/api/health":
+		h.health(w, r)
+	default:
+		http.NotFound(w, r)
+	}
+}
+
+func (h *Handler) addLog(w http.ResponseWriter, r *http.Request) {
+	var req domain.AddLogRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		http.Error(w, "invalid request body", http.StatusBadRequest)
+		return
+	}
+
+	entry, err := h.logger.AddEntry(r.Context(), &req)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusCreated)
+	json.NewEncoder(w).Encode(entry)
+}
+
+func (h *Handler) getLogs(w http.ResponseWriter, r *http.Request) {
+	q := r.URL.Query()
+	level := q.Get("level")
+	source := q.Get("source")
+	limit, _ := strconv.Atoi(q.Get("limit"))
+	offset, _ := strconv.Atoi(q.Get("offset"))
+
+	entries, err := h.logger.GetEntries(r.Context(), level, source, limit, offset)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	json.NewEncoder(w).Encode(entries)
+}
+
+func (h *Handler) getStats(w http.ResponseWriter, r *http.Request) {
+	stats, err := h.logger.GetStats(r.Context())
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+
+	w.Header().Set("Content-Type", "application/json")
