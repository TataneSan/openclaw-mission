+#!/usr/bin/env node
+const { execSync } = require('child_process');
+
+const COLORS = {
+  reset: '\x1b[0m',
+  bold: '\x1b[1m',
+  dim: '\x1b[2m',
+  red: '\x1b[31m',
+  green: '\x1b[32m',
+  yellow: '\x1b[33m',
+  blue: '\x1b[34m',
+  cyan: '\x1b[36m',
+  gray: '\x1b[90m',
+  white: '\x1b[37m'
+};
+
+function run(cmd) {
+  try {
+    return execSync(cmd, { encoding: 'utf-8' }).trim();
+  } catch (err) {
+    return null;
+  }
+}
+
+function parseSize(bytes) {
+  if (!bytes || bytes === '0') return '0B';
+  const units = ['B', 'KB', 'MB', 'GB', 'TB'];
+  const i = Math.floor(Math.log(parseInt(bytes)) / Math.log(1024));
+  return (parseInt(bytes) / Math.pow(1024, i)).toFixed(1) + units[i];
+}
+
+function getStatusColor(status) {
+  if (status.includes('Up')) return COLORS.green;
+  if (status.includes('Exited')) return COLORS.red;
+  if (status.includes('Created')) return COLORS.gray;
+  if (status.includes('Restarting')) return COLORS.yellow;
+  return COLORS.white;
+}
+
+function truncate(str, max = 20) {
+  if (!str) return '';
+  return str.length > max ? str.slice(0, max - 3) + '...' : str;
+}
+
+function getContainers(all) {
+  const flag = all ? '-a' : '';
+  const output = run(`docker ps ${flag} --format '{{.ID}}\t{{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}\t{{.Size}}'`);
+  if (!output) return [];
+
+  return output.split('\n').filter(Boolean).map(line => {
+    const parts = line.split('\t');
+    return {
+      id: parts[0] || '',
+      name: parts[1] || '',
+      image: parts[2] || '',
+      status: parts[3] || '',
+      ports: parts[4] || '',
+      size: parts[5] || ''
+    };
+  });
+}
+
+function getDiskUsage(containerId) {
+  const output = run(`docker system df -v 2>/dev/null`);
+  if (!output) return null;
+
+  const lines = output.split('\n');
+  let inContainer = false;
+  let containerLines = [];
+
+  for (const line of lines) {
+    if (line.includes('Containers')) inContainer = true;
+    if (inContainer && line.includes(containerId.slice(0, 12))) {
+      containerLines.push(line);
+    }
+    if (inContainer && line.trim() === '') break;
+  }
+
