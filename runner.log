+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"regexp"
+	"strings"
+)
+
+type Container struct {
+	ID    string `json:"Id"`
+	Names []string `json:"Names"`
+}
+
+func runDocker(args ...string) (string, error) {
+	cmd := exec.Command("docker", args...)
+	output, err := cmd.CombinedOutput()
+	return strings.TrimSpace(string(output)), err
+}
+
+func listContainers(all bool) ([]Container, error) {
+	args := []string{"ps", "-q", "--no-trunc"}
+	if all {
+		args = append(args, "-a")
+	}
+	idOutput, err := runDocker(args...)
+	if err != nil {
+		return nil, err
+	}
+
+	var containers []Container
+	for _, id := range strings.Split(strings.TrimSpace(idOutput), "\n") {
+		if id = strings.TrimSpace(id); id == "" {
+			continue
+		}
+		nameOutput, err := runDocker("inspect", "-f", "{{.Name}}", id)
+		if err != nil {
+			continue
+		}
+		name := strings.TrimPrefix(nameOutput, "/")
+		containers = append(containers, Container{ID: id[:12], Names: []string{name}})
+	}
+	return containers, nil
+}
+
+func renameContainer(oldName, newName string) error {
+	_, err := runDocker("rename", oldName, newName)
+	return err
+}
+
+func isRunning(name string) (bool, error) {
+	output, err := runDocker("inspect", "-f", "{{.State.Running}}", name)
+	if err != nil {
+		return false, err
+	}
+	return output == "true", nil
+}
