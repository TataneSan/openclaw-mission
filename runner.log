+"""CLI interface for color-palette."""
+
+import sys
+import click
+
+from color_palette.extractor import extract_palette
+from color_palette.display import (
+    display_terminal,
+    display_json,
+    display_css_vars,
+    display_scss,
+    display_tailwind,
+)
+
+
+@click.command()
+@click.argument("url")
+@click.option(
+    "-f", "--format",
+    type=click.Choice(["terminal", "json", "css", "scss", "tailwind"]),
+    default="terminal",
+    help="Output format.",
+)
+@click.option(
+    "-n", "--max-colors",
+    type=int,
+    default=20,
+    help="Maximum colors to display.",
+)
+@click.option(
+    "--no-images",
+    is_flag=True,
+    help="Skip image color extraction.",
+)
+@click.option(
+    "--threshold",
+    type=float,
+    default=20.0,
+    help="Color similarity threshold for deduplication (0-255).",
+)
+@click.version_option(version="1.0.0", prog_name="color-palette")
+def main(url: str, format: str, max_colors: int, no_images: bool, threshold: float):
+    """Extract a color palette from any URL.
+
+    Fetches the page, parses CSS and inline styles, extracts all colors,
+    and displays a beautiful palette in your terminal.
+
+    \b
+    Examples:
+      color-palette https://github.com
+      color-palette https://stripe.com -f json
+      color-palette https://tailwindcss.com -f css
+      color-palette https://vercel.com --no-images -n 10
+    """
+    # Ensure URL has scheme
+    if not url.startswith(("http://", "https://")):
+        url = "https://" + url
+
+    try:
+        with click.progressbar(
+            length=1, label="Fetching palette", show_eta=False
+        ) as bar:
+            result = extract_palette(url, include_images=not no_images)
+            bar.update(1)
+    except Exception as e:
+        click.echo(f"Error: {e}", err=True)
+        sys.exit(1)
+
+    # Apply threshold to dedup if changed
+    if threshold != 20.0:
+        from color_palette.extractor import deduplicate_colors
+        result["colors"] = deduplicate_colors(result["colors"], threshold)
+        result["unique"] = len(result["colors"])
+
+    # Limit colors
+    result["colors"] = result["colors"][:max_colors]
+
