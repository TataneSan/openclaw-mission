+// git-submodule-list lists and displays information about Git submodules.
+//
+// It reads .gitmodules and the Git internal submodule data to show
+// path, URL, commit SHA, and branch for each submodule.
+//
+// Usage:
+//
+//	git-submodule-list [options] [directory]
+//
+// Options:
+//   -json   Output in JSON format
+//   -url    Show only URLs (one per line)
+//   -path   Show only paths (one per line)
+//   -h      Show help
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+)
+
+// Submodule holds info about one submodule.
+type Submodule struct {
+	Name string `json:"name"`
+	Path string `json:"path"`
+	URL  string `json:"url"`
+	Sha  string `json:"sha,omitempty"`
+}
+
+func parseGitmodules(repoDir string) ([]Submodule, error) {
+	path := filepath.Join(repoDir, ".gitmodules")
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+
+	var submodules []Submodule
+	var current string
+	scanner := bufio.NewScanner(f)
+
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+
+		if strings.HasPrefix(line, "[submodule ") {
+			// Extract name: [submodule "name"]
+			start := strings.Index(line, "\"")
+			end := strings.LastIndex(line, "\"")
+			if start >= 0 && end > start {
+				current = line[start+1 : end]
+			}
+			continue
+		}
+
+		if strings.HasPrefix(line, "path =") {
+			p := strings.TrimSpace(line[len("path ="):])
+			sm := Submodule{Name: current, Path: p}
+			submodules = append(submodules, sm)
+			continue
+		}
+
+		if strings.HasPrefix(line, "url =") {
+			url := strings.TrimSpace(line[len("url ="):])
+			if len(submodules) > 0 {
+				submodules[len(submodules)-1].URL = url
+			}
+		}
+	}
+
+	return submodules, scanner.Err()
+}
+
