+#!/usr/bin/env python3
+"""todo-cli — Task manager in the terminal with SQLite persistence."""
+
+import argparse
+import os
+import sqlite3
+import sys
+from datetime import datetime, date
+from pathlib import Path
+
+DB_PATH = os.environ.get("TODO_DB", str(Path.home() / ".todo" / "tasks.db"))
+
+# ANSI
+RED = "\033[91m"
+GREEN = "\033[92m"
+YELLOW = "\033[93m"
+CYAN = "\033[96m"
+MAGENTA = "\033[95m"
+BOLD = "\033[1m"
+DIM = "\033[2m"
+STRIKE = "\033[9m"
+RESET = "\033[0m"
+
+PRIORITY_COLORS = {"high": RED, "medium": YELLOW, "low": CYAN}
+PRIORITY_SYMBOLS = {"high": "🔴", "medium": "🟡", "low": "🔵"}
+
+
+def init_db():
+    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
+    conn = sqlite3.connect(DB_PATH)
+    conn.row_factory = sqlite3.Row
+    conn.execute("PRAGMA journal_mode=WAL")
+    conn.execute("""
+        CREATE TABLE IF NOT EXISTS tasks (
+            id INTEGER PRIMARY KEY AUTOINCREMENT,
+            title TEXT NOT NULL,
+            priority TEXT DEFAULT 'medium',
+            tags TEXT DEFAULT '',
+            due_date TEXT,
+            done INTEGER DEFAULT 0,
+            created_at TEXT NOT NULL,
+            completed_at TEXT
+        )
+    """)
+    conn.commit()
+    return conn
+
+
+def cmd_add(conn, args):
+    now = datetime.now().isoformat()
+    tags = ",".join(args.tags) if args.tags else ""
+    due = args.due.isoformat() if args.due else None
+
+    cur = conn.execute(
+        "INSERT INTO tasks (title, priority, tags, due_date, created_at) VALUES (?, ?, ?, ?, ?)",
+        (args.title, args.priority, tags, due, now),
+    )
+    conn.commit()
+    task_id = cur.lastrowid
+    sym = PRIORITY_SYMBOLS[args.priority]
+    print(f"{GREEN}✓{RESET} Tâche #{task_id} ajoutée {sym} {args.title}")
+
+
+def cmd_list(conn, args):
+    query = "SELECT * FROM tasks WHERE 1=1"
+    params = []
+
+    if args.filter == "todo":
+        query += " AND done = 0"
+    elif args.filter == "done":
+        query += " AND done = 1"
+
+    if args.tag:
+        query += " AND tags LIKE ?"
+        params.append(f"%{args.tag}%")
+
+    if args.priority:
+        query += " AND priority = ?"
