+const http = require('http');
+const url = require('url');
+const crypto = require('crypto');
+
+// ─── Cron Parser ──────────────────────────────────────────────────────────────
+
+function parseField(field, min, max) {
+  const values = new Set();
+
+  for (const part of field.split(',')) {
+    const [expr, step] = part.split('/');
+
+    let start = min;
+    let end = max;
+
+    if (expr === '*') {
+      // wildcard
+    } else if (expr.includes('-')) {
+      const [a, b] = expr.split('-').map(Number);
+      start = a;
+      end = b;
+    } else {
+      start = Number(expr);
+      end = Number(expr);
+    }
+
+    const increment = step ? Number(step) : 1;
+
+    for (let i = start; i <= end; i += increment) {
+      if (i >= min && i <= max) values.add(i);
+    }
+  }
+
+  return [...values].sort((a, b) => a - b);
+}
+
+function parseCron(expr) {
+  const parts = expr.trim().split(/\s+/);
+  if (parts.length !== 5) return null;
+
+  const [minute, hour, dom, month, dow] = parts;
+
+  return {
+    minutes: parseField(minute, 0, 59),
+    hours: parseField(hour, 0, 23),
+    daysOfMonth: parseField(dom, 1, 31),
+    months: parseField(month, 1, 12),
+    daysOfWeek: parseField(dow, 0, 6)
+  };
+}
+
+function matches(now, parsed) {
+  if (!parsed) return false;
+  const d = now;
+  return parsed.minutes.includes(d.getMinutes())
+    && parsed.hours.includes(d.getHours())
+    && parsed.daysOfMonth.includes(d.getDate())
+    && parsed.months.includes(d.getMonth() + 1)
+    && parsed.daysOfWeek.includes(d.getDay());
+}
+
+// ─── Task Store ───────────────────────────────────────────────────────────────
+
+const tasks = new Map();
+let nextId = 1;
+
+function createTask(name, schedule, command, options = {}) {
+  const parsed = parseCron(schedule);
+  if (!parsed) return { error: 'Invalid cron expression' };
+
+  const id = String(nextId++);
+  const task = {
+    id,
+    name: name || `task-${id}`,
+    schedule,
+    command,
+    enabled: options.enabled !== false,
+    parsed,
