+package main
+
+import (
+	"bufio"
+	"encoding/hex"
+	"flag"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"strings"
+)
+
+var version = "1.0.0"
+
+func printUsage() {
+	fmt.Fprintf(os.Stderr, `ncat-lite v%s - A lightweight TCP client and server
+
+Usage:
+  ncat-lite [options] <host> <port>    Connect to a TCP server
+  ncat-lite -l [options] <port>        Listen for incoming connections
+
+Options:
+  -l              Listen mode (start a TCP server)
+  -p <port>       Port to listen on (listen mode only)
+  -s <address>    Address to bind to (default: 0.0.0.0)
+  -c <count>      Close after N connections (listen mode)
+  -t <seconds>    Timeout in seconds (0 = no timeout)
+  -x              Hex dump mode (show hex + ASCII)
+  -q              Quiet mode (suppress status messages)
+  -v              Verbose mode
+  -V              Show version
+
+Examples:
+  ncat-lite example.com 80              Connect to example.com:80
+  ncat-lite -l 8080                     Listen on port 8080
+  ncat-lite -l -c 5 8080               Listen, accept 5 connections then exit
+  ncat-lite -x localhost 8080          Connect with hex dump output
+  echo "GET / HTTP/1.0\r\n\r\n" | ncat-lite example.com 80
+
+`, version)
+}
+
+func hexDump(data []byte) {
+	const bytesPerLine = 16
+	for i := 0; i < len(data); i += bytesPerLine {
+		end := i + bytesPerLine
+		if end > len(data) {
+			end = len(data)
+		}
+		chunk := data[i:end]
+
+		hexParts := make([]string, len(chunk))
+		ascii := make([]byte, len(chunk))
+		for j, b := range chunk {
+			hexParts[j] = fmt.Sprintf("%02x", b)
+			if b >= 32 && b <= 126 {
+				ascii[j] = b
+			} else {
+				ascii[j] = '.'
+			}
+		}
+
+		offset := i / bytesPerLine
+		fmt.Printf("%04x  %-48s  %s\n", offset, strings.Join(hexParts, " "), string(ascii))
+	}
+}
+
+func handleConnection(conn net.Conn, hexMode, quiet, verbose bool) {
+	addr := conn.RemoteAddr().String()
+	if !quiet && verbose {
+		fmt.Fprintf(os.Stderr, "[+] Connection from %s\n", addr)
