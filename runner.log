+package infrastructure
+
+import (
+	"context"
+	"fmt"
+	"sync"
+
+	"github.com/TataneSan/ping-api/internal/domain"
+)
+
+type InMemoryTargetRepository struct {
+	mu      sync.RWMutex
+	targets map[string]*domain.PingTarget
+}
+
+func NewInMemoryTargetRepository() *InMemoryTargetRepository {
+	return &InMemoryTargetRepository{
+		targets: make(map[string]*domain.PingTarget),
+	}
+}
+
+func (r *InMemoryTargetRepository) Save(_ context.Context, target *domain.PingTarget) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.targets[target.ID] = target
+	return nil
+}
+
+func (r *InMemoryTargetRepository) FindAll(_ context.Context) ([]domain.PingTarget, error) {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+	result := make([]domain.PingTarget, 0, len(r.targets))
+	for _, t := range r.targets {
+		result = append(result, *t)
+	}
+	return result, nil
+}
+
+func (r *InMemoryTargetRepository) FindByID(_ context.Context, id string) (*domain.PingTarget, error) {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+	t, ok := r.targets[id]
+	if !ok {
+		return nil, fmt.Errorf("target not found: %s", id)
+	}
+	return t, nil
+}
+
+func (r *InMemoryTargetRepository) Delete(_ context.Context, id string) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if _, ok := r.targets[id]; !ok {
+		return fmt.Errorf("target not found: %s", id)
+	}
+	delete(r.targets, id)
+	return nil
+}
