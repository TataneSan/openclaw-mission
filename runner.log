+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+)
+
+type Bookmark struct {
+	Name   string `json:"name"`
+	URL    string `json:"url"`
+	Tag    string `json:"tag"`
+	Notes  string `json:"notes"`
+}
+
+type Bookmarks struct {
+	Items []Bookmark `json:"bookmarks"`
+}
+
+var bookmarksFile string
+
+func init() {
+	home, err := os.UserHomeDir()
+	if err != nil {
+		home = "."
+	}
+	bookmarksFile = filepath.Join(home, ".cli-bookmarks.json")
+}
+
+func loadBookmarks() (*Bookmarks, error) {
+	data, err := os.ReadFile(bookmarksFile)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return &Bookmarks{}, nil
+		}
+		return nil, err
+	}
+	var b Bookmarks
+	if err := json.Unmarshal(data, &b); err != nil {
+		return nil, err
+	}
+	return &b, nil
+}
+
+func saveBookmarks(b *Bookmarks) error {
+	data, err := json.MarshalIndent(b, "", "  ")
+	if err != nil {
+		return err
+	}
+	return os.WriteFile(bookmarksFile, data, 0644)
+}
+
+func printHeader(title string) {
+	fmt.Println()
+	fmt.Println(strings.Repeat("=", 60))
+	fmt.Printf("  %s\n", title)
+	fmt.Println(strings.Repeat("=", 60))
+}
+
+func main() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	switch os.Args[1] {
+	case "add":
+		if len(os.Args) < 4 {
+			fmt.Fprintf(os.Stderr, "Error: add requires <name> <url> [--tag TAG] [--notes NOTES]\n")
+			printUsage()
+			os.Exit(1)
+		}
+		cmdAdd(os.Args[2], os.Args[3], os.Args[4:])
+	case "list":
+		cmdList(os.Args[2:])
