+"""JSON path navigation engine."""
+
+from typing import Any, Optional
+
+
+def resolve_path(data: Any, path: str) -> Any:
+    """Resolve a dot-notation path against JSON data.
+
+    Supports:
+        - Dot notation:  data.user.name
+        - Array indexing: data.users[0].name
+        - Wildcard:       data.users[*].name  (returns list of results)
+        - Nested:         data["key.with.dots"]
+    """
+    if not path or path == ".":
+        return data
+
+    tokens = _tokenize_path(path)
+    current = data
+
+    for token in tokens:
+        current = _apply_token(current, token)
+        if current is None:
+            return None
+
+    return current
+
+
+def _tokenize_path(path: str) -> list:
+    """Split a path into tokens.
+
+    Examples:
+        "users[0].name" -> ["users", "[0]", "name"]
+        "data.items[*].id" -> ["data", "items", "[*]", "id"]
+    """
+    tokens = []
+    current = ""
+    i = 0
+
+    while i < len(path):
+        ch = path[i]
+
+        if ch == ".":
+            if current:
+                tokens.append(current)
+                current = ""
+        elif ch == "[":
+            if current:
+                tokens.append(current)
+                current = ""
+            # Find matching ]
+            end = path.index("]", i)
+            tokens.append(path[i : end + 1])
+            i = end
+        else:
+            current += ch
+
+        i += 1
+
+    if current:
+        tokens.append(current)
+
+    return tokens
+
+
+def _apply_token(data: Any, token: str) -> Any:
+    """Apply a single path token to data."""
+    if data is None:
+        return None
+
+    # Array index: [0], [1], etc.
+    if token.startswith("[") and token.endswith("]"):
+        inner = token[1:-1].strip()
+
+        if inner == "*":
+            # Wildcard - return list
+            if isinstance(data, list):
+                return data
