+"""Advanced DNS resolution API."""
+
+from fastapi import FastAPI, HTTPException, Query
+from fastapi.middleware.cors import CORSMiddleware
+from pydantic import BaseModel
+import dns.resolver
+import dns.reversename
+import dns.exception
+from typing import Optional
+import socket
+
+app = FastAPI(
+    title="DNS API",
+    description="Advanced DNS resolution service",
+    version="1.0.0",
+)
+
+app.add_middleware(
+    CORSMiddleware,
+    allow_origins=["*"],
+    allow_methods=["*"],
+    allow_headers=["*"],
+)
+
+RECORD_TYPES = ["A", "AAAA", "CNAME", "MX", "NS", "TXT", "SOA", "SRV", "CAA", "PTR", "DNSKEY"]
+
+
+class DnsRecord(BaseModel):
+    type: str
+    ttl: int
+    value: str
+    priority: Optional[int] = None
+    extra: Optional[dict] = None
+
+
+class DnsResponse(BaseModel):
+    domain: str
+    records: list[DnsRecord]
+    nameserver: Optional[str] = None
+
+
+class MultiDnsResponse(BaseModel):
+    domain: str
+    results: dict[str, list[DnsRecord]]
+
+
+class DmarcResponse(BaseModel):
+    domain: str
+    raw: str
+    parsed: dict
+
+
+def resolve_records(domain: str, record_type: str, nameserver: Optional[str] = None) -> list[DnsRecord]:
+    """Resolve DNS records for a domain and type."""
+    resolver = dns.resolver.Resolver()
+    if nameserver:
+        resolver.nameservers = [nameserver]
+
+    records = []
+    try:
+        answers = resolver.resolve(domain, record_type)
+        for rdata in answers:
+            record = DnsRecord(
+                type=record_type,
+                ttl=answers.rrset.ttl,
+                value=str(rdata),
+            )
+
+            if record_type == "MX":
+                record.priority = rdata.preference
+                record.value = str(rdata.exchange).rstrip(".")
+            elif record_type == "SRV":
+                record.priority = rdata.priority
+                record.extra = {
+                    "weight": rdata.weight,
+                    "port": rdata.port,
+                    "target": str(rdata.target).rstrip("."),
+                }
