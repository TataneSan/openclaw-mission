+	return AuthConfig{
+		JWTSecret:       "change-this-secret-in-production",
+		JWTExpiry:       15 * time.Minute,
+		RefreshExpiry:   7 * 24 * time.Hour,
+		MaxRefreshTokens: 5,
+	}
+}
