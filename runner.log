+// idea-box: a CLI idea box with tags and voting
+// Usage: idea-box [command] [flags]
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+)
+
+// Idea represents a single idea
+type Idea struct {
+	ID          string   `json:"id"`
+	Title       string   `json:"title"`
+	Description string   `json:"description"`
+	Tags        []string `json:"tags,omitempty"`
+	Votes       int      `json:"votes"`
+	Created     string   `json:"created"`
+}
+
+// IdeaBox represents the collection of ideas
+type IdeaBox struct {
+	ID    string  `json:"id"`
+	Name  string  `json:"name"`
+	Ideas []Idea  `json:"ideas"`
+}
+
+const dataDir = ".idea-box"
+
+func getBoxPath() string {
+	home, err := os.UserHomeDir()
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "Error: cannot determine home directory\n")
+		os.Exit(1)
+	}
+	return filepath.Join(home, dataDir)
+}
+
+func getBoxFile(name string) string {
+	return filepath.Join(getBoxPath(), name+".json")
+}
+
+func loadBox(name string) (*IdeaBox, error) {
+	path := getBoxFile(name)
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("box '%s' not found. Create it with: idea-box create %s", name, name)
+	}
+	var box IdeaBox
+	if err := json.Unmarshal(data, &box); err != nil {
+		return nil, fmt.Errorf("failed to parse idea box: %w", err)
+	}
+	return &box, nil
+}
+
+func saveBox(box *IdeaBox) error {
+	path := getBoxFile(box.ID)
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		return fmt.Errorf("failed to create directory: %w", err)
+	}
+	data, err := json.MarshalIndent(box, "", "  ")
+	if err != nil {
+		return fmt.Errorf("failed to marshal idea box: %w", err)
+	}
+	return os.WriteFile(path, data, 0644)
+}
+
+func generateID() string {
+	return fmt.Sprintf("%d", time.Now().UnixNano()%1000000)
+}
