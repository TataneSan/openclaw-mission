+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"net"
+	"os"
+	"sort"
+	"strings"
+	"text/tabwriter"
+)
+
+// Connection represents a network connection
+type Connection struct {
+	Proto     string `json:"proto"`
+	LocalAddr string `json:"local_address"`
+	RemoteAddr string `json:"remote_address"`
+	State     string `json:"state"`
+	PID       string `json:"pid,omitempty"`
+}
+
+func getConnections(proto string, filterIP string) ([]Connection, error) {
+	var connections []Connection
+
+	protos := []string{"tcp", "udp"}
+	if proto != "" {
+		protos = []string{strings.ToLower(proto)}
+	}
+
+	for _, p := range protos {
+		addrs, err := net.InterfaceAddrs()
+		if err != nil {
+			return nil, fmt.Errorf("cannot get interface addresses: %w", err)
+		}
+
+		var localAddrs []net.Addr
+		if p == "tcp" {
+			conns, err := net.Interfaces()
+			if err != nil {
+				continue
+			}
+			for _, iface := range conns {
+				addrs, _ := iface.Addrs()
+				localAddrs = append(localAddrs, addrs...)
+			}
+		}
+
+		for _, addr := range localAddrs {
+			ipNet, ok := addr.(*net.IPNet)
+			if !ok {
+				continue
+			}
+			ip := ipNet.IP.String()
+
+			if filterIP != "" && ip != filterIP {
+				continue
+			}
+
+			conn := Connection{
+				Proto:     strings.ToUpper(p),
+				LocalAddr: ip,
+				State:     "LISTEN",
+			}
+			connections = append(connections, conn)
+		}
+
+		// Try to get active connections by checking /proc/net
+		if data, err := os.ReadFile("/proc/net/" + p); err == nil {
+			lines := strings.Split(string(data), "\n")
+			for i, line := range lines {
+				if i == 0 || i == 1 {
+					continue // Skip header lines
+				}
+				if line == "" {
+					continue
+				}
+
+				fields := strings.Fields(line)
