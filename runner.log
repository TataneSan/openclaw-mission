+package handler
+
+import (
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/TataneSan/ip-api/internal/geolocation"
+)
+
+// Handler serves IP information endpoints.
+type Handler struct {
+	geoClient  *geolocation.Client
+	startTime  time.Time
+}
+
+// New creates a new Handler.
+func New(geoClient *geolocation.Client) *Handler {
+	return &Handler{
+		geoClient: geoClient,
+		startTime: time.Now(),
+	}
+}
+
+// Register registers all routes on the given mux.
+func (h *Handler) Register(mux *http.ServeMux) {
+	mux.HandleFunc("/", h.handleRoot)
+	mux.HandleFunc("/json", h.handleJSON)
+	mux.HandleFunc("/text", h.handleText)
+	mux.HandleFunc("/csv", h.handleCSV)
+	mux.HandleFunc("/health", h.handleHealth)
+}
+
+func (h *Handler) handleRoot(w http.ResponseWriter, r *http.Request) {
+	format := r.URL.Query().Get("format")
+	if format == "" {
+		accept := r.Header.Get("Accept")
+		if strings.Contains(accept, "text/plain") {
+			format = "text"
+		} else if strings.Contains(accept, "text/csv") {
+			format = "csv"
+		} else {
+			format = "json"
+		}
+	}
+
+	switch format {
+	case "text":
+		h.handleText(w, r)
+	case "csv":
+		h.handleCSV(w, r)
+	default:
+		h.handleJSON(w, r)
+	}
+}
+
+func (h *Handler) handleJSON(w http.ResponseWriter, r *http.Request) {
+	info, err := h.getInfo(r)
+	if err != nil {
+		http.Error(w, fmt.Sprintf("error: %v", err), http.StatusInternalServerError)
+		return
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	encoder := json.NewEncoder(w)
+	encoder.SetIndent("", "  ")
+	encoder.Encode(info)
+}
+
+func (h *Handler) handleText(w http.ResponseWriter, r *http.Request) {
+	info, err := h.getInfo(r)
+	if err != nil {
+		http.Error(w, fmt.Sprintf("error: %v", err), http.StatusInternalServerError)
+		return
+	}
