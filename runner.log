+"""Terminal formatting and colorization for JSON output."""
+
+import json
+from typing import Any
+
+
+# ANSI color codes
+class Colors:
+    RESET = "\033[0m"
+    BOLD = "\033[1m"
+    DIM = "\033[2m"
+
+    # Foreground
+    RED = "\033[31m"
+    GREEN = "\033[32m"
+    YELLOW = "\033[33m"
+    BLUE = "\033[34m"
+    MAGENTA = "\033[35m"
+    CYAN = "\033[36m"
+    WHITE = "\033[37m"
+
+    # Background
+    BG_DARK = "\033[48;5;236m"
+
+
+def colorize_json(data: Any, indent: int = 2, no_color: bool = False) -> str:
+    """Format JSON with syntax highlighting."""
+    if no_color:
+        return json.dumps(data, indent=indent, ensure_ascii=False)
+
+    raw = json.dumps(data, indent=indent, ensure_ascii=False)
+    lines = raw.split("\n")
+    result = []
+
+    for line in lines:
+        colored = _colorize_line(line)
+        result.append(colored)
+
+    return "\n".join(result)
+
+
+def _colorize_line(line: str) -> str:
+    """Apply colors to a single JSON line."""
+    stripped = line.lstrip()
+    indent = line[: len(line) - len(stripped)]
+
+    if not stripped:
+        return line
+
+    # Key-value line: "key": value
+    if stripped.startswith('"') and '": ' in stripped:
+        key_end = stripped.index('": ') + 3
+        key_part = stripped[:key_end]
+        value_part = stripped[key_end:]
+
+        colored_key = f"{Colors.CYAN}{key_part}{Colors.RESET}"
+        colored_value = _colorize_value(value_part)
+        return f"{indent}{colored_key}{colored_value}"
+
+    # Array/object value (standalone)
+    return f"{indent}{_colorize_value(stripped)}"
+
+
+def _colorize_value(value: str) -> str:
+    """Colorize a JSON value."""
+    if value.startswith('"'):
+        return f"{Colors.GREEN}{value}{Colors.RESET}"
+    elif value in ("true", "false"):
+        return f"{Colors.YELLOW}{value}{Colors.RESET}"
+    elif value == "null":
+        return f"{Colors.DIM}{value}{Colors.RESET}"
+    elif value[0].isdigit() or value[0] == "-":
+        return f"{Colors.MAGENTA}{value}{Colors.RESET}"
+    return value
+
+
+def format_path_result(data: Any, path: str, no_color: bool = False) -> str:
+    """Format a path query result."""
