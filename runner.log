+	TotalBytes    int64
+	RequestsByIP  map[string]int
+	RequestsByPath map[string]int
+	RequestsByStatus map[int]int
+	RequestsByMethod map[string]int
+	TopIPs        []KV
+	TopPaths      []KV
+	StatusCodes   []KV
+}
+
+// KV is a key-value pair for sorted output.
