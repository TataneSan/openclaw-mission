+// FindUserIDByTokenHash searches all refresh tokens and returns the matching user ID.
+func (s *Store) FindUserIDByTokenHash(tokenHash []byte) (string, error) {
+	s.mu.RLock()
+	defer s.mu.RUnlock()
+
+	hashHex := hex.EncodeToString(tokenHash)
+	for _, rt := range s.refreshTokens {
+		if rt.TokenHash == hashHex {
+			return rt.UserID, nil
+		}
+	}
+	return "", domain.ErrTokenInvalid
