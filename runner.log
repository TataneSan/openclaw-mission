+)
+
+func main() {
+	host := flag.String("host", "127.0.0.1", "Bind address")
+	port := flag.Int("port", 8080, "Bind port")
+	maxDelay := flag.String("max-delay", "30s", "Maximum allowed delay")
+	cors := flag.Bool("cors", false, "Enable CORS headers")
+	silent := flag.Bool("silent", false, "Suppress request logs")
