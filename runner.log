+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"strings"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/google/go-cmp/cmp/cmpopts"
+)
+
+type DiffRequest struct {
+	OldText string `json:"old"`
+	NewText string `json:"new"`
+	OldFile string `json:"old_file,omitempty"`
+	NewFile string `json:"new_file,omitempty"`
+}
+
+type DiffResponse struct {
+	UnifiedDiff string `json:"unified_diff"`
+	HasDiff     bool   `json:"has_diff"`
+	Summary     string `json:"summary"`
+}
+
+func diffHandler(w http.ResponseWriter, r *http.Request) {
+	if r.Method != http.MethodPost {
+		http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
+
+	var req DiffRequest
+	decoder := json.NewDecoder(r.Body)
+	if err := decoder.Decode(&req); err != nil {
+		http.Error(w, "Invalid JSON body", http.StatusBadRequest)
+		return
+	}
+
+	if req.OldText == "" && req.NewText == "" {
+		http.Error(w, "Both 'old' and 'new' fields cannot be empty", http.StatusBadRequest)
+		return
+	}
+
+	oldFile := req.OldFile
+	newFile := req.NewFile
+	if oldFile == "" {
+		oldFile = "a"
+	}
+	if newFile == "" {
+		newFile = "b"
+	}
+
+	oldLines := strings.Split(req.OldText, "\n")
+	newLines := strings.Split(req.NewText, "\n")
+
+	diff := cmp.Diff(oldLines, newLines, cmpopts.EquateEmpty())
+
+	response := DiffResponse{
+		HasDiff: diff != "",
+	}
+
+	if diff == "" {
+		response.Summary = "No differences found"
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(response)
+		return
+	}
+
+	unifiedDiff := generateUnifiedDiff(oldLines, newLines, oldFile, newFile)
+	response.UnifiedDiff = unifiedDiff
+	response.Summary = fmt.Sprintf("Differences found between %s and %s", oldFile, newFile)
+
+	w.Header().Set("Content-Type", "application/json")
+	json.NewEncoder(w).Encode(response)
+}
+
+func generateUnifiedDiff(oldLines, newLines []string, oldFile, newFile string) string {
+	var sb strings.Builder
