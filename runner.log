+func main() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	pattern := os.Args[1]
+	opts, files := parseArgs(os.Args[2:])
+
+	re, err := regexp.Compile(pattern)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "error: invalid regex: %v\n", err)
+		os.Exit(1)
+	}
