+package domain
+
+import "time"
+
+// ProbeResult holds the result of a single latency probe to a host.
+type ProbeResult struct {
+	Host    string
+	Port    int
+	Protocol string
+	Latency time.Duration
+	Success bool
+	Error   string
+}
+
+// Summary aggregates probe results for a single host.
+type Summary struct {
+	Host       string
+	Port       int
+	Protocol   string
+	Attempts   int
+	Successes  int
+	MinLatency time.Duration
+	MaxLatency time.Duration
+	AvgLatency time.Duration
+	P95Latency time.Duration
+}
