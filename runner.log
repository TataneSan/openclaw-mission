+'use strict';
+
+const crypto = require('crypto');
+
+/**
+ * All supported hash algorithms.
+ */
+const ALGORITHMS = [
+  'md5',
+  'sha1',
+  'sha224',
+  'sha256',
+  'sha384',
+  'sha512',
+  'sha3-224',
+  'sha3-256',
+  'sha3-384',
+  'sha3-512',
+  'blake2b512',
+  'blake2s256',
+];
+
+/**
+ * Get the list of supported algorithms.
+ * @returns {string[]}
+ */
+function listAlgorithms() {
+  return ALGORITHMS;
+}
+
+/**
+ * Hash a buffer or string with the given algorithm.
+ * @param {string|Buffer} data
+ * @param {string} algorithm
+ * @param {object} [opts]
+ * @param {boolean} [opts.uppercase=false]
+ * @returns {string} hex digest
+ */
+function hash(data, algorithm, opts = {}) {
+  if (!ALGORITHMS.includes(algorithm)) {
+    throw new Error(`Unknown algorithm: ${algorithm}. Available: ${ALGORITHMS.join(', ')}`);
+  }
+  const h = crypto.createHash(algorithm).update(data).digest('hex');
+  return opts.uppercase ? h.toUpperCase() : h;
+}
+
+/**
+ * HMAC a buffer or string.
+ * @param {string|Buffer} data
+ * @param {string} key
+ * @param {string} algorithm
+ * @param {object} [opts]
+ * @param {boolean} [opts.uppercase=false]
+ * @returns {string} hex digest
+ */
+function hmac(data, key, algorithm, opts = {}) {
+  if (!ALGORITHMS.includes(algorithm)) {
+    throw new Error(`Unknown algorithm: ${algorithm}. Available: ${ALGORITHMS.join(', ')}`);
+  }
+  const h = crypto.createHmac(algorithm, key).update(data).digest('hex');
+  return opts.uppercase ? h.toUpperCase() : h;
+}
+
+/**
+ * Hash a file.
+ * @param {string} filePath
+ * @param {string} algorithm
+ * @param {object} [opts]
+ * @param {boolean} [opts.uppercase=false]
+ * @returns {Promise<string>} hex digest
+ */
+async function hashFile(filePath, algorithm, opts = {}) {
+  const fs = require('fs');
+  const data = await fs.promises.readFile(filePath);
+  return hash(data, algorithm, opts);
+}
