+// path-exists checks if files or directories exist.
+//
+// Supports multiple paths, type checking (file, directory, symlink),
+// and returns exit code 0 if all exist, 1 otherwise.
+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+)
+
+type PathInfo struct {
+	Path   string
+	Exists bool
+	IsFile bool
+	IsDir  bool
+	IsLink bool
+	Size   int64
+	Mode   string
+	Err    string
+}
+
+func run() int {
+	var (
+		fileOnly   = flag.Bool("f", false, "check if path is a file")
+		dirOnly    = flag.Bool("d", false, "check if path is a directory")
+		linkOnly   = flag.Bool("l", false, "check if path is a symlink")
+		jsonOut    = flag.Bool("j", false, "output as JSON")
+		verbose    = flag.Bool("v", false, "verbose output with details")
+		exitAll    = flag.Bool("a", false, "exit 0 only if ALL paths exist (default: any)")
+	)
+	flag.Parse()
+
+	paths := flag.Args()
+	if len(paths) == 0 {
+		fmt.Fprintln(os.Stderr, "usage: path-exists [flags] <path> [path...]")
+		flag.PrintDefaults()
+		return 1
+	}
+
+	infos := checkPaths(paths)
+	var anyExists, allExist bool
+	for _, info := range infos {
+		if info.Exists {
+			anyExists = true
+		} else {
+			allExist = false
+			continue
+		}
+		allExist = true
+	}
+
+	if *jsonOut {
+		printJSON(infos)
+	} else if *verbose {
+		printVerbose(infos)
+	} else {
+		printSimple(infos)
+	}
+
+	useAll := *exitAll
+	if useAll && !allExist {
+		return 1
+	}
+	if !useAll && !anyExists {
+		return 1
+	}
+	return 0
+}
+
+func checkPaths(paths []string) []PathInfo {
+	infos := make([]PathInfo, len(paths))
+	for i, p := range paths {
+		info := PathInfo{Path: p}
+		fi, err := os.Lstat(p)
+		if err != nil {
+			info.Exists = false
