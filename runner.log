+		fmt.Fprintf(flag.CommandLine.Output(), "  %s -sort cpu -once   # Sort by CPU usage\n", os.Args[0])
+		fmt.Fprintf(flag.CommandLine.Output(), "  %s -csv stats.csv     # Export to CSV\n", os.Args[0])
+	}
+	flag.Parse()
+
+	if !*once {
+		runStream()
+		return
+	}
+
+	stats, err := captureStats()
