+// CreateBackup creates a backup of the source directory.
+func (r *FileSystemRepository) CreateBackup(ctx context.Context, config backup.BackupConfig) (*backup.BackupStatus, error) {
+	startTime := time.Now()
+	timestamp := startTime.Format("20060102-150405")
+
+	// Generate backup filename
+	backupName := fmt.Sprintf("backup-%s.tar", timestamp)
+	if config.Compression {
+		backupName += ".gz"
+	}
+
+	backupPath := filepath.Join(config.DestDir, backupName)
+
