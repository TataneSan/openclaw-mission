+package main
+
+import (
+	"flag"
+	"fmt"
+	"log"
+	"net/http"
+
+	"github.com/TataneSan/random-api/internal/handler"
+	"github.com/TataneSan/random-api/internal/middleware"
+)
+
+func main() {
+	port := flag.Int("port", 8080, "Port to listen on")
+	host := flag.String("host", "0.0.0.0", "Host to bind to")
+	flag.Parse()
+
+	h := handler.New()
+
+	mux := http.NewServeMux()
+	h.Register(mux)
+
+	srv := &http.Server{
+		Addr:    fmt.Sprintf("%s:%d", *host, *port),
+		Handler: middleware.CORS(mux),
+	}
+
+	log.Printf("random-api listening on http://%s:%d", *host, *port)
+	if err := srv.ListenAndServe(); err != nil {
+		log.Fatalf("server error: %v", err)
+	}
+}
