+#!/usr/bin/env python3
+"""Tests for cert-check."""
+
+import sys
+import os
+import json
+sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
+
+from cert_check import parse_host_port, check_cert, status_icon, format_result
+
+
+def test_parse_host_port_simple():
+    host, port = parse_host_port("example.com")
+    assert host == "example.com"
+    assert port == 443
+
+
+def test_parse_host_port_custom():
+    host, port = parse_host_port("example.com:8443")
+    assert host == "example.com"
+    assert port == 8443
+
+
+def test_parse_host_port_invalid():
+    try:
+        parse_host_port("example.com:abc")
+        assert False, "Should have raised"
+    except ValueError:
+        pass
+
+
+def test_check_cert_valid():
+    """Test with a known valid domain."""
+    result = check_cert("google.com", 443, timeout=10)
+    assert result["status"] in ("ok", "ssl_error")  # ssl_error if cert chain issue
+    if result["status"] == "ok":
+        assert result["days_remaining"] is not None
+        assert result["not_after"] is not None
+        assert result["subject"] is not None
+
+
+def test_check_cert_invalid_host():
+    result = check_cert("this-host-does-not-exist-12345.invalid", 443, timeout=5)
+    assert result["status"] == "dns_error"
+    assert result["error"] is not None
+
+
+def test_status_icon_ok():
+    icon = status_icon("ok", 90, 30, 7, color=False)
+    assert "90d" in icon
+
+
+def test_status_icon_warn():
+    icon = status_icon("ok", 20, 30, 7, color=False)
+    assert "20d" in icon
+
+
+def test_status_icon_crit():
+    icon = status_icon("ok", 5, 30, 7, color=False)
+    assert "5d" in icon
+
+
+def test_status_icon_expired():
+    icon = status_icon("expired", -1, 30, 7, color=False)
+    assert "EXPIRED" in icon
+
+
+def test_format_result():
