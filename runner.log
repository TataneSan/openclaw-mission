+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+	"os/exec"
+	"strings"
+	"time"
+)
+
+func runGit(args ...string) (string, error) {
+	cmd := exec.Command("git", args...)
+	output, err := cmd.CombinedOutput()
+	return strings.TrimSpace(string(output)), err
+}
+
+func isGitRepo() error {
+	_, err := runGit("rev-parse", "--git-dir")
+	if err != nil {
+		return fmt.Errorf("not a git repository: %w", err)
+	}
+	return nil
+}
+
+func getReflogEntries(expireDays int, dryRun bool) ([]string, error) {
+	cutoff := time.Now().AddDate(0, 0, -expireDays).Format("{{.Days}} days ago")
+	args := []string{"reflog", "expire", "--expire=" + cutoff}
+	if dryRun {
+		args = append(args, "--dry-run")
+	}
+	return runLines(args)
+}
+
+func runLines(args ...string) ([]string, error) {
+	cmd := exec.Command("git", args...)
+	output, err := cmd.CombinedOutput()
+	if err != nil {
+		return nil, err
+	}
+	var lines []string
