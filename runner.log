+// diff-stats shows statistics about git diffs between two commits or branches.
+//
+// Displays lines added/removed, files changed, insertion/deletion ratio,
+// and per-file breakdown.
+package main
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"os/exec"
+	"regexp"
+	"sort"
+	"strings"
+)
+
+// FileStats holds diff statistics for a single file.
+type FileStats struct {
+	File     string
+	Additions int
+	Deletions int
+}
+
+// DiffStats holds overall diff statistics.
+type DiffStats struct {
+	Files      []FileStats
+	TotalFiles int
+	TotalAdd   int
+	TotalDel   int
+}
+
+func runGit(args ...string) (string, error) {
+	cmd := exec.Command("git", args...)
+	output, err := cmd.Output()
+	if err != nil {
+		return "", fmt.Errorf("git %s failed: %w", strings.Join(args, " "), err)
+	}
+	return string(output), nil
+}
+
+func parseDiff(from, to string) (*DiffStats, error) {
+	args := []string{"diff", "--stat", "--numstat", fmt.Sprintf("%s...%s", from, to)}
+	output, err := runGit(args...)
+	if err != nil {
+		return nil, err
+	}
+
+	stats := &DiffStats{}
+	scanner := bufio.NewScanner(strings.NewReader(output))
+
+	// Skip the summary line(s) at the top
+	// Format: "\tfiles changed, +X insertions, -Y deletions"
+	// Then blank line, then numstat lines: "added\tdeleted\tfile"
+	foundSeparator := false
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+		if line == "" {
+			foundSeparator = true
+			continue
+		}
+		if !foundSeparator {
+			continue
+		}
+
+		parts := strings.Split(line, "\t")
+		if len(parts) != 3 {
+			continue
+		}
+
+		var additions, deletions int
+		addStr := parts[0]
+		delStr := parts[1]
+
+		// Handle binary files marked as "-"
+		if addStr != "-" {
+			fmt.Sscanf(addStr, "%d", &additions)
+		}
+		if delStr != "-" {
