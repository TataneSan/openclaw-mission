+package main
+
+import (
+	"encoding/csv"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"strings"
+
+	"github.com/BurntSushi/toml"
+)
+
+func main() {
+	args := os.Args[1:]
+	if len(args) > 0 && (args[0] == "--help" || args[0] == "-h") {
+		printUsage()
+		return
+	}
+
+	var input string
+	if len(args) > 0 {
+		input = args[0]
+	}
+
+	var data []byte
+	var err error
+
+	if input == "" || input == "-" {
+		data, err = io.ReadAll(os.Stdin)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "Error reading input: %v\n", err)
+			os.Exit(1)
+		}
+	} else {
+		data, err = os.ReadFile(input)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "Error: %v\n", err)
+			os.Exit(1)
+		}
+	}
+
+	var doc map[string]interface{}
+	if _, err := toml.Decode(string(data), &doc); err != nil {
+		fmt.Fprintf(os.Stderr, "Error: invalid TOML: %v\n", err)
+		os.Exit(1)
+	}
+
+	writer := csv.NewWriter(os.Stdout)
+	defer writer.Flush()
+
+	// Collect all sections
+	var sections []string
+	sectionRows := make(map[string][]map[string]string)
+
+	for key, value := range doc {
+		switch v := value.(type) {
+		case map[string]interface{}:
+			sections = append(sections, key)
+			sectionRows[key] = flattenMap(v)
+		case []interface{}:
+			// Array of tables
+			sections = append(sections, key)
+			for _, item := range v {
+				if tbl, ok := item.(map[string]interface{}); ok {
+					row := flattenMap(tbl)
+					sectionRows[key] = append(sectionRows[key], row)
+				}
+			}
+		default:
+			// Top-level key-value, write as single row
+			if err := writer.Write([]string{key, fmt.Sprintf("%v", v)}); err != nil {
+				fmt.Fprintf(os.Stderr, "Error writing CSV: %v\n", err)
+				os.Exit(1)
+			}
+		}
+	}
+
