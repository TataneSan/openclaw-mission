+package infrastructure
+
+import (
+	"bufio"
+	"os"
+	"strings"
+
+	"github.com/TataneSan/env-validate/internal/domain"
+)
+
+// Loader reads and parses .env files.
+type Loader struct{}
+
+// NewLoader creates a new Loader.
+func NewLoader() *Loader {
+	return &Loader{}
+}
+
+// Load reads a .env file and returns the parsed key-value pairs.
+func (l *Loader) Load(path string) ([]domain.EnvVar, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+
+	var vars []domain.EnvVar
+	scanner := bufio.NewScanner(f)
+	for scanner.Scan() {
+		line := strings.TrimSpace(scanner.Text())
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		key, value, found := strings.Cut(line, "=")
+		if !found {
+			continue
+		}
+		key = strings.TrimSpace(key)
+		value = strings.TrimSpace(value)
+		// Remove surrounding quotes
+		if len(value) >= 2 {
+			if (value[0] == '"' && value[len(value)-1] == '"') ||
+				(value[0] == '\'' && value[len(value)-1] == '\'') {
+				value = value[1 : len(value)-1]
+			}
+		}
+		if key != "" {
+			vars = append(vars, domain.EnvVar{Key: key, Value: value})
+		}
+	}
+
+	return vars, scanner.Err()
+}
+
+// Validate checks that all required keys are present in the loaded env vars.
+func (l *Loader) Validate(path string, vars []domain.EnvVar, required []string) *domain.ValidationResult {
+	result := &domain.ValidationResult{
+		File:     path,
+		Loaded:   vars,
+		Required: required,
+	}
+
+	found := make(map[string]bool)
+	for _, v := range vars {
+		found[v.Key] = true
+	}
+
+	for _, req := range required {
+		if !found[req] {
+			result.Missing = append(result.Missing, req)
+		}
+	}
+
+	for _, v := range vars {
+		foundReq := false
+		for _, req := range required {
+			if v.Key == req {
+				foundReq = true
