+package main
+
+import (
+	"flag"
+	"fmt"
+	"log"
+	"net/http"
+	"os"
+	"os/signal"
+	"time"
+
+	"github.com/TataneSan/echo-api/internal/handlers"
+)
+
+func main() {
+	host := flag.String("host", "127.0.0.1", "Bind address")
+	port := flag.Int("port", 8080, "Bind port")
+	cors := flag.Bool("cors", false, "Enable CORS headers")
+	delay := flag.String("delay", "0s", "Response delay (e.g. 500ms, 1s)")
+	silent := flag.Bool("silent", false, "Suppress request logs")
+	flag.Parse()
+
+	delayDur, err := time.ParseDuration(*delay)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "Invalid delay: %v\n", err)
+		os.Exit(1)
+	}
+
+	cfg := &handlers.Config{
+		CORS:  *cors,
+		Delay: delayDur,
+		Silent: *silent,
+	}
+
+	mux := handlers.NewMux(cfg)
+
+	server := &http.Server{
+		Addr:    fmt.Sprintf("%s:%d", *host, *port),
+		Handler: mux,
+	}
+
+	if !*silent {
+		log.Printf("echo-api starting on http://%s:%d", *host, *port)
+	}
+
+	go func() {
+		if err := server.ListenAndServe(); err != nil && err != http.ErrServerClosed {
+			log.Fatalf("Server error: %v", err)
+		}
+	}()
+
+	sigCh := make(chan os.Signal, 1)
+	signal.Notify(sigCh, os.Interrupt)
+	<-sigCh
+
+	if !*silent {
+		log.Println("Shutting down...")
+	}
+	server.Close()
+}
