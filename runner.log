+package infrastructure
+
+import (
+	"fmt"
+	"os"
+
+	"gopkg.in/yaml.v3"
+
+	"github.com/TataneSan/nginx-gen/internal/model"
+)
+
+// Parser reads and parses YAML configuration files.
+type Parser struct{}
+
+// ParseFile reads a YAML file and returns the parsed config.
+func (p *Parser) ParseFile(path string) (*model.Config, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("failed to read file %s: %w", path, err)
+	}
+	return p.Parse(data)
+}
+
+// Parse unmarshals YAML bytes into a config.
+func (p *Parser) Parse(data []byte) (*model.Config, error) {
+	var cfg model.Config
+	if err := yaml.Unmarshal(data, &cfg); err != nil {
+		return nil, fmt.Errorf("invalid YAML: %w", err)
+	}
+	if len(cfg.Servers) == 0 {
+		return nil, fmt.Errorf("at least one server block is required")
+	}
+	return &cfg, nil
+}
