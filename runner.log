+"""Geocoding and distance calculation API."""
+
+from fastapi import FastAPI, HTTPException, Query
+from fastapi.middleware.cors import CORSMiddleware
+from pydantic import BaseModel, Field
+import math
+import httpx
+from typing import Optional
+
+app = FastAPI(
+    title="Geo API",
+    description="Geocoding, reverse geocoding, and distance calculation",
+    version="1.0.0",
+)
+
+app.add_middleware(
+    CORSMiddleware,
+    allow_origins=["*"],
+    allow_methods=["*"],
+    allow_headers=["*"],
+)
+
+NOMINATIM_URL = "https://nominatim.openstreetmap.org"
+USER_AGENT = "geo-api/1.0"
+
+
+class GeoPoint(BaseModel):
+    lat: float = Field(..., ge=-90, le=90, description="Latitude")
+    lon: float = Field(..., ge=-180, le=180, description="Longitude")
+
+
+class DistanceRequest(BaseModel):
+    from_point: GeoPoint
+    to_point: GeoPoint
+    unit: str = Field("km", pattern="^(km|mi|m|ft)$")
+
+
+class GeocodeResult(BaseModel):
+    lat: float
+    lon: float
+    display_name: str
+    address: dict
+    type: str
+    importance: float
+
+
+class ReverseResult(BaseModel):
+    lat: float
+    lon: float
+    display_name: str
+    address: dict
+
+
+class DistanceResult(BaseModel):
+    from_point: GeoPoint
+    to_point: GeoPoint
+    distance: float
+    unit: str
+    bearing: float
+
+
+def haversine(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
+    """Calculate the great-circle distance between two points in kilometers."""
+    R = 6371  # Earth's radius in km
+    lat1, lon1, lat2, lon2 = map(math.radians, [lat1, lon1, lat2, lon2])
+    dlat = lat2 - lat1
+    dlon = lon2 - lon1
+    a = math.sin(dlat / 2) ** 2 + math.cos(lat1) * math.cos(lat2) * math.sin(dlon / 2) ** 2
+    c = 2 * math.asin(math.sqrt(a))
+    return R * c
+
+
+def bearing(lat1: float, lon1: float, lat2: float, lon2: float) -> float:
+    """Calculate initial bearing between two points in degrees."""
+    lat1, lon1, lat2, lon2 = map(math.radians, [lat1, lon1, lat2, lon2])
+    dlon = lon2 - lon1
+    x = math.sin(dlon) * math.cos(lat2)
+    y = math.cos(lat1) * math.sin(lat2) - math.sin(lat1) * math.cos(lat2) * math.cos(dlon)
