+
+// RepoInfo holds aggregated information about a git repository.
+type RepoInfo struct {
+	Path        string
+	HEAD        string
+	Branch      string
+	TotalCommits int
+	Authors     []string
+	Branches    []string
+	RemoteURL   string
+	Created     string
+	LastCommit  string
+	LastAuthor  string
+	SizeBytes   int64
+}
