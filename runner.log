+package store
+
+import (
+	"database/sql"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+
+	_ "github.com/mattn/go-sqlite3"
+)
+
+// Entry represents a time tracking entry.
+type Entry struct {
+	ID        int
+	Project   string
+	Task      string
+	StartTime time.Time
+	EndTime   *time.Time
+}
+
+// Store manages SQLite persistence for time entries.
+type Store struct {
+	db *sql.DB
+}
+
+// NewStore creates a new Store, opening (or creating) the database.
+func NewStore() (*Store, error) {
+	dir, err := os.UserHomeDir()
+	if err != nil {
+		return nil, fmt.Errorf("failed to get home directory: %w", err)
+	}
+	dbPath := filepath.Join(dir, ".time-tracker.db")
+
+	db, err := sql.Open("sqlite3", dbPath)
+	if err != nil {
+		return nil, fmt.Errorf("failed to open database: %w", err)
+	}
+
+	s := &Store{db: db}
+	if err := s.initDB(); err != nil {
+		db.Close()
+		return nil, err
+	}
+	return s, nil
+}
+
+// Close closes the database connection.
+func (s *Store) Close() error {
+	return s.db.Close()
+}
+
+func (s *Store) initDB() error {
+	query := `
+	CREATE TABLE IF NOT EXISTS entries (
+		id INTEGER PRIMARY KEY AUTOINCREMENT,
+		project TEXT NOT NULL DEFAULT '',
+		task TEXT NOT NULL,
+		start_time TEXT NOT NULL,
+		end_time TEXT
+	);`
+	_, err := s.db.Exec(query)
+	return err
+}
+
+// ActiveEntry returns the entry with no end_time (currently tracking).
+func (s *Store) ActiveEntry() (*Entry, error) {
+	var e Entry
+	err := s.db.QueryRow(
+		"SELECT id, project, task, start_time, end_time FROM entries WHERE end_time IS NULL ORDER BY id DESC LIMIT 1",
+	).Scan(&e.ID, &e.Project, &e.Task, &e.StartTime, &e.EndTime)
+	if err == sql.ErrNoRows {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &e, nil
