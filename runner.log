+package infrastructure
+
+import (
+	"context"
+	"sync"
+	"time"
+
+	"github.com/TataneSan/log-api/internal/domain"
+)
+
+type InMemoryLogRepository struct {
+	mu      sync.RWMutex
+	entries []domain.LogEntry
+}
+
+func NewInMemoryLogRepository() *InMemoryLogRepository {
+	return &InMemoryLogRepository{
+		entries: make([]domain.LogEntry, 0),
+	}
+}
+
+func (r *InMemoryLogRepository) Save(_ context.Context, entry *domain.LogEntry) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.entries = append(r.entries, *entry)
+
+	if len(r.entries) > 10000 {
+		r.entries = r.entries[len(r.entries)-10000:]
+	}
+	return nil
+}
+
+func (r *InMemoryLogRepository) Find(_ context.Context, params domain.FilterParams) ([]domain.LogEntry, error) {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+
+	var filtered []domain.LogEntry
+	for _, e := range r.entries {
+		if params.Level != "" && e.Level != params.Level {
+			continue
+		}
+		if params.Source != "" && e.Source != params.Source {
+			continue
+		}
+		filtered = append(filtered, e)
+	}
+
+	start := params.Offset
+	if start > len(filtered) {
+		start = len(filtered)
+	}
+	end := start + params.Limit
+	if end > len(filtered) {
+		end = len(filtered)
+	}
+
+	if start >= len(filtered) {
+		return []domain.LogEntry{}, nil
+	}
+
+	return filtered[start:end], nil
+}
+
+func (r *InMemoryLogRepository) Count(_ context.Context) (int, error) {
+	r.mu.RLock()
+	defer r.mu.RUnlock()
+	return len(r.entries), nil
+}
