+package service
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"sync"
+	"time"
+
+	"batch-api/internal/model"
+)
+
+// Executor runs a batch of HTTP requests concurrently.
+type Executor struct {
+	client *http.Client
+}
+
+// NewExecutor creates a new Executor with a shared HTTP client.
+func NewExecutor() *Executor {
+	return &Executor{
+		client: &http.Client{
+			Timeout: 30 * time.Second,
+		},
+	}
+}
+
+// Execute runs all requests in parallel and returns their results.
+func (e *Executor) Execute(payload model.BatchPayload) model.BatchResult {
+	defaultTimeout := 10
+	if payload.Timeout > 0 {
+		defaultTimeout = payload.Timeout
+	}
+
+	results := make([]model.BatchResponse, len(payload.Requests))
+	var wg sync.WaitGroup
+	start := time.Now()
+
+	for i, req := range payload.Requests {
+		wg.Add(1)
+		go func(idx int, r model.BatchRequest) {
+			defer wg.Done()
+			results[idx] = e.runOne(r, defaultTimeout)
+		}(i, req)
+	}
+
+	wg.Wait()
+
+	elapsed := time.Since(start)
+	successes, errors := 0, 0
+	for _, r := range results {
+		if r.Error != "" {
+			errors++
+		} else {
+			successes++
+		}
+	}
+
+	return model.BatchResult{
+		Results:   results,
+		TotalMs:   float64(elapsed.Microseconds()) / 1000.0,
+		Successes: successes,
+		Errors:    errors,
+	}
+}
+
+func (e *Executor) runOne(req model.BatchRequest) model.BatchResponse {
+	start := time.Now()
+	resp := model.BatchResponse{
+		ID:     req.ID,
+		Method: req.Method,
+		URL:    req.URL,
+	}
+
+	if req.Method == "" {
+		req.Method = "GET"
+	}
