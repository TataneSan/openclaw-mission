+"""Core link checking logic with concurrent requests."""
+
+import time
+from collections import defaultdict
+from concurrent.futures import ThreadPoolExecutor, as_completed
+from dataclasses import dataclass, field
+from typing import Optional
+from urllib.parse import urljoin, urlparse
+
+import requests
+from bs4 import BeautifulSoup
+
+HEADERS = {
+    "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
+                  "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
+}
+
+# Tags and their URL-bearing attributes
+LINK_TAGS = {
+    "a": "href",
+    "img": "src",
+    "script": "src",
+    "link": "href",
+    "iframe": "src",
+    "source": "src",
+    "video": "src",
+    "audio": "src",
+    "embed": "src",
+    "object": "data",
+    "form": "action",
+}
+
+
+@dataclass
+class LinkResult:
+    """Result of checking a single link."""
+    url: str
+    status: int  # HTTP status code, 0 for errors
+    ok: bool
+    error: Optional[str] = None
+    source_page: str = ""
+    redirect_url: Optional[str] = None
+    response_time: float = 0.0
+    link_type: str = "link"  # link, image, script, etc.
+
+
+@dataclass
+class CheckResult:
+    """Full results of a link check run."""
+    url: str
+    total_links: int = 0
+    checked: int = 0
+    ok_count: int = 0
+    broken_count: int = 0
+    redirect_count: int = 0
+    skipped_count: int = 0
+    elapsed: float = 0.0
+    results: list = field(default_factory=list)
+    broken: list = field(default_factory=list)
+    pages_crawled: int = 0
+
+
+def is_same_domain(url: str, base_url: str) -> bool:
+    """Check if URL is on the same domain as base."""
+    return urlparse(url).netloc == urlparse(base_url).netloc
+
+
+def normalize_url(url: str) -> str:
+    """Normalize URL — strip fragments, trailing slashes."""
+    parsed = urlparse(url)
+    # Strip fragment
+    normalized = parsed._replace(fragment="").geturl()
+    # Strip trailing slash for consistency (except root)
+    if normalized.endswith("/") and parsed.path != "/":
+        normalized = normalized.rstrip("/")
+    return normalized
+
+
