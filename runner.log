+// git-log-visual displays a colorful ASCII visualization of git history.
+// It shows commits as colored dots connected by lines, with branch names
+// and commit messages, providing a compact visual overview of a repository's history.
+package main
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// ANSI colors for commit dots
+var colors = []string{
+	"\033[38;5;208m", // red
+	"\033[38;5;220m", // orange
+	"\033[38;5;118m", // yellow
+	"\033[38;5;46m",  // green
+	"\033[38;5;39m",  // teal
+	"\033[38;5;75m",  // cyan
+	"\033[38;5;69m",  // blue
+	"\033[38;5;129m", // purple
+	"\033[38;5;197m", // magenta
+	"\033[38;5;212m", // pink
+}
+
+const reset = "\033[0m"
+const bold = "\033[1m"
+const dim = "\033[2m"
+const gray = "\033[38;5;245m"
+
+type Commit struct {
+	Hash       string
+	ShortHash  string
+	Author     string
+	Date       time.Time
+	Subject    string
+	Parents    []string
+	BranchTags []string
+	ColorIdx   int
+}
+
+func main() {
+	maxCommits := 30
+	showColor := true
+	repoPath := "."
+
+	args := os.Args[1:]
+	for len(args) > 0 {
+		switch args[0] {
+		case "-n":
+			if len(args) > 1 {
+				n, err := strconv.Atoi(args[1])
+				if err == nil && n > 0 {
+					maxCommits = n
+				}
+			}
+			args = args[2:]
+		case "--no-color":
+			showColor = false
+			args = args[1:]
+		case "-h", "--help":
+			printUsage()
+			os.Exit(0)
+		default:
+			repoPath = args[0]
+			args = args[1:]
+		}
+	}
+
+	if !showColor {
+		for i := range colors {
+			colors[i] = ""
+		}
+		reset = ""
