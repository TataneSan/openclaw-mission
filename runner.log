+package main
+
+import (
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+)
+
+var (
+	input     = flag.String("i", "", "input JSON file (default: stdin)")
+	output    = flag.String("o", "", "output JSON file (default: stdout)")
+	key       = flag.String("k", "", "deduplicate by key (for arrays of objects)")
+	pretty    = flag.Bool("p", true, "pretty-print output")
+	version   = flag.Bool("version", false, "print version and exit")
+)
+
+const versionStr = "json-unique v1.0.0"
+
+func main() {
+	flag.Parse()
+
+	if *version {
+		fmt.Println(versionStr)
+		os.Exit(0)
+	}
+
+	var data []byte
+	if *input == "" {
+		var err error
+		data, err = io.ReadAll(os.Stdin)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "error reading stdin: %v\n", err)
+			os.Exit(1)
+		}
+	} else {
+		var err error
+		data, err = os.ReadFile(*input)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "error reading file: %v\n", err)
+			os.Exit(1)
+		}
+	}
+
+	var result []byte
+	var err error
+
+	if *key != "" {
+		// Deduplicate array of objects by key
+		result, err = uniqueByArray(data, *key)
+	} else {
+		// Deduplicate flat array
+		result, err = uniqueFlat(data)
+	}
+
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "error: %v\n", err)
+		os.Exit(1)
+	}
+
+	writeOutput(result)
+}
+
+func uniqueFlat(data []byte) ([]byte, error) {
+	var arr []json.RawMessage
+	if err := json.Unmarshal(data, &arr); err != nil {
+		return nil, fmt.Errorf("input must be a JSON array: %v", err)
+	}
+
+	seen := make(map[string]bool)
+	var result []json.RawMessage
+
+	for _, item := range arr {
+		key := string(item)
