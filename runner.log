+package interfaces
+
+import (
+	"fmt"
+	"net/http"
+	"strings"
+)
+
+// Router sets up HTTP routes for the rate limiter API.
+func (h *Handler) Router() http.Handler {
+	mux := http.NewServeMux()
+
+	mux.HandleFunc("/health", h.HandleHealth)
+	mux.HandleFunc("/check", h.HandleCheck)
+	mux.HandleFunc("/status", h.HandleStatus)
+	mux.HandleFunc("/reset", h.HandleReset)
+
+	// Policies routes.
+	mux.HandleFunc("/policies", func(w http.ResponseWriter, r *http.Request) {
+		switch r.Method {
+		case http.MethodGet:
+			h.HandleListPolicies(w, r)
+		case http.MethodPost:
+			h.HandleCreatePolicy(w, r)
+		default:
+			writeError(w, http.StatusMethodNotAllowed, "method not allowed")
+		}
+	})
+
+	// Policy by key: /policies/:key
+	mux.HandleFunc("/policies/", func(w http.ResponseWriter, r *http.Request) {
+		// Must have a path after /policies/
+		if !strings.HasPrefix(r.URL.Path, "/policies/") || r.URL.Path == "/policies/" {
+			writeError(w, http.StatusBadRequest, "policy key is required")
+			return
+		}
+
+		switch r.Method {
+		case http.MethodGet:
+			h.HandleGetPolicy(w, r)
+		case http.MethodDelete:
+			h.HandleDeletePolicy(w, r)
+		default:
+			writeError(w, http.StatusMethodNotAllowed, "method not allowed")
+		}
+	})
+
+	// Root redirect to health.
+	mux.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/" {
+			http.NotFound(w, r)
+			return
+		}
+		fmt.Fprintf(w, "Rate Limiter API\nEndpoints:\n  GET  /health\n  GET  /check?policy=KEY&identifier=ID\n  POST /policies\n  GET  /policies\n  GET  /policies/:key\n  DELETE /policies/:key\n  GET  /status?policy=KEY&identifier=ID\n  POST /reset?policy=KEY&identifier=ID\n")
+	})
+
+	return mux
+}
