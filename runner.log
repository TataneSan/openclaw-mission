+package infrastructure
+
+import (
+	"fmt"
+	"rate-limiter-api/internal/domain"
+	"sync"
+	"time"
+)
+
+// InMemoryCache provides an in-memory key/value cache with TTL support.
+type InMemoryCache struct {
+	entries map[string]*domain.Entry
+	mu      sync.RWMutex
+}
+
+// NewInMemoryCache creates a new cache instance.
+func NewInMemoryCache() *InMemoryCache {
+	return &InMemoryCache{
+		entries: make(map[string]*domain.Entry),
+	}
+}
+
+// Set adds or updates a cache entry with the given TTL.
+func (c *InMemoryCache) Set(key string, value interface{}, ttlSeconds int) error {
+	if key == "" {
+		return fmt.Errorf("key cannot be empty")
+	}
+	if ttlSeconds <= 0 {
+		return fmt.Errorf("ttl_seconds must be greater than 0")
+	}
+
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	c.entries[key] = &domain.Entry{
+		Key:       key,
+		Value:     value,
+		ExpiresAt: time.Now().Add(time.Duration(ttlSeconds) * time.Second),
+		CreatedAt: time.Now(),
+	}
+	return nil
+}
+
+// Get retrieves a cache entry by key.
+func (c *InMemoryCache) Get(key string) (*domain.Entry, error) {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+
+	entry, exists := c.entries[key]
+	if !exists {
+		return nil, fmt.Errorf("key %s not found", key)
+	}
+
+	if entry.IsExpired() {
+		return nil, fmt.Errorf("key %s expired", key)
+	}
+
+	return entry, nil
+}
+
+// Delete removes a cache entry by key.
+func (c *InMemoryCache) Delete(key string) error {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+
+	if _, exists := c.entries[key]; !exists {
+		return fmt.Errorf("key %s not found", key)
+	}
+
+	delete(c.entries, key)
+	return nil
+}
+
+// ListKeys returns all non-expired keys.
+func (c *InMemoryCache) ListKeys() []string {
+	c.mu.RLock()
+	defer c.mu.RUnlock()
+
