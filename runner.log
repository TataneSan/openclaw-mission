+'use strict';
+
+const QRCode = require('qrcode');
+const fs = require('fs');
+const pc = require('picocolors');
+
+/**
+ * Generate QR code as ASCII string for terminal display.
+ * @param {string} text - Data to encode
+ * @param {object} [opts]
+ * @param {number} [opts.margin=1] - Module margin
+ * @param {boolean} [opts.invert=false] - Invert colors (for dark terminals)
+ * @returns {Promise<string>}
+ */
+async function toASCII(text, opts = {}) {
+  const { margin = 1, invert = false } = opts;
+
+  const matrix = QRCode.create(text, { errorCorrectionLevel: 'M' });
+  const size = matrix.modules.size;
+  const data = matrix.modules.data;
+
+  const lines = [];
+
+  // Top margin
+  for (let i = 0; i < margin; i++) {
+    lines.push('');
+  }
+
+  for (let row = 0; row < size; row += 2) {
+    let line = '';
+    // Left margin
+    for (let i = 0; i < margin; i++) line += '  ';
+
+    for (let col = 0; col < size; col++) {
+      const top = data[row * size + col] === 1;
+      const bottom = row + 1 < size ? data[(row + 1) * size + col] === 1 : false;
+
+      if (top && bottom) {
+        line += invert ? '  ' : '█';
+      } else if (top && !bottom) {
+        line += invert ? '  ' : '▀';
+      } else if (!top && bottom) {
+        line += invert ? '  ' : '▄';
+      } else {
+        line += invert ? '██' : '  ';
+      }
+    }
+
+    lines.push(line);
+  }
+
+  // Bottom margin
+  for (let i = 0; i < margin; i++) {
+    lines.push('');
+  }
+
+  return lines.join('\n');
+}
+
+/**
+ * Generate QR code as colored terminal string.
+ * @param {string} text - Data to encode
+ * @param {object} [opts]
+ * @param {number} [opts.margin=1]
+ * @param {string} [opts.fg='white'] - Foreground color
+ * @param {string} [opts.bg='black'] - Background color
+ * @returns {Promise<string>}
+ */
+async function toColored(text, opts = {}) {
