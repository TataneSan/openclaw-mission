+	addr := ":8080"
+	fmt.Printf("template-api starting on %s\n", addr)
+
+	srv := &http.Server{
+		Addr:         addr,
+		Handler:      router,
+		ReadTimeout:  10 * time.Second,
+		WriteTimeout: 10 * time.Second,
+		IdleTimeout:  60 * time.Second,
+	}
+
+	if err := srv.ListenAndServe(); err != nil {
+		fmt.Printf("server error: %v\n", err)
+	}
+}
