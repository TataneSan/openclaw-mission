+// cli-biography — Quick biographical notes on people.
+//
+// Store and retrieve brief biographical notes (name, birth, occupation,
+// bio text, tags) in a local JSON store. Supports search and filtering.
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+)
+
+// Person represents a biographical entry.
+type Person struct {
+	Name       string   `json:"name"`
+	Born       string   `json:"born,omitempty"`
+	Died       string   `json:"died,omitempty"`
+	Occupation string   `json:"occupation,omitempty"`
+	Bio        string   `json:"bio"`
+	Tags       []string `json:"tags,omitempty"`
+	Created    string   `json:"created"`
+	Updated    string   `json:"updated"`
+}
+
+// Store holds all biographical entries.
+type Store struct {
+	People []Person `json:"people"`
+}
+
+func loadStore(path string) (*Store, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return &Store{}, nil
+		}
+		return nil, err
+	}
+	var store Store
+	if err := json.Unmarshal(data, &store); err != nil {
+		return nil, fmt.Errorf("invalid store file: %w", err)
+	}
+	return &store, nil
+}
+
+func saveStore(path string, store *Store) error {
+	data, err := json.MarshalIndent(store, "", "  ")
+	if err != nil {
+		return err
+	}
+	return os.WriteFile(path, data, 0644)
+}
+
+func storePath() string {
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return filepath.Join(os.TempDir(), "biography.json")
+	}
+	dir := filepath.Join(home, ".config", "cli-biography")
+	os.MkdirAll(dir, 0755)
+	return filepath.Join(dir, "biography.json")
+}
+
+func now() string {
+	return time.Now().UTC().Format(time.RFC3339)
+}
+
+func main() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
