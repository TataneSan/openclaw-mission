+package main
+
+import (
+	"log"
+	"net/http"
+	"os"
+
+	"github.com/TataneSan/validate-api/internal/handler"
+	"github.com/TataneSan/validate-api/internal/middleware"
+	"github.com/TataneSan/validate-api/internal/validator"
+)
+
+func main() {
+	port := os.Getenv("PORT")
+	if port == "" {
+		port = "8080"
+	}
+
+	v := validator.New()
+	h := handler.New(v)
+
+	mw := middleware.New()
+
+	mux := http.NewServeMux()
+
+	// Health
+	mux.HandleFunc("GET /health", handler.Health)
+
+	// Validate email
+	mux.HandleFunc("POST /api/validate/email", mw.Logging(h.ValidateEmail))
+
+	// Validate phone
+	mux.HandleFunc("POST /api/validate/phone", mw.Logging(h.ValidatePhone))
+
+	// Validate CPF (Brazilian)
+	mux.HandleFunc("POST /api/validate/cpf", mw.Logging(h.ValidateCPF))
+
+	// Validate CNPJ (Brazilian)
+	mux.HandleFunc("POST /api/validate/cnpj", mw.Logging(h.ValidateCNPJ))
+
+	log.Printf("validate-api starting on :%s", port)
+	if err := http.ListenAndServe(":"+port, mux); err != nil {
+		log.Fatalf("server failed: %v", err)
+	}
+}
