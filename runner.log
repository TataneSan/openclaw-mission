+        "basic": {},
+        "open_graph": {},
+        "twitter": {},
+        "http_equiv": {},
+        "other": {},
+    }
+
+    for tag in meta_tags:
+        content = tag.get("content", "")
+        if not content:
+            continue
+
+        prop = tag.get("property", "")
+        name = tag.get("name", "")
+        http_equiv = tag.get("http-equiv", "")
+        key = prop or name or http_equiv
+
