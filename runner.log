+package store
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+)
+
+// Item represents a single checklist item.
+type Item struct {
+	Text     string
+	Done     bool
+	DoneAt   *time.Time
+	Category string
+}
+
+// Checklist represents a named, reusable checklist.
+type Checklist struct {
+	Name        string
+	Description string
+	Items       []Item
+	CreatedAt   time.Time
+	UpdatedAt   time.Time
+}
+
+// Store manages persistence for checklists.
+type Store struct {
+	baseDir string
+}
+
+// NewStore creates a new Store using the given base directory.
+func NewStore() (*Store, error) {
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return nil, fmt.Errorf("failed to get home directory: %w", err)
+	}
+	baseDir := filepath.Join(home, ".checklist-cli")
+	if err := os.MkdirAll(baseDir, 0755); err != nil {
+		return nil, fmt.Errorf("failed to create data directory: %w", err)
+	}
+	return &Store{baseDir: baseDir}, nil
+}
+
+func (s *Store) filePath(name string) string {
+	return filepath.Join(s.baseDir, sanitizeName(name)+".json")
+}
+
+// List returns all checklist names.
+func (s *Store) List() ([]string, error) {
+	entries, err := os.ReadDir(s.baseDir)
+	if err != nil {
+		return nil, err
+	}
+	var names []string
+	for _, e := range entries {
+		if e.IsDir() || filepath.Ext(e.Name()) != ".json" {
+			continue
+		}
