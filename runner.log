+)
+
+// ContainerStats holds parsed stats for a single container.
+type ContainerStats struct {
+	Name       string
+	CPUPct     float64
+	MemUsage   string
+	MemLimit   string
+	MemPct     float64
+	NetIO      string
+	BlockIO    string
+	PIDs       string
+}
+
+var (
+	filter     = flag.String("f", "", "Filter containers by name (substring match)")
