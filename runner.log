+"""Reminder Bot - Telegram bot for reminders with cron support."""
+
+import logging
+import os
+import re
+import sqlite3
+import asyncio
+from datetime import datetime, timedelta
+from typing import Optional
+
+import pytz
+from dotenv import load_dotenv
+from telegram import Update, Bot
+from telegram.ext import (
+    Application,
+    CommandHandler,
+    ContextTypes,
+    ConversationHandler,
+    MessageHandler,
+    filters,
+)
+
+# Load environment
+load_dotenv()
+
+TELEGRAM_BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
+TIMEZONE = os.getenv("TIMEZONE", "Europe/Paris")
+DATA_DIR = os.getenv("DATA_DIR", "./data")
+
+# Logging
+logging.basicConfig(
+    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
+    level=logging.INFO,
+)
+logger = logging.getLogger(__name__)
+
+# States
+WAITING_REMINDER = 1
+
+# French day names
+DAY_NAMES = {
+    "lundi": 0, "mardi": 1, "mercredi": 2, "jeudi": 3,
+    "vendredi": 4, "samedi": 5, "dimanche": 6,
+}
+
+
+class ReminderDB:
+    """SQLite database for storing reminders."""
+    
+    def __init__(self, db_path: str):
+        self.db_path = db_path
+        os.makedirs(os.path.dirname(db_path) or ".", exist_ok=True)
+        self.init_db()
+    
+    def init_db(self):
+        """Initialize database schema."""
+        with sqlite3.connect(self.db_path) as conn:
+            conn.execute("""
+                CREATE TABLE IF NOT EXISTS reminders (
+                    id INTEGER PRIMARY KEY AUTOINCREMENT,
+                    chat_id INTEGER NOT NULL,
+                    user_id INTEGER NOT NULL,
+                    message TEXT NOT NULL,
+                    remind_at TEXT NOT NULL,
+                    recurring TEXT,
+                    created_at TEXT DEFAULT CURRENT_TIMESTAMP
+                )
+            """)
+            conn.commit()
+    
+    def add_reminder(self, chat_id: int, user_id: int, message: str, 
+                     remind_at: str, recurring: Optional[str] = None) -> int:
+        """Add a new reminder. Returns reminder ID."""
+        with sqlite3.connect(self.db_path) as conn:
+            cursor = conn.execute(
+                "INSERT INTO reminders (chat_id, user_id, message, remind_at, recurring) VALUES (?, ?, ?, ?, ?)",
+                (chat_id, user_id, message, remind_at, recurring)
+            )
