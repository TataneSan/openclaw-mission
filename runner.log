+package main
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestParsePath(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected int
+	}{
+		{"store.books[0].title", 4},
+		{"users[*].name", 2},
+		{"items[1:5]", 1},
+		{"data.nested.deep.value", 4},
+	}
+
+	for _, tt := range tests {
+		segments := parsePath(tt.input)
+		if len(segments) != tt.expected {
+			t.Errorf("parsePath(%q) got %d segments, want %d", tt.input, len(segments), tt.expected)
+		}
+	}
+}
+
+func TestResolvePath(t *testing.T) {
+	var data interface{}
+	json.Unmarshal([]byte(`{"users":[{"name":"Alice","age":30},{"name":"Bob","age":25}]}`), &data)
+
+	tests := []struct {
+		path     string
+		expected string
+	}{
+		{"users[0].name", `"Alice"`},
+		{"users[1].age", "25"},
+		{"users[-1].name", `"Bob"`},
+	}
+
+	for _, tt := range tests {
+		result, err := resolvePath(data, tt.path)
+		if err != nil {
+			t.Errorf("resolvePath(%q) error: %v", tt.path, err)
+			continue
+		}
+		b, _ := json.Marshal(result)
+		if string(b) != tt.expected {
+			t.Errorf("resolvePath(%q) = %s, want %s", tt.path, string(b), tt.expected)
+		}
+	}
+}
+
+func TestWildcard(t *testing.T) {
+	var data interface{}
+	json.Unmarshal([]byte(`{"items":[{"id":1},{"id":2},{"id":3}]}`), &data)
+
+	result, err := resolvePath(data, "items[*].id")
+	if err != nil {
+		t.Fatalf("wildcard error: %v", err)
+	}
