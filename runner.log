+		Level:  req.Level,
+		Msg:    req.Msg,
+		Source: req.Source,
+		Extra:  req.Extra,
+		TS:     time.Now().UTC(),
+	}
+
+	if err := l.repo.Save(ctx, entry); err != nil {
+		return nil, fmt.Errorf("failed to save entry: %w", err)
+	}
+
+	return entry, nil
+}
+
+func (l *Logger) GetEntries(ctx context.Context, level string, source string, limit int, offset int) ([]LogEntry, error) {
+	params := FilterParams{
