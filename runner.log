+package infrastructure
+
+import (
+	"fmt"
+	"os"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+// Parser reads and parses YAML config files.
+type Parser struct{}
+
+// ParseFile reads a YAML file and returns the config.
+func (p *Parser) ParseFile(path string) ([]byte, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("failed to read file %s: %w", path, err)
+	}
+	return data, nil
+}
+
+// Unmarshal converts YAML bytes to a string representation for validation.
+func (p *Parser) Unmarshal(data []byte) (string, error) {
+	// Validate YAML syntax by attempting to unmarshal
+	var raw map[string]interface{}
+	if err := yaml.Unmarshal(data, &raw); err != nil {
+		return "", fmt.Errorf("invalid YAML: %w", err)
+	}
+
+	// Check for required fields
+	servers, ok := raw["servers"]
+	if !ok {
+		return "", fmt.Errorf("missing required field 'servers'")
+	}
+
+	srvList, ok := servers.([]interface{})
+	if !ok || len(srvList) == 0 {
+		return "", fmt.Errorf("'servers' must be a non-empty list")
+	}
+
+	for i, srv := range srvList {
+		srvMap, ok := srv.(map[string]interface{})
+		if !ok {
+			return "", fmt.Errorf("server[%d] must be a mapping", i)
+		}
+
+		if _, ok := srvMap["listen"]; !ok {
+			return "", fmt.Errorf("server[%d]: missing required field 'listen'", i)
+		}
+		if _, ok := srvMap["server_name"]; !ok {
+			return "", fmt.Errorf("server[%d]: missing required field 'server_name'", i)
+		}
+	}
+
+	return strings.TrimSpace(string(data)), nil
+}
