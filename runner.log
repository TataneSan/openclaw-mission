+"""URL Shortener — FastAPI application."""
+
+from __future__ import annotations
+
+import os
+import re
+import secrets
+import string
+
+from fastapi import FastAPI, HTTPException, Request
+from fastapi.responses import RedirectResponse
+from pydantic import BaseModel, HttpUrl
+
+from . import database as db
+
+app = FastAPI(
+    title="URL Shortener",
+    description="Shorten URLs with click tracking and statistics.",
+    version="1.0.0",
+)
+
+CODE_LENGTH = int(os.environ.get("CODE_LENGTH", "6"))
+BASE_URL = os.environ.get("BASE_URL", "http://localhost:8000")
+
+VALID_CODE_RE = re.compile(r"^[a-zA-Z0-9_-]{3,32}$")
+
+
+class ShortenRequest(BaseModel):
+    url: str
+    custom_code: str | None = None
+
+
+class ShortenResponse(BaseModel):
+    short_url: str
+    code: str
+    original_url: str
+
+
+class StatsResponse(BaseModel):
+    code: str
+    original_url: str
+    created_at: str
+    click_count: int
+    recent_clicks: list[dict]
+    top_referrers: list[dict]
+
+
+def _generate_code(length: int = CODE_LENGTH) -> str:
+    alphabet = string.ascii_letters + string.digits
+    return "".join(secrets.choice(alphabet) for _ in range(length))
+
+
+@app.on_event("startup")
+async def startup():
+    db.init_db()
+
+
+@app.get("/")
+async def root():
+    return {
+        "service": "url-shortener",
+        "version": "1.0.0",
+        "endpoints": {
+            "POST /shorten": "Shorten a URL",
+            "GET /{code}": "Redirect to original URL",
+            "GET /stats/{code}": "Get click statistics",
+            "GET /urls": "List all shortened URLs",
+            "DELETE /urls/{code}": "Delete a shortened URL",
+            "GET /health": "Health check",
+        },
+    }
+
+
+@app.get("/health")
+async def health():
+    return {"status": "ok"}
+
