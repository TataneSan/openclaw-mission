+// ssh-key-gen generates SSH key pairs with a simple CLI interface.
+//
+// Supports ed25519, rsa, ecdsa key types with configurable options.
+//
+// Usage:
+//
+//	ssh-key-gen
+//	ssh-key-gen -t rsa -b 4096 -c "user@example.com"
+//	ssh-key-gen -t ed25519 -o ~/.ssh/id_ed25519
+package main
+
+import (
+	"crypto/rand"
+	"crypto/rsa"
+	"flag"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+)
+
+func main() {
+	fs := flag.NewFlagSet("ssh-key-gen", flag.ExitOnError)
+	keyType := fs.String("t", "ed25519", "key type: ed25519, rsa, ecdsa")
+	bits := fs.Int("b", 0, "key size in bits (RSA: 2048-16384, ECDSA: 256/384/521, Ed25519: fixed)")
+	comment := fs.String("c", "", "comment for the public key")
+	output := fs.String("o", "", "output path for private key (default: ~/.ssh/id_<type>)")
+	password := fs.Bool("p", false, "prompt for a passphrase")
+	noPrompt := fs.Bool("y", false, "overwrite existing key without prompting")
+	showPub := fs.Bool("show", true, "display the public key after generation")
+	fs.Usage = func() {
+		fmt.Fprintf(os.Stderr, "Usage: %s [options]\n\n", os.Args[0])
+		fmt.Fprintf(os.Stderr, "Generate SSH key pairs with a simple interface.\n\n")
+		fmt.Fprintf(os.Stderr, "Options:\n")
+		fs.PrintDefaults()
+		fmt.Fprintf(os.Stderr, `\nKey types:
+  ed25519  Recommended. Fast, secure, compact keys. (default)
+  rsa      Widely supported. Use -b 4096 for strong keys.
+  ecdsa    Elliptic curve. Use -b 256, 384, or 521.
+
