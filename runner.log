+package main
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strings"
+	"time"
+)
+
+type Commit struct {
+	Hash      string
+	ShortHash string
+	Author    string
+	Email     string
+	Date      time.Time
+	Subject   string
+	Body      string
+}
+
+func runGit(args ...string) (string, error) {
+	cmd := exec.Command("git", args...)
+	cmd.Dir = repoDir
+	out, err := cmd.Output()
+	return strings.TrimSpace(string(out)), err
+}
+
+func runGitFormat(format string) (string, error) {
+	return runGit("log", "-1", "--format="+format)
+}
+
+func getCommit() (*Commit, error) {
+	c := &Commit{}
+
+	hash, err := runGitFormat("%H")
+	if err != nil {
+		return nil, err
+	}
+	c.Hash = hash
+
+	shortHash, err := runGitFormat("%h")
+	if err != nil {
+		return nil, err
+	}
+	c.ShortHash = shortHash
+
+	author, err := runGitFormat("%an")
+	if err != nil {
+		return nil, err
+	}
+	c.Author = author
+
+	email, err := runGitFormat("%ae")
+	if err != nil {
+		return nil, err
+	}
+	c.Email = email
+
+	dateStr, err := runGitFormat("%aI")
+	if err != nil {
+		return nil, err
+	}
+	c.Date, err = time.Parse(time.RFC3339, dateStr)
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse date: %w", err)
+	}
+
+	subject, err := runGitFormat("%s")
+	if err != nil {
+		return nil, err
+	}
+	c.Subject = subject
+
+	body, err := runGitFormat("%b")
+	if err != nil {
+		return nil, err
+	}
+	c.Body = body
