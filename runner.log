+    level=logging.INFO,
+    format="%(asctime)s [%(levelname)s] %(message)s",
+)
+log = logging.getLogger(__name__)
+
+# Config
+BOT_TOKEN = os.environ.get("TELEGRAM_BOT_TOKEN", "")
+CHAT_ID = os.environ.get("TELEGRAM_CHAT_ID", "")
+WEBHOOK_SECRET = os.environ.get("GITHUB_WEBHOOK_SECRET", "")
+PORT = int(os.environ.get("PORT", "8000"))
+
+if not BOT_TOKEN or not CHAT_ID:
+    log.error("TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID are required")
+    sys.exit(1)
+
+bot = Bot(token=BOT_TOKEN)
+app = FastAPI(title="GitHub Notifier Bot", version="1.0.0")
+
+
+def _verify_signature(payload: bytes, signature: str) -> bool:
+    """Verify GitHub webhook signature."""
+    if not WEBHOOK_SECRET:
+        return True  # No secret configured, skip verification
+    if not signature.startswith("sha256="):
+        return False
+    expected = hmac.new(
+        WEBHOOK_SECRET.encode(), payload, hashlib.sha256
+    ).hexdigest()
+    return hmac.compare_digest(f"sha256={expected}", signature)
+
+
+def _format_push(data: dict) -> str:
+    repo = data["repository"]["full_name"]
+    pusher = data["pusher"]["name"]
+    branch = data["ref"].split("/")[-1]
+    commits = data.get("commits", [])
+    count = len(commits)
+
+    lines = [f"📤 <b>Push</b> to <code>{repo}:{branch}</code>"]
+    lines.append(f"by <b>{pusher}</b> — {count} commit{'s' if count != 1 else ''}"]
+
+    for c in commits[:5]:
+        msg = c["message"].split("\n")[0][:80]
+        sha = c["id"][:7]
+        lines.append(f"  • <code>{sha}</code> {msg}")
+
+    if count > 5:
+        lines.append(f"  ... and {count - 5} more")
+
+    return "\n".join(lines)
+
