+// quick-survey — create and analyze quick surveys in the terminal
+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+)
+
+const defaultDataFile = "surveys.json"
+
+type Response struct {
+	Value   string    `json:"value"`
+	Timestamp time.Time `json:"timestamp"`
+	Note    string    `json:"note,omitempty"`
+}
+
+type Survey struct {
+	ID         string     `json:"id"`
+	Title      string     `json:"title"`
+	Question   string     `json:"question"`
+	Options    []string   `json:"options"`
+	Responses  []Response `json:"responses"`
+	Created    string     `json:"created"`
+	AllowMulti bool       `json:"allow_multi,omitempty"`
+	AllowOther bool       `json:"allow_other,omitempty"`
+}
+
+type Data struct {
+	Surveys []Survey `json:"surveys"`
+}
+
+func dataPath() string {
+	if env := os.Getenv("QUICK_SURVEY_DATA"); env != "" {
+		return env
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return defaultDataFile
+	}
+	return filepath.Join(home, ".quick-survey", defaultDataFile)
+}
+
+func loadData() (*Data, error) {
+	path := dataPath()
+	bytes, err := os.ReadFile(path)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return &Data{Surveys: []Survey{}}, nil
+		}
+		return nil, err
+	}
+	var data Data
+	if err := json.Unmarshal(bytes, &data); err != nil {
+		return nil, err
+	}
+	if data.Surveys == nil {
+		data.Surveys = []Survey{}
+	}
+	return &data, nil
+}
+
+func saveData(data *Data) error {
+	path := dataPath()
+	dir := filepath.Dir(path)
