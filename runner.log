+def find_env_file(path: str | None) -> str | None:
+    """Find an env file to check."""
+    if path:
+        if os.path.isfile(path):
+            return path
+        return None
+
+    # Auto-detect common filenames
+    candidates = [
+        ".env.example",
+        ".env.sample",
+        ".env.template",
+        ".env.required",
+        ".env",
+    ]
+    for name in candidates:
+        if os.path.isfile(name):
+            return name
+    return None
+
+
+def print_table(results: dict, show_set: bool = False) -> None:
+    """Print results as a formatted table."""
+    missing = results["missing"]
+    empty = results["empty"]
+    env_set = results["set"]
+
+    if not missing and not empty and not show_set:
+        print(f"\n  {GREEN}✓ All environment variables are set!{RESET}\n")
+        return
+
+    # Calculate column widths
+    all_vars = missing + empty + (env_set if show_set else [])
+    if not all_vars:
+        print(f"\n  {GREEN}✓ All environment variables are set!{RESET}\n")
+        return
+
+    name_width = max(len(v.name) for v in all_vars) + 2
+    status_width = 10
+
+    # Header
+    print()
+    print(
+        f"  {BOLD}{'VARIABLE':<{name_width}}  {'STATUS':<{status_width}}  {'DEFAULT'}{RESET}"
+    )
+    print(f"  {'─' * name_width}  {'─' * status_width}  {'─' * 20}")
+
+    # Missing (red)
+    for var in missing:
+        default_str = var.default or "—"
+        desc = f"  {DIM}# {var.description}{RESET}" if var.description else ""
