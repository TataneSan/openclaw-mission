+	cpuAlert   = flag.Float64("cpu-alert", 0, "CPU usage threshold for alert (0 to disable)")
+	memAlert   = flag.Float64("mem-alert", 0, "Memory usage threshold for alert (0 to disable)")
+	sortBy     = flag.String("sort", "", "Sort by column: cpu, mem, net (default: docker order)")
+	noStream   = flag.Bool("no-stream", false, "Do not clear screen between updates")
+)
+
+func main() {
+	flag.Usage = func() {
+		fmt.Fprintf(flag.CommandLine.Output(), "Usage: %s [options]\n\n", os.Args[0])
+		fmt.Fprintf(flag.CommandLine.Output(), "Real-time Docker container stats viewer.\n\n")
+		fmt.Fprintf(flag.CommandLine.Output(), "Options:\n")
+		flag.PrintDefaults()
+		fmt.Fprintf(flag.CommandLine.Output(), "\nExamples:\n")
+		fmt.Fprintf(flag.CommandLine.Output(), "  %s                    # Stream all containers\n", os.Args[0])
