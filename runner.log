+//
+// Usage:
+//   regex-extract <pattern> [flags] [file...]
+//
+// Examples:
+//   regex-extract '[0-9]+\.json' *.json
+//   echo "hello world" | regex-extract 'l+'
+//   regex-extract '(?<email>[^@]+@[^@]+)' --named log.txt
