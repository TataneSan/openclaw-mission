+const express = require('express');
+const http = require('http');
+const https = require('https');
+const url = require('url');
+
+const app = express();
+app.use(express.json({ limit: '10mb' }));
+app.use(express.text());
+app.use(express.raw());
+
+// In-memory stores
+const routes = new Map();
+const deliveryLogs = [];
+const MAX_LOGS = 1000;
+
+// Forward payload to a target URL
+function forwardPayload(targetUrl, method, body, headers, retries = 3, retryDelay = 1000) {
+  return new Promise((resolve) => {
+    attempt(0);
+
+    function attempt(attemptNum) {
+      const parsed = url.parse(targetUrl);
+      if (!parsed.protocol) {
+        resolve({ error: 'Invalid URL', status: 'error', attempts: attemptNum + 1 });
+        return;
+      }
+
+      const client = parsed.protocol === 'https:' ? https : http;
+      const options = {
+        method: method || 'POST',
+        hostname: parsed.hostname,
+        port: parsed.port || (parsed.protocol === 'https:' ? 443 : 80),
+        path: parsed.path,
+        headers: Object.assign({}, headers || {}, {
+          'Content-Length': Buffer.isBuffer(body) ? body.length : Buffer.byteLength(body || '')
+        })
+      };
+
+      const startTime = Date.now();
+      const req = client.request(options, (res) => {
+        let data = '';
+        res.on('data', chunk => data += chunk);
+        res.on('end', () => {
+          const duration = Date.now() - startTime;
+          const success = res.statusCode >= 200 && res.statusCode < 300;
+
+          resolve({
+            statusCode: res.statusCode,
+            duration,
+            success,
+            attempts: attemptNum + 1,
+            responseBody: data.substring(0, 500)
+          });
+        });
+      });
+
+      req.on('error', (err) => {
+        const duration = Date.now() - startTime;
+        if (attemptNum < retries - 1) {
+          setTimeout(() => attempt(attemptNum + 1), retryDelay * (attemptNum + 1));
+        } else {
+          resolve({ error: err.message, duration, status: 'error', attempts: attemptNum + 1 });
+        }
+      });
+
+      req.setTimeout(30000, () => {
+        req.destroy();
+      });
+
+      if (body) {
+        req.write(body);
+      }
+      req.end();
+    }
+  });
+}
+
