+package generator
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"math/big"
+	mrand "math/rand"
+	"strings"
+	"time"
+)
+
+func init() {
+	mrand.Seed(time.Now().UnixNano())
+}
+
+// Int generates a random integer between min and max (inclusive).
+func Int(min, max int64) (int64, error) {
+	if min > max {
+		return 0, fmt.Errorf("min must be <= max")
+	}
+	if min == max {
+		return min, nil
+	}
+
+	n, err := rand.Int(rand.Reader, big.NewInt(max-min+1))
+	if err != nil {
+		return 0, fmt.Errorf("generate random: %w", err)
+	}
+
+	return min + n.Int64(), nil
+}
+
+// Float generates a random float64 between min and max with given precision.
+func Float(min, max float64, precision int) (float64, error) {
+	if min > max {
+		return 0, fmt.Errorf("min must be <= max")
+	}
+	if precision < 0 || precision > 15 {
+		precision = 4
+	}
+
+	n := mrand.Float64()
+	result := min + n*(max-min)
+
+	multiplier := 1.0
+	for i := 0; i < precision; i++ {
+		multiplier *= 10
+	}
+
+	return float64(int64(result*multiplier + 0.5)) / multiplier, nil
+}
+
+// UUID generates a random UUID v4 string.
+func UUID() (string, error) {
+	b := make([]byte, 16)
+	if _, err := rand.Read(b); err != nil {
+		return "", fmt.Errorf("generate uuid: %w", err)
+	}
+
+	b[6] = (b[6] & 0x0f) | 0x40
+	b[8] = (b[8] & 0x3f) | 0x80
+
+	return fmt.Sprintf("%s-%s-%s-%s-%s",
+		hex.EncodeToString(b[0:4]),
+		hex.EncodeToString(b[4:6]),
+		hex.EncodeToString(b[6:8]),
+		hex.EncodeToString(b[8:10]),
+		hex.EncodeToString(b[10:16]),
+	), nil
+}
+
+// String generates a random string of given length and type.
+func String(length int, strType string, charset string) (string, error) {
+	if length <= 0 {
+		return "", fmt.Errorf("length must be positive")
+	}
