+
+// SystemdRepository queries system services using systemctl and process information.
+type SystemdRepository struct{}
+
+// NewSystemdRepository creates a new SystemdRepository.
+func NewSystemdRepository() *SystemdRepository {
+	return &SystemdRepository{}
+}
+
+// EnumerateServices lists all services on the system.
+func (r *SystemdRepository) EnumerateServices(ctx context.Context) ([]service.ServiceStatus, error) {
+	cmd := exec.CommandContext(ctx, "systemctl", "list-units", "--type=service", "--all", "--no-pager", "--no-legend", "--plain")
+	output, err := cmd.Output()
+	if err != nil {
+		return nil, fmt.Errorf("failed to execute systemctl: %w", err)
+	}
+
+	lines := strings.Split(strings.TrimSpace(string(output)), "\n")
+	var services []service.ServiceStatus
+
+	for _, line := range lines {
+		if line == "" {
+			continue
+		}
+		status := parseSystemctlLine(line)
+		services = append(services, status)
+	}
+
+	return services, nil
+}
+
+// FetchService returns detailed status for a specific service.
+func (r *SystemdRepository) FetchService(ctx context.Context, name string) (*service.ServiceStatus, error) {
+	status := &service.ServiceStatus{
+		Name: name,
+	}
+
+	// Check if service exists and get its status
+	cmd := exec.CommandContext(ctx, "systemctl", "is-active", name)
+	output, err := cmd.Output()
+	state := strings.TrimSpace(string(output))
+	if err != nil && state != "inactive" && state != "activating" {
+		status.Error = fmt.Sprintf("service not found: %s", name)
+		return status, nil
+	}
+	status.Active = state == "active"
+
+	// Check if service is enabled
+	cmd = exec.CommandContext(ctx, "systemctl", "is-enabled", name)
+	output, err = cmd.Output()
+	enabledState := strings.TrimSpace(string(output))
+	if err == nil {
+		status.Enabled = enabledState == "enabled"
+	}
+
