+package infrastructure
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"strings"
+	"time"
+
+	"docker-logs-cli/internal/domain"
+)
+
+// DockerClient interacts with Docker via the CLI.
+type DockerClient struct {
+	binary string // path to docker binary
+}
+
+// NewDockerClient creates a new DockerClient.
+func NewDockerClient() *DockerClient {
+	return &DockerClient{binary: "docker"}
+}
+
+// checkDocker verifies that the docker CLI is available.
+func (c *DockerClient) checkDocker() error {
+	if _, err := exec.LookPath(c.binary); err != nil {
+		return fmt.Errorf("docker CLI not found in PATH")
+	}
+	return nil
+}
+
+// ListContainers returns all running container names and IDs.
+func (c *DockerClient) ListContainers(ctx context.Context) ([]string, error) {
+	if err := c.checkDocker(); err != nil {
+		return nil, err
+	}
+
+	cmd := exec.CommandContext(ctx, c.binary, "ps", "-q", "--format", "{{.Names}}")
+	output, err := cmd.Output()
+	if err != nil {
+		return nil, fmt.Errorf("failed to list containers: %w", err)
+	}
+
+	lines := strings.Split(strings.TrimSpace(string(output)), "\n")
+	var containers []string
+	for _, line := range lines {
+		line = strings.TrimSpace(line)
+		if line != "" {
+			containers = append(containers, line)
+		}
+	}
+	return containers, nil
+}
+
+// StreamLogs streams logs from one or more containers.
+func (c *DockerClient) StreamLogs(ctx context.Context, filter domain.Filter) (<-chan domain.LogEntry, <-chan error) {
+	logChan := make(chan domain.LogEntry, 100)
+	errChan := make(chan error, 1)
+
+	go func() {
+		defer close(logChan)
+		defer close(errChan)
+
+		if err := c.checkDocker(); err != nil {
+			errChan <- err
+			return
+		}
+
+		containers := filter.Containers
+		if len(containers) == 0 {
+			running, err := c.ListContainers(ctx)
+			if err != nil {
+				errChan <- fmt.Errorf("failed to list containers: %w", err)
+				return
+			}
+			containers = running
