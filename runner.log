+    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
+    level=logging.INFO,
+)
+logger = logging.getLogger(__name__)
+
+# Open-Meteo API
+GEOCODING_BASE = "https://geocoding-api.open-meteo.com/v1"
+WEATHER_BASE = "https://api.open-meteo.com/v1"
