+package infrastructure
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/TataneSan/log-analyzer/internal/model"
+)
+
+var (
+	// Combined Log Format: 127.0.0.1 - frank [10/Oct/2000:13:55:36 -0700] "GET /apache_pb.gif HTTP/1.0" 200 2326 "http://www.example.com/start.html" "Mozilla/4.08 ..."
+	combinedRE = regexp.MustCompile(`^(\S+)\s+\S+\s+\S+\s+\[([^\]]+)\]\s+"(\S+)\s+(\S+)\s*([^"]*)"\s+(\d{3})\s+(\d+|-)(?:\s+"([^"]*)")?(?:\s+"([^"]*)")?.*$`)
+
+	// Common Log Format: 127.0.0.1 - frank [10/Oct/2000:13:55:36 -0700] "GET /apache_pb.gif HTTP/1.0" 200 2326
+	commonRE = regexp.MustCompile(`^(\S+)\s+\S+\s+\S+\s+\[([^\]]+)\]\s+"(\S+)\s+(\S+)\s*([^"]*)"\s+(\d{3})\s+(\d+|-)$`)
+)
+
+// Parser reads log files and yields parsed entries.
+type Parser struct{}
+
+// ParseFile parses a log file and returns all entries.
+func (p *Parser) ParseFile(path string) ([]model.Entry, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, fmt.Errorf("failed to open file: %w", err)
+	}
+	defer f.Close()
+
+	var entries []model.Entry
+	scanner := bufio.NewScanner(f)
+	// Increase buffer for long log lines
+	buf := make([]byte, 0, 64*1024)
+	scanner.Buffer(buf, 1024*1024)
+
+	lineNum := 0
+	for scanner.Scan() {
+		lineNum++
+		line := strings.TrimSpace(scanner.Text())
+		if line == "" {
+			continue
+		}
+		entry, err := p.parseLine(line)
+		if err != nil {
+			continue // skip unparseable lines
+		}
+		entries = append(entries, entry)
+	}
+
+	if err := scanner.Err(); err != nil {
+		return nil, fmt.Errorf("error reading file: %w", err)
+	}
+	return entries, nil
+}
+
+func (p *Parser) parseLine(line string) (model.Entry, error) {
+	matches := combinedRE.FindStringSubmatch(line)
+	if matches == nil {
+		matches = commonRE.FindStringSubmatch(line)
+		if matches == nil {
+			return model.Entry{}, fmt.Errorf("unparseable line")
+		}
+		// common format has fewer groups; pad
+		matches = append(matches, "", "")
+	}
+
+	status, _ := strconv.Atoi(matches[6])
+	bytesStr := matches[7]
+	bytes := int64(0)
+	if bytesStr != "-" {
+		bytes, _ = strconv.ParseInt(bytesStr, 10, 64)
+	}
+
+	ts, _ := time.Parse("02/Jan/2006:15:04:05 -0700", matches[2])
