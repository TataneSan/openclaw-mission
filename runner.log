+package handlers
+
+import (
+	"encoding/json"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+)
+
+// Config holds the server configuration.
+type Config struct {
+	CORS   bool
+	Silent bool
+}
+
+// Store holds all counters with thread-safe access.
+type Store struct {
+	mu       sync.RWMutex
+	counters map[string]int64
+}
+
+var store = &Store{
+	counters: make(map[string]int64),
+}
+
+// NewMux creates the HTTP multiplexer with all routes.
+func NewMux(cfg *Config) *http.ServeMux {
+	mux := http.NewServeMux()
+	h := &handler{cfg: cfg}
+
+	mux.HandleFunc("/", h.list)
+	mux.HandleFunc("/counter/", h.counter)
+	mux.HandleFunc("/counter", h.resetAll)
+
+	return mux
+}
+
+type handler struct {
+	cfg *Config
+}
+
+func (h *handler) cors(w http.ResponseWriter) {
+	if h.cfg.CORS {
+		w.Header().Set("Access-Control-Allow-Origin", "*")
+		w.Header().Set("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS")
+		w.Header().Set("Access-Control-Allow-Headers", "*")
+	}
+}
+
+func (h *handler) jsonResponse(w http.ResponseWriter, data interface{}, status int) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	json.NewEncoder(w).Encode(data)
+}
+
+func (h *handler) list(w http.ResponseWriter, r *http.Request) {
+	h.cors(w)
+
+	if r.Method == http.MethodOptions {
+		w.WriteHeader(204)
+		return
+	}
+
+	if r.Method != http.MethodGet {
+		h.jsonResponse(w, map[string]string{"error": "method not allowed"}, http.StatusMethodNotAllowed)
+		return
+	}
+
+	store.mu.RLock()
+	counters := make(map[string]int64, len(store.counters))
+	for k, v := range store.counters {
+		counters[k] = v
+	}
+	store.mu.RUnlock()
+
+	h.jsonResponse(w, counters, http.StatusOK)
+}
