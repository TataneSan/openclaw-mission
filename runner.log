+// yaml-to-csv converts YAML to CSV.
+//
+// Reads YAML from stdin or a file and outputs CSV to stdout or a file.
+// Supports YAML documents containing lists of mappings.
+package main
+
+import (
+	"bytes"
+	"encoding/csv"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+func run() int {
+	var (
+		input     = flag.String("f", "", "input file (default: stdin)")
+		output    = flag.String("o", "", "output file (default: stdout)")
+		delimiter = flag.String("d", ",", "field delimiter")
+	)
+	flag.Parse()
+
+	// Read input
+	var reader io.Reader
+	if *input != "" {
+		f, err := os.Open(*input)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "error: %v\n", err)
+			return 1
+		}
+		defer f.Close()
+		reader = f
+	} else {
+		reader = os.Stdin
+	}
+
+	data, err := io.ReadAll(reader)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "error reading input: %v\n", err)
+		return 1
+	}
+
+	// Parse YAML
+	var parsed any
+	if err := yaml.Unmarshal(data, &parsed); err != nil {
+		fmt.Fprintf(os.Stderr, "error parsing YAML: %v\n", err)
+		return 1
+	}
+
+	// Convert to list of maps
+	records, err := toRecords(parsed)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "error: %v\n", err)
+		return 1
+	}
+
+	if len(records) == 0 {
+		return 0
+	}
+
+	// Collect all headers in order
+	headers := collectHeaders(records)
+
+	// Write CSV
+	var buf bytes.Buffer
+	writer := csv.NewWriter(&buf)
+	writer.Comma = rune((*delimiter)[0])
+
+	// Header row
+	if err := writer.Write(headers); err != nil {
+		fmt.Fprintf(os.Stderr, "error writing header: %v\n", err)
+		return 1
+	}
+
