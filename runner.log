+package main
+
+import (
+	"log"
+	"net/http"
+	"os"
+
+	"github.com/TataneSan/log-api/internal/application"
+	"github.com/TataneSan/log-api/internal/domain"
+	"github.com/TataneSan/log-api/internal/infrastructure"
+)
+
+func main() {
+	port := os.Getenv("PORT")
+	if port == "" {
+		port = "8080"
+	}
+
+	repo := infrastructure.NewInMemoryLogRepository()
+	logger := domain.NewLogger(repo)
+	handler := application.NewHandler(logger)
+
+	addr := ":" + port
+	log.Printf("log-api starting on %s", addr)
+
+	if err := http.ListenAndServe(addr, handler); err != nil {
+		log.Fatalf("server failed: %v", err)
+	}
+}
