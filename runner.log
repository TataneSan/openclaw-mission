+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/BurntSushi/toml"
+)
+
+// flatten recursively flattens a nested map into dot-notation keys
+func flatten(m map[string]interface{}, prefix string, result map[string]interface{}) {
+	for k, v := range m {
+		key := k
+		if prefix != "" {
+			key = prefix + "." + k
+		}
+
+		switch val := v.(type) {
+		case map[string]interface{}:
+			flatten(val, key, result)
+		case []interface{}:
+			// Check if it's an array of tables
+			allTables := true
+			for _, item := range val {
+				if _, ok := item.(map[string]interface{}); !ok {
+					allTables = false
+					break
+				}
+			}
+			if allTables {
+				for i, item := range val {
+					arrKey := fmt.Sprintf("%s[%d]", key, i)
+					flatten(item.(map[string]interface{}), arrKey, result)
+				}
+			} else {
+				result[key] = val
+			}
+		default:
+			result[key] = val
+		}
+	}
+}
+
+// formatValue formats a value for display
+func formatValue(v interface{}) string {
+	if v == nil {
+		return "null"
+	}
+
+	switch val := v.(type) {
+	case bool:
+		return fmt.Sprintf("%v", val)
+	case string:
+		return val
+	case int64, int:
+		return fmt.Sprintf("%d", val)
+	case float64:
+		if val == float64(int64(val)) {
+			return fmt.Sprintf("%d", int64(val))
+		}
+		return fmt.Sprintf("%g", val)
+	case time.Time:
+		return val.Format(time.RFC3339)
+	case []interface{}:
+		data, _ := json.Marshal(val)
+		return string(data)
+	case map[string]interface{}:
+		return "[table]"
+	default:
+		return fmt.Sprintf("%v", val)
+	}
+}
+
+func printUsage() {
+	fmt.Println("toml-cli - Parse and query TOML files")
