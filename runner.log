+package interfaces
+
+import (
+	"encoding/json"
+	"math/rand"
+	"net/http"
+
+	"github.com/gorilla/mux"
+
+	"github.com/TataneSan/redirect-api/internal/infrastructure"
+)
+
+func CreateRedirectHandler(store *infrastructure.Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var req domain.Redirect
+		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+			writeError(w, http.StatusBadRequest, "invalid JSON body")
+			return
+		}
+		defer r.Body.Close()
+
+		if req.DestURL == "" {
+			writeError(w, http.StatusBadRequest, "dest_url is required")
+			return
+		}
+
+		result := store.CreateRedirect(&req)
+		writeJSON(w, http.StatusCreated, result)
+	}
+}
+
+func ListRedirectsHandler(store *infrastructure.Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		redirects := store.ListRedirects()
+		writeJSON(w, http.StatusOK, redirects)
+	}
+}
+
+func GetRedirectHandler(store *infrastructure.Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		vars := mux.Vars(r)
+		id := vars["id"]
+
+		redirect, err := store.GetRedirect(id)
+		if err != nil {
+			writeError(w, http.StatusNotFound, err.Error())
+			return
+		}
+		writeJSON(w, http.StatusOK, redirect)
+	}
+}
+
