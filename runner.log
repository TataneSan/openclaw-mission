+package service
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"log"
+	"net/http"
+	"sync"
+	"time"
+)
+
+// Notifier handles sending notifications through multiple channels.
+type Notifier struct {
+	mu sync.Mutex
+}
+
+// New creates a new Notifier.
+func New() *Notifier {
+	return &Notifier{}
+}
+
+// SendRequest represents a notification to send.
+type SendRequest struct {
+	Channel string `json:"channel"`
+	To      string `json:"to"`
+	Subject string `json:"subject"`
+	Body    string `json:"body"`
+}
+
+// SendResult represents the result of sending a notification.
+type SendResult struct {
+	Success bool   `json:"success"`
+	Channel string `json:"channel"`
+	Message string `json:"message"`
+}
+
+// Send dispatches a notification through the specified channel.
+func (n *Notifier) Send(req SendRequest) SendResult {
+	switch req.Channel {
+	case "webhook":
+		return n.sendWebhook(req)
+	case "email":
+		return n.sendEmail(req)
+	case "slack":
+		return n.sendSlack(req)
+	default:
+		return SendResult{
+			Success: false,
+			Channel: req.Channel,
+			Message: fmt.Sprintf("unsupported channel: %s (supported: webhook, email, slack)", req.Channel),
+		}
+	}
+}
+
+func (n *Notifier) sendWebhook(req SendRequest) SendResult {
+	if req.To == "" {
+		return SendResult{Success: false, Channel: "webhook", Message: "webhook URL is required"}
+	}
+
+	payload := map[string]string{
+		"subject": req.Subject,
+		"body":    req.Body,
+		"ts":      time.Now().UTC().Format(time.RFC3339),
+	}
+
+	data, err := json.Marshal(payload)
+	if err != nil {
+		return SendResult{Success: false, Channel: "webhook", Message: "failed to marshal payload: " + err.Error()}
+	}
+
+	client := &http.Client{Timeout: 10 * time.Second}
+	resp, err := client.Post(req.To, "application/json", bytes.NewReader(data))
+	if err != nil {
+		return SendResult{Success: false, Channel: "webhook", Message: "request failed: " + err.Error()}
+	}
+	defer resp.Body.Close()
+
