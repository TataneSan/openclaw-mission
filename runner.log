+// captcha-api — Simple CAPTCHA generation and verification API.
+//
+// Supports text and math CAPTCHAs with PNG image generation.
+package main
+
+import (
+	"crypto/rand"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"image"
+	"image/color"
+	"image/draw"
+	"image/jpeg"
+	"image/png"
+	"math"
+	"math/big"
+	"math/trap"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+const (
+	defaultWidth  = 200
+	defaultHeight = 80
+	captchaTTL    = 5 * time.Minute
+)
+
+// Store holds generated CAPTCHAs in memory.
+type Store struct {
+	mu      sync.RWMutex
+	captchas map[string]*Captcha
+}
+
+// Captcha represents a generated CAPTCHA.
+type Captcha struct {
+	ID      string    `json:"id"`
+	Answer  string    `json:"-"`
+	Type    string    `json:"type"`
+	Created time.Time `json:"created"`
+	Expired bool      `json:"-"`
+}
+
+// CaptchaResponse is the JSON response for CAPTCHA generation.
+type CaptchaResponse struct {
+	ID     string `json:"id"`
+	Type   string `json:"type"`
+	Image  string `json:"image"` // base64-encoded PNG
+	Hint   string `json:"hint,omitempty"`
+	Expiry int    `json:"expiry_seconds"`
+}
+
+// VerifyRequest is the JSON body for verification.
+type VerifyRequest struct {
+	ID     string `json:"id"`
+	Answer string `json:"answer"`
+}
+
+// VerifyResponse is the JSON response for verification.
+type VerifyResponse struct {
+	Valid   bool   `json:"valid"`
+	Message string `json:"message"`
+}
+
+var store = &Store{
+	captchas: make(map[string]*Captcha),
+}
+
+// Cleanup expired CAPTCHAs periodically.
+func init() {
+	go func() {
+		ticker := time.NewTicker(1 * time.Minute)
+		for range ticker.C {
+			store.cleanup()
+		}
