+
+# ANSI colors
+RED = "\033[31m"
+GREEN = "\033[32m"
+YELLOW = "\033[33m"
+BLUE = "\033[34m"
+MAGENTA = "\033[35m"
+CYAN = "\033[36m"
+BOLD = "\033[1m"
+DIM = "\033[2m"
+RESET = "\033[0m"
+
+# Heatmap characters (light to dense)
+HEATMAP_CHARS = " ░▒▓█"
+WEEKDAY_NAMES = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]
+
+
+def print_header(text: str):
+    """Print a section header."""
+    print(f"\n  {BOLD}{CYAN}{text}{RESET}")
+    print(f"  {'─' * 50}")
+
+
+def format_number(n: int) -> str:
+    """Format a number with commas."""
+    return f"{n:,}"
+
+
+def print_overview(stats: RepoStats):
+    """Print repository overview."""
+    print_header("Repository Overview")
+    print(f"  Path:          {stats.repo_path}")
+    print(f"  First commit:  {stats.first_commit or 'N/A'}")
+    print(f"  Last commit:   {stats.last_commit or 'N/A'}")
+    print(f"  Total commits: {format_number(stats.total_commits)}")
+    print(f"  Active days:   {stats.active_days}")
+    print(f"  Insertions:    {GREEN}+{format_number(stats.total_insertions)}{RESET}")
+    print(f"  Deletions:     {RED}-{format_number(stats.total_deletions)}{RESET}")
+
+
+def print_contributors(stats: RepoStats, limit: int = 15):
+    """Print top contributors."""
+    print_header(f"Top Contributors (by commits)")
+
+    if not stats.contributors:
+        print(f"  {DIM}No contributors found{RESET}")
+        return
+
+    max_commits = stats.contributors[0].commits if stats.contributors else 1
+    bar_width = 30
+
+    for i, c in enumerate(stats.contributors[:limit]):
+        bar_len = int((c.commits / max_commits) * bar_width)
+        bar = "█" * bar_len + "░" * (bar_width - bar_len)
+        net = c.insertions - c.deletions
+        net_str = f"{GREEN}+{net}{RESET}" if net >= 0 else f"{RED}{net}{RESET}"
+
+        print(f"  {BOLD}{c.name:<20}{RESET} {bar} {BOLD}{c.commits:>5}{RESET} commits  "
+              f"{GREEN}+{c.insertions}{RESET} {RED}-{c.deletions}{RESET} ({net_str})")
+
+
+def print_hourly_heatmap(stats: RepoStats):
+    """Print commit activity by hour."""
+    print_header("Activity by Hour")
+
+    if not stats.hourly_activity:
+        return
