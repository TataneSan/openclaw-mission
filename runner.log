+// cors-proxy is a simple CORS proxy that forwards HTTP requests to target URLs
+// while adding appropriate CORS headers to the responses.
+//
+// Usage:
+//   cors-proxy [flags]
+//
+// Flags:
+//   -port int     Port to listen on (default 8080)
+//   -host string  Host to bind to (default "127.0.0.1")
+//   -allow-origin string  Allowed origin (default "*")
+//   -timeout int  Request timeout in seconds (default 30)
 package main
 
 import (
+	"bytes"
 	"flag"
 	"fmt"
+	"io"
 	"log"
 	"net/http"
 	"net/http/httputil"
 	"net/url"
 	"os"
 	"os/signal"
+	"strings"
 	"syscall"
 	"time"
 )
 
+type config struct {
+	port        int
+	host        string
+	allowOrigin string
+	timeout     time.Duration
+}
+
+func parseConfig() config {
+	cfg := config{}
+	flag.IntVar(&cfg.port, "port", 8080, "port to listen on")
+	flag.StringVar(&cfg.host, "host", "127.0.0.1", "host to bind to")
+	flag.StringVar(&cfg.allowOrigin, "allow-origin", "*", "allowed origin for CORS")
+	flag.IntVar((*int)(&cfg.timeout), "timeout", 30, "request timeout in seconds")
+	flag.Parse()
+
+	if cfg.timeout <= 0 {
+		cfg.timeout = 30 * time.Second
+	} else {
+		cfg.timeout = time.Duration(cfg.timeout) * time.Second
+	}
+
+	return cfg
+}
+
+func corsHeaders(next http.Handler, allowOrigin string) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Access-Control-Allow-Origin", allowOrigin)
+		w.Header().Set("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, PATCH, OPTIONS, HEAD")
+		w.Header().Set("Access-Control-Allow-Headers",
+			"Content-Type, Authorization, X-Requested-With, Accept, Origin")
+		w.Header().Set("Access-Control-Allow-Credentials", "true")
+		w.Header().Set("Access-Control-Max-Age", "86400")
+
+		if r.Method == http.MethodOptions {
+			w.WriteHeader(http.StatusNoContent)
+			return
+		}
+
+		next.ServeHTTP(w, r)
+	})
+}
+
+func proxyHandler(timeout time.Duration) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		targetURL := r.URL.Query().Get("url")
+		if targetURL == "" {
+			http.Error(w, `{"error": "missing 'url' query parameter"}`, http.StatusBadRequest)
+			return
+		}
