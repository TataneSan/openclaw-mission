+package handlers
+
+import (
+	"bytes"
+	"compress/gzip"
+	"encoding/json"
+	"fmt"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"net/url"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Config holds the server configuration.
+type Config struct {
+	DefaultStatus int
+	DefaultDelay  time.Duration
+	DefaultBody   string
+	JSONResponse  bool
+	BasicUser     string
+	BasicPass     string
+	CORS          bool
+	Silent        bool
+}
+
+// NewMux creates and returns the HTTP multiplexer with all routes configured.
+func NewMux(cfg *Config) *http.ServeMux {
+	mux := http.NewServeMux()
+
+	h := &handler{cfg: cfg}
+
+	// Static endpoints
+	mux.HandleFunc("/", h.index)
+	mux.HandleFunc("/get", h.echo)
+	mux.HandleFunc("/post", h.echo)
+	mux.HandleFunc("/put", h.echo)
+	mux.HandleFunc("/delete", h.echo)
+	mux.HandleFunc("/patch", h.echo)
+	mux.HandleFunc("/headers", h.headers)
+	mux.HandleFunc("/json", h.json)
+	mux.HandleFunc("/html", h.html)
+	mux.HandleFunc("/cookies", h.cookies)
+	mux.HandleFunc("/response-headers", h.responseHeaders)
+	mux.HandleFunc("/gzip", h.gzip)
+
+	// Pattern-based endpoints
+	mux.HandleFunc("/delay/", h.delay)
+	mux.HandleFunc("/status/", h.statusCode)
+	mux.HandleFunc("/basic-auth/", h.basicAuth)
+	mux.HandleFunc("/stream/", h.stream)
+
+	return mux
+}
+
+type handler struct {
+	cfg *Config
+}
+
+func (h *handler) logf(format string, args ...interface{}) {
+	if !h.cfg.Silent {
+		log.Printf(format, args...)
+	}
+}
+
+func (h *handler) applyCors(w http.ResponseWriter) {
+	if !h.cfg.CORS {
+		return
+	}
+	w.Header().Set("Access-Control-Allow-Origin", "*")
+	w.Header().Set("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, PATCH, OPTIONS")
+	w.Header().Set("Access-Control-Allow-Headers", "*")
+}
