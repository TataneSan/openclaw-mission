+package infrastructure
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/TataneSan/quick-survey/internal/domain"
+)
+
+type JSONVoteStore struct {
+	dataDir string
+}
+
+func NewJSONVoteStore(dataDir string) *JSONVoteStore {
+	if err := os.MkdirAll(dataDir, 0755); err != nil {
+		panic(err)
+	}
+	return &JSONVoteStore{dataDir: dataDir}
+}
+
+func (s *JSONVoteStore) votesPath() string {
+	return filepath.Join(s.dataDir, "votes.json")
+}
+
+func (s *JSONVoteStore) loadVotes() ([]domain.Vote, error) {
+	data, err := os.ReadFile(s.votesPath())
+	if err != nil {
+		if os.IsNotExist(err) {
+			return []domain.Vote{}, nil
+		}
+		return nil, fmt.Errorf("failed to read votes: %w", err)
+	}
+	var votes []domain.Vote
+	if err := json.Unmarshal(data, &votes); err != nil {
+		return nil, fmt.Errorf("failed to unmarshal votes: %w", err)
+	}
+	return votes, nil
+}
+
+func (s *JSONVoteStore) saveVotes(votes []domain.Vote) error {
+	data, err := json.MarshalIndent(votes, "", "  ")
+	if err != nil {
+		return fmt.Errorf("failed to marshal votes: %w", err)
+	}
+	return os.WriteFile(s.votesPath(), data, 0644)
+}
+
+func (s *JSONVoteStore) Add(vote domain.Vote) error {
+	vote.VotedAt = time.Now()
+	votes, err := s.loadVotes()
+	if err != nil {
+		return err
+	}
+	votes = append(votes, vote)
+	return s.saveVotes(votes)
+}
+
+func (s *JSONVoteStore) GetBySurvey(surveyID string) ([]domain.Vote, error) {
+	votes, err := s.loadVotes()
+	if err != nil {
+		return nil, err
+	}
+	var result []domain.Vote
+	for _, v := range votes {
+		if v.SurveyID == surveyID {
+			result = append(result, v)
+		}
+	}
+	return result, nil
+}
