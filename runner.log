+"""Image compression API."""
+
+from fastapi import FastAPI, HTTPException, UploadFile, File, Query, Form
+from fastapi.middleware.cors import CORSMiddleware
+from fastapi.responses import Response
+from pydantic import BaseModel
+from PIL import Image
+import io
+import base64
+
+app = FastAPI(
+    title="Image Compress API",
+    description="Compress and optimize images (JPEG, PNG, WebP)",
+    version="1.0.0",
+)
+
+app.add_middleware(
+    CORSMiddleware,
+    allow_origins=["*"],
+    allow_methods=["*"],
+    allow_headers=["*"],
+)
+
+MAX_FILE_SIZE = 20 * 1024 * 1024  # 20MB
+SUPPORTED_FORMATS = {"JPEG", "PNG", "WEBP", "GIF", "BMP", "TIFF"}
+
+
+class CompressResult(BaseModel):
+    original_size: int
+    compressed_size: int
+    savings_pct: float
+    format: str
+    width: int
+    height: int
+    base64: str
+
+
+class InfoResult(BaseModel):
+    format: str
+    mode: str
+    width: int
+    height: int
+    size_bytes: int
+
+
+def get_format_mimetype(fmt: str) -> str:
+    return {"JPEG": "image/jpeg", "PNG": "image/png", "WEBP": "image/webp", "GIF": "image/gif"}.get(fmt, "application/octet-stream")
+
+
+def compress_image(
+    img: Image.Image,
+    format: str = "JPEG",
+    quality: int = 80,
+    max_width: int = None,
+    max_height: int = None,
+) -> tuple[bytes, str]:
+    """Compress an image and return bytes + format."""
+    if max_width or max_height:
+        w, h = img.size
+        ratio = 1.0
+        if max_width and w > max_width:
+            ratio = min(ratio, max_width / w)
+        if max_height and h > max_height:
+            ratio = min(ratio, max_height / h)
+        if ratio < 1.0:
+            img = img.resize((int(w * ratio), int(h * ratio)), Image.LANCZOS)
+
+    if format == "JPEG" and img.mode in ("RGBA", "P", "LA"):
+        img = img.convert("RGB")
+    elif format == "PNG" and img.mode == "P":
+        img = img.convert("RGBA")
+
+    buf = io.BytesIO()
+    save_kwargs = {}
+    fmt = format.upper()
+
+    if fmt == "JPEG":
+        save_kwargs = {"quality": quality, "optimize": True, "progressive": True}
