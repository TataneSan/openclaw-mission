+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+
+	"github.com/TataneSan/cli-dictionary/internal/client"
+)
+
+func main() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	cmd := os.Args[1]
+	args := os.Args[2:]
+
+	switch cmd {
+	case "define", "def":
+		handleDefine(args)
+	case "synonyms", "syn":
+		handleSynonyms(args)
+	case "antonyms", "ant":
+		handleAntonyms(args)
+	case "lookup", "look":
+		handleLookup(args)
+	case "help", "-h", "--help":
+		printUsage()
+	case "version", "-v", "--version":
+		fmt.Println("cli-dictionary v1.0.0")
+	default:
+		fmt.Fprintf(os.Stderr, "Error: unknown command '%s'\n\n", cmd)
+		printUsage()
+		os.Exit(1)
+	}
+}
+
+func handleDefine(args []string) {
+	if len(args) == 0 {
+		fmt.Fprintln(os.Stderr, "Error: word required")
+		fmt.Fprintln(os.Stderr, "Usage: cli-dictionary define <word>")
+		os.Exit(1)
+	}
+
+	word := strings.Join(args, " ")
+	dict := client.NewDictionary()
+
