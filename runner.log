+package backup
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+// BackupConfig holds the configuration for a backup operation.
+type BackupConfig struct {
+	SourceDir    string        // Source directory to backup
+	DestDir      string        // Destination directory for backups
+	MaxBackups   int           // Maximum number of backups to keep (0 = unlimited)
+	Compression  bool          // Whether to compress backups
+	Exclude      []string      // Patterns to exclude (glob patterns)
+	Retention    time.Duration // How long to keep backups (0 = forever)
+	Timestamp    string        // Timestamp format for backup names
+}
+
+// BackupStatus represents the status of a backup operation.
+type BackupStatus struct {
+	Source       string    `json:"source"`
+	Destination  string    `json:"destination"`
+	BackupName   string    `json:"backup_name"`
+	FilesBacked  int       `json:"files_backed_up"`
+	FilesSkipped int       `json:"files_skipped"`
+	TotalSize    int64     `json:"total_size_bytes"`
+	BackupSize   int64     `json:"backup_size_bytes"`
+	Duration     string    `json:"duration"`
+	StartTime    time.Time `json:"start_time"`
+	EndTime      time.Time `json:"end_time"`
+	Error        string    `json:"error,omitempty"`
+}
+
+// BackupManager handles backup operations.
+type BackupManager struct {
+	repo BackupRepository
+}
+
+// BackupRepository defines the interface for backup storage operations.
+type BackupRepository interface {
+	CreateBackup(ctx context.Context, config BackupConfig) (*BackupStatus, error)
+	ListBackups(ctx context.Context, destDir string) ([]BackupStatus, error)
+	RestoreBackup(ctx context.Context, backupPath, restoreDir string) error
+	DeleteBackup(ctx context.Context, backupPath string) error
+	GetBackupInfo(ctx context.Context, backupPath string) (*BackupStatus, error)
+}
+
+// NewBackupManager creates a new BackupManager with the given repository.
+func NewBackupManager(repo BackupRepository) *BackupManager {
+	return &BackupManager{repo: repo}
+}
+
+// CreateBackup performs a backup of the source directory.
+func (bm *BackupManager) CreateBackup(ctx context.Context, config BackupConfig) (*BackupStatus, error) {
+	if err := validateConfig(config); err != nil {
+		return nil, fmt.Errorf("invalid configuration: %w", err)
+	}
+
+	status, err := bm.repo.CreateBackup(ctx, config)
+	if err != nil {
+		return nil, fmt.Errorf("backup failed: %w", err)
+	}
+
+	return status, nil
+}
