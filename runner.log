+// git-diff-files lists files modified between two git commits.
+package main
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"strings"
+)
+
+type ChangeType int
+
+const (
+	Added ChangeType = iota
+	Modified
+	Deleted
+	Renamed
+)
+
+func (c ChangeType) label() string {
+	switch c {
+	case Added:
+		return "A"
+	case Modified:
+		return "M"
+	case Deleted:
+		return "D"
+	case Renamed:
+		return "R"
+	}
+	return "?"
+}
+
+func main() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	refs := os.Args[1:]
+	if len(refs) > 2 {
+		fatal(fmt.Errorf("expected 1-2 arguments"))
+	}
+
+	var left, right string
+	switch len(refs) {
+	case 1:
+		right = refs[0]
+	case 2:
+		left = refs[0]
+		right = refs[1]
+	}
+
+	files, err := getDiff(left, right)
+	if err != nil {
+		fatal(err)
+	}
+
+	for _, f := range files {
+		fmt.Printf("[%s] %s\n", f.typ.label(), f.path)
+	}
+}
+
+type diffFile struct {
+	typ  ChangeType
+	path string
+}
+
+func getDiff(left, right string) ([]diffFile, error) {
+	args := []string{"diff", "--name-status"}
+	if left != "" {
+		args = append(args, left, right)
+	} else {
+		args = append(args, right)
+	}
+
+	cmd := exec.Command("git", args...)
+	out, err := cmd.Output()
