+// LogEntry represents a single log line from a Docker container.
+type LogEntry struct {
+	Container string
+	Stream    string // "stdout" or "stderr"
+	Message   string
+	Timestamp time.Time
+}
+
+// Filter defines criteria for filtering log entries.
+type Filter struct {
+	Containers []string // container names or IDs (empty = all)
+	Level      string   // log level filter (info, warn, error, etc.)
+	Since      string   // show logs since timestamp (e.g., "10m", "2h")
+	Follow     bool     // follow log output in real-time
+	Tail       string   // number of lines from the end ("all" or number)
+	Grep       string   // regex pattern to match in log messages
+	Stream     string   // filter by stream: "stdout", "stderr", or "all"
+}
