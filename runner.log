+const (
+	vaultFile   = ".secrets"
+	keyLen      = 32 // AES-256
+	nonceLen    = 12
+)
+
+// Secret represents a single secret entry.
+type Secret struct {
+	Key       string    `json:"key"`
+	Value     string    `json:"-"`
+	Group     string    `json:"group"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+	Tags      []string  `json:"tags,omitempty"`
+}
+
+// SecretEntry is the JSON-serializable form (without plaintext value).
+type SecretEntry struct {
+	Key       string   `json:"key"`
+	Value     string   `json:"value"`
+	Group     string   `json:"group"`
+	CreatedAt string   `json:"created_at"`
+	UpdatedAt string   `json:"updated_at"`
+	Tags      []string `json:"tags,omitempty"`
+}
+
+// Vault manages encrypted secrets.
+type Vault struct {
+	path    string
+	key     []byte
+	secrets []Secret
+}
+
+// New creates a new Vault at the given path with the given password.
+func New(path string, password string) (*Vault, error) {
+	if password == "" {
+		return nil, fmt.Errorf("password is required")
+	}
+
+	key := deriveKey(password)
+	v := &Vault{
+		path:    path,
+		key:     key,
+		secrets: []Secret{},
+	}
+
+	if err := v.load(); err != nil {
+		return nil, err
+	}
+
+	return v, nil
+}
+
+// NewDefault creates a vault at the default location.
+func NewDefault(password string) (*Vault, error) {
+	return New(filepath.Join(".", vaultFile), password)
+}
