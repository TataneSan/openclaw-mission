+package main
+
+import (
+	"fmt"
+	"log"
+	"net/http"
+	"os"
+	"rate-limiter-api/internal/infrastructure"
+	"rate-limiter-api/internal/interfaces"
+	"strconv"
+)
+
+func main() {
+	port := os.Getenv("PORT")
+	if port == "" {
+		port = "8080"
+	}
+
+	service := infrastructure.NewTokenBucketService()
+	handler := interfaces.NewHandler(service)
+	router := handler.Router()
+
+	fmt.Printf("Rate Limiter API starting on port %s\n", port)
+	fmt.Println("Endpoints:")
+	fmt.Println("  GET    /health")
+	fmt.Println("  GET    /check?policy=KEY&identifier=ID")
+	fmt.Println("  POST   /policies")
+	fmt.Println("  GET    /policies")
+	fmt.Println("  GET    /policies/:key")
+	fmt.Println("  DELETE /policies/:key")
+	fmt.Println("  GET    /status?policy=KEY&identifier=ID")
+	fmt.Println("  POST   /reset?policy=KEY&identifier=ID")
+
+	// Print config.
+	if envPort := os.Getenv("PORT"); envPort != "" {
+		fmt.Printf("Config: PORT=%s\n", envPort)
+	}
+
+	if err := http.ListenAndServe(":"+port, router); err != nil {
+		log.Fatalf("Server failed: %v", err)
+	}
+}
+
+func init() {
+	// Parse and validate PORT env var.
+	if port := os.Getenv("PORT"); port != "" {
+		if _, err := strconv.Atoi(port); err != nil {
+			fmt.Fprintf(os.Stderr, "Warning: invalid PORT value %q, using default 8080\n", port)
+			os.Setenv("PORT", "8080")
+		}
+	}
+}
