+"""WHOIS domain lookup API."""
+
+from fastapi import FastAPI, HTTPException, Query
+from fastapi.middleware.cors import CORSMiddleware
+from pydantic import BaseModel
+import whois
+from datetime import datetime
+from typing import Optional
+import re
+
+app = FastAPI(
+    title="WHOIS API",
+    description="Domain WHOIS lookup service",
+    version="1.0.0",
+)
+
+app.add_middleware(
+    CORSMiddleware,
+    allow_origins=["*"],
+    allow_methods=["*"],
+    allow_headers=["*"],
+)
+
+
+class WhoisResponse(BaseModel):
+    domain: str
+    registrar: Optional[str] = None
+    creation_date: Optional[str] = None
+    expiration_date: Optional[str] = None
+    updated_date: Optional[str] = None
+    name_servers: list[str] = []
+    status: list[str] = []
+    registrant: Optional[str] = None
+    emails: list[str] = []
+    dnssec: Optional[str] = None
+    raw: Optional[str] = None
+
+
+class DomainCheckResponse(BaseModel):
+    domain: str
+    available: bool
+    message: str
+
+
+def format_date(d) -> Optional[str]:
+    """Format a date object to ISO string."""
+    if d is None:
+        return None
+    if isinstance(d, list):
+        d = d[0]
+    if isinstance(d, datetime):
+        return d.isoformat()
+    return str(d)
+
+
+def normalize_list(val) -> list:
+    """Ensure value is a list."""
+    if val is None:
+        return []
+    if isinstance(val, str):
+        return [val]
+    return list(val)
+
+
+@app.get("/whois", response_model=WhoisResponse)
+async def whois_lookup(
+    domain: str = Query(..., description="Domain name to look up"),
+    raw: bool = Query(False, description="Include raw WHOIS data"),
+):
+    """Perform WHOIS lookup for a domain."""
+    domain = domain.lower().strip()
+    if not re.match(r'^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z]{2,})+$', domain):
+        raise HTTPException(400, f"Invalid domain format: {domain}")
+
+    try:
+        w = whois.whois(domain)
+    except Exception as e:
+        raise HTTPException(502, f"WHOIS lookup failed: {str(e)}")
