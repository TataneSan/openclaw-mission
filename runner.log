+"""Text statistics core logic."""
+
+import re
+from dataclasses import dataclass
+from typing import Optional
+
+
+@dataclass
+class TextStats:
+    """Container for all text statistics."""
+
+    characters: int = 0
+    characters_no_spaces: int = 0
+    words: int = 0
+    sentences: int = 0
+    paragraphs: int = 0
+    lines: int = 0
+    avg_word_length: float = 0.0
+    unique_words: int = 0
+    longest_word: str = ""
+    reading_time_minutes: float = 0.0
+    speaking_time_minutes: float = 0.0
+
+    # Constants
+    READING_WPM = 238  # Average reading speed
+    SPEAKING_WPM = 150  # Average speaking speed
+
+    @classmethod
+    def from_text(cls, text: str) -> "TextStats":
+        """Compute statistics from text."""
+        stats = cls()
+
+        stats.characters = len(text)
+        stats.characters_no_spaces = len(text.replace(" ", "").replace("\n", "").replace("\t", ""))
+        stats.lines = text.count("\n") + (1 if text and not text.endswith("\n") else 0)
+
+        # Words
+        words = text.split()
+        stats.words = len(words)
+
+        if words:
+            stats.avg_word_length = sum(len(w) for w in words) / len(words)
+            stats.unique_words = len(set(w.lower() for w in words))
+            stats.longest_word = max(words, key=len)
+
+        # Sentences (split on .!?)
+        sentences = re.split(r'[.!?]+', text)
+        sentences = [s.strip() for s in sentences if s.strip()]
+        stats.sentences = len(sentences)
+
+        # Paragraphs (split on blank lines)
+        paragraphs = re.split(r'\n\s*\n', text)
+        paragraphs = [p.strip() for p in paragraphs if p.strip()]
+        stats.paragraphs = len(paragraphs)
+
+        # Reading/speaking time
+        stats.reading_time_minutes = stats.words / cls.READING_WPM
+        stats.speaking_time_minutes = stats.words / cls.SPEAKING_WPM
+
+        return stats
+
+    def format_reading_time(self, reading: bool = True) -> str:
+        """Format reading or speaking time."""
+        minutes = self.reading_time_minutes if reading else self.speaking_time_minutes
+        if minutes < 1:
+            seconds = int(minutes * 60)
+            return f"{seconds} seconds"
+        elif minutes < 60:
+            return f"{minutes:.0f} minutes"
+        else:
+            hours = minutes / 60
+            return f"{hours:.1f} hours"
+
+    def to_dict(self) -> dict:
+        """Convert to dictionary."""
+        return {
+            "characters": self.characters,
+            "characters_no_spaces": self.characters_no_spaces,
