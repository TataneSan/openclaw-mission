+package main
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/TataneSan/service-check/internal/infrastructure"
+	"github.com/TataneSan/service-check/internal/service"
+)
+
+const (
+	version = "1.0.0"
+	blue    = "\033[34m"
+	green   = "\033[32m"
+	yellow  = "\033[33m"
+	red     = "\033[31m"
+	reset   = "\033[0m"
+	bold    = "\033[1m"
+)
+
+func main() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	switch os.Args[1] {
+	case "list":
+		handleList(os.Args[2:])
+	case "get":
+		handleGet(os.Args[2:])
+	case "search":
+		handleSearch(os.Args[2:])
+	case "summary":
+		handleSummary(os.Args[2:])
+	case "version":
+		fmt.Printf("service-check %s\n", version)
+	case "help", "--help", "-h":
+		printUsage()
+	default:
+		fmt.Fprintf(os.Stderr, "Unknown command: %s\n\n", os.Args[1])
+		printUsage()
+		os.Exit(1)
+	}
+}
+
