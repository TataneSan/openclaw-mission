+// FormatJSONOutput returns a JSON-compatible summary string for backups.
+func FormatJSONOutput(backups []BackupStatus) string {
+	if len(backups) == 0 {
+		return "[]"
+	}
+
+	var sb strings.Builder
+	sb.WriteString("[\n")
+	for i, b := range backups {
+		sb.WriteString("  {\n")
+		sb.WriteString(fmt.Sprintf("    \"name\": %q,\n", b.BackupName))
+		sb.WriteString(fmt.Sprintf("    \"source\": %q,\n", b.Source))
+		sb.WriteString(fmt.Sprintf("    \"destination\": %q,\n", b.Destination))
+		sb.WriteString(fmt.Sprintf("    \"files_backed_up\": %d,\n", b.FilesBacked))
+		sb.WriteString(fmt.Sprintf("    \"files_skipped\": %d,\n", b.FilesSkipped))
+		sb.WriteString(fmt.Sprintf("    \"total_size_bytes\": %d,\n", b.TotalSize))
+		sb.WriteString(fmt.Sprintf("    \"backup_size_bytes\": %d,\n", b.BackupSize))
+		sb.WriteString(fmt.Sprintf("    \"start_time\": %q,\n", b.StartTime.Format(time.RFC3339)))
+		sb.WriteString(fmt.Sprintf("    \"end_time\": %q,\n", b.EndTime.Format(time.RFC3339)))
+		sb.WriteString(fmt.Sprintf("    \"duration\": %q\n", b.Duration))
+		if i < len(backups)-1 {
+			sb.WriteString("  },\n")
+		} else {
+			sb.WriteString("  }\n")
+		}
+	}
+	sb.WriteString("]")
+	return sb.String()
+}
