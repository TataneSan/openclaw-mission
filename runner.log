+package config
+
+import (
+	"os"
+	"time"
+
+	"gopkg.in/yaml.v3"
+)
+
+// Config represents the deploy configuration file.
+type Config struct {
+	App       string      `yaml:"app"`
+	Environment string    `yaml:"environment"`
+	Source    SourceConfig `yaml:"source"`
+	Target    TargetConfig `yaml:"target"`
+	PreDeploy []string    `yaml:"pre_deploy"`
+	Deploy    []string    `yaml:"deploy"`
+	PostDeploy []string   `yaml:"post_deploy"`
+	Rollback  []string    `yaml:"rollback"`
+	Retain    int         `yaml:"retain"`
+}
+
+// SourceConfig defines where the deployment artifacts come from.
+type SourceConfig struct {
+	Type     string `yaml:"type"` // local, git, s3
+	Path     string `yaml:"path"`
+	Repo     string `yaml:"repo"`
+	Branch   string `yaml:"branch"`
+	Bucket   string `yaml:"bucket"`
+	Region   string `yaml:"region"`
+}
+
+// TargetConfig defines where to deploy.
+type TargetConfig struct {
+	Type     string            `yaml:"type"` // local, ssh, docker
+	Host     string            `yaml:"host"`
+	Port     int               `yaml:"port"`
+	User     string            `yaml:"user"`
+	Path     string            `yaml:"path"`
+	KeyFile  string            `yaml:"key_file"`
+	Service  string            `yaml:"service"`
+	Image    string            `yaml:"image"`
+	EnvVars  map[string]string `yaml:"env_vars"`
+}
+
+// DeploymentRecord represents a single deployment entry in history.
+type DeploymentRecord struct {
+	ID        string    `yaml:"id"`
+	Timestamp time.Time `yaml:"timestamp"`
+	Version   string    `yaml:"version"`
+	Commit    string    `yaml:"commit"`
+	Author    string    `yaml:"author"`
+	Status    string    `yaml:"status"` // success, failed, rolled_back
+	Duration  string    `yaml:"duration"`
+	Message   string    `yaml:"message"`
+}
+
+// Load reads and parses a deploy configuration file.
+func Load(path string) (*Config, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+
+	var cfg Config
+	if err := yaml.Unmarshal(data, &cfg); err != nil {
+		return nil, err
+	}
+
+	if cfg.App == "" {
+		cfg.App = "app"
+	}
+	if cfg.Environment == "" {
+		cfg.Environment = "production"
+	}
+	if cfg.Retain == 0 {
+		cfg.Retain = 5
+	}
