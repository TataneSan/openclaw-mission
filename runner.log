+// yaml-lint checks YAML syntax and style.
+//
+// Usage:
+//   yaml-lint [flags] [file...]
+//
+// Examples:
+//   yaml-lint config.yaml
+//   yaml-lint --strict *.yml
+//   cat file.yaml | yaml-lint
+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+type Issue struct {
+	File    string
+	Line    int
+	Column  int
+	Severity string // "error", "warning", "style"
+	Message string
+}
+
+func main() {
+	opts, files := parseArgs(os.Args[1:])
+
+	if len(files) == 0 {
+		if hasStdin() {
+			issues := lintStdin(opts)
+			exitWithIssues(issues, opts)
+			return
+		}
+		printUsage()
+		os.Exit(1)
+	}
+
+	var allIssues []Issue
+	for _, f := range files {
+		data, err := os.ReadFile(f)
+		if err != nil {
+			allIssues = append(allIssues, Issue{
+				File:     f,
+				Severity: "error",
+				Message:  fmt.Sprintf("cannot read file: %v", err),
+			})
+			continue
+		}
+		issues := lintBytes(f, data, opts)
+		allIssues = append(allIssues, issues...)
+	}
+
+	exitWithIssues(allIssues, opts)
+}
+
+func lintBytes(filename string, data []byte, opts lintOpts) []Issue {
+	var issues []Issue
+
