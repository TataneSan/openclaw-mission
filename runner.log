+package main
+
+import (
+	"log"
+	"net/http"
+	"os"
+
+	"github.com/TataneSan/notify-api/internal/handler"
+	"github.com/TataneSan/notify-api/internal/middleware"
+	"github.com/TataneSan/notify-api/internal/service"
+)
+
+func main() {
+	port := os.Getenv("PORT")
+	if port == "" {
+		port = "8080"
+	}
+
+	notifier := service.New()
+	h := handler.New(notifier)
+	mw := middleware.New()
+
+	mux := http.NewServeMux()
+
+	// Health
+	mux.HandleFunc("GET /health", handler.Health)
+
+	// Send notification
+	mux.HandleFunc("POST /api/notify", mw.Logging(h.Send))
+
+	log.Printf("notify-api starting on :%s", port)
+	if err := http.ListenAndServe(":"+port, mux); err != nil {
+		log.Fatalf("server failed: %v", err)
+	}
+}
