+package cli
+
+import (
+	"fmt"
+	"os"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/TataneSan/tcp-dump-lite/internal/domain"
+	"github.com/TataneSan/tcp-dump-lite/internal/infrastructure"
+
+	"github.com/spf13/cobra"
+)
+
+const version = "1.0.0"
+
+var rootCmd = &cobra.Command{
+	Use:   "tcp-dump-lite",
+	Short: "Lightweight network connection monitor and analyzer",
+	Long: `tcp-dump-lite captures and analyzes network connections from /proc/net.
+
+View active TCP/UDP connections, monitor traffic in real-time,
+filter by IP or protocol, and generate connection statistics.
+
+No root required — reads from /proc/net/tcp and /proc/net/udp.
+
+Examples:
+  tcp-dump-lite snapshot
+  tcp-dump-lite monitor --interval 2s
+  tcp-dump-lite snapshot --ip 192.168.1.1
+  tcp-dump-lite snapshot --protocol tcp
+  tcp-dump-lite top --limit 10`,
+	Version: version,
+}
+
+func Execute() error {
+	return rootCmd.Execute()
+}
+
+func init() {
+	rootCmd.AddCommand(snapshotCmd())
+	rootCmd.AddCommand(monitorCmd())
+	rootCmd.AddCommand(topCmd())
+}
+
+func snapshotCmd() *cobra.Command {
+	var filterIP string
+	var protocol string
+	cmd := &cobra.Command{
+		Use:   "snapshot",
+		Short: "Take a snapshot of current network connections",
+		Long:  "Display all active TCP and UDP connections at this moment.",
+		RunE: func(cmd *cobra.Command, args []string) error {
+			p := parseProtocol(protocol)
+			capture := infrastructure.NewCapture(filterIP, p, 0)
+			packets, err := capture.ReadConnections()
+			if err != nil {
+				return err
+			}
+
+			if len(packets) == 0 {
+				fmt.Println("No connections found.")
+				return nil
+			}
+
+			printHeader()
+			for _, pkt := range packets {
+				printPacket(&pkt)
+			}
+			fmt.Printf("\nTotal: %d connection(s)\n", len(packets))
+			return nil
+		},
+	}
+	cmd.Flags().StringVarP(&filterIP, "ip", "i", "", "Filter by IP address")
+	cmd.Flags().StringVarP(&protocol, "protocol", "p", "", "Filter by protocol (tcp, udp)")
+	return cmd
+}
