+"""IP info lookup core logic."""
+
+import json
+import socket
+import urllib.request
+import urllib.error
+from dataclasses import dataclass, fields
+from typing import Optional
+
+
+# Free IP geolocation APIs (no key required)
+API_ENDPOINTS = [
+    "https://ipapi.co/json/",
+    "https://ipinfo.io/json",
+    "https://api.ipgeolocation.io/ipgeo?apiKey=demo",
+]
+
+
+@dataclass
+class IPInfo:
+    """Container for IP address information."""
+
+    ip: str = ""
+    city: str = ""
+    region: str = ""
+    country: str = ""
+    country_code: str = ""
+    postal: str = ""
+    latitude: Optional[float] = None
+    longitude: Optional[float] = None
+    timezone: str = ""
+    isp: str = ""
+    org: str = ""
+    asn: str = ""
+    hostname: str = ""
+
+    @classmethod
+    def from_api_response(cls, data: dict) -> "IPInfo":
+        """Create IPInfo from API response, handling different API formats."""
+        info = cls()
+
+        # Map known field names from different APIs
+        field_mappings = {
+            "ip": ["ip", "ip_address", "public_ip", "query"],
+            "city": ["city"],
+            "region": ["region", "region_name", "stateProv", "state"],
+            "country": ["country_name", "country_name"],
+            "country_code": ["country_code", "country"],
+            "postal": ["postal", "postal_code", "zipcode"],
+            "latitude": ["latitude", "lat"],
+            "longitude": ["longitude", "lon"],
+            "timezone": ["timezone"],
+            "isp": ["isp", "org", "organization"],
+            "org": ["org", "organization"],
+            "asn": ["asn", "asn_organization"],
+        }
+
+        for field_name, possible_keys in field_mappings.items():
+            for key in possible_keys:
+                if key in data and data[key]:
+                    field_type = cls.__annotations__.get(field_name, str)
+                    try:
+                        if field_type == float or field_type == Optional[float]:
+                            setattr(info, field_name, float(data[key]))
+                        else:
+                            setattr(info, field_name, str(data[key]))
+                        break
+                    except (ValueError, TypeError):
+                        setattr(info, field_name, str(data[key]))
+                        break
+
+        return info
+
+    def format_text(self) -> str:
+        """Format as human-readable text."""
+        lines = []
+        for field in fields(self):
+            value = getattr(self, field.name)
