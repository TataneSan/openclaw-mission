+package main
+
+import (
+	"fmt"
+	"net/http"
+	"time"
+
+	"github.com/gorilla/mux"
+
+	"github.com/TataneSan/webhook-monitor/internal/infrastructure"
+	"github.com/TataneSan/webhook-monitor/internal/interfaces"
+)
+
+func main() {
+	store := infrastructure.NewStore()
+	monitor := infrastructure.NewMonitor(store)
+
+	router := mux.NewRouter()
+
+	api := router.PathPrefix("/api/v1").Subrouter()
+
+	// Webhook CRUD
+	api.HandleFunc("/webhooks", interfaces.CreateWebhookHandler(store)).Methods("POST")
+	api.HandleFunc("/webhooks", interfaces.ListWebhooksHandler(store)).Methods("GET")
+	api.HandleFunc("/webhooks/{id}", interfaces.GetWebhookHandler(store)).Methods("GET")
+	api.HandleFunc("/webhooks/{id}", interfaces.UpdateWebhookHandler(store)).Methods("PUT")
+	api.HandleFunc("/webhooks/{id}", interfaces.DeleteWebhookHandler(store)).Methods("DELETE")
+
+	// Monitoring
+	api.HandleFunc("/webhooks/{id}/results", interfaces.GetResultsHandler(store)).Methods("GET")
+	api.HandleFunc("/webhooks/{id}/alerts", interfaces.GetAlertsHandler(store)).Methods("GET")
+	api.HandleFunc("/webhooks/{id}/test", interfaces.TestWebhookHandler(store)).Methods("POST")
+
+	addr := ":8080"
+	fmt.Printf("webhook-monitor starting on %s\n", addr)
+
+	monitor.Start()
+
+	srv := &http.Server{
+		Addr:         addr,
+		Handler:      router,
+		ReadTimeout:  10 * time.Second,
+		WriteTimeout: 10 * time.Second,
+		IdleTimeout:  60 * time.Second,
+	}
+
+	if err := srv.ListenAndServe(); err != nil {
+		fmt.Printf("server error: %v\n", err)
+	}
+}
