+package infrastructure
+
+import (
+	"fmt"
+	"os"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+
+	"github.com/TataneSan/nginx-gen/internal/domain"
+)
+
+// Parser reads and parses YAML config files.
+type Parser struct{}
+
+// NewParser creates a new YAML parser.
+func NewParser() *Parser {
+	return &Parser{}
+}
+
+// ParseFile reads and parses a YAML config file.
+func (p *Parser) ParseFile(path string) (*domain.Config, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("failed to read file: %w", err)
+	}
+	return p.Parse(data)
+}
+
+// Parse parses YAML bytes into a config.
+func (p *Parser) Parse(data []byte) (*domain.Config, error) {
+	var cfg domain.Config
+	if err := yaml.Unmarshal(data, &cfg); err != nil {
+		return nil, fmt.Errorf("failed to parse YAML: %w", err)
+	}
+	return &cfg, nil
+}
+
+// Generator produces nginx configuration from a parsed config.
+type Generator struct{}
+
+// NewGenerator creates a new config generator.
+func NewGenerator() *Generator {
+	return &Generator{}
+}
+
+// Generate produces the nginx.conf text from a config.
+func (g *Generator) Generate(cfg *domain.Config) string {
+	var sb strings.Builder
+
+	sb.WriteString("# Auto-generated by nginx-gen\n")
+	sb.WriteString("# Edit the YAML source and regenerate instead of modifying this file.\n\n")
+	sb.WriteString("events {\n")
+	sb.WriteString("    worker_connections 1024;\n")
+	sb.WriteString("}\n\n")
+	sb.WriteString("http {\n")
+	sb.WriteString("    include       mime.types;\n")
+	sb.WriteString("    default_type  application/octet-stream;\n")
+	sb.WriteString("    sendfile      on;\n")
+	sb.WriteString("    keepalive_timeout 65;\n\n")
+
+	for i, srv := range cfg.HTTP.Servers {
+		if i > 0 {
+			sb.WriteString("\n")
+		}
+		g.writeServer(&sb, &srv)
+	}
+
+	sb.WriteString("}\n")
+	return sb.String()
+}
+
+func (g *Generator) writeServer(sb *strings.Builder, srv *domain.Server) {
+	sb.WriteString("    server {\n")
+	sb.WriteString(fmt.Sprintf("        listen %d;", srv.Listen))
+	sb.WriteString(fmt.Sprintf("\n        server_name %s;", srv.ServerName))
+
+	if srv.AccessLog != "" {
