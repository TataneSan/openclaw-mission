+type SurveyService struct {
+	surveyStore domain.SurveyStore
+	voteStore   domain.VoteStore
+}
+
+func NewSurveyService(surveyStore domain.SurveyStore, voteStore domain.VoteStore) *SurveyService {
+	return &SurveyService{
+		surveyStore: surveyStore,
+		voteStore:   voteStore,
+	}
+}
+
+func (s *SurveyService) CreateSurvey(title string, options []string, multi bool) (*domain.Survey, error) {
+	if title == "" {
+		return nil, fmt.Errorf("title is required")
+	}
+	if len(options) < 2 {
+		return nil, fmt.Errorf("at least 2 options are required")
+	}
+
+	survey := domain.Survey{
+		Title:   title,
+		Options: options,
+		Multi:   multi,
+	}
+
+	if err := s.surveyStore.Save(survey); err != nil {
+		return nil, fmt.Errorf("failed to save survey: %w", err)
+	}
+
+	return &survey, nil
+}
+
+func (s *SurveyService) GetSurvey(id string) (*domain.Survey, error) {
+	survey, err := s.surveyStore.Get(id)
+	if err != nil {
+		return nil, err
+	}
+	return &survey, nil
+}
+
+func (s *SurveyService) ListSurveys() ([]domain.Survey, error) {
+	return s.surveyStore.List()
+}
+
+func (s *SurveyService) DeleteSurvey(id string) error {
+	if _, err := s.surveyStore.Get(id); err != nil {
+		return err
+	}
+	return s.surveyStore.Delete(id)
