+// markdown-preview renders markdown files in the terminal with colored output.
+//
+// Usage:
+//
+//	markdown-preview <file>
+//	markdown-preview <file1> <file2> ...
+//
+// Reads from stdin if no file is provided:
+//
+//	cat README.md | markdown-preview
+//
+// Examples:
+//
+//	markdown-preview README.md
+//	markdown-preview *.md
+//	cat notes.md | markdown-preview
+package main
+
+import (
+	"bufio"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+)
+
+const (
+	reset       = "\033[0m"
+	bold        = "\033[1m"
+	dim         = "\033[2m"
+	italic      = "\033[3m"
+	underline   = "\033[4m"
+	strikethrough = "\033[9m"
+
+	fgRed    = "\033[38;5;203m"
+	fgGreen  = "\033[38;5;118m"
+	fgYellow = "\033[38;5;220m"
+	fgBlue   = "\033[38;5;75m"
+	fgCyan   = "\033[38;5;38m"
+	fgMagenta = "\033[38;5;135m"
+	fgGray   = "\033[38;5;245m"
+	fgWhite  = "\033[38;5;252m"
+
