+package main
+
+import (
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"sort"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+func main() {
+	fs := flag.NewFlagSet("yaml-to-toml", flag.ExitOnError)
+	fs.Usage = func() {
+		fmt.Fprintf(os.Stderr, "Usage: yaml-to-toml [file.yml]\n\n")
+		fmt.Fprintf(os.Stderr, "Convert YAML files to TOML format.\n")
+		fmt.Fprintf(os.Stderr, "Reads from stdin if no file is provided.\n")
+	}
+	fs.Parse(os.Args[1:])
+
+	var data []byte
+	var err error
+
+	args := fs.Args()
+	if len(args) > 0 {
+		data, err = os.ReadFile(args[0])
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "error reading file: %v\n", err)
+			os.Exit(1)
+		}
+	} else {
+		buf := make([]byte, 0, 4096)
+		tmp := make([]byte, 4096)
+		for {
+			n, readErr := os.Stdin.Read(tmp)
+			if n > 0 {
+				buf = append(buf, tmp[:n]...)
+			}
+			if readErr != nil {
+				break
+			}
+		}
+		data = buf
+	}
+
+	var doc interface{}
+	if err := yaml.Unmarshal(data, &doc); err != nil {
+		fmt.Fprintf(os.Stderr, "error parsing YAML: %v\n", err)
+		os.Exit(1)
+	}
+
+	// Convert via JSON intermediate to get clean map structure
+	jsonData, err := json.Marshal(doc)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "error converting: %v\n", err)
+		os.Exit(1)
+	}
+
+	var result map[string]interface{}
+	if err := json.Unmarshal(jsonData, &result); err != nil {
+		fmt.Fprintf(os.Stderr, "error: YAML root must be a mapping (got %T)\n", doc)
+		os.Exit(1)
+	}
+
+	toml := toTOML(result, 0)
+	fmt.Print(toml)
+}
+
+func toTOML(data map[string]interface{}, depth int) string {
+	var sb strings.Builder
+
+	// Separate simple keys from nested maps
+	var simpleKeys []string
+	var nestedKeys []string
+
+	keys := make([]string, 0, len(data))
