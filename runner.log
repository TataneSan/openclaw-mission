+package main
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+func main() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	cmd := os.Args[1]
+
+	switch cmd {
+	case "join":
+		handleJoin(os.Args[2:])
+	case "dirname":
+		handleDirname(os.Args[2:])
+	case "basename":
+		handleBasename(os.Args[2:])
+	case "ext":
+		handleExt(os.Args[2:])
+	case "abs":
+		handleAbs(os.Args[2:])
+	case "clean":
+		handleClean(os.Args[2:])
+	case "rel":
+		handleRel(os.Args[2:])
