+package main
+
+import (
+	"encoding/csv"
+	"flag"
+	"fmt"
+	"math"
+	"os"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+func detectDelimiter(data []byte) rune {
+	counts := map[rune]int{',': 0, ';': 0, '\t': 0, '|': 0}
+	for _, b := range data {
+		r := rune(b)
+		if _, ok := counts[r]; ok {
+			counts[r]++
+		}
+	}
+	best := rune(',')
+	bestCount := 0
+	for r, c := range counts {
+		if c > bestCount {
+			best = r
+			bestCount = c
+		}
+	}
+	return best
+}
+
+func readCSV(path string, delimiter rune) ([]string, [][]string, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, nil, err
+	}
+	defer f.Close()
+
+	reader := csv.NewReader(f)
+	reader.Comma = delimiter
+	reader.LazyQuotes = true
+	reader.TrimLeadingSpace = true
+	reader.FieldsPerRecord = -1
+
+	records, err := reader.ReadAll()
+	if err != nil {
+		return nil, nil, err
+	}
+	if len(records) == 0 {
+		return nil, nil, fmt.Errorf("empty CSV file")
+	}
+
+	return records[0], records[1:], nil
+}
+
+type colStats struct {
+	Name       string
+	NonEmpty   int
+	Empty      int
+	Unique     int
+	IsNumeric  bool
+	Min        float64
+	Max        float64
+	Sum        float64
+	Mean       float64
+	Median     float64
+	StdDev     float64
+	TopValues  [][2]string
+}
+
+func computeStats(headers []string, rows [][]string) []colStats {
+	numCols := len(headers)
+	stats := make([]colStats, numCols)
+	for i, h := range headers {
+		stats[i].Name = h
+	}
+
