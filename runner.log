+package infrastructure
+
+import (
+	"encoding/binary"
+	"fmt"
+	"net"
+	"time"
+
+	"github.com/TataneSan/tcp-dump-lite/internal/domain"
+)
+
+type Capture struct {
+	conn     *net.IPConn
+	iface    *net.Interface
+	filterIP string
+	filterP  domain.Protocol
+}
+
+func NewCapture(ifaceName, filterIP string, filterP domain.Protocol) (*Capture, error) {
+	var iface *net.Interface
+	if ifaceName != "" {
+		var err error
+		iface, err = net.InterfaceByName(ifaceName)
+		if err != nil {
+			return nil, fmt.Errorf("interface not found: %w", err)
+		}
+	}
+
+	addr := &net.IPAddr{IP: net.IPv4zero}
+	conn, err := net.ListenIP("ip0:all", addr)
+	if err != nil {
+		return nil, fmt.Errorf("listen: %w", err)
+	}
+
+	return &Capture{conn: conn, iface: iface, filterIP: filterIP, filterP: filterP}, nil
+}
+
+func (c *Capture) ReadPacket() (*domain.Packet, error) {
+	buf := make([]byte, 65535)
+	c.conn.SetReadDeadline(time.Now().Add(100 * time.Millisecond))
+	n, srcAddr, err := conn.ReadFrom(buf)
+	if err != nil {
+		return nil, err
+	}
+
+	return parseIPv4(buf[:n], srcAddr)
+}
+
+func (c *Capture) Close() error {
+	return c.conn.Close()
+}
+
+func parseIPv4(buf []byte, srcAddr net.Addr) (*domain.Packet, error) {
+	if len(buf) < 20 {
+		return nil, fmt.Errorf("packet too short")
+	}
+
+	versionIHL := buf[0]
+	version := versionIHL >> 4
+	if version != 4 {
+		return nil, nil
+	}
+
+	ihl := int(versionIHL&0x0F) * 4
+	if len(buf) < ihl {
+		return nil, fmt.Errorf("invalid IHL")
+	}
+
+	totalLen := binary.BigEndian.Uint16(buf[2:4])
+	protocol := buf[9]
+	ttl := buf[8]
+
+	srcIP := net.IP(buf[12:16]).String()
+	dstIP := net.IP(buf[16:20]).String()
+
+	pkt := &domain.Packet{
+		Timestamp: time.Now(),
+		Protocol:  domain.Protocol(protocol),
