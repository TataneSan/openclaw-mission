+// yaml-to-json converts YAML files to JSON format.
+//
+// Supports single and multiple YAML documents, pretty printing,
+// and streaming from stdin.
+package main
+
+import (
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"os"
+	"strings"
+
+	"gopkg.in/yaml.v3"
+)
+
+func convertYAMLToJSON(reader io.Reader, compact bool) error {
+	decoder := yaml.NewDecoder(reader)
+	first := true
+
+	for {
+		var node yaml.Node
+		if err := decoder.Decode(&node); err != nil {
+			if err == io.EOF {
+				break
+			}
+			return fmt.Errorf("failed to decode YAML: %w", err)
+		}
+
+		// Skip empty documents
+		if len(node.Content) == 0 {
+			continue
+		}
+
+		// Convert YAML node to generic map/slice
+		data, err := convertNode(&node)
+		if err != nil {
+			return fmt.Errorf("failed to convert node: %w", err)
+		}
+
+		if !first {
+			fmt.Print("\n")
+		}
+		first = false
+
+		var output []byte
+		if compact {
+			output, err = json.Marshal(data)
+		} else {
+			output, err = json.MarshalIndent(data, "", "  ")
+		}
+		if err != nil {
+			return fmt.Errorf("failed to marshal JSON: %w", err)
+		}
+
+		fmt.Println(string(output))
+	}
+
+	return nil
+}
+
+func convertNode(node *yaml.Node) (interface{}, error) {
+	switch node.Kind {
+	case yaml.DocumentNode:
+		if len(node.Content) == 0 {
+			return nil, nil
+		}
+		return convertNode(node.Content[0])
+
+	case yaml.MappingNode:
+		m := make(map[string]interface{})
+		for i := 0; i < len(node.Content); i += 2 {
+			key := node.Content[i].Value
+			val, err := convertNode(node.Content[i+1])
+			if err != nil {
+				return nil, err
+			}
