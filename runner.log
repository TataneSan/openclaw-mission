+// docker-compose-validator validates docker-compose files for common issues.
+//
+// It checks YAML syntax, required fields, deprecated options, and best practices
+// in docker-compose.yml files.
+//
+// Usage:
+//
+//	docker-compose-validator [options] [file]
+//
+// Options:
+//   -json   Output results in JSON format
+//   -warn   Also show warnings (not just errors)
+//   -h      Show help
+package main
+
+import (
+	"encoding/json"
+	"flag"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// Issue represents a validation finding.
+type Issue struct {
+	Service string `json:"service"`
+	Field   string `json:"field"`
+	Level   string `json:"level"` // "error" or "warning"
+	Message string `json:"message"`
+}
+
+// Result holds all validation issues for one file.
+type Result struct {
+	File    string  `json:"file"`
+	Issues  []Issue `json:"issues"`
+	Errors  int     `json:"errors"`
+	Warnings int    `json:"warnings"`
+}
+
+func readFile(path string) ([]byte, error) {
+	return os.ReadFile(path)
+}
+
+func validateComposeYAML(data []byte) []Issue {
+	var issues []Issue
+	content := string(data)
+	lines := strings.Split(content, "\n")
+
+	// Basic YAML syntax checks
+	// Check for tabs (YAML doesn't allow tabs for indentation)
+	for i, line := range lines {
+		if strings.Contains(line, "\t") {
+			issues = append(issues, Issue{
+				Field:   "syntax",
+				Level:   "error",
+				Message: fmt.Sprintf("line %d: tabs are not allowed as indentation in YAML, use spaces", i+1),
+			})
+		}
+	}
+
+	// Check for common issues in compose files
+	// These are simple string-based checks since we don't have a YAML parser dependency
+
+	// Check for version field (deprecated in compose v2+)
+	if strings.HasPrefix(strings.TrimSpace(content), "version:") {
+		issues = append(issues, Issue{
+			Field:   "version",
+			Level:   "warning",
+			Message: "the 'version' field is deprecated and no longer needed in modern Compose files",
+		})
+	}
+
+	// Check for deprecated 'links' (prefer networks)
+	if strings.Contains(content, "links:") {
+		issues = append(issues, Issue{
