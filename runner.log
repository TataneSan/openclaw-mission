+package domain
+
+import (
+	"sort"
+
+	"github.com/TataneSan/log-analyzer/internal/model"
+)
+
+// Analyzer computes statistics from log entries.
+type Analyzer struct{}
+
+// Analyze computes stats from a list of entries.
+func (a *Analyzer) Analyze(entries []model.Entry) *model.Stats {
+	stats := &model.Stats{
+		RequestsByIP:     make(map[string]int),
+		RequestsByPath:   make(map[string]int),
+		RequestsByStatus: make(map[int]int),
+		RequestsByMethod: make(map[string]int),
+	}
+
+	for _, e := range entries {
+		stats.TotalRequests++
+		stats.TotalBytes += e.Bytes
+		stats.RequestsByIP[e.IP]++
+		stats.RequestsByPath[e.Path]++
+		stats.RequestsByStatus[e.Status]++
+		stats.RequestsByMethod[e.Method]++
+	}
+
+	stats.TopIPs = topN(stats.RequestsByIP, 10)
+	stats.TopPaths = topN(stats.RequestsByPath, 10)
+	stats.StatusCodes = topStatusCodes(stats.RequestsByStatus, 20)
+
+	return stats
+}
+
+func topN(m map[string]int, n int) []model.KV {
+	items := make([]model.KV, 0, len(m))
+	for k, v := range m {
+		items = append(items, model.KV{Key: k, Value: v})
+	}
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].Value == items[j].Value {
+			return items[i].Key < items[j].Key
+		}
+		return items[i].Value > items[j].Value
+	})
+	if len(items) > n {
+		items = items[:n]
+	}
+	return items
+}
+
+func topStatusCodes(m map[int]int, n int) []model.KV {
+	items := make([]model.KV, 0, len(m))
+	for k, v := range m {
+		items = append(items, model.KV{Key: strconv.Itoa(k), Value: v})
+	}
+	sort.Slice(items, func(i, j int) bool {
+		if items[i].Value == items[j].Value {
+			return items[i].Key < items[j].Key
+		}
+		return items[i].Value > items[j].Value
+	})
+	if len(items) > n {
+		items = items[:n]
+	}
+	return items
+}
