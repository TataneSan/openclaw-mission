+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Subtask represents a subtask within a goal
+type Subtask struct {
+	ID        int       `json:"id"`
+	Title     string    `json:"title"`
+	Done      bool      `json:"done"`
+	CreatedAt time.Time `json:"created_at"`
+}
+
+// Goal represents a goal with subtasks and metadata
+type Goal struct {
+	ID          int       `json:"id"`
+	Title       string    `json:"title"`
+	Description string    `json:"description,omitempty"`
+	Category    string    `json:"category,omitempty"`
+	Priority    string    `json:"priority,omitempty"`
+	Subtasks    []Subtask `json:"subtasks,omitempty"`
+	Status      string    `json:"status"` // active, completed, abandoned
+	CreatedAt   time.Time `json:"created_at"`
+	CompletedAt time.Time `json:"completed_at,omitempty"`
+	NextSubtask int       `json:"next_subtask"`
+}
+
+// Tracker manages all goals
+type Tracker struct {
+	Goals    []Goal `json:"goals"`
+	NextID   int    `json:"next_id"`
+}
+
+const dataDir = "~/.goal-tracker"
+
+func main() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(0)
+	}
+
+	dataFile := getDataFile()
+	cmd := os.Args[1]
+
+	switch cmd {
+	case "add", "new":
+		handleAdd(dataFile, os.Args[2:])
+	case "list", "ls":
+		handleList(dataFile, os.Args[2:])
+	case "show", "get":
+		handleShow(dataFile, os.Args[2:])
+	case "add-task", "task":
+		handleAddTask(dataFile, os.Args[2:])
+	case "done", "complete-task":
+		handleDoneTask(dataFile, os.Args[2:])
+	case "complete", "finish":
+		handleComplete(dataFile, os.Args[2:])
+	case "delete", "rm":
+		handleDelete(dataFile, os.Args[2:])
+	case "progress":
+		handleProgress(dataFile, os.Args[2:])
+	case "stats":
+		handleStats(dataFile)
+	case "export":
+		handleExport(dataFile, os.Args[2:])
+	case "help", "--help", "-h":
+		printUsage()
+	default:
+		fmt.Fprintf(os.Stderr, "Unknown command: %s\nRun 'goal-tracker help' for usage.\n", cmd)
+		os.Exit(1)
