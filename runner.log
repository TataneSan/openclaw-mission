+package main
+
+import (
+	"bytes"
+	"flag"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/yuin/goldmark"
+	"github.com/yuin/goldmark/extension"
+)
+
+func main() {
+	var (
+		inputPath   = flag.String("i", "", "Input markdown file (required)")
+		outputPath  = flag.String("o", "", "Output PDF file (default: same name with .pdf)")
+		title       = flag.String("title", "", "Document title (default: filename)")
+		author      = flag.String("author", "", "Author name")
+		pageWidth   = flag.Float64("width", 595.28, "Page width in points (A4: 595.28)")
+		pageHeight  = flag.Float64("height", 841.89, "Page height in points (A4: 841.89)")
+		margin      = flag.Float64("margin", 72.0, "Page margin in points")
+		fontSize    = flag.Int("font-size", 11, "Base font size")
+		help        = flag.Bool("h", false, "Show help")
+	)
+	flag.Parse()
+
+	if *help {
+		printUsage()
+		return
+	}
+
+	if *inputPath == "" {
+		fmt.Fprintf(os.Stderr, "Error: input file is required\n")
+		printUsage()
+		os.Exit(1)
+	}
+
+	md, err := os.ReadFile(*inputPath)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "Error reading file: %v\n", err)
+		os.Exit(1)
+	}
+
+	docTitle := *title
+	if docTitle == "" {
+		docTitle = filepath.Base(*inputPath)
+		docTitle = strings.TrimSuffix(docTitle, filepath.Ext(docTitle))
+	}
+
+	outPath := *outputPath
+	if outPath == "" {
+		outPath = strings.TrimSuffix(*inputPath, filepath.Ext(*inputPath)) + ".pdf"
+	}
+
+	html := markdownToHTML(md)
+	pdf := renderPDF(html, pdfConfig{
+		Title:      docTitle,
+		Author:     *author,
+		PageWidth:  *pageWidth,
+		PageHeight: *pageHeight,
+		Margin:     *margin,
+		FontSize:   *fontSize,
+	})
+
+	if err := os.WriteFile(outPath, pdf, 0644); err != nil {
+		fmt.Fprintf(os.Stderr, "Error writing PDF: %v\n", err)
+		os.Exit(1)
+	}
+
+	fmt.Printf("Generated: %s\n", outPath)
+}
+
