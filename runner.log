+// git-branch-age shows the age of each git branch.
+//
+// Displays local and remote branches sorted by last commit date,
+// with human-readable age (e.g. "2 days ago").
+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+	"os/exec"
+	"sort"
+	"strings"
+	"time"
+)
+
+type Branch struct {
+	Name    string
+	Hash    string
+	Subject string
+	Author  string
+	Date    time.Time
+	Remote  bool
+}
+
+func run() int {
+	var (
+		all     = flag.Bool("a", false, "show all branches (local + remote)")
+		remote  = flag.Bool("r", false, "show only remote branches")
+		local   = flag.Bool("l", false, "show only local branches")
+		jsonOut = flag.Bool("j", false, "output as JSON")
+		limit   = flag.Int("n", 0, "limit output to N branches (0 = all)")
+	)
+	flag.Parse()
+
+	branches, err := getBranches(*all, *remote, *local)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "error: %v\n", err)
+		return 1
+	}
+
+	if len(branches) == 0 {
+		fmt.Fprintln(os.Stderr, "no branches found")
+		return 0
+	}
+
+	// Sort by date descending (newest first)
+	sort.Slice(branches, func(i, j int) bool {
+		return branches[i].Date.After(branches[j].Date)
+	})
+
+	if *limit > 0 && len(branches) > *limit {
+		branches = branches[:*limit]
+	}
+
+	now := time.Now()
+
+	if *jsonOut {
+		printJSON(branches, now)
+	} else {
+		printTable(branches, now)
+	}
+
+	return 0
+}
+
+func getBranches(all, remoteOnly, localOnly bool) ([]Branch, error) {
+	var branches []Branch
+	seen := make(map[string]bool)
+
+	if !remoteOnly {
+		local, err := getLocalBranches()
+		if err != nil {
+			return nil, err
+		}
+		branches = append(branches, local...)
+		for _, b := range local {
+			seen[b.Name] = true
