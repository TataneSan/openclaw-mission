+#!/usr/bin/env python3
+"""pdf-text-extract - Extract text from PDF files."""
+
+import argparse
+import sys
+import os
+
+
+def extract_text(pdf_path, pages=None, password=None):
+    """Extract text from a PDF file."""
+    try:
+        from pypdf import PdfReader
+    except ImportError:
+        print("Error: pypdf is required. Install with: pip install pypdf", file=sys.stderr)
+        sys.exit(1)
+
+    reader = PdfReader(pdf_path, password=password)
+    total_pages = len(reader.pages)
+
+    if pages:
+        page_nums = []
+        for p in pages:
+            if p < 1 or p > total_pages:
+                print(f"Error: page {p} out of range (1-{total_pages})", file=sys.stderr)
+                sys.exit(1)
+            page_nums.append(p)
+    else:
+        page_nums = list(range(1, total_pages + 1))
+
+    texts = []
+    for i, page_num in enumerate(page_nums):
+        page = reader.pages[page_num - 1]
+        text = page.extract_text() or ""
+        texts.append((page_num, text))
+
+    return texts, total_pages
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="Extract text from PDF files",
