+package geolocation
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+)
+
+const (
+	ipInfoURL = "https://ipinfo.io/json?token="
+	ipAPIURL  = "https://ipapi.co/json/"
+)
+
+// Client fetches IP geolocation data from external APIs.
+type Client struct {
+	httpClient *http.Client
+}
+
+// NewClient creates a new geolocation client.
+func NewClient(timeout time.Duration) *Client {
+	return &Client{
+		httpClient: &http.Client{Timeout: timeout},
+	}
+}
+
+// Lookup returns geolocation info for the given IP address.
+// If ip is empty, it fetches info for the server's outgoing IP.
+func (c *Client) Lookup(ip string) (*Info, error) {
+	info, err := c.lookupIPAPI()
+	if err == nil && info.IP != "" {
+		return info, nil
+	}
+
+	info, err = c.lookupIPInfo()
+	if err == nil && info.IP != "" {
+		return info, nil
+	}
+
+	return c.localInfo(ip)
+}
+
+func (c *Client) lookupIPAPI() (*Info, error) {
+	req, err := http.NewRequest("GET", ipAPIURL, nil)
+	if err != nil {
+		return nil, fmt.Errorf("create request: %w", err)
+	}
+	req.Header.Set("Accept", "application/json")
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("http request: %w", err)
+	}
+	defer resp.Body.Close()
+
+	body, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return nil, fmt.Errorf("read body: %w", err)
+	}
+
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("ipapi.co returned %d: %s", resp.StatusCode, string(body))
+	}
+
+	var raw ipAPIResponse
+	if err := json.Unmarshal(body, &raw); err != nil {
+		return nil, fmt.Errorf("parse json: %w", err)
+	}
+
+	return &Info{
+		IP:           raw.IP,
+		Country:      raw.CountryName,
+		CountryCode:  raw.CountryCode,
+		Region:       raw.Region,
+		RegionCode:   raw.RegionCode,
+		City:         raw.City,
