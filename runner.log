+// net-latency measures network latency to hosts using TCP and HTTP probes.
+//
+// Usage:
+//
+//	net-latency <host> [port] [flags]
+//	net-latency http://<url> [flags]
+//
+// Flags:
+//
+//	-c, --count    number of probes (default 4)
+//	-t, --timeout  connection timeout (default 5s)
+//	-q, --quiet    only print summary, not individual results
+//	-h, --help     show help
+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/TataneSan/net-latency/internal/domain"
+	"github.com/TataneSan/net-latency/internal/infrastructure"
+	"github.com/TataneSan/net-latency/internal/presentation"
+)
+
+func main() {
+	fs := flag.NewFlagSet("net-latency", flag.ExitOnError)
+	count := fs.Int("c", 4, "number of probes")
+	timeout := fs.Duration("t", 5*time.Second, "connection timeout")
+	quiet := fs.Bool("q", false, "only print summary")
+	fs.Bool("h", false, "show help")
+
+	fs.Parse(os.Args[1:])
+
+	if fs.NArg() == 0 {
+		fmt.Fprintf(os.Stderr, "Usage: net-latency <host> [port] [flags]\n")
+		fmt.Fprintf(os.Stderr, "       net-latency http://<url> [flags]\n")
+		fmt.Fprintf(os.Stderr, "\nMeasures network latency to hosts using TCP and HTTP probes.\n\n")
+		fmt.Fprintf(os.Stderr, "Examples:\n")
+		fmt.Fprintf(os.Stderr, "  net-latency google.com\n")
+		fmt.Fprintf(os.Stderr, "  net-latency google.com 443\n")
+		fmt.Fprintf(os.Stderr, "  net-latency http://google.com -c 10\n")
+		fmt.Fprintf(os.Stderr, "  net-latency 8.8.8.8 53 -t 3s -q\n")
+		os.Exit(1)
+	}
+
+	host := fs.Arg(0)
+	prober := infrastructure.NewTCPProber(*timeout)
+	printer := presentation.NewPrinter()
+	var results []domain.ProbeResult
+
+	isHTTP := strings.HasPrefix(host, "http://") || strings.HasPrefix(host, "https://")
+
+	if isHTTP {
+		for i := 0; i < *count; i++ {
+			r := prober.ProbeHTTP(host)
+			results = append(results, r)
+			if !*quiet {
+				printer.PrintResults([]domain.ProbeResult{r})
+			}
+		}
+	} else {
