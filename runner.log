+// uuid-api is a REST API for generating UUIDs (v4 and v7).
+//
+// Endpoints:
+//   GET /v4              - Single UUID v4
+//   GET /v4?n=5          - Multiple UUIDs v4 (up to 100)
+//   GET /v7              - Single UUID v7
+//   GET /v7?n=5          - Multiple UUIDs v7 (up to 100)
+//   GET /validate?uuid=  - Validate a UUID string
+//   GET /health          - Health check
+package main
+
+import (
+	"crypto/rand"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"log"
+	"math/big"
+	"net"
+	"net/http"
+	"os"
+	"os/signal"
+	"strconv"
+	"strings"
+	"syscall"
+	"time"
+)
+
+type config struct {
+	port int
+	host string
+}
+
+func parseConfig() config {
+	cfg := config{}
+	flag.IntVar(&cfg.port, "port", 8080, "port to listen on")
+	flag.StringVar(&cfg.host, "host", "127.0.0.1", "host to bind to")
+	flag.Parse()
+	return cfg
+}
+
+// UUIDv4 generates a random UUID version 4.
+func UUIDv4() string {
+	b := make([]byte, 16)
+	rand.Read(b)
+	b[6] = (b[6] & 0x0f) | 0x40
+	b[8] = (b[8] & 0x3f) | 0x80
+	return formatUUID(b)
+}
+
+// UUIDv7 generates a time-ordered UUID version 7.
+func UUIDv7() string {
+	now := time.Now()
+
+	// Unix timestamp in milliseconds (48 bits)
+	millis := now.UnixMilli()
+	b := make([]byte, 16)
+
+	// First 6 bytes: timestamp milliseconds (big-endian, only lower 48 bits)
+	binary.BigEndian.PutUint64(b[:8], uint64(millis))
+
+	// Random bits for remaining fields (40 bits of randomness)
+	rand.Read(b[6:16])
+
+	// Set version (7) in byte 6
+	b[6] = (b[6] & 0x0f) | 0x70
+
+	// Set variant (RFC 4122) in byte 8
+	b[8] = (b[8] & 0x3f) | 0x80
+
+	return formatUUID(b)
+}
+
+func formatUUID(b []byte) string {
+	h := hex.EncodeToString(b)
+	return fmt.Sprintf("%s-%s-%s-%s-%s", h[0:8], h[8:12], h[12:16], h[16:20], h[20:32])
