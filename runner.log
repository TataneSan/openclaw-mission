+package cli
+
+import (
+	"fmt"
+	"os"
+
+	"github.com/TataneSan/nginx-gen/internal/infrastructure"
+)
+
+// Execute runs the CLI.
+func Execute() error {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	cmd := os.Args[1]
+
+	switch cmd {
+	case "generate", "gen":
+		return cmdGenerate()
+	case "validate", "lint":
+		return cmdValidate()
+	case "example":
+		return cmdExample()
+	case "help", "--help", "-h":
+		printUsage()
+		return nil
+	default:
+		fmt.Fprintf(os.Stderr, "Unknown command: %s\n", cmd)
+		printUsage()
+		os.Exit(1)
+		return nil
+	}
+}
+
+func cmdGenerate() error {
+	if len(os.Args) < 3 {
+		fmt.Fprintf(os.Stderr, "Usage: nginx-gen generate <config.yaml> [output.conf]\n")
+		os.Exit(1)
+		return nil
+	}
+
+	yamlPath := os.Args[2]
+	outputPath := "nginx.conf"
+	if len(os.Args) >= 4 {
+		outputPath = os.Args[3]
+	}
+
+	parser := infrastructure.NewParser()
+	cfg, err := parser.ParseFile(yamlPath)
+	if err != nil {
+		return fmt.Errorf("parse error: %w", err)
+	}
+
+	gen := infrastructure.NewGenerator()
+	nginxConf := gen.Generate(cfg)
+
+	if outputPath == "-" {
+		fmt.Print(nginxConf)
+		return nil
+	}
+
+	if err := os.WriteFile(outputPath, []byte(nginxConf), 0644); err != nil {
+		return fmt.Errorf("failed to write file: %w", err)
+	}
+
+	fmt.Printf("Generated %s from %s\n", outputPath, yamlPath)
+	return nil
+}
+
+func cmdValidate() error {
+	if len(os.Args) < 3 {
+		fmt.Fprintf(os.Stderr, "Usage: nginx-gen validate <config.yaml>\n")
+		os.Exit(1)
+		return nil
+	}
+
