+			RefillRate:     float64(policy.RefillRate),
+			RefillInterval: policy.RefillInterval,
+			LastRefill:     time.Now(),
+		}
+		buckets[identifier] = bucket
+	}
+	return bucket, policy, nil
+}
+
+func (s *TokenBucketService) refillBucket(bucket *domain.Bucket) {
+	now := time.Now()
+	elapsed := now.Sub(bucket.LastRefill).Seconds()
+	if elapsed > 0 && bucket.RefillRate > 0 {
+		intervalSecs := bucket.RefillInterval.Seconds()
+		tokensToAdd := (elapsed / intervalSecs) * bucket.RefillRate
+		bucket.Tokens = min(bucket.Tokens+tokensToAdd, bucket.MaxTokens)
+		bucket.LastRefill = now
+	}
 }
 
