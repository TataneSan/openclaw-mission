+package service
+
+import (
+	"fmt"
+	"reflect"
+	"sort"
+	"strconv"
+	"strings"
+
+	"transform-api/internal/model"
+)
+
+// Transformer executes data transformation operations.
+type Transformer struct{}
+
+// NewTransformer creates a new Transformer.
+func NewTransformer() *Transformer {
+	return &Transformer{}
+}
+
+// Execute applies the requested transformation to the data.
+func (t *Transformer) Execute(req model.TransformRequest) model.TransformResponse {
+	resp := model.TransformResponse{
+		Operation: req.Operation,
+	}
+
+	target := t.resolvePath(req.Data, req.Path)
+	if target == nil {
+		target = req.Data
+	}
+
+	var result interface{}
+	var err error
+
+	switch req.Operation {
+	case "map":
+		result, err = t.mapItems(target, req.Expr)
+	case "filter":
+		result, err = t.filterItems(target, req.Expr)
+	case "sort":
+		result, err = t.sortItems(target, req.Key, req.Asc)
+	case "group":
+		result, err = t.groupItems(target, req.Key)
+	case "flatten":
+		result = t.flatten(target)
+	case "unique":
+		result, err = t.uniqueItems(target, req.Key)
+	case "limit":
+		result = t.limitItems(target, req.Limit, req.Offset)
+	default:
+		err = fmt.Errorf("unknown operation: %s", req.Operation)
+	}
+
+	if err != nil {
+		resp.Error = err.Error()
+		return resp
+	}
+
+	resp.Data = result
+	if arr, ok := result.([]interface{}); ok {
+		resp.Count = len(arr)
+	} else if m, ok := result.(map[string]interface{}); ok {
+		resp.Count = len(m)
+	}
+	return resp
+}
