+package presentation
+
+import (
+	"fmt"
+	"os"
+
+	"github.com/TataneSan/env-validate/internal/domain"
+)
+
+// Printer formats and prints validation results.
+type Printer struct{}
+
+// NewPrinter creates a new Printer.
+func NewPrinter() *Printer {
+	return &Printer{}
+}
+
+// Print outputs the validation result.
+func (p *Printer) Print(result *domain.ValidationResult) {
+	if result.IsValid {
+		fmt.Printf("✓ %s: all required keys present\n", result.File)
+	} else {
+		fmt.Printf("✗ %s: missing required keys\n", result.File)
+	}
+
+	fmt.Printf("Loaded: %d variables\n", len(result.Loaded))
+	fmt.Printf("Required: %d keys\n", len(result.Required))
+
+	if len(result.Missing) > 0 {
+		fmt.Println()
+		fmt.Println("Missing:")
+		for _, k := range result.Missing {
+			fmt.Printf("  ✗ %s\n", k)
+		}
+	}
+
+	if len(result.Extra) > 0 {
+		fmt.Println()
+		fmt.Println("Extra (not in required list):")
+		for _, k := range result.Extra {
+			fmt.Printf("  ? %s\n", k)
+		}
+	}
+
+	fmt.Println()
+}
+
+// ExitCode returns the appropriate exit code.
+func (p *Printer) ExitCode(result *domain.ValidationResult) int {
+	if result.IsValid {
+		return 0
+	}
+	return 1
+}
