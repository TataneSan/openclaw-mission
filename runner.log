+package main
+
+import (
+	"bufio"
+	"fmt"
+	"os"
+	"strings"
+)
+
+func usage() {
+	fmt.Fprintf(os.Stderr, `env-to-yaml - Convert .env files to YAML format
+
+Usage:
+  env-to-yaml [options] [file]
+
+Options:
+  -o, --output FILE   Write output to file instead of stdout
+  -h, --help          Show this help
+
+Examples:
+  env-to-yaml .env
+  env-to-yaml .env -o config.yaml
+  cat .env | env-to-yaml
+  env-to-yaml .env.production > production.yaml
+
+If no file is given, reads from stdin.
+`)
+}
+
+func escapeYAMLValue(v string) string {
+	if v == "" {
+		return "''"
+	}
+
+	// Check if value needs quoting
+	needsQuote := false
+	if v[0] == '{' || v[0] == '[' || v[0] == '&' || v[0] == '*' || v[0] == '!' ||
+		v[0] == '|' || v[0] == '<' || v[0] == '>' || v[0] == '=' || v[0] == '%' ||
+		v[0] == '@' || v[0] == '`' {
+		needsQuote = true
+	}
+	if strings.Contains(v, ": ") || strings.Contains(v, " #") || strings.Contains(v, "\n") {
+		needsQuote = true
+	}
+	if v == "true" || v == "false" || v == "null" || v == "yes" || v == "no" ||
+		v == "on" || v == "off" || v == "True" || v == "False" || v == "Null" {
+		needsQuote = true
+	}
+	// Check if it's a number
+	if isNumber(v) {
+		needsQuote = true
+	}
+
+	if !needsQuote {
+		return v
+	}
+
+	// Use single quotes, escape existing single quotes
+	if strings.Contains(v, "'") && !strings.Contains(v, "\"") {
+		return "\"" + strings.ReplaceAll(v, "\"", "\\\"") + "\""
+	}
+	return "'" + strings.ReplaceAll(v, "'", "''") + "'"
+}
+
+func isNumber(s string) bool {
+	if s == "" {
+		return false
+	}
+	for i, c := range s {
+		if i == 0 && (c == '+' || c == '-') {
+			continue
+		}
+		if c < '0' || c > '9' {
+			return false
+		}
+	}
+	return true
+}
