+package infrastructure
+
+import (
+	"net"
+	"time"
+
+	"github.com/TataneSan/net-latency/internal/domain"
+)
+
+// TCPProber measures network latency using TCP connections.
+type TCPProber struct {
+	Timeout time.Duration
+}
+
+// NewTCPProber creates a new TCPProber with the given timeout.
+func NewTCPProber(timeout time.Duration) *TCPProber {
+	return &TCPProber{Timeout: timeout}
+}
+
+// Probe attempts a TCP connection to host:port and returns the result.
+func (p *TCPProber) Probe(host string, port int) domain.ProbeResult {
+	addr := net.JoinHostPort(host, strconv.Itoa(port))
+	start := time.Now()
+
+	conn, err := net.DialTimeout("tcp", addr, p.Timeout)
+	elapsed := time.Since(start)
+
+	result := domain.ProbeResult{
+		Host:     host,
+		Port:     port,
+		Protocol: "TCP",
+		Latency:  elapsed,
+	}
+
+	if err != nil {
+		result.Success = false
+		result.Error = err.Error()
+		return result
+	}
+	defer conn.Close()
+
+	result.Success = true
+	return result
+}
+
+// ProbeHTTP measures HTTP GET latency to a URL.
+func (p *TCPProber) ProbeHTTP(url string) domain.ProbeResult {
+	start := time.Now()
+
+	req, err := http.NewRequest("GET", url, nil)
+	if err != nil {
+		return domain.ProbeResult{
+			Host:     url,
+			Protocol: "HTTP",
+			Success:  false,
+			Error:    err.Error(),
+		}
+	}
+
+	client := &http.Client{Timeout: p.Timeout}
+	resp, err := client.Do(req)
+	elapsed := time.Since(start)
+
+	result := domain.ProbeResult{
+		Host:     url,
+		Protocol: "HTTP",
+		Latency:  elapsed,
+	}
+
+	if err != nil {
+		result.Success = false
+		result.Error = err.Error()
+		return result
+	}
+	defer resp.Body.Close()
+
+	result.Success = true
+	return result
