+package main
+
+import (
+	"bufio"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+)
+
+type Recipe struct {
+	Name        string   `json:"name"`
+	Category    string   `json:"category"`
+	Time        string   `json:"time"`
+	Servings    int      `json:"servings"`
+	Ingredients []string `json:"ingredients"`
+	Steps       []string `json:"steps"`
+	Tags        []string `json:"tags,omitempty"`
+	CreatedAt   string   `json:"created_at"`
+}
+
+type RecipeBook struct {
+	Recipes []Recipe `json:"recipes"`
+}
+
+func getRecipeDir() string {
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return "./.cli-cookbook"
+	}
+	return filepath.Join(home, ".cli-cookbook")
+}
+
+func getRecipeFile() string {
+	return filepath.Join(getRecipeDir(), "recipes.json")
+}
+
+func loadRecipes() (*RecipeBook, error) {
+	dir := getRecipeDir()
+	file := getRecipeFile()
+
+	if _, err := os.Stat(file); os.IsNotExist(err) {
+		os.MkdirAll(dir, 0755)
+		return &RecipeBook{Recipes: []Recipe{}}, nil
+	}
+
+	data, err := os.ReadFile(file)
+	if err != nil {
+		return nil, fmt.Errorf("failed to read recipes: %w", err)
+	}
+
+	var book RecipeBook
+	if err := json.Unmarshal(data, &book); err != nil {
+		return nil, fmt.Errorf("failed to parse recipes: %w", err)
+	}
+	if book.Recipes == nil {
+		book.Recipes = []Recipe{}
+	}
+	return &book, nil
+}
+
+func saveRecipes(book *RecipeBook) error {
+	dir := getRecipeDir()
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		return err
+	}
+	data, err := json.MarshalIndent(book, "", "  ")
+	if err != nil {
+		return err
+	}
+	return os.WriteFile(getRecipeFile(), data, 0644)
+}
+
+func readLine(reader *bufio.Reader, prompt string) string {
