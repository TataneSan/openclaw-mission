+	info.IsAnnotated = isAnnotated
+
+	if isAnnotated {
+		// Parse annotated tag object
+		tagObj, _ := runGit("cat-file", "-p", name)
+		scanner := bufio.NewScanner(strings.NewReader(tagObj))
+		for scanner.Scan() {
+			line := scanner.Text()
+			if strings.HasPrefix(line, "object ") {
