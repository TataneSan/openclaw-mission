+
+// Execute runs the command based on args and store.
+func Execute(args []string, store *storage.Store) {
+	if len(args) < 1 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	switch args[0] {
+	case "add":
+		cmdAdd(args[1:], store)
+	case "list", "ls":
+		cmdList(args[1:], store)
+	case "search", "find":
+		cmdSearch(args[1:], store)
+	case "update", "edit":
+		cmdUpdate(args[1:], store)
+	case "remove", "rm", "delete":
+		cmdRemove(args[1:], store)
+	case "done", "read":
+		cmdDone(args[1:], store)
+	case "stats":
+		cmdStats(store)
+	case "export":
+		cmdExport(args[1:], store)
+	case "help", "--help", "-h":
+		printUsage()
+	default:
+		fmt.Fprintf(os.Stderr, "Unknown command: %s\n", args[0])
+		printUsage()
+		os.Exit(1)
+	}
+}
+
+func printUsage() {
+	fmt.Println(`reading-list - Manage your reading list
+
+Usage:
+  reading-list <command> [arguments]
+
+Commands:
+  add <url> [-t tag] [-n note] [-T title]  Add a URL to read
+  list [status|tag]                         List items (filter by status or tag)
+  search <query>                            Search items by query
+  update <id> [-t tag] [-n note] [-T title] Update an item
+  done <id>                                 Mark item as read
+  remove <id>                               Remove an item
+  stats                                     Show reading stats
+  export [json|csv]                         Export list (default: json)
+  help                                      Show this help
+
+Status filters: to_read, reading, done
+Examples:
+  reading-list add https://example.com/article -t tech -n "Important article"
+  reading-list list to_read
+  reading-list list tag:tech
+  reading-list search "article"
+  reading-list done 1
+  reading-list remove 2`)
+}
