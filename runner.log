+package domain
+
+import (
+	"fmt"
+	"strings"
+
+	"github.com/TataneSan/nginx-gen/internal/model"
+)
+
+// Generator converts a config model into nginx.conf text.
+type Generator struct{}
+
+// Generate renders the complete nginx configuration.
+func (g *Generator) Generate(cfg *model.Config) string {
+	var sb strings.Builder
+
+	sb.WriteString("# Generated by nginx-gen\n")
+	sb.WriteString("# Do not edit manually — update the YAML source instead.\n\n")
+	sb.WriteString("events {\n")
+	sb.WriteString("    worker_connections 1024;\n")
+	sb.WriteString("}\n\n")
+	sb.WriteString("http {\n")
+	sb.WriteString("    include       mime.types;\n")
+	sb.WriteString("    default_type  application/octet-stream;\n")
+	sb.WriteString("    sendfile      on;\n")
+	sb.WriteString("    keepalive_timeout 65;\n\n")
+
+	for i, srv := range cfg.Servers {
+		if i > 0 {
+			sb.WriteString("\n")
+		}
+		g.writeServer(&sb, &srv)
+	}
+
+	sb.WriteString("}\n")
+	return sb.String()
+}
+
+func (g *Generator) writeServer(sb *strings.Builder, srv *model.Server) {
+	sb.WriteString("    server {\n")
+
+	// listen directive
+	if srv.SSLCert != "" && srv.SSLKey != "" {
+		sb.WriteString(fmt.Sprintf("        listen %d ssl;\n", srv.Listen))
+	} else {
+		sb.WriteString(fmt.Sprintf("        listen %d;\n", srv.Listen))
+	}
+
+	sb.WriteString(fmt.Sprintf("        server_name %s;\n", srv.ServerName))
+
+	if srv.Root != "" {
+		sb.WriteString(fmt.Sprintf("        root %s;\n", srv.Root))
+	}
+	if srv.Index != "" {
+		sb.WriteString(fmt.Sprintf("        index %s;\n", srv.Index))
+	}
+	if srv.AccessLog != "" {
+		sb.WriteString(fmt.Sprintf("        access_log %s;\n", srv.AccessLog))
+	}
+	if srv.ErrorLog != "" {
+		sb.WriteString(fmt.Sprintf("        error_log %s;\n", srv.ErrorLog))
+	}
+
+	// SSL
+	if srv.SSLCert != "" && srv.SSLKey != "" {
+		sb.WriteString(fmt.Sprintf("        ssl_certificate %s;\n", srv.SSLCert))
+		sb.WriteString(fmt.Sprintf("        ssl_certificate_key %s;\n", srv.SSLKey))
+		sb.WriteString("        ssl_protocols TLSv1.2 TLSv1.3;\n")
+		sb.WriteString("        ssl_ciphers HIGH:!aNULL:!MD5;\n")
+	}
+
+	// Server-level return
+	if srv.ReturnCode != nil {
