+package infrastructure
+
+import (
+	"fmt"
+	"rate-limiter-api/internal/domain"
+	"sync"
+	"time"
+)
+
+// TokenBucketService manages rate limiting using the token bucket algorithm.
+type TokenBucketService struct {
+	policies map[string]*domain.Policy
+	buckets  map[string]map[string]*domain.Bucket // policyKey -> identifier -> bucket
+	mu       sync.RWMutex
+}
+
+// NewTokenBucketService creates a new service instance.
+func NewTokenBucketService() *TokenBucketService {
+	return &TokenBucketService{
+		policies: make(map[string]*domain.Policy),
+		buckets:  make(map[string]map[string]*domain.Bucket),
+	}
+}
+
+// AddPolicy registers a new rate limiting policy.
+func (s *TokenBucketService) AddPolicy(policy *domain.Policy) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	if _, exists := s.policies[policy.Key]; exists {
+		return fmt.Errorf("policy %s already exists", policy.Key)
+	}
+	if policy.MaxTokens <= 0 {
+		return fmt.Errorf("max_tokens must be greater than 0")
+	}
+	if policy.RefillRate < 0 {
+		return fmt.Errorf("refill_rate must be non-negative")
+	}
+	if policy.RefillInterval <= 0 {
+		return fmt.Errorf("refill_interval must be greater than 0")
+	}
+
+	policy.CreatedAt = time.Now()
+	s.policies[policy.Key] = policy
+	s.buckets[policy.Key] = make(map[string]*domain.Bucket)
+	return nil
+}
+
+// DeletePolicy removes a policy and all its buckets.
+func (s *TokenBucketService) DeletePolicy(key string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	if _, exists := s.policies[key]; !exists {
+		return fmt.Errorf("policy %s not found", key)
+	}
+	delete(s.policies, key)
+	delete(s.buckets, key)
+	return nil
+}
+
