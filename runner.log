+	bold    = "\033[1m"
+)
+
+func main() {
+	if len(os.Args) < 2 {
+		printUsage()
+		os.Exit(1)
+	}
+
+	switch os.Args[1] {
+	case "create":
+		handleCreate(os.Args[2:])
+	case "list":
+		handleList(os.Args[2:])
+	case "restore":
+		handleRestore(os.Args[2:])
+	case "delete":
+		handleDelete(os.Args[2:])
+	case "cleanup":
+		handleCleanup(os.Args[2:])
+	case "version":
+		fmt.Printf("backup-cli %s\n", version)
+	case "help", "--help", "-h":
+		printUsage()
+	default:
+		fmt.Fprintf(os.Stderr, "Unknown command: %s\n\n", os.Args[1])
+		printUsage()
+		os.Exit(1)
+	}
+}
