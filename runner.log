+// project-log: journal de projet avec milestones
+// Usage: project-log [command] [flags]
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+)
+
+// Entry represents a single journal entry
+type Entry struct {
+	Date    string `json:"date"`
+	Title   string `json:"title"`
+	Content string `json:"content"`
+	Tags    []string `json:"tags,omitempty"`
+}
+
+// Milestone represents a project milestone
+type Milestone struct {
+	Date        string `json:"date"`
+	Title       string `json:"title"`
+	Description string `json:"description"`
+	Completed   bool   `json:"completed"`
+}
+
+// ProjectLog represents the full project log
+type ProjectLog struct {
+	ProjectName string      `json:"project_name"`
+	Description string      `json:"description"`
+	Created     string      `json:"created"`
+	Entries     []Entry     `json:"entries"`
+	Milestones  []Milestone `json:"milestones"`
+}
+
+const dataDir = ".project-log"
+
+func getLogPath() string {
+	home, err := os.UserHomeDir()
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "Error: cannot determine home directory\n")
+		os.Exit(1)
+	}
+	return filepath.Join(home, dataDir)
+}
+
+func getProjectPath(name string) string {
+	return filepath.Join(getLogPath(), name+".json")
+}
+
+func loadProject(name string) (*ProjectLog, error) {
+	path := getProjectPath(name)
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("project '%s' not found. Create it with: project-log init %s", name, name)
+	}
+	var log ProjectLog
+	if err := json.Unmarshal(data, &log); err != nil {
+		return nil, fmt.Errorf("failed to parse project log: %w", err)
+	}
+	return &log, nil
+}
+
+func saveProject(log *ProjectLog) error {
+	path := getProjectPath(log.ProjectName)
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		return fmt.Errorf("failed to create directory: %w", err)
+	}
+	data, err := json.MarshalIndent(log, "", "  ")
+	if err != nil {
+		return fmt.Errorf("failed to marshal project log: %w", err)
+	}
+	return os.WriteFile(path, data, 0644)
