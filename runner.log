+package main
+
+import (
+	"fmt"
+	"log"
+	"net/http"
+	"os"
+	"strconv"
+
+	"cache-api/internal/infrastructure"
+	"cache-api/internal/interfaces"
+)
+
+func main() {
+	port := getPort()
+
+	cache := infrastructure.NewInMemoryCache()
+	handler := interfaces.NewHandler(cache)
+	router := handler.Router()
+
+	fmt.Printf("Cache API starting on port %s\n", port)
+	fmt.Println("Endpoints:")
+	fmt.Println("  GET    /health")
+	fmt.Println("  GET    /stats")
+	fmt.Println("  PUT    /cache/:key?value=...&ttl=60")
+	fmt.Println("  GET    /cache/:key")
+	fmt.Println("  DELETE /cache/:key")
+	fmt.Println("  GET    /cache")
+	fmt.Println("  DELETE /cache")
+
+	if err := http.ListenAndServe(":"+port, router); err != nil {
+		log.Fatalf("Server failed: %v", err)
+	}
+}
+
+func getPort() string {
+	port := os.Getenv("PORT")
+	if port == "" {
+		return "8080"
+	}
+	if _, err := strconv.Atoi(port); err != nil {
+		fmt.Fprintf(os.Stderr, "Warning: invalid PORT %q, using 8080\n", port)
+		return "8080"
+	}
+	return port
+}
