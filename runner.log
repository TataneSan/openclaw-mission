+package infrastructure
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/TataneSan/webhook-monitor/internal/domain"
+)
+
+type Monitor struct {
+	store      *Store
+	httpClient *http.Client
+	mu         sync.Mutex
+	running    bool
+	failCount  map[string]int
+}
+
+func NewMonitor(store *Store) *Monitor {
+	return &Monitor{
+		store: store,
+		httpClient: &http.Client{
+			Timeout: 30 * time.Second,
+		},
+		failCount: make(map[string]int),
+	}
+}
+
+func (m *Monitor) Start() {
+	m.mu.Lock()
+	m.running = true
+	m.mu.Unlock()
+
+	go m.run()
+}
+
+func (m *Monitor) Stop() {
+	m.mu.Lock()
+	m.running = false
+	m.mu.Unlock()
+}
+
+func (m *Monitor) run() {
+	m.store.ListWebhooks() // trigger initial scan
+
+	for {
+		m.mu.Lock()
+		if !m.running {
+			m.mu.Unlock()
+			return
+		}
+		m.mu.Unlock()
+
+		webhooks := m.store.ListWebhooks()
+		for _, w := range webhooks {
+			if w.Enabled {
+				go m.checkWebhook(w)
+			}
+		}
+
+		// Sleep for the minimum interval among all webhooks
+		time.Sleep(10 * time.Second)
+	}
+}
+
+func (m *Monitor) checkWebhook(w *domain.Webhook) {
+	// Check if enough time has passed since last check
+	lastResults := m.store.GetResults(w.ID)
+	if len(lastResults) > 0 {
+		lastCheck := lastResults[len(lastResults)-1].Check
+		if time.Since(lastCheck) < time.Duration(w.Interval)*time.Second {
+			return
+		}
+	}
