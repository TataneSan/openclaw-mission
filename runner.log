+package domain
+
+import (
+	"context"
+	"crypto/rand"
+	"fmt"
+)
+
+func generateID() string {
+	b := make([]byte, 16)
+	rand.Read(b)
+	return fmt.Sprintf("%x-%x-%x-%x-%x", b[0:4], b[4:6], b[6:8], b[8:10], b[10:16])
+}
+
+type ServiceRepository interface {
+	Save(ctx context.Context, svc *Service) error
+	FindAll(ctx context.Context) ([]Service, error)
+	FindByID(ctx context.Context, id string) (*Service, error)
+	Delete(ctx context.Context, id string) error
+}
+
+type StatusManager struct {
+	repo ServiceRepository
+}
+
+func NewStatusManager(repo ServiceRepository) *StatusManager {
+	return &StatusManager{repo: repo}
+}
+
+func (m *StatusManager) AddService(ctx context.Context, req *AddServiceRequest) (*Service, error) {
+	if req.Name == "" {
+		return nil, fmt.Errorf("name is required")
+	}
+
+	switch req.Status {
+	case StatusOnline, StatusDegraded, StatusOffline, StatusMaintenance:
+	default:
+		req.Status = StatusOnline
+	}
+
+	svc := &Service{
+		ID:        generateID(),
+		Name:      req.Name,
+		URL:       req.URL,
+		Status:    req.Status,
+		UpdatedAt: time.Now().UTC(),
+	}
+
+	if err := m.repo.Save(ctx, svc); err != nil {
+		return nil, fmt.Errorf("failed to save service: %w", err)
+	}
+
+	return svc, nil
+}
+
+func (m *StatusManager) ListServices(ctx context.Context) ([]Service, error) {
+	return m.repo.FindAll(ctx)
+}
+
+func (m *StatusManager) GetService(ctx context.Context, id string) (*Service, error) {
+	return m.repo.FindByID(ctx, id)
+}
+
+func (m *StatusManager) RemoveService(ctx context.Context, id string) error {
+	return m.repo.Delete(ctx, id)
+}
+
+func (m *StatusManager) UpdateStatus(ctx context.Context, id string, req *UpdateStatusRequest) (*Service, error) {
+	svc, err := m.repo.FindByID(ctx, id)
+	if err != nil {
+		return nil, err
+	}
+
+	switch req.Status {
+	case StatusOnline, StatusDegraded, StatusOffline, StatusMaintenance:
+		svc.Status = req.Status
+	default:
+		return nil, fmt.Errorf("invalid status: %s", req.Status)
