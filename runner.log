+"""Core environment variable checking logic."""
+
+import os
+import re
+from dataclasses import dataclass, field
+from enum import Enum
+from typing import Optional
+
+
+class VarStatus(Enum):
+    SET = "set"
+    MISSING = "missing"
+    EMPTY = "empty"
+
+
+@dataclass
+class EnvVar:
+    """Represents an environment variable definition."""
+
+    name: str
+    required: bool = True
+    default: Optional[str] = None
+    description: str = ""
+    value: Optional[str] = field(default=None, repr=False)
+
+    @property
+    def status(self) -> VarStatus:
+        val = os.environ.get(self.name)
+        if val is None:
+            if self.default is not None:
+                return VarStatus.SET
+            return VarStatus.MISSING
+        if val == "" and self.required:
+            return VarStatus.EMPTY
+        return VarStatus.SET
+
+    @property
+    def effective_value(self) -> Optional[str]:
+        val = os.environ.get(self.name)
+        if val is not None:
+            return val
+        return self.default
+
+
+def parse_env_file(path: str) -> list[EnvVar]:
+    """Parse a .env / .env.example file.
+
+    Supports formats:
+      - VAR_NAME              (required, no default)
+      - VAR_NAME=default      (required, with default)
+      - VAR_NAME=             (required, empty default)
+      - # VAR_NAME            (optional/commented out)
+      - #VAR_NAME=default     (optional, with default)
+      - # description         (attached to next var)
+    """
+    vars_list: list[EnvVar] = []
