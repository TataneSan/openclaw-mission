+
+		if file == "-" {
+			reader = bufio.NewScanner(os.Stdin)
+		} else {
+			f, err := os.Open(file)
+			if err != nil {
+				fmt.Fprintf(os.Stderr, "error: %v\n", err)
+				continue
+			}
+			reader = bufio.NewScanner(f)
+			lineNum = 0
+			defer f.Close()
+		}
+
