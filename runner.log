+package interfaces
+
+import (
+	"encoding/json"
+	"net/http"
+	"strings"
+
+	"github.com/gorilla/mux"
+
+	"github.com/TataneSan/webhook-monitor/internal/domain"
+	"github.com/TataneSan/webhook-monitor/internal/infrastructure"
+)
+
+func CreateWebhookHandler(store *infrastructure.Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		var req domain.Webhook
+		if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+			writeError(w, http.StatusBadRequest, "invalid JSON body")
+			return
+		}
+		defer r.Body.Close()
+
+		if req.Name == "" || req.URL == "" {
+			writeError(w, http.StatusBadRequest, "name and url are required")
+			return
+		}
+
+		req.Method = strings.ToUpper(req.Method)
+		if req.Method == "" {
+			req.Method = "GET"
+		}
+
+		result := store.CreateWebhook(&req)
+		writeJSON(w, http.StatusCreated, result)
+	}
+}
+
+func ListWebhooksHandler(store *infrastructure.Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		webhooks := store.ListWebhooks()
+		writeJSON(w, http.StatusOK, webhooks)
+	}
+}
+
+func GetWebhookHandler(store *infrastructure.Store) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		vars := mux.Vars(r)
+		id := vars["id"]
+
+		webhook, err := store.GetWebhook(id)
+		if err != nil {
+			writeError(w, http.StatusNotFound, err.Error())
+			return
+		}
+		writeJSON(w, http.StatusOK, webhook)
+	}
+}
+
