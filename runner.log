+const express = require('express');
+const http = require('http');
+const https = require('https');
+const url = require('url');
+
+const app = express();
+app.use(express.json());
+
+// In-memory store for monitored URLs
+const monitors = new Map();
+
+// Check a single URL health
+async function checkUrl(targetUrl, timeout = 5000) {
+  return new Promise((resolve) => {
+    const startTime = Date.now();
+    const parsed = url.parse(targetUrl);
+
+    if (!parsed.protocol) {
+      resolve({
+        error: 'Invalid URL: missing protocol (use http:// or https://)',
+        status: 'error'
+      });
+      return;
+    }
+
+    if (parsed.protocol !== 'http:' && parsed.protocol !== 'https:') {
+      resolve({
+        error: 'Unsupported protocol: ' + parsed.protocol,
+        status: 'error'
+      });
+      return;
+    }
+
+    const client = parsed.protocol === 'https:' ? https : http;
+
+    const req = client.get(targetUrl, { timeout }, (res) => {
+      const responseTime = Date.now() - startTime;
+      const status = (res.statusCode >= 200 && res.statusCode < 400) ? 'healthy' : 'unhealthy';
+
+      // Consume response data to free up memory
+      res.resume();
+
+      resolve({
+        statusCode: res.statusCode,
+        responseTime,
+        status,
+        headers: {
+          server: res.headers['server'],
+          contentType: res.headers['content-type'],
+          cacheControl: res.headers['cache-control']
+        }
+      });
+    });
+
+    req.on('timeout', () => {
+      req.destroy();
+      resolve({
+        error: 'Request timed out after ' + timeout + 'ms',
+        responseTime: Date.now() - startTime,
+        status: 'timeout'
+      });
+    });
+
+    req.on('error', (err) => {
+      resolve({
+        error: err.message,
+        responseTime: Date.now() - startTime,
+        status: 'error'
+      });
+    });
+  });
+}
+
