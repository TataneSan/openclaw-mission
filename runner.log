+package command
+
+import (
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/TataneSan/git-ignore/internal/infrastructure/templates"
+	"github.com/TataneSan/git-ignore/internal/service"
+)
+
+func Run(args []string) error {
+	if len(args) == 0 {
+		printUsage()
+		return nil
+	}
+
+	switch args[0] {
+	case "list", "-l", "--list":
+		return cmdList()
+	case "show", "-s", "--show":
+		if len(args) < 2 {
+			return fmt.Errorf("usage: git-ignore show <template>")
+		}
+		return cmdShow(args[1])
+	case "add", "-a", "--add":
+		return cmdAdd(args[1:])
+	case "init", "-i", "--init":
+		return cmdInit(args[1:])
+	case "merge", "-m", "--merge":
+		return cmdMerge(args[1:])
+	case "templates":
+		return cmdList()
+	case "help", "-h", "--help":
+		printUsage()
+		return nil
+	case "version", "-v", "--version":
+		fmt.Println("git-ignore v1.0.0")
+		return nil
+	default:
+		// Try to treat first arg as template name for show
+		if templates.Exists(args[0]) {
+			return cmdShow(args[0])
+		}
+		return fmt.Errorf("unknown command: %s\n\nRun 'git-ignore help' for usage", args[0])
+	}
+}
+
+func cmdList() error {
+	names := templates.List()
+	fmt.Println("Available templates:")
+	fmt.Println(strings.Repeat("-", 40))
+	for _, name := range names {
+		desc := templates.Description(name)
+		fmt.Printf("  %-20s %s\n", name, desc)
+	}
+	fmt.Printf("\n%d templates available\n", len(names))
+	return nil
+}
+
+func cmdShow(name string) error {
+	content, err := templates.Get(name)
+	if err != nil {
+		return err
+	}
+	fmt.Print(content)
+	return nil
+}
