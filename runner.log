+"""Terminal display with ANSI color blocks."""
+
+import json
+
+
+def ansi_bg(r: int, g: int, b: int) -> str:
+    """Return ANSI escape for 24-bit background color."""
+    return f"\033[48;2;{r};{g};{b}m"
+
+
+def ansi_fg(r: int, g: int, b: int) -> str:
+    """Return ANSI escape for 24-bit foreground color."""
+    return f"\033[38;2;{r};{g};{b}m"
+
+
+RESET = "\033[0m"
+BOLD = "\033[1m"
+DIM = "\033[2m"
+
+
+def luminance(r: int, g: int, b: int) -> float:
+    """Relative luminance for contrast calculation."""
+    return 0.299 * r + 0.587 * g + 0.114 * b
+
+
+def text_color(r: int, g: int, b: int) -> str:
+    """Return white or black ANSI foreground based on background luminance."""
+    return ansi_fg(255, 255, 255) if luminance(r, g, b) < 140 else ansi_fg(0, 0, 0)
+
+
+def color_block(r: int, g: int, b: int, width: int = 12) -> str:
+    """Render a colored block in terminal."""
+    bg = ansi_bg(r, g, b)
+    fg = text_color(r, g, b)
+    return f"{bg}{fg}{' ' * width}{RESET}"
+
+
+def display_terminal(result: dict, width: int = 12) -> None:
+    """Display palette in terminal with ANSI colors."""
+    print()
+    print(f"{BOLD}🎨 Color Palette{RESET}")
+    print(f"{DIM}   Source: {result['url']}{RESET}")
+    print(f"{DIM}   Page:   {result['title']}{RESET}")
+    print(f"{DIM}   Found:  {result['total_found']} colors → {result['unique']} unique{RESET}")
+    print()
+
+    if not result["colors"]:
+        print("   No colors found.")
+        print()
+        return
+
+    # Header
+    print(f"   {'BLOCK':>{width+2}}  {'HEX':<10}  {'RGB':<20}  {'COUNT':>5}  {'SOURCE'}")
+    print(f"   {'─' * (width+2)}  {'─'*10}  {'─'*20}  {'─'*5}  {'─'*12}")
+
+    for c in result["colors"]:
+        r, g, b = c["rgb"]
+        block = color_block(r, g, b, width)
+        hex_str = c["hex"]
+        rgb_str = f"rgb({r}, {g}, {b})"
+        count = c.get("count", 1)
+        source = c.get("source", "css")
+
+        print(f"   {block}  {hex_str:<10}  {rgb_str:<20}  {count:>5}  {source}")
+
+    print()
+
+    # Big swatches
+    print(f"   {BOLD}Swatches:{RESET}")
+    line1 = "   "
+    line2 = "   "
+    line3 = "   "
+    for c in result["colors"][:16]:  # Max 16 swatches
+        r, g, b = c["rgb"]
+        bg = ansi_bg(r, g, b)
+        fg = text_color(r, g, b)
+        line1 += f"{bg}{fg}      {RESET} "
+        line2 += f"{bg}{fg}{c['hex']:^6}{RESET} "
