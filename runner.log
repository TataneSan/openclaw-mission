+
+func (v *Validator) Validate(content, format string) *domain.ValidationResult {
+	format = strings.ToLower(strings.TrimSpace(format))
+	if format == "" {
+		format = detectFormat(content)
+	}
+
+	switch format {
+	case "json":
+		return v.validateJSON(content)
+	case "yaml", "yml":
+		return v.validateYAML(content)
+	case "toml":
+		return v.validateTOML(content)
+	case "ini", "cfg", "conf":
+		return v.validateINI(content)
+	default:
+		return &domain.ValidationResult{
+			Valid:  false,
+			Format: format,
+			Errors: []domain.Error{{Message: fmt.Sprintf("unsupported format: %s", format)}},
+		}
+	}
+}
+
