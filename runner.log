+package rotator
+
+import (
+	"compress/gzip"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+)
+
+type Rotator struct {
+	Dir        string
+	MaxSizeMB  int
+	MaxBackups int
+	Compress   bool
+	Extension  string
+	DryRun     bool
+	Verbose    bool
+	MinAgeHours int
+}
+
+type RotationResult struct {
+	File       string
+	Rotated    bool
+	Reason     string
+	OldSize    int64
+	BackupFile string
+	Error      error
+}
+
+func (r *Rotator) Rotate() []*RotationResult {
+	pattern := filepath.Join(r.Dir, "*"+r.Extension)
+	matches, err := filepath.Glob(pattern)
+	if err != nil {
+		return []*RotationResult{{File: pattern, Error: err}}
+	}
+
+	if r.Verbose {
+		fmt.Printf("Found %d log files matching %s\n", len(matches), pattern)
+	}
+
+	var results []*RotationResult
+
+	for _, file := range matches {
+		result := r.processFile(file)
+		results = append(results, result)
+	}
+
+	return results
+}
+
+func (r *Rotator) processFile(file string) *RotationResult {
+	result := &RotationResult{File: file}
+
+	info, err := os.Stat(file)
+	if err != nil {
+		result.Error = fmt.Errorf("stat failed: %w", err)
+		return result
+	}
+
+	result.OldSize = info.Size()
+
+	if info.IsDir() {
+		return result
+	}
+
+	sizeMB := float64(info.Size()) / 1024 / 1024
+	if sizeMB < float64(r.MaxSizeMB) {
+		if r.Verbose {
+			fmt.Printf("SKIP %s (%.2f MB < %d MB threshold)\n", file, sizeMB, r.MaxSizeMB)
+		}
+		return result
+	}
