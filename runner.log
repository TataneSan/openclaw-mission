+// systemd-once: run a command once with systemd logging and service management.
+//
+// Creates a temporary systemd one-shot service, executes the command,
+// and provides logging via journalctl.
+package main
+
+import (
+	"flag"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"text/template"
+)
+
+var unitTemplate = template.Must(template.New("service").Parse(`[Unit]
+Description={{.Description}}
+After={{.After}}
+
+[Service]
+Type=oneshot
+ExecStart={{.ExecStart}}
+WorkingDirectory={{.WorkingDir}}
+StandardOutput=journal
+StandardError=journal
+{{- if .User }}
+User={{.User}}
+{{- end }}
+{{- if .Group }}
+Group={{.Group}}
+{{- end }}
+{{- if .Environment }}
+Environment={{.Environment}}
+{{- end }}
+
+[Install]
+WantedBy=multi-user.target
+`))
+
+type unitConfig struct {
+	Description  string
+	After        string
+	ExecStart    string
+	WorkingDir   string
+	User         string
+	Group        string
+	Environment  string
+}
+
+func run(cmd *exec.Cmd, stdin string) (string, error) {
+	if stdin != "" {
+		cmd.Stdin = strings.NewReader(stdin)
+	}
+	out, err := cmd.CombinedOutput()
+	return string(out), err
+}
+
+func systemdRunning() bool {
+	_, err := exec.LookPath("systemctl")
+	if err != nil {
+		return false
+	}
+	// Check if systemd is PID 1
+	out, err := exec.Command("cat", "/proc/1/comm").CombinedOutput()
+	return err == nil && strings.TrimSpace(string(out)) == "systemd"
+}
+
+func install(unitName, unitPath, userMode bool) error {
+	target := "/etc/systemd/system"
+	if userMode {
+		xdg := os.Getenv("XDG_DATA_HOME")
+		if xdg == "" {
+			home, _ := os.UserHomeDir()
+			xdg = filepath.Join(home, ".local", "share")
+		}
+		target = filepath.Join(xdg, "systemd", "user")
+	}
