+package application
+
+import (
+	"encoding/json"
+	"net/http"
+	"strconv"
+
+	"github.com/TataneSan/ping-api/internal/domain"
+)
+
+type Handler struct {
+	pinger *domain.Pinger
+}
+
+func NewHandler(pinger *domain.Pinger) *Handler {
+	return &Handler{pinger: pinger}
+}
+
+func (h *Handler) ServeHTTP(w http.ResponseWriter, r *http.Request) {
+	switch {
+	case r.Method == http.MethodPost && r.URL.Path == "/api/targets":
+		h.addTarget(w, r)
+	case r.Method == http.MethodGet && r.URL.Path == "/api/targets":
+		h.listTargets(w, r)
+	case r.Method == http.MethodDelete && len(r.URL.Path) > len("/api/targets/") && r.URL.Path[:len("/api/targets/")] == "/api/targets/":
+		id := r.URL.Path[len("/api/targets/"):]
+		h.removeTarget(w, r, id)
+	case r.Method == http.MethodPatch && len(r.URL.Path) > len("/api/targets/") && len(r.URL.Path) > len("/api/targets//toggle") && r.URL.Path[:len("/api/targets/")] == "/api/targets/" && r.URL.Path[len("/api/targets/"):] != "":
+		parts := r.URL.Path
+		if len(parts) > len("/api/targets//toggle") && parts[len(parts)-len("/toggle"):] == "/toggle" {
+			id := parts[len("/api/targets/") : len(parts)-len("/toggle")]
+			h.toggleTarget(w, r, id)
+		} else {
+			http.NotFound(w, r)
+		}
+	case r.Method == http.MethodPost && len(r.URL.Path) > len("/api/targets//ping") && r.URL.Path[:len("/api/targets/")] == "/api/targets/" && r.URL.Path[len(r.URL.Path)-len("/ping"):] == "/ping":
+		id := r.URL.Path[len("/api/targets/") : len(r.URL.Path)-len("/ping")]
+		h.pingNow(w, r, id)
+	case r.Method == http.MethodGet && len(r.URL.Path) > len("/api/targets//results") && r.URL.Path[:len("/api/targets/")] == "/api/targets/" && r.URL.Path[len(r.URL.Path)-len("/results"):] == "/results":
+		id := r.URL.Path[len("/api/targets/") : len(r.URL.Path)-len("/results")]
+		h.getResults(w, r, id)
+	case r.Method == http.MethodGet && r.URL.Path == "/api/results":
+		h.getLatestResults(w, r)
+	case r.Method == http.MethodGet && r.URL.Path == "/api/health":
+		h.health(w, r)
+	default:
+		http.NotFound(w, r)
+	}
+}
+
+func (h *Handler) addTarget(w http.ResponseWriter, r *http.Request) {
+	var req domain.AddTargetRequest
+	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
+		http.Error(w, "invalid request body", http.StatusBadRequest)
+		return
+	}
+
+	target, err := h.pinger.AddTarget(r.Context(), &req)
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusBadRequest)
+		return
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(http.StatusCreated)
+	json.NewEncoder(w).Encode(target)
+}
+
+func (h *Handler) listTargets(w http.ResponseWriter, r *http.Request) {
+	targets, err := h.pinger.ListTargets(r.Context())
+	if err != nil {
+		http.Error(w, err.Error(), http.StatusInternalServerError)
+		return
+	}
+
+	w.Header().Set("Content-Type", "application/json")
+	json.NewEncoder(w).Encode(targets)
+}
