+// tcp-dump-lite — Lightweight network connection monitor and analyzer
+//
+// Reads from /proc/net/tcp and /proc/net/udp to display active connections.
+// No root privileges required.
+//
+// Usage:
+//   tcp-dump-lite snapshot     Show current connections
+//   tcp-dump-lite monitor      Continuously monitor (default: 2s interval)
+//   tcp-dump-lite top          Show top connections by activity
+package main
+
+import (
+	"fmt"
+	"os"
+
+	"github.com/TataneSan/tcp-dump-lite/internal/interface/cli"
+)
+
+func main() {
+	if err := cli.Execute(); err != nil {
+		fmt.Fprintf(os.Stderr, "Error: %v\n", err)
+		os.Exit(1)
+	}
+}
