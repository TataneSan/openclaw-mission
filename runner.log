+				i++
+				args.root = os.Args[i]
+			}
+		case "--array-element":
+			flags = true
+			if i+1 < len(os.Args) && !strings.HasPrefix(os.Args[i+1], "--") {
+				i++
+				args.arrayEl = os.Args[i]
+			}
+		default:
+			if flags {
+				flags = false
+				continue
+			}
+			if !strings.HasPrefix(arg, "-") {
+				args.input = arg
+			}
+		}
+	}
+
+	return args
+}
