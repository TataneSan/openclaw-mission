+package queue
+
+import (
+	"sync"
+	"time"
+)
+
+// Queue manages a priority queue of jobs.
+type Queue struct {
+	mu    sync.Mutex
+	jobs  []Job
+}
+
+// Job represents a job in the queue.
+type Job struct {
+	ID        string    `json:"id"`
+	Priority  int       `json:"priority"`
+	Payload   string    `json:"payload"`
+	Status    string    `json:"status"`
+	CreatedAt time.Time `json:"created_at"`
+}
+
+// New creates a new Queue.
+func New() *Queue {
+	return &Queue{
+		jobs: make([]Job, 0),
+	}
+}
+
+// Add adds a job to the queue.
+func (q *Queue) Add(job Job) {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+
+	job.Status = "pending"
+	job.CreatedAt = time.Now().UTC()
+	q.jobs = append(q.jobs, job)
+}
+
+// Pop removes and returns the highest priority job.
+func (q *Queue) Pop() *Job {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+
+	if len(q.jobs) == 0 {
+		return nil
+	}
+
+	// Find highest priority job (highest number = highest priority)
+	highestIdx := 0
+	highestPriority := q.jobs[0].Priority
+
+	for i, job := range q.jobs {
+		if job.Priority > highestPriority {
+			highestIdx = i
+			highestPriority = job.Priority
+		}
+	}
+
+	job := q.jobs[highestIdx]
+	q.jobs = append(q.jobs[:highestIdx], q.jobs[highestIdx+1:]...)
+
+	return &job
+}
+
+// List returns all jobs in the queue.
+func (q *Queue) List() []Job {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+
+	result := make([]Job, len(q.jobs))
+	copy(result, q.jobs)
+	return result
+}
+
+// Size returns the number of jobs in the queue.
+func (q *Queue) Size() int {
+	q.mu.Lock()
