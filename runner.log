+#!/usr/bin/env node
+
+const fs = require('fs');
+const path = require('path');
+const readline = require('readline');
+
+const SNIPPETS_DIR = path.join(process.env.HOME || process.env.USERPROFILE || '.', '.snippets');
+const SNIPPETS_FILE = path.join(SNIPPETS_DIR, 'snippets.json');
+
+const BLUE = '\x1b[34m';
+const GREEN = '\x1b[32m';
+const YELLOW = '\x1b[33m';
+const RED = '\x1b[31m';
+const BOLD = '\x1b[1m';
+const DIM = '\x1b[2m';
+const RESET = '\x1b[0m';
+
+function ensureDir() {
+  if (!fs.existsSync(SNIPPETS_DIR)) {
+    fs.mkdirSync(SNIPPETS_DIR, { recursive: true });
+  }
+}
+
+function loadSnippets() {
+  ensureDir();
+  if (!fs.existsSync(SNIPPETS_FILE)) {
+    return [];
+  }
+  const raw = fs.readFileSync(SNIPPETS_FILE, 'utf-8');
+  return JSON.parse(raw);
+}
+
+function saveSnippets(snippets) {
+  ensureDir();
+  fs.writeFileSync(SNIPPETS_FILE, JSON.stringify(snippets, null, 2) + '\n');
+}
+
+function addSnippet(name, command, description) {
+  const snippets = loadSnippets();
+  const existing = snippets.find(s => s.name === name);
+  if (existing) {
+    existing.command = command;
+    existing.description = description || existing.description;
+    existing.updatedAt = new Date().toISOString();
+  } else {
+    snippets.push({
+      name,
+      command,
+      description: description || '',
+      createdAt: new Date().toISOString(),
+      updatedAt: new Date().toISOString(),
+    });
+  }
+  saveSnippets(snippets);
+  console.log(`${GREEN}✓${RESET} Snippet "${BLUE}${name}${RESET}" saved.`);
+}
+
+function listSnippets(filter) {
+  const snippets = loadSnippets();
+  if (snippets.length === 0) {
+    console.log(`${DIM}No snippets saved yet. Use: snippet add <name> <command> [description]${RESET}`);
+    return;
+  }
+
+  let filtered = snippets;
+  if (filter) {
+    const q = filter.toLowerCase();
+    filtered = snippets.filter(
+      s => s.name.toLowerCase().includes(q) ||
+           s.command.toLowerCase().includes(q) ||
+           (s.description && s.description.toLowerCase().includes(q))
+    );
+  }
+
+  if (filtered.length === 0) {
+    console.log(`${YELLOW}No snippets match "${filter}"${RESET}`);
+    return;
+  }
