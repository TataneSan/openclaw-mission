+// git-tag-info displays detailed information about git tags.
+//
+// Usage:
+//   git-tag-info [flags] [tag-name]
+//
+// If tag-name is provided, shows details for that specific tag.
+// Otherwise, lists all tags with summary information.
+package main
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const version = "1.0.0"
+
+type cliArgs struct {
+	tagName   string
+	format    string
+	sortBy    string
+	verbose   bool
+	version   bool
+	help      bool
+	repoPath  string
+}
+
+func parseArgs() cliArgs {
+	args := cliArgs{format: "text", sortBy: "date"}
+	i := 1
+	for i < len(os.Args) {
+		arg := os.Args[i]
+		switch arg {
+		case "--version", "-v":
+			args.version = true
+		case "--help", "-h":
+			args.help = true
+		case "--verbose", "--long":
+			args.verbose = true
+		case "--format", "-f":
+			i++
+			if i < len(os.Args) {
+				args.format = os.Args[i]
+			}
+		case "--sort", "-s":
+			i++
+			if i < len(os.Args) {
+				args.sortBy = os.Args[i]
+			}
+		case "--repo":
+			i++
+			if i < len(os.Args) {
+				args.repoPath = os.Args[i]
+			}
+		default:
+			if !strings.HasPrefix(arg, "-") {
+				args.tagName = arg
+			}
+		}
+		i++
+	}
+	return args
+}
+
+type tagInfo struct {
+	Name        string
+	Target      string // commit SHA the tag points to
+	Tagger      string
+	TaggedDate  string
+	CommitMsg   string
+	Author      string
+	CommitDate  string
+	IsAnnotated bool
+	CommitCount int // commits since this tag (0 if latest)
