+package infrastructure
+
+import (
+	"os/exec"
+	"path/filepath"
+	"strconv"
+	"strings"
+
+	"github.com/TataneSan/git-repo-info/internal/domain"
+)
+
+// Collector gathers git repository information by running git commands.
+type Collector struct {
+	Path string
+}
+
+// NewCollector creates a new Collector for the given path.
+func NewCollector(path string) *Collector {
+	if path == "" {
+		path = "."
+	}
+	return &Collector{Path: path}
+}
+
+// Collect runs all git queries and returns a RepoInfo.
+func (c *Collector) Collect() (*domain.RepoInfo, error) {
+	info := &domain.RepoInfo{Path: c.Path}
+
+	if err := c.run("rev-parse", "--show-toplevel"); err != nil {
+		return nil, err
+	}
+
+	info.HEAD = c.runOne("rev-parse", "HEAD")
+	info.Branch = c.runOne("rev-parse", "--abbrev-ref", "HEAD")
+	info.TotalCommits = c.runCount("rev-list", "--count", "HEAD")
+	info.Authors = c.runAuthors("shortlog", "-sn", "HEAD")
+	info.Branches = c.runBranches("branch", "--format=%(refname:short)")
+	info.RemoteURL = c.runRemote()
+	info.Created = c.runFirstCommitDate()
+	info.LastCommit = c.runOne("log", "-1", "--format=%H")
+	info.LastAuthor = c.runOne("log", "-1", "--format=%an <%ae>")
+	info.SizeBytes = c.runSize()
+
+	return info, nil
+}
+
+func (c *Collector) run(args ...string) string {
+	cmd := exec.Command("git", args...)
+	cmd.Dir = c.Path
+	out, err := cmd.Output()
+	if err != nil {
+		return ""
+	}
+	return strings.TrimSpace(string(out))
+}
+
+func (c *Collector) runOne(args ...string) string {
+	return c.run(args...)
+}
+
+func (c *Collector) runCount(args ...string) int {
+	out := c.run(args...)
+	n, _ := strconv.Atoi(out)
+	return n
+}
+
+func (c *Collector) runAuthors(args ...string) []string {
+	out := c.run(args...)
+	if out == "" {
+		return nil
+	}
+	var authors []string
+	for _, line := range strings.Split(out, "\n") {
+		parts := strings.Fields(line)
+		if len(parts) >= 2 {
+			authors = append(authors, strings.Join(parts[1:], " "))
+		}
+	}
